# Supabase Configuration
# Get these values from your Supabase project settings
# https://app.supabase.com/project/_/settings/api

PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Notes:
# - PUBLIC_SUPABASE_URL: The URL of your Supabase project
# - PUBLIC_SUPABASE_ANON_KEY: The anonymous/public key (safe to expose in frontend)
# - Never expose the service_role key in frontend code!

# Giscus Configuration (GitHub Comments)
# Get these values from https://giscus.app
# 1. Go to https://giscus.app
# 2. Enter your repository name (e.g., username/repo)
# 3. Select the Discussions category (must have Discussions enabled on your repo)
# 4. Copy the repo ID and category ID from the generated script

PUBLIC_GISCUS_REPO=your-username/your-repo
PUBLIC_GISCUS_REPO_ID=your-repo-id
PUBLIC_GISCUS_CATEGORY=General
PUBLIC_GISCUS_CATEGORY_ID=your-category-id

# Notes:
# - Your GitHub repository must have Discussions enabled
# - PUBLIC_GISCUS_REPO: Format is "owner/repo" (e.g., "openflows/openflows-website")
# - PUBLIC_GISCUS_REPO_ID: Get from giscus.app or GitHub API
# - PUBLIC_GISCUS_CATEGORY: The discussion category name (default: "General")
# - PUBLIC_GISCUS_CATEGORY_ID: Get from giscus.app or GitHub API
