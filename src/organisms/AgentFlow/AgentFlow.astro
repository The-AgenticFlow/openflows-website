---
const TICKET = { id: 'T-042', issue: '#128' };

const STEPS = [
  {
    agent: 'NEXUS',
    role: 'The Controller',
    description: `Turns GitHub issue ${TICKET.issue} into ticket ${TICKET.id}, checks the repository is CI-ready, and assigns an idle FORGE worker in its own Coder workspace.`,
    state: 'assigned',
    log: `${TICKET.id} created from issue ${TICKET.issue}, assigned to forge-2`,
  },
  {
    agent: 'FORGE',
    role: 'The Builder',
    description: 'Writes a plan and stops until it is approved, then implements in small commits on its own branch and runs the test suite.',
    state: 'building',
    log: `plan_ready, building on forge-2/${TICKET.id}`,
  },
  {
    agent: 'SENTINEL',
    role: 'The Reviewer',
    description: 'Approves the plan before any code is written, then reviews the pull request against your standards. Anything risky is escalated to a human.',
    state: 'in review',
    log: 'pull request approved, 0 security flags',
  },
  {
    agent: 'VESSEL',
    role: 'The DevOps Engineer',
    description: 'Waits for every CI check to pass, then merges the approved pull request.',
    state: 'merged',
    log: 'all checks passed, merged pull request #312',
  },
  {
    agent: 'LORE',
    role: 'The Documenter',
    description: 'Updates the changelog and docs with the pull request and ticket references, so the change is explained where people look for it.',
    state: 'documented',
    log: `CHANGELOG.md updated for ${TICKET.id}`,
  },
];

const RING = { size: 400, radius: 150 };
const center = RING.size / 2;
const circumference = 2 * Math.PI * RING.radius;
const nodes = STEPS.map((step, index) => {
  const angle = (index / STEPS.length) * 2 * Math.PI - Math.PI / 2;
  const x = center + RING.radius * Math.cos(angle);
  const y = center + RING.radius * Math.sin(angle);
  const labelX = 50 + ((x - center) / RING.size) * 100 * 1.24;
  const labelY = 50 + ((y - center) / RING.size) * 100 * 1.24;
  return { ...step, x, y, labelX, labelY };
});

const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="agent-flow" id="agent-flow" aria-labelledby="agent-flow-title" data-agent-flow>
  <div class="agent-flow-stage">
    <div class="agent-flow-inner">
      <div class="agent-flow-copy">
        <p class="agent-flow-label">The flow</p>
        <h2 id="agent-flow-title">From issue to merged pull request, one agent at a time</h2>
        <p class="agent-flow-intro">
          Every ticket moves through the same five agents. Each one hands over only when its gate passes,
          and every step is recorded.
        </p>

        <ol class="agent-flow-steps">
          {STEPS.map((step, index) => (
            <li class="agent-flow-step" data-step={index}>
              <p class="agent-flow-count">{pad(index + 1)} / {pad(STEPS.length)}<span>{step.role}</span></p>
              <h3>{step.agent}</h3>
              <p class="agent-flow-description">{step.description}</p>
              <p class="agent-flow-log"><span>{step.agent.toLowerCase()}</span>{step.log}</p>
            </li>
          ))}
        </ol>

        <div class="agent-flow-progress" aria-hidden="true">
          {STEPS.map((step, index) => (
            <button type="button" tabindex="-1" data-jump={index} aria-label={`Show ${step.agent}`}>
              <span></span>
            </button>
          ))}
        </div>
      </div>

      <div class="agent-flow-ring" aria-hidden="true">
        <svg viewBox={`0 0 ${RING.size} ${RING.size}`}>
          <circle class="ring-track" cx={center} cy={center} r={RING.radius} />
          <circle
            class="ring-arc"
            cx={center}
            cy={center}
            r={RING.radius}
            stroke-dasharray={circumference}
            stroke-dashoffset={circumference}
            transform={`rotate(-90 ${center} ${center})`}
            data-ring-arc
            data-circumference={circumference}
          />
          {nodes.map((node, index) => (
            <circle class="ring-node" cx={node.x} cy={node.y} r="9" data-ring-node={index} />
          ))}
        </svg>

        {nodes.map((node, index) => (
          <span
            class="ring-label"
            data-ring-label={index}
            style={`left: ${node.labelX}%; top: ${node.labelY}%`}
          >
            {node.agent}
          </span>
        ))}

        <div class="ring-center">
          <span class="ring-center-label">Step</span>
          <span class="ring-center-number" data-ring-number>01</span>
          <span class="ring-center-state" data-ring-state>{TICKET.id} {STEPS[0].state}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-agent-flow]');
  const pinnedQuery = window.matchMedia('(min-width: 960px) and (prefers-reduced-motion: no-preference)');

  if (root) {
    const steps = [...root.querySelectorAll<HTMLElement>('.agent-flow-step')];
    const nodes = [...root.querySelectorAll<SVGCircleElement>('[data-ring-node]')];
    const labels = [...root.querySelectorAll<HTMLElement>('[data-ring-label]')];
    const jumps = [...root.querySelectorAll<HTMLButtonElement>('[data-jump]')];
    const arc = root.querySelector<SVGCircleElement>('[data-ring-arc]');
    const number = root.querySelector<HTMLElement>('[data-ring-number]');
    const state = root.querySelector<HTMLElement>('[data-ring-state]');
    const states = ['assigned', 'building', 'in review', 'merged', 'documented'];
    const circumference = Number(arc?.dataset.circumference ?? 0);
    const count = steps.length;
    let current = -1;
    let frame = 0;

    const setStep = (active: number) => {
      if (active === current) return;
      current = active;
      steps.forEach((el, i) => el.classList.toggle('is-active', i === active));
      nodes.forEach((el, i) => {
        el.classList.toggle('is-active', i === active);
        el.classList.toggle('is-done', i < active);
      });
      labels.forEach((el, i) => el.classList.toggle('is-active', i === active));
      jumps.forEach((el, i) => el.classList.toggle('is-filled', i <= active));
      if (number) number.textContent = String(active + 1).padStart(2, '0');
      if (state) state.textContent = `T-042 ${states[active]}`;
    };

    const progress = () => {
      const scrollable = root.offsetHeight - window.innerHeight;
      return scrollable > 0 ? Math.min(1, Math.max(0, -root.getBoundingClientRect().top / scrollable)) : 0;
    };

    const update = () => {
      frame = 0;
      const p = progress();
      setStep(Math.min(count - 1, Math.floor(p * count)));
      if (arc) arc.style.strokeDashoffset = String(circumference * (1 - Math.max(p, 0.012)));
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    const jumpTo = (index: number) => {
      const scrollable = root.offsetHeight - window.innerHeight;
      const target = root.offsetTop + scrollable * ((index + 0.5) / count);
      if (window.lenis) window.lenis.scrollTo(target);
      else window.scrollTo({ top: target, behavior: 'smooth' });
    };

    jumps.forEach((button, index) => button.addEventListener('click', () => jumpTo(index)));

    const applyMode = () => {
      const pinned = pinnedQuery.matches;
      root.dataset.mode = pinned ? 'pinned' : 'static';
      window.removeEventListener('scroll', onScroll);
      if (pinned) {
        window.addEventListener('scroll', onScroll, { passive: true });
        current = -1;
        update();
      }
    };

    pinnedQuery.addEventListener('change', applyMode);
    applyMode();
  }
</script>

<style>
  .agent-flow {
    --flow-accent: var(--color-aubergine);
    --flow-accent-soft: #8fb8b2;
    --flow-line: var(--color-driftwood);

    position: relative;
    background: var(--color-bone);
    color: var(--color-ink);
  }

  .agent-flow-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    max-width: var(--max-width-6xl);
    margin-inline: auto;
    padding: 6rem var(--space-6);
  }

  .agent-flow-label {
    margin: 0 0 1rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .agent-flow-copy h2 {
    margin: 0 0 1.5rem;
    max-width: 16ch;
    font-size: clamp(2.25rem, 3.6vw, 3.25rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .agent-flow-intro {
    margin: 0 0 2.5rem;
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-ink);
  }

  .agent-flow-steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .agent-flow-step {
    padding-block: 2rem;
    border-top: 1px solid var(--flow-line);
  }

  .agent-flow-count {
    display: flex;
    gap: 1rem;
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-graphite);
    font-variant-numeric: tabular-nums;
  }

  .agent-flow-step h3 {
    margin: 0 0 1rem;
    font-size: clamp(3rem, 5.5vw, 4.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .agent-flow-description {
    margin: 0 0 1rem;
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-ink);
  }

  .agent-flow-log {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-graphite);
  }

  .agent-flow-log span {
    color: var(--flow-accent);
  }

  .agent-flow-progress,
  .agent-flow-ring {
    display: none;
  }

  /* Pinned mode: the stage stays in view while scrolling moves through the steps. */
  .agent-flow[data-mode='pinned'] {
    height: 460vh;
  }

  .agent-flow[data-mode='pinned'] .agent-flow-stage {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    height: 100vh;
    overflow: hidden;
  }

  .agent-flow[data-mode='pinned'] .agent-flow-inner {
    width: 100%;
  }

  .agent-flow[data-mode='pinned'] .agent-flow-steps {
    display: grid;
    border-top: 1px solid var(--flow-line);
  }

  .agent-flow[data-mode='pinned'] .agent-flow-step {
    grid-area: 1 / 1;
    border: 0;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
    pointer-events: none;
  }

  .agent-flow[data-mode='pinned'] .agent-flow-step.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .agent-flow[data-mode='pinned'] .agent-flow-progress {
    display: flex;
    gap: 0.375rem;
  }

  .agent-flow-progress button {
    flex: 1;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .agent-flow-progress span {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: var(--color-fog);
    transition: background-color 0.35s ease;
  }

  .agent-flow-progress button.is-filled span {
    background: var(--flow-accent);
  }

  .agent-flow[data-mode='pinned'] .agent-flow-ring {
    position: relative;
    display: block;
    width: min(100%, 30rem);
    aspect-ratio: 1;
    justify-self: center;
  }

  .agent-flow-ring svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ring-track {
    fill: none;
    stroke: var(--color-fog);
    stroke-width: 1.5;
  }

  .ring-arc {
    fill: none;
    stroke: var(--flow-accent);
    stroke-width: 2;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.12s linear;
  }

  .ring-node {
    fill: var(--color-bone);
    stroke: var(--color-driftwood);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    transition: fill 0.35s ease, stroke 0.35s ease, transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .ring-node.is-done {
    fill: var(--flow-accent-soft);
    stroke: var(--flow-accent);
  }

  .ring-node.is-active {
    fill: var(--flow-accent);
    stroke: var(--flow-accent);
    transform: scale(1.45);
  }

  .ring-label {
    position: absolute;
    transform: translate(-50%, -50%);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-graphite);
    white-space: nowrap;
    transition: color 0.35s ease;
  }

  .ring-label.is-active {
    color: var(--color-ink);
    font-weight: 600;
  }

  .ring-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    pointer-events: none;
  }

  .ring-center-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-graphite);
  }

  .ring-center-number {
    font-size: clamp(3rem, 5vw, 4rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .ring-center-state {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-graphite);
  }

  @media (max-width: 959px) {
    .agent-flow-inner {
      grid-template-columns: 1fr;
      padding: 4rem var(--space-4);
    }

    .agent-flow-step h3 {
      font-size: 2.75rem;
    }
  }
</style>
