---
const TICKET = { id: 'T-042', title: 'Add rate limiting to the public API', issue: '#128' };

const STEPS = [
  {
    agent: 'NEXUS',
    role: 'The Controller',
    action: 'Picks up the issue',
    description: `Turns GitHub issue ${TICKET.issue} into ticket ${TICKET.id}, checks the repository is CI-ready, and assigns an idle FORGE worker in its own Coder workspace.`,
    state: 'Assigned',
    log: `nexus     ${TICKET.id} created from issue ${TICKET.issue}, assigned to forge-2`,
    color: 'var(--color-agent-nexus)',
  },
  {
    agent: 'FORGE',
    role: 'The Builder',
    action: 'Plans, then builds',
    description: 'Writes a plan and stops until it is approved, then implements in small commits on its own branch and runs the test suite.',
    state: 'Building',
    log: `forge-2   plan_ready, building on forge-2/${TICKET.id}`,
    color: 'var(--color-agent-forge)',
  },
  {
    agent: 'SENTINEL',
    role: 'The Reviewer',
    action: 'Reviews the plan and the code',
    description: 'Approves the plan before any code is written, then reviews the pull request against your standards. Anything risky is escalated to a human.',
    state: 'In review',
    log: 'sentinel  pull request approved, 0 security flags',
    color: 'var(--color-agent-sentinel)',
  },
  {
    agent: 'VESSEL',
    role: 'The DevOps Engineer',
    action: 'Ships it',
    description: 'Waits for every CI check to pass, then merges the approved pull request.',
    state: 'Merged',
    log: 'vessel    all checks passed, merged pull request #312',
    color: 'var(--color-agent-vessel)',
  },
  {
    agent: 'LORE',
    role: 'The Documenter',
    action: 'Writes it down',
    description: 'Updates the changelog and docs with the pull request and ticket references, so the change is explained where people look for it.',
    state: 'Documented',
    log: `lore      CHANGELOG.md updated for ${TICKET.id}`,
    color: 'var(--color-agent-lore)',
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="agent-flow" id="agent-flow" aria-labelledby="agent-flow-title" data-agent-flow>
  <div class="agent-flow-stage">
    <div class="agent-flow-inner">
      <div class="agent-flow-copy">
        <h2 id="agent-flow-title">From issue to merged pull request, one agent at a time.</h2>

        <ol class="agent-flow-steps">
          {STEPS.map((step, index) => (
            <li class="agent-flow-step" data-step={index} style={`--agent: ${step.color}`}>
              <p class="agent-flow-count">{pad(index + 1)} / {pad(STEPS.length)}</p>
              <h3>
                <span class="agent-flow-agent">{step.agent}</span>
                <span class="agent-flow-action">{step.action}</span>
              </h3>
              <p class="agent-flow-description">{step.description}</p>
            </li>
          ))}
        </ol>

        <div class="agent-flow-progress" aria-hidden="true">
          {STEPS.map((step, index) => (
            <button type="button" tabindex="-1" data-jump={index} aria-label={`Show ${step.agent}`}>
              <span></span>
            </button>
          ))}
        </div>
      </div>

      <div class="agent-flow-console" aria-hidden="true">
        <div class="console-header">
          <span class="console-ticket">{TICKET.id}</span>
          <span class="console-title">{TICKET.title}</span>
          <span class="console-state" data-console-state>{STEPS[0].state}</span>
        </div>

        <div class="console-rail">
          <div class="console-rail-track"><div class="console-rail-fill" data-rail-fill></div></div>
          {STEPS.map((step, index) => (
            <div class="console-agent" data-console-agent={index} style={`--agent: ${step.color}`}>
              <span class="console-dot">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m3.5 8.5 3 3 6-7" />
                </svg>
              </span>
              <span class="console-agent-name">{step.agent}</span>
              <span class="console-agent-role">{step.role}</span>
            </div>
          ))}
        </div>

        <div class="console-log">
          {STEPS.map((step, index) => (
            <p class="console-log-line" data-console-log={index}>{step.log}</p>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-agent-flow]');
  const pinnedQuery = window.matchMedia('(min-width: 960px) and (prefers-reduced-motion: no-preference)');

  if (root) {
    const steps = [...root.querySelectorAll<HTMLElement>('.agent-flow-step')];
    const agents = [...root.querySelectorAll<HTMLElement>('[data-console-agent]')];
    const logs = [...root.querySelectorAll<HTMLElement>('[data-console-log]')];
    const jumps = [...root.querySelectorAll<HTMLButtonElement>('[data-jump]')];
    const fill = root.querySelector<HTMLElement>('[data-rail-fill]');
    const stateLabel = root.querySelector<HTMLElement>('[data-console-state]');
    const states = ['Assigned', 'Building', 'In review', 'Merged', 'Documented'];
    const count = steps.length;
    let current = -1;
    let frame = 0;

    const setStep = (active: number) => {
      if (active === current) return;
      current = active;
      steps.forEach((el, i) => el.classList.toggle('is-active', i === active));
      agents.forEach((el, i) => {
        el.classList.toggle('is-active', i === active);
        el.classList.toggle('is-done', i < active);
      });
      logs.forEach((el, i) => el.classList.toggle('is-visible', i <= active));
      jumps.forEach((el, i) => el.classList.toggle('is-filled', i <= active));
      if (stateLabel) stateLabel.textContent = states[active];
    };

    const progress = () => {
      const rect = root.getBoundingClientRect();
      const scrollable = root.offsetHeight - window.innerHeight;
      return scrollable > 0 ? Math.min(1, Math.max(0, -rect.top / scrollable)) : 0;
    };

    const update = () => {
      frame = 0;
      const p = progress();
      setStep(Math.min(count - 1, Math.floor(p * count)));
      if (fill) fill.style.transform = `scaleY(${p})`;
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    const jumpTo = (index: number) => {
      const scrollable = root.offsetHeight - window.innerHeight;
      const target = root.offsetTop + scrollable * ((index + 0.5) / count);
      if (window.lenis) window.lenis.scrollTo(target);
      else window.scrollTo({ top: target, behavior: 'smooth' });
    };

    jumps.forEach((button, index) => button.addEventListener('click', () => jumpTo(index)));

    const applyMode = () => {
      const pinned = pinnedQuery.matches;
      root.dataset.mode = pinned ? 'pinned' : 'static';
      window.removeEventListener('scroll', onScroll);
      if (pinned) {
        window.addEventListener('scroll', onScroll, { passive: true });
        current = -1;
        update();
      }
    };

    pinnedQuery.addEventListener('change', applyMode);
    applyMode();
  }
</script>

<style>
  .agent-flow {
    --flow-bg: #1d1c1b;
    --flow-surface: #262523;
    --flow-line: rgba(242, 240, 235, 0.12);
    --flow-text: #f2f0eb;
    --flow-muted: rgba(242, 240, 235, 0.62);

    position: relative;
    background: var(--flow-bg);
    color: var(--flow-text);
  }

  .agent-flow-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 6rem var(--space-6);
  }

  .agent-flow-copy h2 {
    margin: 0 0 2.5rem;
    max-width: 20ch;
    font-size: clamp(2rem, 3.4vw, 3rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--flow-text);
    text-wrap: balance;
  }

  .agent-flow-steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .agent-flow-step {
    padding-block: 1.5rem;
    border-top: 1px solid var(--flow-line);
  }

  .agent-flow-count {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--flow-muted);
    font-variant-numeric: tabular-nums;
  }

  .agent-flow-step h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin: 0 0 0.75rem;
    font-weight: 600;
    color: var(--flow-text);
  }

  .agent-flow-agent {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--agent);
  }

  .agent-flow-action {
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }

  .agent-flow-description {
    margin: 0;
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--flow-muted);
  }

  .agent-flow-progress {
    display: none;
  }

  .agent-flow-console {
    overflow: hidden;
    border: 1px solid var(--flow-line);
    border-radius: var(--radius-xl);
    background: var(--flow-surface);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.6);
  }

  .console-header {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--flow-line);
    font-size: 0.9375rem;
  }

  .console-ticket {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--flow-muted);
  }

  .console-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .console-state {
    flex-shrink: 0;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: rgba(242, 240, 235, 0.08);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .console-rail {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.25rem;
  }

  .console-rail-track {
    position: absolute;
    top: 2.25rem;
    bottom: 2.25rem;
    left: calc(1.25rem + 1.375rem);
    width: 2px;
    background: var(--flow-line);
  }

  .console-rail-fill {
    width: 100%;
    height: 100%;
    background: var(--flow-text);
    opacity: 0.7;
    transform: scaleY(0);
    transform-origin: top;
  }

  .console-agent {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem auto 1fr;
    align-items: center;
    gap: 0.875rem;
    padding: 0.625rem 0;
    border-radius: var(--radius-lg);
    transition: background-color 0.35s ease;
  }

  .console-dot {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    justify-self: center;
    border: 2px solid var(--flow-line);
    border-radius: 50%;
    background: var(--flow-surface);
    color: transparent;
    transition: border-color 0.35s ease, background-color 0.35s ease, color 0.35s ease, transform 0.35s ease;
  }

  .console-dot svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .console-agent-name {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--flow-muted);
    transition: color 0.35s ease;
  }

  .console-agent-role {
    font-size: 0.875rem;
    color: var(--flow-muted);
  }

  .console-log {
    min-height: 9.5rem;
    padding: 1rem 1.25rem 1.25rem;
    border-top: 1px solid var(--flow-line);
    background: rgba(0, 0, 0, 0.18);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.75;
    white-space: pre;
    overflow-x: auto;
  }

  .console-log-line {
    margin: 0;
    color: var(--flow-muted);
  }

  /* Pinned mode: the section scrolls through the steps while the stage stays in view. */
  .agent-flow[data-mode='pinned'] {
    height: 460vh;
  }

  .agent-flow[data-mode='pinned'] .agent-flow-stage {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    height: 100vh;
    overflow: hidden;
  }

  .agent-flow[data-mode='pinned'] .agent-flow-inner {
    width: 100%;
  }

  .agent-flow[data-mode='pinned'] .agent-flow-steps {
    display: grid;
  }

  .agent-flow[data-mode='pinned'] .agent-flow-step {
    grid-area: 1 / 1;
    padding: 0;
    border: 0;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
    pointer-events: none;
  }

  .agent-flow[data-mode='pinned'] .agent-flow-step.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .agent-flow[data-mode='pinned'] .agent-flow-progress {
    display: flex;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }

  .agent-flow-progress button {
    flex: 1;
    max-width: 4rem;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .agent-flow-progress span {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: var(--flow-line);
    transition: background-color 0.35s ease;
  }

  .agent-flow-progress button.is-filled span {
    background: var(--flow-text);
  }

  .agent-flow[data-mode='pinned'] .console-log-line {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .agent-flow[data-mode='pinned'] .console-log-line.is-visible {
    opacity: 1;
    transform: none;
  }

  .console-agent.is-active {
    background: rgba(242, 240, 235, 0.05);
  }

  .console-agent.is-active .console-dot {
    border-color: var(--agent);
    background: var(--agent);
    transform: scale(1.1);
  }

  .console-agent.is-done .console-dot {
    border-color: var(--flow-text);
    background: var(--flow-text);
    color: var(--flow-bg);
  }

  .console-agent.is-active .console-agent-name,
  .console-agent.is-done .console-agent-name {
    color: var(--flow-text);
  }

  .agent-flow-console .console-log-line.is-visible:last-of-type,
  .agent-flow-console .console-log-line.is-visible:has(+ .console-log-line:not(.is-visible)) {
    color: var(--flow-text);
  }

  /* Static mode (small screens, reduced motion, no JavaScript): show the steps as a list. */
  .agent-flow:not([data-mode='pinned']) .agent-flow-console {
    display: none;
  }

  @media (max-width: 959px) {
    .agent-flow-inner {
      grid-template-columns: 1fr;
      padding: 4rem var(--space-4);
    }
  }
</style>
