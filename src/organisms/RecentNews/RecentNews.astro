---
import { getCollection } from 'astro:content';
import RecentNews from '@/organisms/RecentNews/RecentNews.jsx';

const allBlogs = await getCollection('blogs');

// Filter to published, non-draft blogs and get last 3
const posts = allBlogs
  .filter(blog => !blog.data.is_draft && blog.data.status === 'published')
  .sort((a, b) => {
    const dateA = a.data.published_at ? new Date(a.data.published_at).getTime() : 0;
    const dateB = b.data.published_at ? new Date(b.data.published_at).getTime() : 0;
    return dateB - dateA;
  })
  .slice(0, 3)
  .map(post => ({
    id: post.id,
    category: 'Blog',
    date: post.data.published_at 
      ? new Date(post.data.published_at).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        })
      : '',
    title: post.data.title,
    excerpt: post.data.excerpt,
    href: `/blog/${(post.data.slug || post.slug).trim()}`,
    image: post.data.cover_image_url || '',
    featured: post.data.is_featured || false,
  }));
---

<RecentNews posts={posts} />