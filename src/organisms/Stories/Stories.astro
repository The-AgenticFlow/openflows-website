---
interface StoryModule {
  frontmatter: Record<string, string | undefined>;
  rawContent: () => string;
}

interface Story {
  id: string;
  category: string;
  date?: Date;
  title: string;
  summary: string;
  href: string;
  image: string;
}

const SUMMARY_MAX_LENGTH = 240;

const firstParagraph = (markdown: string): string => {
  const paragraph = markdown
    .split(/\n\s*\n/)
    .map((block) =>
      block
        .split('\n')
        .map((line) => line.replace(/^>\s?/, '').trim())
        .filter(Boolean)
        .join(' '),
    )
    .find((block) => block && !block.startsWith('#') && !block.startsWith('['));
  if (!paragraph) return '';
  return paragraph.length > SUMMARY_MAX_LENGTH
    ? `${paragraph.slice(0, SUMMARY_MAX_LENGTH).replace(/\s+\S*$/, '')}…`
    : paragraph;
};

const storyModules = import.meta.glob<StoryModule>('/src/content/stories/*.md', { eager: true });

const stories: Story[] = Object.entries(storyModules)
  .map(([path, mod]) => {
    const slug = path.split('/').pop()!.replace('.md', '');
    const { frontmatter } = mod;
    return {
      id: slug,
      category: frontmatter.category || '',
      date: frontmatter.date ? new Date(frontmatter.date) : undefined,
      title: frontmatter.title || '',
      summary: frontmatter.excerpt || firstParagraph(mod.rawContent()),
      href: frontmatter.href || `/stories/${slug}`,
      image: frontmatter.image || '',
    };
  })
  .sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0));

const formatDate = (date?: Date) =>
  date ? date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '';

const QUOTE_MAX_LENGTH = 140;

const toQuote = (summary: string): string => {
  if (summary.length <= QUOTE_MAX_LENGTH) return summary;
  const firstSentence = summary.match(/^.+?[.!?](?=\s|$)/)?.[0];
  return firstSentence && firstSentence.length <= QUOTE_MAX_LENGTH * 1.5 ? firstSentence : summary;
};

const STRIP_COUNT = 3;
const [feature, ...others] = stories;
const strip = others.slice(0, STRIP_COUNT);
const hasMore = others.length > STRIP_COUNT;
const featureQuote = feature?.summary ? toQuote(feature.summary) : '';
---

{feature && (
  <section class="stories" aria-labelledby="stories-title">
    <div class="stories-container">
      <div class="stories-header">
        <div>
          <h2 id="stories-title">Stories</h2>
          <p>How teams put OpenFlows to work, and what they learned along the way.</p>
        </div>
        {hasMore && <a href="/resources#stories" class="stories-all">All stories</a>}
      </div>

      <article class="story-feature">
        <div class="story-feature-image">
          {feature.image ? (
            <img src={feature.image} alt="" loading="lazy" decoding="async" />
          ) : (
            <div class="story-feature-fallback" aria-hidden="true">
              <img src="/openlogo-transparent.png" alt="" width="48" height="48" />
            </div>
          )}
        </div>
        <div class="story-feature-body">
          {feature.category && <p class="story-category">{feature.category}</p>}
          {featureQuote && (
            <blockquote class="story-feature-quote">
              <p>“{featureQuote}”</p>
            </blockquote>
          )}
          <h3 class="story-feature-title">
            <a href={feature.href}>{feature.title}</a>
          </h3>
          <p class="story-feature-footer">
            <span class="story-cta">Read the story</span>
            {feature.date && <time datetime={feature.date.toISOString()}>{formatDate(feature.date)}</time>}
          </p>
        </div>
      </article>

      {strip.length > 0 && (
        <ul class="story-strip" role="list">
          {strip.map((story) => (
            <li class="story-strip-item">
              {story.category && <p class="story-category">{story.category}</p>}
              <h3 class="story-strip-title">
                <a href={story.href}>{story.title}</a>
              </h3>
              {story.summary && <p class="story-strip-summary">{story.summary}</p>}
              {story.date && <time datetime={story.date.toISOString()}>{formatDate(story.date)}</time>}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
)}

<style>
  .stories {
    --stories-text: var(--color-parchment-canvas);
    --stories-text-secondary: #c4beb6;
    --stories-text-muted: #a8a29a;
    --stories-accent: #8fcabd;
    --stories-rule: rgba(242, 240, 235, 0.16);

    padding: clamp(4rem, 8vw, 6.5rem) 0;
    background: var(--color-ink);
    color: var(--stories-text);
  }

  .stories-container {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .stories-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .stories-header h2 {
    margin: 0 0 0.5rem;
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--stories-text);
  }

  .stories-header p {
    margin: 0;
    max-width: 36rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--stories-text-secondary);
  }

  .stories-all {
    flex-shrink: 0;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--stories-accent);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--transition-fast);
  }

  .stories-all:hover {
    color: var(--stories-accent);
    text-decoration-color: currentColor;
  }

  .stories-all:focus-visible {
    outline: 2px solid var(--stories-accent);
    outline-offset: 3px;
  }

  .story-category {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--stories-accent);
  }

  .story-feature {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .story-feature-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: rgba(242, 240, 235, 0.06);
    outline: 1px solid var(--stories-rule);
    outline-offset: -1px;
  }

  .story-feature-image > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-feature-fallback {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: var(--color-aubergine);
  }

  .story-feature-fallback img {
    width: 48px;
    height: auto;
    filter: brightness(0) invert(1);
  }

  .story-feature-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .story-feature-quote {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .story-feature-quote p {
    margin: 0;
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--stories-text);
    text-wrap: balance;
    hanging-punctuation: first;
  }

  .story-feature-title,
  .story-strip-title {
    margin: 0;
    font-weight: 600;
    text-wrap: balance;
  }

  .story-feature-title {
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  .story-strip-title {
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .story-feature-title a {
    color: var(--stories-text-secondary);
    text-decoration: none;
  }

  .story-strip-title a {
    color: var(--stories-text);
    text-decoration: none;
  }

  .story-feature-title a::after,
  .story-strip-title a::after {
    content: '';
    position: absolute;
    inset: -0.5rem;
    border-radius: var(--radius-xl);
  }

  .story-feature-title a:hover,
  .story-strip-title a:hover {
    color: var(--stories-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .story-feature-title a:focus-visible,
  .story-strip-title a:focus-visible {
    outline: none;
  }

  .story-feature-title a:focus-visible::after,
  .story-strip-title a:focus-visible::after {
    outline: 2px solid var(--stories-accent);
  }

  .story-feature-footer {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--stories-text-muted);
  }

  .story-cta {
    font-weight: 600;
    color: var(--stories-accent);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--transition-fast);
  }

  .story-feature:hover .story-cta {
    text-decoration-color: currentColor;
  }

  .story-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .story-strip-item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--stories-rule);
  }

  .story-strip-summary {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--stories-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .story-strip-item time {
    margin-top: auto;
    padding-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--stories-text-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 860px) {
    .story-feature {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .story-strip {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .story-strip-item {
      padding-block: 1.25rem;
    }
  }

  @media (max-width: 640px) {
    .stories-container {
      padding-inline: var(--space-4);
    }

    .stories-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
