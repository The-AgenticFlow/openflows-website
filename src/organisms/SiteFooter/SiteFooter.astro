---
const GITHUB = 'https://github.com/The-AgenticFlow/OpenFlows';
const DISCORD = 'https://discord.gg/gDhK2RQZpY';

const COLUMNS = [
  {
    heading: 'Product',
    links: [
      { label: 'Agents', href: '/agents' },
      { label: 'How it works', href: '/#agent-flow' },
      { label: 'Enterprise', href: '/enterprise' },
      { label: 'Demos', href: '/demos' },
    ],
  },
  {
    heading: 'Docs',
    links: [
      { label: 'Get started', href: '/docs/getting-started' },
      { label: 'Installation', href: '/docs/getting-started/installation' },
      { label: 'Architecture', href: '/docs/architecture' },
      { label: 'FAQ', href: '/docs/resources/faq' },
    ],
  },
  {
    heading: 'Resources',
    links: [
      { label: 'Blog', href: '/blog' },
      { label: 'Research', href: '/research' },
      { label: 'Case studies', href: '/resources#stories' },
      { label: 'Developer hub', href: '/developer' },
    ],
  },
  {
    heading: 'Community',
    links: [
      { label: 'About', href: '/about' },
      { label: 'GitHub', href: GITHUB, external: true },
      { label: 'Discussions', href: `${GITHUB}/discussions`, external: true },
      { label: 'Releases', href: `${GITHUB}/releases`, external: true },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-grid">
      <div class="site-footer-brand">
        <p class="site-footer-tagline">Own the architecture.<br />Let the agents ship it.</p>
        <p class="site-footer-about">
          OpenFlows orchestrates a governed team of AI agents on top of your Coder environment, from GitHub issue to
          merged pull request.
        </p>
        <div class="site-footer-social">
          <a href={GITHUB} target="_blank" rel="noopener noreferrer" aria-label="OpenFlows on GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.38 7.86 10.9.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z" />
            </svg>
          </a>
          <a href={DISCORD} target="_blank" rel="noopener noreferrer" aria-label="OpenFlows on Discord">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.32 4.37A19.8 19.8 0 0 0 15.43 2.85a.07.07 0 0 0-.08.04c-.21.38-.44.87-.61 1.25a18.3 18.3 0 0 0-5.49 0 12.6 12.6 0 0 0-.62-1.25.08.08 0 0 0-.08-.04 19.7 19.7 0 0 0-4.89 1.52.07.07 0 0 0-.03.03C.53 9.05-.32 13.58.1 18.06a.08.08 0 0 0 .03.05 19.9 19.9 0 0 0 6 3.03.08.08 0 0 0 .08-.03c.46-.63.87-1.3 1.23-1.99a.08.08 0 0 0-.04-.11 13.1 13.1 0 0 1-1.87-.89.08.08 0 0 1-.01-.13l.37-.29a.07.07 0 0 1 .08-.01c3.93 1.79 8.18 1.79 12.06 0a.07.07 0 0 1 .08.01l.37.29a.08.08 0 0 1-.01.13c-.6.35-1.22.65-1.87.89a.08.08 0 0 0-.04.11c.36.7.77 1.36 1.22 1.99a.08.08 0 0 0 .09.03 19.8 19.8 0 0 0 6-3.03.08.08 0 0 0 .03-.05c.5-5.18-.84-9.67-3.55-13.66a.06.06 0 0 0-.03-.03ZM8.02 15.33c-1.18 0-2.16-1.09-2.16-2.42s.96-2.42 2.16-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.96 2.42-2.16 2.42Zm7.97 0c-1.18 0-2.15-1.09-2.15-2.42s.95-2.42 2.15-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.95 2.42-2.16 2.42Z" />
            </svg>
          </a>
        </div>
      </div>

      {COLUMNS.map((column) => (
        <nav class="site-footer-column" aria-label={column.heading}>
          <h2>{column.heading}</h2>
          <ul>
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="site-footer-bottom">
      <p>© {year} OpenFlows. Released under the MIT License.</p>
      <a href="#top" class="site-footer-top" data-back-to-top>Back to top</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 5rem 0 3.5rem;
    border-top: 1px solid var(--color-driftwood);
  }

  .site-footer-inner {
    max-width: var(--max-width-6xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .site-footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(4, minmax(0, 1fr));
    gap: 2.5rem 2rem;
  }

  .site-footer-tagline {
    margin: 0 0 1rem;
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .site-footer-about {
    margin: 0 0 1.5rem;
    max-width: 19rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-graphite);
  }

  .site-footer-social {
    display: flex;
    gap: 0.625rem;
  }

  .site-footer-social a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-driftwood);
    border-radius: 50%;
    color: var(--color-ink);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .site-footer-social a:hover {
    border-color: var(--color-border-hover);
    background-color: var(--color-bone);
  }

  .site-footer-social svg {
    width: 1.0625rem;
    height: 1.0625rem;
  }

  .site-footer-column h2 {
    margin: 0 0 1.125rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .site-footer-column ul {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer-column a,
  .site-footer-top {
    font-size: 0.9375rem;
    color: var(--color-graphite);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
  }

  .site-footer-column a:hover,
  .site-footer-top:hover {
    color: var(--color-ink);
    text-decoration-color: currentColor;
  }

  .site-footer a:focus-visible {
    outline: 2px solid var(--color-aubergine);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .site-footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-driftwood);
  }

  .site-footer-bottom p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-graphite);
  }

  @media (max-width: 960px) {
    .site-footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      padding: 3.5rem 0 2.5rem;
    }

    .site-footer-inner {
      padding-inline: var(--space-4);
    }
  }
</style>
