---
import PixelField from '@/components/site/PixelField.astro';

const REPO = 'https://github.com/The-AgenticFlow/OpenFlows';

const COLUMNS = [
  {
    heading: 'Product',
    links: [
      { label: 'Agent team', href: '/agents' },
      { label: 'How it works', href: '/#how-it-works' },
      { label: 'Enterprise', href: '/enterprise' },
      { label: 'Demos', href: '/demos' },
      { label: 'Security model', href: '/docs/architecture/security-by-design' },
    ],
  },
  {
    heading: 'Docs',
    links: [
      { label: 'Quick start', href: '/docs/getting-started' },
      { label: 'Installation', href: '/docs/getting-started/installation' },
      { label: 'Core concepts', href: '/docs/concepts' },
      { label: 'Architecture', href: '/docs/architecture' },
      { label: 'Reference', href: '/docs/reference' },
    ],
  },
  {
    heading: 'Resources',
    links: [
      { label: 'Blog', href: '/blog' },
      { label: 'Research', href: '/research' },
      { label: 'Case studies', href: '/resources#stories' },
      { label: 'Developers', href: '/developers' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'Community',
    links: [
      { label: 'GitHub', href: REPO, external: true },
      { label: 'Discord', href: 'https://discord.gg/gDhK2RQZpY', external: true },
      { label: 'Discussions', href: `${REPO}/discussions`, external: true },
      { label: 'Releases', href: `${REPO}/releases`, external: true },
      { label: 'Contribute', href: '/docs/contributing' },
      { label: 'Contact', href: '/resources#contact' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="footer of-dark">
  <PixelField cell={32} density={0.035} />
  <div class="of-container of-container-wide">
    <div class="top">
      <div class="brand-col">
        <a href="/" class="brand" aria-label="OpenFlows home">
          <img src="/openlogo-light.png" alt="" width="34" height="34" loading="lazy" />
          <span>OpenFlows</span>
        </a>
        <p class="tagline">The autonomous AI dev team that turns GitHub issues into reviewed, merged pull requests, inside your own Coder environment.</p>
        <div class="status">
          <span class="of-dot is-live"></span>
          <span>Open source · MIT licensed · Self-hosted</span>
        </div>
        <div class="socials">
          <a href={REPO} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.79-.26.79-.58v-2.23c-3.34.73-4.03-1.42-4.03-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.19.69.8.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
          <a href="https://discord.gg/gDhK2RQZpY" target="_blank" rel="noopener noreferrer" aria-label="Discord">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.32 4.37a19.8 19.8 0 0 0-4.89-1.52.07.07 0 0 0-.08.04c-.21.38-.44.86-.61 1.25a18.3 18.3 0 0 0-5.49 0 12.6 12.6 0 0 0-.62-1.25.08.08 0 0 0-.08-.04 19.7 19.7 0 0 0-4.88 1.52.07.07 0 0 0-.03.03C.53 9.05-.32 13.58.1 18.06a.08.08 0 0 0 .03.05 19.9 19.9 0 0 0 6 3.03.08.08 0 0 0 .08-.03c.46-.63.87-1.3 1.23-1.99a.08.08 0 0 0-.04-.11 13.1 13.1 0 0 1-1.87-.89.08.08 0 0 1-.01-.13l.37-.29a.07.07 0 0 1 .08-.01c3.93 1.79 8.18 1.79 12.06 0a.07.07 0 0 1 .08.01l.37.29a.08.08 0 0 1 0 .13c-.6.35-1.22.64-1.88.89a.08.08 0 0 0-.04.11c.36.7.77 1.36 1.23 1.99a.08.08 0 0 0 .08.03 19.8 19.8 0 0 0 6-3.03.08.08 0 0 0 .03-.05c.5-5.18-.84-9.67-3.55-13.66a.06.06 0 0 0-.03-.03zM8.02 15.33c-1.18 0-2.16-1.09-2.16-2.42s.96-2.42 2.16-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.96 2.42-2.16 2.42zm7.97 0c-1.18 0-2.15-1.09-2.15-2.42s.95-2.42 2.15-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.95 2.42-2.16 2.42z"/></svg>
          </a>
        </div>
      </div>

      {COLUMNS.map((col) => (
        <div class="col">
          <h3>{col.heading}</h3>
          <ul>
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                  {link.external && <span aria-hidden="true" class="ext">↗</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="bottom">
      <p>© {year} OpenFlows · Maintained by the AgenticFlow team</p>
      <p class="bottom-links">
        <a href={`${REPO}/blob/HEAD/LICENSE`} target="_blank" rel="noopener noreferrer">MIT License</a>
        <a href={`${REPO}/blob/HEAD/SECURITY.md`} target="_blank" rel="noopener noreferrer">Security</a>
        <a href="/sitemap-index.xml">Sitemap</a>
      </p>
    </div>
  </div>
  <div class="wordmark" aria-hidden="true">OpenFlows</div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    padding: 5rem 0 0;
    border-top: 1px solid var(--of-line);
    background: var(--of-bg);
    isolation: isolate;
  }

  .glow {
    position: absolute;
    left: 50%;
    bottom: -320px;
    width: 1200px;
    height: 560px;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(62, 224, 161, 0.1), rgba(155, 123, 255, 0.06) 50%, transparent);
    pointer-events: none;
  }

  .footer :global(.of-pixels) { z-index: -1; opacity: 0.35; mask-image: linear-gradient(180deg, transparent 30%, #000 85%); -webkit-mask-image: linear-gradient(180deg, transparent 30%, #000 85%); }

  .top {
    position: relative;
    display: grid;
    grid-template-columns: 1.6fr repeat(4, 1fr);
    gap: 2.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .tagline {
    margin-top: 1rem;
    max-width: 34ch;
    font-size: 0.9rem;
    color: var(--of-text-2);
    line-height: 1.6;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--of-text-3);
  }

  .socials { display: flex; gap: 0.5rem; margin-top: 1.25rem; }

  .socials a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    border: 1px solid var(--of-line-strong);
    color: var(--of-text-2);
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

  .socials a:hover { color: var(--of-text); background: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.22); }
  .socials svg { width: 16px; height: 16px; }

  .col h3 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--of-text-3);
    margin-bottom: 1rem;
  }

  .col ul { display: grid; gap: 0.65rem; }
  .col a { font-size: 0.9rem; color: var(--of-text-2); }
  .col a:hover { color: var(--of-text); }
  .ext { margin-left: 0.25rem; font-size: 0.75em; opacity: 0.6; }

  .bottom {
    position: relative;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 4rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--of-line);
    font-size: 0.82rem;
    color: var(--of-text-3);
  }

  .bottom-links { display: flex; gap: 1.25rem; }
  .bottom-links a:hover { color: var(--of-text); }

  .wordmark {
    position: relative;
    margin-top: -0.5rem;
    text-align: center;
    font-weight: 700;
    font-size: clamp(5rem, 19vw, 17rem);
    line-height: 0.78;
    letter-spacing: -0.06em;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    user-select: none;
    pointer-events: none;
  }

  @media (max-width: 960px) {
    .top { grid-template-columns: repeat(2, 1fr); }
    .brand-col { grid-column: 1 / -1; }
  }
</style>
