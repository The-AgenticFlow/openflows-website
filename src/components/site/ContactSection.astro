---
const REPO = 'https://github.com/The-AgenticFlow/OpenFlows';

// Set this to a monitored inbox to send the form by email instead of
// opening a prefilled GitHub Discussion.
const CONTACT_EMAIL: string | null = null;

const TOPICS = [
  { value: 'evaluation', label: 'Enterprise evaluation' },
  { value: 'partnership', label: 'Partnership or integration' },
  { value: 'support', label: 'Help running OpenFlows' },
  { value: 'press', label: 'Press or speaking' },
  { value: 'other', label: 'Something else' },
];

const CHANNELS = [
  {
    title: 'Discord',
    desc: 'Fastest answers from maintainers and other operators.',
    href: 'https://discord.gg/gDhK2RQZpY',
    cta: 'Join the server',
    icon: '<path d="M20.32 4.37a19.8 19.8 0 0 0-4.89-1.52.07.07 0 0 0-.08.04c-.21.38-.44.86-.61 1.25a18.3 18.3 0 0 0-5.49 0 12.6 12.6 0 0 0-.62-1.25.08.08 0 0 0-.08-.04 19.7 19.7 0 0 0-4.88 1.52.07.07 0 0 0-.03.03C.53 9.05-.32 13.58.1 18.06a.08.08 0 0 0 .03.05 19.9 19.9 0 0 0 6 3.03.08.08 0 0 0 .08-.03c.46-.63.87-1.3 1.23-1.99a.08.08 0 0 0-.04-.11 13.1 13.1 0 0 1-1.87-.89.08.08 0 0 1-.01-.13l.37-.29a.07.07 0 0 1 .08-.01c3.93 1.79 8.18 1.79 12.06 0a.07.07 0 0 1 .08.01l.37.29a.08.08 0 0 1 0 .13c-.6.35-1.22.64-1.88.89a.08.08 0 0 0-.04.11c.36.7.77 1.36 1.23 1.99a.08.08 0 0 0 .08.03 19.8 19.8 0 0 0 6-3.03.08.08 0 0 0 .03-.05c.5-5.18-.84-9.67-3.55-13.66a.06.06 0 0 0-.03-.03zM8.02 15.33c-1.18 0-2.16-1.09-2.16-2.42s.96-2.42 2.16-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.96 2.42-2.16 2.42zm7.97 0c-1.18 0-2.15-1.09-2.15-2.42s.95-2.42 2.15-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.95 2.42-2.16 2.42z"/>',
    fill: true,
  },
  {
    title: 'GitHub Discussions',
    desc: 'Questions, ideas and evaluation threads, in public.',
    href: `${REPO}/discussions`,
    cta: 'Open discussions',
    icon: '<path d="M4 5h11v8H8l-4 3z"/><path d="M15 9h5v8l-3-2h-6v-2"/>',
  },
  {
    title: 'Report a security issue',
    desc: 'Private vulnerability reports go straight to the maintainers.',
    href: `${REPO}/security/advisories/new`,
    cta: 'Report privately',
    icon: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M12 8v5M12 16h.01"/>',
  },
  {
    title: 'Bugs and feature requests',
    desc: 'Found something broken or missing? Open an issue.',
    href: `${REPO}/issues/new`,
    cta: 'Open an issue',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/>',
  },
];
---

  <section class="of-section contact-section" id="contact">
    <div class="of-container">
      <div class="of-head" data-reveal>
        <span class="of-eyebrow">Contact</span>
        <h2 class="of-h2">Talk to the people building OpenFlows.</h2>
        <p>Planning an evaluation, exploring a partnership, or stuck on a deployment? Tell us what you are working on and the maintainers will get back to you.</p>
      </div>
      <div class="contact">
        <form class="form of-card" id="contact-form" data-reveal data-email={CONTACT_EMAIL ?? ''} data-repo={REPO} novalidate>
          <div class="form-head">
            <h2>Send a message</h2>
            <p>{CONTACT_EMAIL ? 'Your email app opens with the message ready to send.' : 'This opens a prefilled GitHub Discussion, so the whole team sees it and replies in one place.'}</p>
          </div>

          <fieldset class="topics">
            <legend>What is it about?</legend>
            <div class="topic-list">
              {TOPICS.map((t, i) => (
                <label class="topic">
                  <input type="radio" name="topic" value={t.label} checked={i === 0} />
                  <span>{t.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          {CONTACT_EMAIL && (
            <div class="row">
              <label class="field"><span>Name</span><input name="name" autocomplete="name" /></label>
              <label class="field"><span>Company</span><input name="company" autocomplete="organization" /></label>
            </div>
          )}

          <label class="field">
            <span>Subject</span>
            <input name="subject" required maxlength="140" placeholder="e.g. Evaluating OpenFlows for 40 engineers on Coder" />
          </label>

          <label class="field">
            <span>Message</span>
            <textarea name="message" required rows="6" placeholder="Your team, your Coder setup, and what you want OpenFlows to do."></textarea>
          </label>

          <p class="form-error" id="form-error" role="alert" hidden>Add a subject and a short message first.</p>

          <div class="form-foot">
            <button type="submit" class="of-btn of-btn-primary of-btn-lg"><span class="of-sq"></span>{CONTACT_EMAIL ? 'Send message' : 'Continue on GitHub'}</button>
            {!CONTACT_EMAIL && <span class="form-note">Don’t include secrets or private details: discussions are public.</span>}
          </div>
        </form>

        <aside class="channels">
          <p class="channels-label">Other ways to reach us</p>
          {CHANNELS.map((c) => (
            <a href={c.href} target="_blank" rel="noopener noreferrer" class="channel" data-reveal>
              <span class="ch-icon"><svg viewBox="0 0 24 24" fill={c.fill ? 'currentColor' : 'none'} stroke={c.fill ? 'none' : 'currentColor'} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon} /></span>
              <span class="ch-text"><b>{c.title}</b><span>{c.desc}</span></span>
              <span class="ch-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
          <div class="evaluate" data-reveal>
            <p class="channels-label">Prefer to try it first?</p>
            <p>Run a contained pilot on one repository. The setup script handles the GitHub App, Coder, Redis and templates.</p>
            <a href="/docs/getting-started/installation" class="of-link">Read the setup guide →</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const error = document.getElementById('form-error');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const topic = String(data.get('topic') || 'General');
    const subject = String(data.get('subject') || '').trim();
    const message = String(data.get('message') || '').trim();
    if (!subject || !message) {
      if (error) error.hidden = false;
      return;
    }
    if (error) error.hidden = true;
    const email = form.dataset.email;
    if (email) {
      const name = String(data.get('name') || '').trim();
      const company = String(data.get('company') || '').trim();
      const body = `${message}\n\n--\nTopic: ${topic}${name ? `\nName: ${name}` : ''}${company ? `\nCompany: ${company}` : ''}`;
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(`[${topic}] ${subject}`)}&body=${encodeURIComponent(body)}`;
      return;
    }
    const title = `[${topic}] ${subject}`;
    const body = `${message}\n\n---\n_Sent from openflows.dev_`;
    window.open(`${form.dataset.repo}/discussions/new?title=${encodeURIComponent(title)}&body=${encodeURIComponent(body)}`, '_blank', 'noopener');
  });
</script>

<style>
  .contact-section { border-top: 1px solid var(--of-line); scroll-margin-top: var(--nav-height); }
  .contact { display: grid; grid-template-columns: 1.25fr 0.9fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }

  .form { padding: clamp(1.5rem, 3.5vw, 2.5rem); display: grid; gap: 1.4rem; }
  .form-head h2 { font-size: 1.6rem; letter-spacing: -0.03em; }
  .form-head p { margin-top: 0.4rem; color: var(--of-text-2); font-size: 0.92rem; }

  .topics { border: 0; }
  .topics legend, .field > span { display: block; margin-bottom: 0.55rem; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--of-text-3); }
  .topic-list { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .topic input { position: absolute; opacity: 0; pointer-events: none; }
  .topic span { display: inline-flex; align-items: center; height: 36px; padding: 0 0.95rem; border-radius: 999px; border: 1px solid var(--of-line-strong); font-size: 0.88rem; color: var(--of-text-2); cursor: pointer; transition: color 0.2s, background 0.2s, border-color 0.2s; }
  .topic span:hover { color: var(--of-text); }
  .topic input:checked + span { color: var(--of-invert); background: var(--of-text); border-color: var(--of-text); }
  .topic input:focus-visible + span { outline: 2px solid var(--of-text); outline-offset: 2px; }

  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .field input, .field textarea {
    width: 100%;
    padding: 0.8rem 0.95rem;
    border-radius: 12px;
    border: 1px solid var(--of-line-strong);
    background: var(--of-bg);
    color: var(--of-text);
    font: inherit;
    font-size: 0.95rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .field textarea { resize: vertical; min-height: 140px; line-height: 1.55; }
  .field input::placeholder, .field textarea::placeholder { color: var(--of-text-3); }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--of-text); box-shadow: 0 0 0 4px color-mix(in srgb, var(--of-text) 8%, transparent); }

  .form-error { font-size: 0.88rem; color: var(--color-destructive); }
  .form-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .form-note { font-size: 0.82rem; color: var(--of-text-3); }

  .channels { display: grid; gap: 0.6rem; }
  .channels-label { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--of-text-3); margin-bottom: 0.4rem; }
  .channel { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.15rem; border-radius: 16px; border: 1px solid var(--of-line); background: var(--of-surface); transition: border-color 0.3s, transform 0.4s var(--ease-out); }
  .channel:hover { border-color: var(--of-line-strong); transform: translateX(4px); }
  .ch-icon { display: grid; place-items: center; width: 40px; height: 40px; flex-shrink: 0; border-radius: 11px; background: var(--of-text); color: var(--of-invert); }
  .ch-icon svg { width: 19px; height: 19px; }
  .ch-text { flex: 1; display: flex; flex-direction: column; }
  .ch-text b { font-weight: 500; font-size: 0.95rem; }
  .ch-text span { font-size: 0.84rem; color: var(--of-text-2); }
  .ch-arrow { color: var(--of-text-3); transition: color 0.2s; }
  .channel:hover .ch-arrow { color: var(--of-text); }

  .evaluate { margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--of-line-strong); }
  .evaluate p:not(.channels-label) { color: var(--of-text-2); font-size: 0.92rem; line-height: 1.6; margin-bottom: 0.9rem; }

  @media (max-width: 960px) {
    .contact { grid-template-columns: 1fr; }
    .row { grid-template-columns: 1fr; }
  }
</style>
