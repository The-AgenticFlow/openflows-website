---
// Site-wide search: a trigger for the navbar and a dialog that searches every
// page, docs article, blog post, paper and agent. The index is the static
// /search-index.json, fetched the first time the dialog opens.
---

<button class="ss-trigger" type="button" data-site-search-open aria-label="Search the site">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
  <span class="ss-label">Search</span>
  <kbd class="ss-kbd" data-ss-mod>Ctrl K</kbd>
</button>

<div class="ss" id="site-search" hidden>
  <div class="ss-backdrop" data-site-search-close></div>
  <div class="ss-panel" role="dialog" aria-modal="true" aria-label="Search OpenFlows">
    <div class="ss-field">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input id="site-search-input" type="search" placeholder="Search docs, blog, research and pages…" autocomplete="off" spellcheck="false" aria-controls="site-search-results" />
      <button type="button" class="ss-esc" data-site-search-close>Esc</button>
    </div>
    <div class="ss-filters" role="group" aria-label="Filter results">
      {['All', 'Docs', 'Blog', 'Research', 'Page', 'Agent'].map((f, i) => (
        <button type="button" data-ss-filter={f} aria-pressed={i === 0 ? 'true' : 'false'}>{f === 'Page' ? 'Pages' : f === 'Agent' ? 'Agents' : f}</button>
      ))}
    </div>
    <ul class="ss-results" id="site-search-results" role="listbox" data-lenis-prevent></ul>
    <p class="ss-empty" id="site-search-empty" hidden></p>
    <div class="ss-foot" aria-hidden="true"><span><kbd>↑</kbd><kbd>↓</kbd> to move</span><span><kbd>↵</kbd> to open</span><span><kbd>Esc</kbd> to close</span></div>
  </div>
</div>

<script>
  interface Entry { url: string; type: string; title: string; summary: string; text: string }

  const dialog = document.getElementById('site-search') as HTMLElement | null;
  const input = document.getElementById('site-search-input') as HTMLInputElement | null;
  const list = document.getElementById('site-search-results') as HTMLUListElement | null;
  const empty = document.getElementById('site-search-empty') as HTMLElement | null;
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-ss-filter]')];

  if (dialog && input && list && empty) {
    const isMac = /Mac|iPhone|iPad/.test(navigator.platform);
    document.querySelectorAll('[data-ss-mod]').forEach((k) => (k.textContent = isMac ? '⌘ K' : 'Ctrl K'));

    let index: Entry[] | null = null;
    let loading: Promise<void> | null = null;
    let filter = 'All';
    let active = 0;
    let lastFocus: Element | null = null;

    const load = () =>
      (loading ??= fetch('/search-index.json')
        .then((r) => r.json())
        .then((data: Entry[]) => {
          index = data.map((e) => ({ ...e, title: e.title, text: e.text }));
        })
        .catch(() => {
          index = [];
        }));

    const escapeHtml = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);
    const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

    const highlight = (text: string, terms: string[]) => {
      let html = escapeHtml(text);
      for (const t of terms) html = html.replace(new RegExp(`(${escapeRe(escapeHtml(t))})`, 'gi'), '<mark>$1</mark>');
      return html;
    };

    // Show the stretch of body text around the first match, so the visitor sees why it matched.
    const snippet = (e: Entry, terms: string[]) => {
      const lower = e.text.toLowerCase();
      const at = terms.map((t) => lower.indexOf(t)).filter((i) => i >= 0).sort((a, b) => a - b)[0];
      if (at === undefined || e.summary.toLowerCase().includes(terms[0])) return e.summary;
      const start = Math.max(0, at - 60);
      return `${start > 0 ? '…' : ''}${e.text.slice(start, start + 170).trim()}…`;
    };

    const score = (e: Entry, terms: string[]) => {
      const title = e.title.toLowerCase();
      const summary = e.summary.toLowerCase();
      const text = e.text.toLowerCase();
      let total = 0;
      for (const t of terms) {
        const s = (title.includes(t) ? 10 : 0) + (title.startsWith(t) ? 4 : 0) + (summary.includes(t) ? 4 : 0) + (text.includes(t) ? 1 + Math.min(4, text.split(t).length - 2) * 0.25 : 0);
        if (!s) return 0;
        total += s;
      }
      return total + (e.type === 'Docs' ? 0.5 : 0);
    };

    const SUGGESTED = ['/docs/getting-started', '/docs/getting-started/installation', '/agents', '/docs/architecture/components-and-interactions', '/enterprise', '/blog'];

    const render = () => {
      if (!index) return;
      const q = input.value.trim().toLowerCase();
      const terms = q.split(/\s+/).filter(Boolean);
      let results: Entry[];
      if (!terms.length) {
        results = SUGGESTED.map((u) => index!.find((e) => e.url === u)).filter(Boolean) as Entry[];
        if (filter !== 'All') results = index.filter((e) => e.type === filter).slice(0, 8);
      } else {
        results = index
          .filter((e) => filter === 'All' || e.type === filter)
          .map((e) => [e, score(e, terms)] as const)
          .filter(([, s]) => s > 0)
          .sort((a, b) => b[1] - a[1])
          .slice(0, 20)
          .map(([e]) => e);
      }
      active = 0;
      list.innerHTML = results
        .map(
          (e, i) => `<li role="option" aria-selected="${i === 0}"><a href="${e.url}" class="ss-hit">
            <span class="ss-type">${escapeHtml(e.type)}</span>
            <span class="ss-body"><span class="ss-title">${highlight(e.title, terms)}</span><span class="ss-snippet">${highlight(snippet(e, terms), terms)}</span></span>
            <span class="ss-go" aria-hidden="true">↵</span></a></li>`,
        )
        .join('');
      empty.hidden = results.length > 0;
      empty.textContent = terms.length ? `No results for “${input.value.trim()}”.` : '';
      if (!terms.length && results.length) list.insertAdjacentHTML('afterbegin', '<li class="ss-heading" role="presentation">Suggested</li>');
    };

    const items = () => [...list.querySelectorAll<HTMLElement>('li[role="option"]')];
    const move = (dir: number) => {
      const all = items();
      if (!all.length) return;
      active = (active + dir + all.length) % all.length;
      all.forEach((li, i) => li.setAttribute('aria-selected', String(i === active)));
      all[active].scrollIntoView({ block: 'nearest' });
    };

    const open = async () => {
      lastFocus = document.activeElement;
      dialog.hidden = false;
      document.documentElement.classList.add('ss-open');
      (window as any).__lenis?.stop?.();
      requestAnimationFrame(() => dialog.classList.add('is-open'));
      input.focus();
      input.select();
      await load();
      render();
    };

    const close = () => {
      dialog.classList.remove('is-open');
      document.documentElement.classList.remove('ss-open');
      (window as any).__lenis?.start?.();
      setTimeout(() => (dialog.hidden = true), 180);
      (lastFocus as HTMLElement | null)?.focus?.();
    };

    document.querySelectorAll('[data-site-search-open]').forEach((b) => b.addEventListener('click', open));
    dialog.querySelectorAll('[data-site-search-close]').forEach((b) => b.addEventListener('click', close));
    input.addEventListener('input', render);
    filters.forEach((b) =>
      b.addEventListener('click', () => {
        filter = b.dataset.ssFilter ?? 'All';
        filters.forEach((f) => f.setAttribute('aria-pressed', String(f === b)));
        render();
        input.focus();
      }),
    );
    list.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });

    document.addEventListener('keydown', (e) => {
      const typing = e.target instanceof HTMLElement && (e.target.isContentEditable || /INPUT|TEXTAREA|SELECT/.test(e.target.tagName));
      if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
        if (document.getElementById('docs-search')) return; // the docs keep their own search
        e.preventDefault();
        dialog.hidden ? open() : close();
        return;
      }
      if (dialog.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
      else if (e.key === 'Enter') {
        const link = items()[active]?.querySelector('a');
        if (link) { e.preventDefault(); close(); window.location.href = link.href; }
      }
    });
  }
</script>

<style>
  .ss-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 36px;
    min-width: 200px;
    padding: 0 0.45rem 0 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--of-line-strong);
    background: color-mix(in srgb, var(--of-text) 3%, transparent);
    color: var(--of-text-3);
    font-size: 0.85rem;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .ss-trigger:hover { color: var(--of-text-2); border-color: color-mix(in srgb, var(--of-text) 25%, transparent); }
  .ss-trigger svg { width: 15px; height: 15px; }
  .ss-label { flex: 1; text-align: left; }
  .ss-kbd, .ss-foot kbd, .ss-esc {
    padding: 0.1rem 0.4rem;
    border-radius: 6px;
    border: 1px solid var(--of-line-strong);
    background: var(--of-bg);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--of-text-3);
  }

  .ss { position: fixed; inset: 0; z-index: 200; display: flex; justify-content: center; align-items: flex-start; padding: min(12vh, 120px) 16px 16px; }
  .ss[hidden] { display: none; }
  .ss-backdrop { position: absolute; inset: 0; background: rgba(8, 8, 10, 0.45); backdrop-filter: blur(6px); opacity: 0; transition: opacity 0.18s; }
  .ss-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(680px, 100%);
    max-height: min(640px, 78vh);
    border-radius: 18px;
    border: 1px solid var(--of-line-strong);
    background: var(--of-bg);
    color: var(--of-text);
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.35);
    opacity: 0;
    transform: translateY(-8px) scale(0.985);
    transition: opacity 0.18s, transform 0.25s var(--ease-out);
    overflow: hidden;
  }
  .ss.is-open .ss-backdrop, .ss.is-open .ss-panel { opacity: 1; transform: none; }

  .ss-field { display: flex; align-items: center; gap: 0.7rem; padding: 0.95rem 1.1rem; border-bottom: 1px solid var(--of-line); }
  .ss-field svg { width: 18px; height: 18px; color: var(--of-text-3); flex-shrink: 0; }
  .ss-field input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; color: var(--of-text); font: inherit; font-size: 1rem; }
  .ss-field input::-webkit-search-cancel-button { display: none; }
  .ss-esc { cursor: pointer; }

  .ss-filters { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0.7rem 1.1rem; border-bottom: 1px solid var(--of-line); }
  .ss-filters button { padding: 0.25rem 0.7rem; border-radius: 999px; border: 1px solid var(--of-line); background: none; color: var(--of-text-2); font-size: 0.78rem; cursor: pointer; }
  .ss-filters button:hover { color: var(--of-text); }
  .ss-filters button[aria-pressed='true'] { color: var(--of-invert); background: var(--of-text); border-color: var(--of-text); }

  .ss-results { flex: 1; overflow-y: auto; margin: 0; padding: 0.4rem; list-style: none; }
  .ss-results :global(.ss-heading) { padding: 0.6rem 0.75rem 0.3rem; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--of-text-3); }
  .ss-results :global(.ss-hit) { display: flex; align-items: flex-start; gap: 0.85rem; padding: 0.7rem 0.75rem; border-radius: 10px; color: inherit; text-decoration: none; }
  .ss-results :global(li[aria-selected='true'] .ss-hit), .ss-results :global(.ss-hit:hover) { background: color-mix(in srgb, var(--of-text) 6%, transparent); }
  .ss-results :global(.ss-type) { flex-shrink: 0; width: 76px; margin-top: 0.15rem; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--of-text-3); }
  .ss-results :global(.ss-body) { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.2rem; }
  .ss-results :global(.ss-title) { font-size: 0.93rem; font-weight: 500; color: var(--of-text); }
  .ss-results :global(.ss-snippet) { font-size: 0.82rem; line-height: 1.5; color: var(--of-text-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ss-results :global(mark) { background: color-mix(in srgb, var(--of-accent, #0f6b5c) 22%, transparent); color: inherit; border-radius: 3px; padding: 0 1px; }
  .ss-results :global(.ss-go) { align-self: center; font-size: 0.8rem; color: var(--of-text-3); opacity: 0; }
  .ss-results :global(li[aria-selected='true'] .ss-go) { opacity: 1; }

  .ss-empty { padding: 2rem 1rem; text-align: center; font-size: 0.9rem; color: var(--of-text-3); }
  .ss-foot { display: flex; gap: 1.1rem; padding: 0.6rem 1.1rem; border-top: 1px solid var(--of-line); font-size: 0.72rem; color: var(--of-text-3); }
  .ss-foot kbd { margin-right: 0.2rem; }

  @media (max-width: 1180px) { .ss-trigger { min-width: 0; } .ss-label, .ss-kbd { display: none; } .ss-trigger { width: 36px; justify-content: center; padding: 0; } }
  @media (max-width: 640px) { .ss-results :global(.ss-type) { display: none; } .ss-foot { display: none; } }
</style>
