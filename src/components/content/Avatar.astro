---
interface Props {
  name: string;
  initials: string;
  src?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { name, initials, src, size = 'md' } = Astro.props;

// Initials sit on one of a few soft tints, picked from the name so a person keeps their colour.
const TINTS = ['#cfe1dd', '#e6dccf', '#d9dbe8', '#e9d6d3', '#dde5cf'];
const hash = [...name].reduce((sum, char) => sum + char.charCodeAt(0), 0);
const tint = TINTS[hash % TINTS.length];
---

<span class={`avatar avatar-${size}`} style={`--tint: ${tint}`} aria-hidden="true">
  <span class="avatar-initials">{initials}</span>
  {src && (
    <img
      src={src}
      alt=""
      width="96"
      height="96"
      loading="lazy"
      decoding="async"
      referrerpolicy="no-referrer"
      onerror="this.remove()"
    />
  )}
</span>

<style>
  .avatar {
    position: relative;
    display: inline-grid;
    flex-shrink: 0;
    place-items: center;
    overflow: hidden;
    border-radius: 50%;
    background: var(--tint);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-weight: 600;
    line-height: 1;
  }

  .avatar-sm {
    width: 1.25rem;
    height: 1.25rem;
    font-size: 0.5rem;
  }

  .avatar-md {
    width: 1.75rem;
    height: 1.75rem;
    font-size: 0.625rem;
  }

  .avatar-lg {
    width: 2.5rem;
    height: 2.5rem;
    font-size: 0.8125rem;
  }

  .avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
