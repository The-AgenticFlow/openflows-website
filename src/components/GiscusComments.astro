---
interface Props {
  repo: string;
  repoId: string;
  category: string;
  categoryId: string;
}

const { repo, repoId, category, categoryId } = Astro.props;
---

<div class="giscus-container">
  <h2 class="giscus-title">Comments</h2>
  <div class="giscus-wrapper">
    <script
      src="https://giscus.app/client.js"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="preferred_color_scheme"
      data-lang="en"
      crossorigin="anonymous"
      async
    ></script>
  </div>
</div>

<style>
  .giscus-container {
    max-width: 100%;
    margin: 4rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .giscus-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .giscus-wrapper {
    width: 100%;
  }

  /* Giscus iframe styling */
  .giscus-wrapper iframe {
    width: 100% !important;
    border: none;
  }

  /* Dark mode support for giscus */
  [data-theme="dark"] .giscus-wrapper iframe {
    color-scheme: dark;
  }
</style>
