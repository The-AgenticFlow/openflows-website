---
interface Props {
  before: string[];
  after: string[];
}

const { before, after } = Astro.props as Props;
---

<div class="comparison">
  <div class="comparisonCol before">
    <p class="comparisonLabel">Before</p>
    <ul class="comparisonList">
      {before.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
  <div class="comparisonCol after">
    <p class="comparisonLabel">After</p>
    <ul class="comparisonList">
      {after.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</div>

<style>
  .comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .comparisonCol {
    padding: 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .comparisonCol.before {
    background-color: rgba(248, 113, 113, 0.05);
    border-color: rgba(248, 113, 113, 0.2);
  }

  .comparisonCol.after {
    background-color: rgba(52, 211, 153, 0.05);
    border-color: rgba(52, 211, 153, 0.2);
  }

  .comparisonLabel {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .comparisonCol.before .comparisonLabel {
    color: var(--color-agent-vessel);
  }

  .comparisonCol.after .comparisonLabel {
    color: #34d399;
  }

  .comparisonList {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .comparisonList li {
    padding: 0.3rem 0 0.3rem 1.25rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    position: relative;
  }

  .comparisonCol.before .comparisonList li::before {
    content: '✕';
    position: absolute;
    left: 0;
    color: var(--color-agent-vessel);
    font-weight: 600;
  }

  .comparisonCol.after .comparisonList li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #34d399;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .comparison {
      grid-template-columns: 1fr;
    }
  }
</style>
