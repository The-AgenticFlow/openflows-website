---
import Cover from '@/components/content/Cover.astro';
import AuthorByline from './AuthorByline.astro';
import { formatPostDate, getPostHref, getReadTime, type BlogPost } from './blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const publishedAt = post.data.published_at;
---

<article class="lead" data-lead-card>
  <div class="lead-body">
    <p class="lead-meta">
      {post.data.category_id && <span class="chip">{post.data.category_id}</span>}
      {publishedAt && <time datetime={publishedAt.toISOString()}>{formatPostDate(publishedAt)}</time>}
      <span>{getReadTime(post)} min read</span>
    </p>
    <h2 class="lead-title">
      <a href={getPostHref(post)}>{post.data.title}</a>
    </h2>
    {post.data.excerpt && <p class="lead-excerpt">{post.data.excerpt}</p>}
    <div class="lead-foot">
      <AuthorByline post={post} />
      <span class="go" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17 17 7" />
          <path d="M8 7h9v9" />
        </svg>
      </span>
    </div>
  </div>

  <div class="lead-media">
    <Cover src={post.data.cover_image_url} eager />
  </div>
</article>

<style>
  .lead {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-driftwood);
  }

  .lead[hidden] {
    display: none;
  }

  .lead-body {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .lead-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-graphite);
  }

  .chip {
    color: var(--color-aubergine);
    font-weight: 600;
  }

  .lead-title {
    margin: 0;
    font-size: clamp(1.375rem, 2vw, 1.875rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .lead-title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .lead-title a::after {
    content: '';
    position: absolute;
    inset: -1rem -1rem 2rem;
  }

  .lead-title a:focus-visible {
    outline: none;
  }

  .lead-title a:focus-visible::after {
    outline: 2px solid var(--color-aubergine);
    border-radius: var(--radius-xl);
  }

  .lead-excerpt {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-graphite);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lead-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .go {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-driftwood);
    border-radius: 50%;
    color: var(--color-ink);
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s var(--transition-fast, ease);
  }

  .go svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .lead:hover .go {
    background: var(--color-ink);
    color: var(--color-parchment-canvas);
    transform: translate(2px, -2px);
  }

  .lead-media {
    position: relative;
  }

  .lead-media :global(.cover) {
    aspect-ratio: 628 / 337;
    border-radius: 0;
  }

  @media (max-width: 860px) {
    .lead {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-bottom: 2.5rem;
    }

    .lead-media {
      order: -1;
    }
  }
</style>
