---
import Avatar from '@/components/content/Avatar.astro';
import { getPostAuthors } from './authors';
import type { BlogPost } from './blog';

interface Props {
  post: BlogPost;
  size?: 'sm' | 'md' | 'lg';
}

const { post, size = 'md' } = Astro.props;
const authors = await getPostAuthors(post);
---

{authors.length > 0 && (
  <ul class="byline" aria-label={authors.length > 1 ? 'Authors' : 'Author'}>
    {authors.map((author) => (
      <li class="byline-person">
        <Avatar name={author.name} initials={author.initials} src={author.avatarUrl} size={size} />
        <span class="byline-name">{author.name}</span>
      </li>
    ))}
  </ul>
)}

<style>
  .byline {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .byline-person {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .byline-name {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-ink);
  }
</style>
