---
import MetaLine from '@/components/content/MetaLine.astro';
import { getPostAuthors } from './authors';
import { formatPostDate, getAuthorNames, getReadTime, type BlogPost } from './blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const publishedAt = post.data.published_at;
const authors = await getPostAuthors(post);
---

<MetaLine
  items={[
    {
      label: getAuthorNames(post),
      emphasis: true,
      avatars: authors.map((author) => ({ name: author.name, initials: author.initials, src: author.avatarUrl })),
    },
    publishedAt && { label: formatPostDate(publishedAt), datetime: publishedAt.toISOString() },
    { label: `${getReadTime(post)} min read` },
  ]}
/>
