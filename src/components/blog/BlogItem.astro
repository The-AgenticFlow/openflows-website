---
import Cover from '@/components/content/Cover.astro';
import AuthorByline from './AuthorByline.astro';
import { getPostAuthors } from './authors';
import { formatPostDate, getPostHref, getReadTime, type BlogPost } from './blog';

interface Props {
  post: BlogPost;
  /** The featured post is also listed here, but hidden until a filter is applied. */
  hidden?: boolean;
  lead?: boolean;
}

const { post, hidden = false, lead = false } = Astro.props;
const publishedAt = post.data.published_at;
const authors = await getPostAuthors(post);

const searchText = [
  post.data.title,
  post.data.excerpt,
  post.data.category_id,
  ...authors.map((author) => author.name),
]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<article
  class="item"
  hidden={hidden}
  data-post
  data-lead={lead ? 'true' : 'false'}
  data-topic={post.data.category_id ?? ''}
  data-search={searchText}
>
  <div class="item-body">
    <p class="item-meta">
      {post.data.category_id && <span class="chip">{post.data.category_id}</span>}
      {publishedAt && <time datetime={publishedAt.toISOString()}>{formatPostDate(publishedAt)}</time>}
      <span>{getReadTime(post)} min read</span>
    </p>
    <h3 class="item-title">
      <a href={getPostHref(post)}>{post.data.title}</a>
    </h3>
    {post.data.excerpt && <p class="item-excerpt">{post.data.excerpt}</p>}
    <div class="item-foot">
      <AuthorByline post={post} />
    </div>
  </div>

  <div class="item-media">
    <Cover src={post.data.cover_image_url} />
    <span class="go" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17 17 7" />
        <path d="M8 7h9v9" />
      </svg>
    </span>
  </div>
</article>

<style>
  .item {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 15rem);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
    padding-block: 2rem;
    border-bottom: 1px solid var(--color-driftwood);
  }

  .item[hidden] {
    display: none;
  }

  .item.is-entering {
    animation: blog-item-in 0.45s ease both;
  }

  .item-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .item-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-graphite);
  }

  .chip {
    padding: 0.2rem 0.625rem;
    border-radius: 999px;
    background: var(--color-lavender-chip);
    color: var(--color-aubergine);
    font-weight: 600;
  }

  .item-title {
    margin: 0;
    font-size: clamp(1.25rem, 1.9vw, 1.625rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .item-title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .item-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .item-title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .item-title a:focus-visible {
    outline: none;
  }

  .item-title a:focus-visible::after {
    outline: 2px solid var(--color-aubergine);
    outline-offset: 4px;
    border-radius: var(--radius-lg);
  }

  .item-excerpt {
    margin: 0;
    max-width: 38rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-graphite);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .item-foot {
    margin-top: 0.25rem;
  }

  .item-media {
    position: relative;
  }

  .go {
    position: absolute;
    right: 0.625rem;
    bottom: 0.625rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-bone);
    color: var(--color-ink);
    box-shadow: 0 2px 8px rgba(20, 19, 18, 0.18);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .go svg {
    width: 1rem;
    height: 1rem;
  }

  .item:hover .go,
  .item:focus-within .go {
    opacity: 1;
    transform: none;
  }

  @keyframes blog-item-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (max-width: 640px) {
    .item {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-block: 1.5rem;
    }

    .item-media {
      order: -1;
    }

    .go {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .item.is-entering {
      animation: none;
    }

    .go {
      transition: none;
    }
  }
</style>
