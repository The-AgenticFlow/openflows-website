---
// Hero.astro - Hero section with typewriter animation
const QUICK_LINKS = [
  { label: 'Install in 60 seconds', href: '#get-started' },
  { label: 'How it works', href: '#how-it-works' },
  { label: 'Meet the agents', href: '/agents' },
  { label: 'Documentation', href: '/docs' },
  { label: 'Open Source', href: 'https://github.com/The-AgenticFlow/OpenFlows', external: true },
]
---

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding: calc(var(--nav-height) + var(--space-12)) var(--space-6) var(--space-20);
    overflow: hidden;
  }

  .hero::after {
    content: '';
    position: absolute;
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, var(--color-cyan-surface) 0%, transparent 70%);
    z-index: -1;
    pointer-events: none;
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 720px;
    width: 100%;
    gap: var(--space-6);
  }

  .heading {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--color-cyan) 0%, #1A1A1A 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .br {
    display: block;
  }

  .sub {
    font-size: clamp(var(--font-size-base), 2vw, var(--font-size-lg));
    color: var(--color-text-secondary);
    max-width: 560px;
    line-height: 1.7;
  }

  /* Terminal */
  .terminal {
    width: 100%;
    max-width: 600px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-align: left;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgba(26, 26, 26, 0.15);
  }

  .terminal-title {
    margin-left: 8px;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-family: 'IBM Plex Mono', monospace;
    letter-spacing: 0.04em;
  }

  .terminal-body {
    padding: 16px;
    min-height: 160px;
    font-family: 'IBM Plex Mono', 'Fira Code', monospace;
    font-size: 0.78rem;
    line-height: 1.8;
  }

  .line {
    display: flex;
    align-items: baseline;
    gap: 8px;
    color: var(--color-text-secondary);
    overflow: hidden;
  }

  .prompt {
    color: var(--color-cyan);
    text-shadow: 0 0 10px var(--color-cyan-glow);
    flex-shrink: 0;
  }

  .cursor {
    display: inline-block;
    width: 1ch;
    height: 1em;
    background-color: var(--color-text-primary);
    border-radius: 1px;
    margin-left: 1px;
    animation: blink 1s step-end infinite;
    vertical-align: middle;
  }

  /* Quick-link pills */
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    padding: 0.35rem 0.875rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: transparent;
    transition: color var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast), box-shadow var(--transition-fast);
    text-decoration: none;
    cursor: pointer;
  }

  .pill:hover {
    color: var(--color-cyan);
    border-color: var(--color-cyan);
    background-color: var(--color-cyan-surface);
    box-shadow: 0 0 15px var(--color-cyan-muted);
  }

  @media (max-width: 768px) {
    .hero {
      padding: calc(var(--nav-height) + var(--space-8)) var(--space-4) var(--space-16);
    }

    .content {
      gap: var(--space-5);
    }

    .terminal {
      max-width: 100%;
    }

    .terminal-body {
      font-size: 0.7rem;
      padding: 12px;
      min-height: 120px;
    }
  }

  @media (max-width: 600px) {
    .heading {
      font-size: 2.2rem;
    }

    .br {
      display: none;
    }

    .sub {
      font-size: var(--font-size-base);
      line-height: 1.6;
    }

    .pills {
      gap: var(--space-1);
    }

    .pill {
      font-size: var(--font-size-xs);
      padding: 0.25rem 0.6rem;
    }

    .terminal-body {
      font-size: 0.65rem;
      line-height: 1.6;
      min-height: 100px;
    }
  }

  @media (max-width: 400px) {
    .heading {
      font-size: 1.8rem;
    }

    .hero::after {
      width: 300px;
      height: 300px;
    }
  }
</style>

<section class="hero" aria-label="Hero section">
  <div class="content">
    <!-- Main heading -->
    <h1 class="heading fade-up delay-1">
      Your autonomous <br class="br" />
      AI development team
    </h1>

    <!-- Sub-heading -->
    <p class="sub fade-up delay-2">
      OpenFlows is a squad of specialized AI agents — written in Rust — that discovers
      your GitHub issues, writes code, reviews it, opens pull requests, and merges them.
      All without you writing a single line of code.
    </p>

    <!-- Terminal animation -->
    <div class="terminal fade-up delay-3" aria-live="polite" aria-label="Live orchestration log">
      <div class="terminal-header">
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="terminal-title">openflows run</span>
      </div>
      <div class="terminal-body" id="terminal-body">
        <!-- Lines will be added by JS -->
      </div>
    </div>

    <!-- Quick-link pills -->
    <div class="pills fade-up delay-4">
      {QUICK_LINKS.map(({ label, href, external }) => (
        <a
          href={href}
          class="pill"
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
        >
          {label}
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  const TYPEWRITER_LINES = [
    'nexus: syncing 3 open issues to github...',
    'nexus: assigning T-001 → forge-1',
    'forge-1: worktree created → writing PLAN.md',
    'sentinel: reviewing CONTRACT.md → AGREED',
    'forge-1: implementing segment 2/4...',
    'sentinel: segment-2-eval.md → APPROVED',
    'forge-1: all segments done → opening PR #7',
    'vessel: CI success ✓ → squash-merging PR #7',
    'lore: writing ADR-003 → docs committed',
    'nexus: T-001 merged. picking next ticket.',
  ];
  const speed = 38;
  let displayed = [];
  let lineIndex = 0;
  let charIndex = 0;
  let timer = null;

  function typeLine() {
    if (lineIndex >= TYPEWRITER_LINES.length) return;

    const currentLine = TYPEWRITER_LINES[lineIndex];
    
    if (charIndex <= currentLine.length) {
      timer = setTimeout(() => {
        if (charIndex === currentLine.length) {
          // line complete — pause then move to next
          setTimeout(() => {
            displayed.push(currentLine);
            lineIndex++;
            charIndex = 0;
            renderTerminal();
            typeLine();
          }, 320);
        } else {
          charIndex++;
          renderTerminal();
          typeLine();
        }
      }, speed);
    }
  }

  function renderTerminal() {
    const terminalBody = document.getElementById('terminal-body');
    if (!terminalBody) return;

    let html = '';
    displayed.forEach((line, i) => {
      html += `<div class="line"><span class="prompt">❯</span><span>${line}</span></div>`;
    });

    if (lineIndex < TYPEWRITER_LINES.length) {
      const currentPartial = TYPEWRITER_LINES[lineIndex].slice(0, charIndex);
      html += `<div class="line"><span class="prompt">❯</span><span>${currentPartial}</span><span class="cursor" aria-hidden="true"></span></div>`;
    }

    terminalBody.innerHTML = html;
  }

  // Start typewriter when component is ready
  // astro:page-load fires on client-side navigation, but NOT on initial page load
  // So we also call typeLine() immediately for the first load
  typeLine();
  document.addEventListener('astro:page-load', () => {
    typeLine();
  });
</script>
