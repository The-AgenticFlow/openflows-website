---
// GetStartedBanner.astro - Static CTA banner
---

<section class="section" id="get-started" aria-labelledby="get-started-title">
  <div class="container">
    <div class="card">
      <h2 id="get-started-title" class="heading">
        Get started with OpenFlows
      </h2>
      <p class="sub">
        Install in 60 seconds. Point it at a GitHub repo with open issues. Watch your team ship.
      </p>
      <div class="actions">
        <a
          class="btn btn-outline"
          href="https://github.com/The-AgenticFlow/OpenFlows"
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub
        </a>
        <a
          class="btn btn-cyan"
          href="/docs/getting-started/installation"
        >
          Installation Guide &rarr;
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding: var(--space-16) 0;
  }

  .container {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-16) var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-8);
  }

  .heading {
    font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-4xl));
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .sub {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    max-width: 480px;
    line-height: 1.7;
    margin-top: calc(var(--space-8) * -0.5);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-family);
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    border-radius: var(--radius-full);
    transition: background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      backdrop-filter var(--transition-fast),
      opacity var(--transition-fast);
    cursor: pointer;
    text-decoration: none;
    outline: none;
    font-size: var(--font-size-sm);
    padding: 0.5rem 1.125rem;
  }

  .btn:focus-visible {
    box-shadow: 0 0 0 2px var(--color-bg), 0 0 0 4px var(--color-accent);
  }

  .btn-outline {
    background-color: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
  }

  .btn-outline:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-hover);
    background-color: var(--color-surface-2);
    transform: translateY(-1px) scale(1.02);
  }

  .btn-cyan {
    background-color: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
  }

  .btn-cyan:hover {
    background-color: var(--glass-cyan-bg);
    border-color: var(--color-cyan);
    color: var(--color-cyan);
    box-shadow: var(--glow-cyan-intense);
    transform: translateY(-1px) scale(1.02);
  }

  @media (max-width: 768px) {
    .section {
      padding: var(--space-12) 0;
    }

    .card {
      padding: var(--space-12) var(--space-6);
    }
  }

  @media (max-width: 480px) {
    .card {
      padding: var(--space-10) var(--space-5);
    }

    .heading {
      font-size: clamp(var(--font-size-xl), 5vw, var(--font-size-2xl));
    }

    .sub {
      font-size: var(--font-size-sm);
    }

    .actions {
      flex-direction: column;
      width: 100%;
    }

    .actions>* {
      width: 100%;
    }
  }
</style>
