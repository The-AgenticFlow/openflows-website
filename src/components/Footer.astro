---
// Footer.astro - Static footer component
const FOOTER_LINKS = [
  {
    heading: 'OpenFlows',
    links: [
      { label: 'Get Started →', href: '/docs/getting-started' },
      { label: 'Installation Guide', href: '/docs/getting-started/installation' },
      { label: 'Self-host', href: '/docs/getting-started/installation' },
      { label: 'Releases →', href: 'https://github.com/The-AgenticFlow/OpenFlows/releases', external: true },
    ],
  },
  {
    heading: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Blog', href: '/blog' },
      { label: 'Use Cases', href: '/use-cases' },
      { label: 'Open Source →', href: 'https://github.com/The-AgenticFlow', external: true },
    ],
  },
  {
    heading: 'More',
    links: [
      { label: 'Demos', href: '/demos' },
      { label: 'Terminal Demo', href: '/demos/terminal' },
      { label: 'Walkthrough', href: '/demos/walkthrough' },
      { label: 'Discussions →', href: 'https://github.com/The-AgenticFlow/OpenFlows/discussions', external: true },
    ],
  },
]

const SOCIAL_LINKS = [
  {
    label: 'GitHub',
    href: 'https://github.com/The-AgenticFlow/OpenFlows',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" /></svg>`,
  },
  {
    label: 'Discord',
    href: 'https://discord.gg/nrtR2t4nWW',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.04.033.055a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z" /></svg>`,
  },
]

const year = new Date().getFullYear()
---

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
    font-size: var(--font-size-sm);
  }

  .container {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  /* Link columns */
  .columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-16);
    padding-bottom: var(--space-16);
    max-width: 900px;
    margin: 0 auto;
  }

  .column {
    min-width: 0;
    text-align: center;
  }

  .column-heading {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-cyan);
    margin-bottom: var(--space-4);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .link-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: center;
  }

  .link {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--font-size-sm);
    transition: color var(--transition-fast), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    line-height: 1.6;
    display: inline-block;
  }

  .link:hover {
    color: var(--color-cyan);
    transform: translateX(6px);
  }

  /* Bottom bar */
  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .bottom-left {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .socials {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast), transform var(--transition-fast);
    line-height: 1;
  }

  .social-link:hover {
    color: var(--color-cyan);
    transform: scale(1.2);
  }

  .copyright {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .policy-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .policy-link:hover {
    color: var(--color-text-secondary);
  }

  /* Logo styles */
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-icon {
    width: 64px;
    height: 64px;
    display: block;
    flex-shrink: 0;
    object-fit: contain;
    filter: drop-shadow(0 0 14px var(--color-cyan-glow));
  }

  .logo-name {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    background: linear-gradient(135deg, var(--color-cyan) 0%, #1A1A1A 70%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: none;
    filter: drop-shadow(0 0 6px var(--color-cyan-glow));
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .columns {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-10);
      max-width: 700px;
    }
  }

  @media (max-width: 768px) {
    .footer {
      padding-top: var(--space-10);
      padding-bottom: var(--space-6);
    }

    .columns {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
      padding-bottom: var(--space-10);
      max-width: 100%;
    }

    .column-heading {
      margin-bottom: var(--space-2);
      font-size: var(--font-size-xs);
    }

    .link-list {
      gap: 2px;
    }

    .link {
      line-height: 1.4;
      font-size: var(--font-size-xs);
    }
  }

  @media (max-width: 640px) {
    .columns {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
      padding-bottom: var(--space-8);
    }

    .column-heading {
      margin-bottom: var(--space-1);
    }

    .link-list {
      gap: 0;
    }

    .link {
      line-height: 1.3;
    }

    .bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }

    .bottom-left {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }

  @media (max-width: 480px) {
    .container {
      padding-inline: var(--space-3);
    }

    .footer {
      padding-top: var(--space-8);
      padding-bottom: var(--space-4);
    }

    .columns {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-3);
      padding-bottom: var(--space-6);
    }

    .column-heading {
      margin-bottom: 4px;
    }

    .link-list {
      gap: 0;
    }

    .link {
      line-height: 1.2;
    }

    .logo-icon {
      width: 48px;
      height: 48px;
    }

    .logo-name {
      font-size: 1.5rem;
    }
  }
</style>

<footer class="footer">
  <div class="container">
    <!-- Link columns -->
    <div class="columns">
      {FOOTER_LINKS.map(({ heading, links }) => (
        <div class="column">
          <h3 class="column-heading">{heading}</h3>
          <ul class="link-list">
            {links.map(({ label, href, external }) => (
              <li>
                <a
                  href={href}
                  class="link"
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="bottom">
      <div class="bottom-left">
        <a href="/" class="logo" aria-label="Openflows home">
          <img src="/openlogo-transparent.png" alt="Openflows Logo" class="logo-icon" />
          <span class="logo-name">Openflows</span>
        </a>
        <div class="socials">
          {SOCIAL_LINKS.map(({ label, href, icon }) => (
            <a
              href={href}
              class="social-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label}
              set:html={icon}
            />
          ))}
        </div>
      </div>

      <p class="copyright">
        OpenFlows © {year}
        {' · '}
        <a href="/privacy" class="policy-link">Privacy</a>
        {' · '}
        <a href="/terms" class="policy-link">Terms</a>
        {' · '}
        <a
          href="https://github.com/The-AgenticFlow/OpenFlows"
          class="policy-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          MIT License
        </a>
      </p>
    </div>
  </div>
</footer>
