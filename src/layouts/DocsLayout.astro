---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DOCS_READING_PATH } from '@/data/docsReadingPath';

interface Props {
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const { breadcrumbs } = Astro.props;
const pageLabel = breadcrumbs?.length ? breadcrumbs[breadcrumbs.length - 1].label : '';
const pageTitle = pageLabel && !['Docs', 'Documentation'].includes(pageLabel) ? `${pageLabel} · OpenFlows Docs` : 'Documentation · OpenFlows';

// Sidebar navigation tree with nested support
interface SidebarLink {
  label: string;
  href: string;
  children?: SidebarLink[];
}

interface SidebarSection {
  title: string;
  links: SidebarLink[];
}

const SIDEBAR: SidebarSection[] = [
  {
    title: 'Introduction',
    links: [
      { label: 'What is OpenFlows', href: '/docs/introduction/what-is-openflows' },
      { label: 'How OpenFlows works', href: '/docs/introduction/how-it-works' },
      { label: 'Use cases', href: '/docs/introduction/use-cases' },
      { label: 'How OpenFlows compares', href: '/docs/introduction/how-openflows-compares' },
    ],
  },
  {
    title: 'Get Started',
    links: [
      { label: 'Quick Start', href: '/docs/getting-started' },
      { label: 'Installation', href: '/docs/getting-started/installation' },
      { label: 'First Issue Walkthrough', href: '/docs/getting-started/first-issue' },
      { label: 'Token Guide', href: '/docs/getting-started/token-guide' },
      { label: 'Lifecycle Steps', href: '/docs/getting-started/lifecycle-steps' },
      { label: 'Completion & Merge', href: '/docs/getting-started/completion-and-merge' },
    ],
  },
  {
    title: 'Core Concepts',
    links: [
      { label: 'Architecture-First Development', href: '/docs/concepts/architecture-first' },
      { label: 'The Agent Team', href: '/docs/concepts/agent-team' },
      { label: 'The Planning Gate', href: '/docs/concepts/planning-gate' },
      { label: 'The Coordination Store', href: '/docs/concepts/coordination-store' },
      { label: 'Workspaces', href: '/docs/concepts/workspaces' },
      { label: 'Tenants', href: '/docs/concepts/tenants' },
      { label: 'Human Escalation', href: '/docs/concepts/human-escalation' },
      { label: 'The Agent Registry', href: '/docs/concepts/agent-registry' },
      { label: 'The Coder / OpenFlows Split', href: '/docs/concepts/coder-openflows-split' },
    ],
  },
  {
    title: 'Architecture',
    links: [
      { label: 'Overview', href: '/docs/architecture' },
      { label: 'Components and Interactions', href: '/docs/architecture/components-and-interactions' },
      { label: 'Manager Runtime', href: '/docs/architecture/manager-runtime' },
      { label: 'Credentials and Trust', href: '/docs/architecture/credentials' },
      { label: 'Hooks and A2A', href: '/docs/architecture/hooks-and-a2a' },
      { label: 'Big Picture', href: '/docs/architecture/big-picture' },
      { label: 'The Controller', href: '/docs/architecture/controller' },
      { label: 'The Workspace Fleet', href: '/docs/architecture/workspace-fleet' },
      { label: 'How the Pieces Talk', href: '/docs/architecture/how-the-pieces-talk' },
      { label: 'State Machine & Recovery', href: '/docs/architecture/state-machine-recovery' },
      { label: 'Decision & Routing', href: '/docs/architecture/decision-routing' },
      { label: 'Security by Design', href: '/docs/architecture/security-by-design' },
      { label: 'How It\'s Deployed', href: '/docs/architecture/deployment' },
    ],
  },
  {
    title: 'Guides',
    links: [
      { label: 'Agent Setup', href: '/docs/guides/agent-setup' },
      { label: 'Model Routing', href: '/docs/guides/model-routing' },
      { label: 'Multi-Tenancy', href: '/docs/guides/multi-tenancy' },
      { label: 'Extending: Skills', href: '/docs/guides/extending-skills' },
      { label: 'Extending: MCP', href: '/docs/guides/extending-mcp' },
      { label: 'Extending: Models', href: '/docs/guides/extending-models' },
      { label: 'Operations & Monitoring', href: '/docs/guides/operations' },
      { label: 'Troubleshooting', href: '/docs/guides/troubleshooting' },
    ],
  },
  {
    title: 'Reference',
    links: [
      { label: 'Glossary', href: '/docs/reference/glossary' },
      { label: 'Roles Reference', href: '/docs/reference/roles-reference' },
      { label: 'Lifecycle States', href: '/docs/reference/lifecycle-states' },
      { label: 'Configuration Reference', href: '/docs/reference/configuration-reference' },
      { label: 'Limits & Defaults', href: '/docs/reference/limits-and-defaults' },
      { label: 'Command Surface', href: '/docs/reference/command-surface' },
      { label: 'Notifications Reference', href: '/docs/reference/notifications-reference' },
    ],
  },
  {
    title: 'Contributing',
    links: [
      { label: 'Contributor Guide', href: '/docs/contributing' },
      { label: 'Development Setup', href: '/docs/contributing/development-setup' },
      { label: 'Adding Skills', href: '/docs/contributing/adding-skills' },
      { label: 'Testing', href: '/docs/contributing/testing' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Overview', href: '/docs/resources' },
      { label: 'Further Reading', href: '/docs/resources/further-reading' },
      { label: 'Community & Support', href: '/docs/resources/community-and-support' },
      { label: 'FAQ', href: '/docs/resources/faq' },
    ],
  },
];

const currentPath = Astro.url.pathname;
const pathIndex = DOCS_READING_PATH.findIndex(({ href }) => href === currentPath.replace(/\/$/, ''));
---

<BaseLayout footer={false} smooth={false} title={pageTitle} description="Everything you need to install, configure, and operate the OpenFlows orchestration layer.">
  <button class="docsMenuButton" type="button" aria-label="Open documentation navigation" aria-controls="docs-navigation" aria-expanded="false">☰ <span>Contents</span></button>
  {/* Sidebar  -  fixed position, always visible */}
  <aside class="sidebar" id="docs-navigation" aria-label="Documentation navigation" data-lenis-prevent>
    <button class="docsSearchTrigger" type="button" data-docs-search-open>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <span>Search docs</span>
      <kbd>⌘K</kbd>
    </button>
    <a href="/docs" class:list={['docsOverview', { active: currentPath === '/docs' || currentPath === '/docs/' }]}>Overview</a>
    {SIDEBAR.map(({ title, links }) => {
      const containsCurrent = links.some((link) => link.href === currentPath || link.children?.some((c) => c.href === currentPath));
      return (
        <details class="navGroup" open={containsCurrent || title === 'Get Started'}>
          <summary>
            <span>{title}</span>
            <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 3l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <ul class="sidebarNav">
            {links.map((link) => (
              <li>
                <a href={link.href} class:list={['sidebarLink', { active: currentPath === link.href }]}>{link.label}</a>
              </li>
            ))}
          </ul>
        </details>
      );
    })}
  </aside>

  <div class="docsSearch" id="docs-search" hidden>
    <div class="docsSearchBackdrop" data-docs-search-close></div>
    <div class="docsSearchPanel" role="dialog" aria-modal="true" aria-label="Search documentation">
      <div class="docsSearchField">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input id="docs-search-input" type="search" placeholder="Search the documentation…" autocomplete="off" spellcheck="false" />
        <kbd data-docs-search-close>Esc</kbd>
      </div>
      <ul class="docsSearchResults" id="docs-search-results" data-lenis-prevent>
        {SIDEBAR.flatMap(({ title, links }) => links.map((link) => (
          <li>
            <a href={link.href} data-search-item data-search-text={`${title} ${link.label}`.toLowerCase()}>
              <span class="dsTitle">{link.label}</span>
              <span class="dsSection">{title}</span>
            </a>
          </li>
        )))}
      </ul>
      <p class="docsSearchEmpty" id="docs-search-empty" hidden>No pages match your search.</p>
    </div>
  </div>

  {/* Main content  -  only this scrolls */}
  <main class:list={['content', { docsHomeContent: currentPath === '/docs' || currentPath === '/docs/' }]}>
    <div class="contentInner">
      {breadcrumbs && (
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          {breadcrumbs.map(({ label, href }) => (
            <span>
              <span class="sep">›</span>
              {href ? <a href={href}>{label}</a> : <span class="current">{label}</span>}
            </span>
          ))}
        </nav>
      )}
      <slot />
      {pathIndex >= 0 && (
        <nav class="docsPageSequence" aria-label="Continue reading">
          <p>Read in order · {pathIndex + 1} of {DOCS_READING_PATH.length}</p>
          <div>
            {pathIndex > 0 && <a href={DOCS_READING_PATH[pathIndex - 1].href}><span>Previous</span><strong>{DOCS_READING_PATH[pathIndex - 1].label}</strong></a>}
            {pathIndex < DOCS_READING_PATH.length - 1 && <a href={DOCS_READING_PATH[pathIndex + 1].href}><span>Next</span><strong>{DOCS_READING_PATH[pathIndex + 1].label}</strong></a>}
          </div>
        </nav>
      )}
    </div>
  </main>
  {currentPath !== '/docs' && currentPath !== '/docs/' && (
    <aside class="docsToc" aria-label="On this page">
      <p class="docsTocTitle">On this page</p>
      <nav id="docs-page-toc"></nav>
    </aside>
  )}
</BaseLayout>

<style is:global>

  /* --- Coder-style sidebar --- */
  .docsSearchTrigger {
    display: flex; align-items: center; gap: 0.6rem; width: 100%;
    height: 38px; padding: 0 0.6rem 0 0.75rem; margin-bottom: 1.25rem;
    border-radius: 10px; border: 1px solid var(--of-line-strong);
    background: var(--of-bg); color: var(--of-text-3); font-size: 0.875rem;
    transition: border-color 0.2s, color 0.2s;
  }
  .docsSearchTrigger:hover { border-color: color-mix(in srgb, var(--of-text) 30%, transparent); color: var(--of-text-2); }
  .docsSearchTrigger svg { width: 15px; height: 15px; }
  .docsSearchTrigger kbd, .docsSearchField kbd {
    margin-left: auto; padding: 0.1rem 0.4rem; border-radius: 5px;
    border: 1px solid var(--of-line-strong); font-family: var(--font-mono); font-size: 0.68rem; color: var(--of-text-3);
  }
  .docsOverview { display: block; padding: 0.45rem 0.75rem; margin-bottom: 0.5rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; color: var(--of-text); }
  .docsOverview:hover { background: var(--of-surface-2); }
  .docsOverview.active { background: var(--of-surface-2); }
  .navGroup { margin-bottom: 0.25rem; }
  .navGroup summary {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.5rem 0.75rem; border-radius: 8px; cursor: pointer; list-style: none;
    font-size: 0.875rem; font-weight: 500; color: var(--of-text);
  }
  .navGroup summary::-webkit-details-marker { display: none; }
  .navGroup summary:hover { background: var(--of-surface-2); }
  .navGroup summary svg { width: 12px; height: 12px; color: var(--of-text-3); transition: transform 0.25s var(--ease-out); }
  .navGroup[open] summary svg { transform: rotate(90deg); }
  .navGroup .sidebarNav { margin: 0.15rem 0 0.6rem 0.75rem; padding-left: 0.5rem; border-left: 1px solid var(--of-line); }
  .navGroup .sidebarLink { font-size: 0.85rem; padding: 0.35rem 0.6rem; }

  /* --- Search dialog --- */
  .docsSearch { position: fixed; inset: 0; z-index: 300; display: grid; place-items: start center; padding: 12vh 1rem 1rem; }
  .docsSearch[hidden] { display: none; }
  .docsSearchBackdrop { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.35); backdrop-filter: blur(4px); animation: dsFade 0.2s ease both; }
  .docsSearchPanel {
    position: relative; width: min(640px, 100%); max-height: 70vh; display: flex; flex-direction: column;
    border-radius: 16px; border: 1px solid var(--of-line-strong); background: var(--of-surface);
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.3); overflow: hidden; animation: dsIn 0.28s var(--ease-out) both;
  }
  @keyframes dsFade { from { opacity: 0; } }
  @keyframes dsIn { from { opacity: 0; transform: translateY(-8px) scale(0.98); } }
  .docsSearchField { display: flex; align-items: center; gap: 0.75rem; padding: 0 1rem; border-bottom: 1px solid var(--of-line); color: var(--of-text-3); }
  .docsSearchField svg { width: 18px; height: 18px; flex-shrink: 0; }
  .docsSearchField input { flex: 1; height: 56px; border: 0; outline: 0; background: none; font: inherit; font-size: 1rem; color: var(--of-text); }
  .docsSearchField kbd { cursor: pointer; }
  .docsSearchResults { overflow-y: auto; padding: 0.5rem; }
  .docsSearchResults a { display: flex; justify-content: space-between; gap: 1rem; padding: 0.65rem 0.75rem; border-radius: 9px; text-decoration: none; }
  .docsSearchResults a.is-active, .docsSearchResults a:hover { background: var(--of-surface-2); }
  .dsTitle { font-size: 0.92rem; color: var(--of-text); }
  .dsSection { font-family: var(--font-mono); font-size: 0.7rem; color: var(--of-text-3); white-space: nowrap; }
  .docsSearchEmpty { padding: 2rem; text-align: center; color: var(--of-text-3); font-size: 0.9rem; }
  /* Full page layout - sidebar fixed, content scrolls */
  html, body {
    height: 100%;
    margin: 0;
    overflow: hidden; /* Prevent body scroll */
  }

  /* Sidebar - fixed position, full height, independently scrollable */
  .sidebar {
    position: fixed;
    top: var(--nav-height);
    left: 0;
    width: 256px;
    height: calc(100vh - var(--nav-height));
    height: calc(100dvh - var(--nav-height));
    padding: 2rem 1.5rem 2rem 2rem;
    overflow-y: auto;
    background: var(--of-surface);
    border-right: 1px solid var(--of-line);
    z-index: 40;
    scrollbar-width: thin;
    scrollbar-color: var(--color-driftwood) transparent;
  }

  .docsHomeLink { display:block; color:var(--color-aubergine); font-weight:700; text-decoration:none; margin-bottom:1.25rem; }
  .docsFilterLabel { display:block; color:var(--color-graphite); font-size:.75rem; font-weight:700; margin-bottom:.4rem; }
  .docsFilter { width:100%; padding:.65rem .75rem; margin-bottom:1.5rem; border:1px solid var(--color-driftwood); border-radius:var(--radius-md); background:var(--color-bone); color:var(--color-ink); font:inherit; font-size:.875rem; }
  .docsFilter:focus-visible { outline:2px solid var(--color-aubergine); outline-offset:2px; }
  .docsReadingNav { padding:1rem 0; margin:0 0 1.5rem; border-top:1px solid var(--color-driftwood); border-bottom:1px solid var(--color-driftwood); }
  .docsReadingNav ol { list-style:none; padding:0; margin:0; }
  .docsReadingNav a { display:flex; gap:.6rem; align-items:baseline; }
  .docsReadingNav a span { color:var(--color-graphite); font-size:.75rem; font-variant-numeric:tabular-nums; }
  .docsReadingNav a.active span { color:inherit; }
  .docsBrowse > summary { margin:0 0 1rem; color:var(--color-graphite); font-size:.75rem; font-weight:700; letter-spacing:.05em; text-transform:uppercase; cursor:pointer; }
  .docsPageSequence { margin-top:4rem; padding-top:1.5rem; border-top:1px solid var(--color-driftwood); }
  .docsPageSequence > p { margin:0 0 1rem; color:var(--color-graphite); font-size:.8rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; }
  .docsPageSequence > div { display:flex; gap:1rem; justify-content:space-between; }
  .docsPageSequence a { display:flex; flex:1; flex-direction:column; gap:.3rem; padding:1rem; border:1px solid var(--color-driftwood); border-radius:var(--radius-md); text-decoration:none; background:var(--color-bone); }
  .docsPageSequence a:hover { border-color:var(--color-aubergine); }
  .docsPageSequence a span { color:var(--color-graphite); font-size:.75rem; }
  .docsPageSequence a strong { color:var(--color-ink); font-size:.95rem; }
  .sidebarSection[hidden], .sidebarNav li[hidden] { display:none; }

  .sidebar::-webkit-scrollbar {
    width: 4px;
  }

  .sidebar::-webkit-scrollbar-thumb {
    background: var(--color-driftwood);
    border-radius: 2px;
  }

  .sidebarSection {
    margin-bottom: 1.5rem;
  }

  .sidebarTitle {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-graphite);
    margin-bottom: 0.5rem;
  }

  .sidebarNav {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebarLink {
    display: block;
    padding: 0.45rem 0.75rem;
    font-size: 0.875rem;
    color: var(--of-text-2);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .sidebarLink:hover {
    background: rgba(0, 0, 0, 0.04);
    color: var(--of-text);
  }

  .sidebarLink.active {
    background: var(--of-surface-2);
    color: var(--of-text);
    font-weight: 500;
  }

  /* Content - offset by sidebar width, independently scrollable */
  .content {
    background: var(--of-surface);
    margin-left: 256px;
    padding: calc(var(--nav-height) + 2rem) 2rem 2rem;
    max-width: calc(100vw - 256px);
    height: 100vh;
    height: 100dvh;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-driftwood) transparent;
  }

  .content::-webkit-scrollbar {
    width: 6px;
  }

  .content::-webkit-scrollbar-thumb {
    background: var(--color-driftwood);
    border-radius: 3px;
  }

  .contentInner {
    max-width: 800px;
    margin-inline: auto;
  }

  .content :is(h2, h3, h4) { scroll-margin-top:1.5rem; }
  .docsToc { position:fixed; top:var(--nav-height); right:0; width:220px; height:calc(100dvh - var(--nav-height)); padding:2rem 1.5rem; overflow-y:auto; border-left:1px solid var(--of-line); background:var(--of-surface); }
  .docsTocTitle { margin:0 0 .9rem; color:var(--color-graphite); font-size:.75rem; font-weight:700; letter-spacing:.05em; text-transform:uppercase; }
  .docsToc a { display:block; padding:.4rem .65rem; border-left:2px solid var(--of-line); color:var(--of-text-3); font-size:.8rem; line-height:1.4; text-decoration:none; }
  .docsToc a:hover { color:var(--of-text); } .docsToc a.active { color:var(--of-text); border-left-color:var(--of-text); }
  .docsToc a.level-three { padding-left:1.25rem; }
  .docsMenuButton { display:none; }

  @media (min-width: 1201px) {
    .content { max-width:calc(100vw - 476px); margin-right:220px; }
    .content.docsHomeContent { max-width:calc(100vw - 256px); margin-right:0; }
  }
  @media (max-width: 1200px) { .docsToc { display:none; } }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-graphite);
    margin-bottom: 2rem;
  }

  .breadcrumbs a {
    color: var(--color-graphite);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-aubergine);
  }

  .breadcrumbs .sep {
    color: var(--color-driftwood);
  }

  .breadcrumbs .current {
    color: var(--color-ink);
    font-weight: 500;
  }

  /* Mobile: sidebar becomes a drawer */
  @media (max-width: 1024px) {
    .docsMenuButton { display:flex; align-items:center; gap:.5rem; position:fixed; top:calc(var(--nav-height) + .75rem); left:1rem; z-index:50; padding:.55rem .8rem; border:1px solid var(--color-driftwood); border-radius:var(--radius-md); background:var(--color-parchment-canvas); color:var(--color-ink); box-shadow:var(--shadow-card); font:inherit; font-size:.85rem; cursor:pointer; }
    .sidebar {
      position: fixed;
      top: var(--nav-height);
      left: 0;
      width: 280px;
      height: calc(100vh - var(--nav-height));
      height: calc(100dvh - var(--nav-height));
      transform: translateX(-100%);
      transition: transform 0.25s ease;
      box-shadow: var(--shadow-xl);
      padding: 4.5rem 1.25rem 1.5rem;
      z-index: 40;
    }

    .sidebar.open {
      transform: translateX(0);
    }

    .content {
      margin-left: 0;
      max-width: 100vw;
      height: 100vh;
      height: 100dvh;
      padding: calc(var(--nav-height) + 4.5rem) 1rem 2rem;
    }

    html.body-scroll-lock, body.body-scroll-lock {
      overflow: hidden;
    }
  }
</style>

<script>
  // Make content headings shareable: each section heading becomes an anchor
  // link with a stable id. Clicking the pilcrow copies the full URL (with the
  // heading hash) to the clipboard and scrolls to the section, so it can be
  // shared and linked directly.
  const indexHeadingLinks = () => {
    const article = document.querySelector('.content') || document.body;
    let usedIds = new Set();

    article.querySelectorAll('h1, h2, h3, h4').forEach((heading) => {
      if (!heading.id) {
        const base = (heading.textContent || '')
          .trim()
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');
        let id = base || 'section';
        let n = 2;
        while (usedIds.has(id)) {
          id = `${base}-${n++}`;
        }
        usedIds.add(id);
        heading.id = id;
      } else {
        usedIds.add(heading.id);
      }

      // Skip the page title (h1) - only section headings get share links.
      if (heading.tagName === 'H1') return;

      // Avoid double-adding on re-runs (Svelte/Astro islands may re-invoke).
      if (heading.querySelector('.heading-link')) return;

      const link = document.createElement('a');
      link.className = 'heading-link';
      link.href = `#${heading.id}`;
      link.setAttribute('aria-label', `Link to "${heading.textContent.trim()}"`);
      link.setAttribute('title', 'Copy link to this section');
      link.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';

      link.addEventListener('click', (e) => {
        e.preventDefault();
        const url = `${location.origin}${location.pathname}#${heading.id}`;
        const label = link.getAttribute('aria-label') || '';
        let copied = false;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(() => { copied = true; }).catch(() => { copied = false; });
        } else {
          // Fallback for older browsers / non-secure contexts.
          try {
            const temp = document.createElement('textarea');
            temp.value = url;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand('copy');
            document.body.removeChild(temp);
            copied = true;
          } catch (_) { copied = false; }
        }
        // Scroll to the section and update the hash for a shareable URL.
        history.replaceState(null, '', `#${heading.id}`);
        heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
        // Brief visual feedback.
        link.classList.add('copied');
        link.innerHTML = '<span style="font-size:12px;font-weight:700">✓</span>';
        setTimeout(() => {
          link.classList.remove('copied');
          link.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';
        }, 1500);
      });

      heading.appendChild(link);
    });
  };

  const initializeDocs = () => {
    indexHeadingLinks();
    const toc = document.querySelector('#docs-page-toc');
    const headings = [...document.querySelectorAll('.content h2, .content h3')];
    if (toc) {
      for (const heading of headings) {
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        const label = heading.querySelector('.stepTitle') ?? heading.childNodes[0];
        link.textContent = label?.textContent?.trim() || heading.textContent?.trim() || 'Section';
        if (heading.tagName === 'H3') link.classList.add('level-three');
        toc.appendChild(link);
      }
      if (!headings.length) toc.closest('.docsToc')?.setAttribute('hidden', '');
    }
    const content = document.querySelector('.content');
    const updateActive = () => {
      const current = [...headings].reverse().find(heading => heading.getBoundingClientRect().top <= 180);
      toc?.querySelectorAll('a').forEach(link => link.classList.toggle('active', current && link.getAttribute('href') === `#${current.id}`));
    };
    content?.addEventListener('scroll', updateActive, { passive: true });
    updateActive();
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeDocs);
  else initializeDocs();

  // Mobile sidebar toggle
  const sidebar = document.querySelector('.sidebar');
  const menuBtn = document.querySelector('.docsMenuButton');
  const filter = document.querySelector('#docs-filter');
  filter?.addEventListener('input', () => {
    const query = filter.value.trim().toLowerCase();
    if (query) sidebar?.querySelector('.docsBrowse')?.setAttribute('open', '');
    sidebar?.querySelectorAll('.docsReadingNav li').forEach(item => {
      item.hidden = !item.textContent?.toLowerCase().includes(query);
    });
    sidebar?.querySelectorAll('.sidebarSection').forEach(section => {
      let visible = 0;
      section.querySelectorAll('.sidebarNav li').forEach(item => {
        const matches = item.textContent?.toLowerCase().includes(query);
        item.hidden = !matches;
        if (matches) visible++;
      });
      section.hidden = visible === 0;
    });
  });

  // Collapsible sidebar: toggle children visibility
  document.querySelectorAll('.sidebarParent').forEach(button => {
    const parentLi = button.closest('li');
    const childrenList = parentLi?.querySelector('.sidebarChildren');

    if (childrenList) {
      button.addEventListener('click', () => {
        const isExpanded = button.getAttribute('data-expanded') === 'true';

        if (isExpanded) {
          button.setAttribute('data-expanded', 'false');
          button.setAttribute('aria-expanded', 'false');
          childrenList.classList.remove('open');
        } else {
          button.setAttribute('data-expanded', 'true');
          button.setAttribute('aria-expanded', 'true');
          childrenList.classList.add('open');
        }
      });
    }
  });

  menuBtn?.addEventListener('click', () => {
    const open = sidebar?.classList.toggle('open') ?? false;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close documentation navigation' : 'Open documentation navigation');
  });
  sidebar?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
    sidebar.classList.remove('open');
    menuBtn?.setAttribute('aria-expanded', 'false');
  }));

  // ⌘K docs search
  (() => {
    const dialog = document.getElementById('docs-search');
    const input = document.getElementById('docs-search-input') as HTMLInputElement | null;
    const empty = document.getElementById('docs-search-empty');
    if (!dialog || !input) return;
    const items = [...dialog.querySelectorAll<HTMLAnchorElement>('[data-search-item]')];
    let active = 0;
    const visible = () => items.filter((i) => !i.parentElement!.hidden);
    const highlight = () => {
      const list = visible();
      items.forEach((i) => i.classList.remove('is-active'));
      if (list[active]) {
        list[active].classList.add('is-active');
        list[active].scrollIntoView({ block: 'nearest' });
      }
    };
    const filter = () => {
      const q = input.value.trim().toLowerCase();
      items.forEach((i) => { i.parentElement!.hidden = !!q && !q.split(/\s+/).every((w) => (i.dataset.searchText || '').includes(w)); });
      if (empty) empty.hidden = visible().length > 0;
      active = 0;
      highlight();
    };
    const open = () => { dialog.hidden = false; input.value = ''; filter(); setTimeout(() => input.focus(), 10); };
    const close = () => { dialog.hidden = true; };
    document.querySelectorAll('[data-docs-search-open]').forEach((b) => b.addEventListener('click', open));
    dialog.querySelectorAll('[data-docs-search-close]').forEach((b) => b.addEventListener('click', close));
    input.addEventListener('input', filter);
    window.addEventListener('keydown', (e) => {
      const typing = (e.target as HTMLElement)?.closest('input, textarea');
      if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) { e.preventDefault(); open(); return; }
      if (dialog.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowDown') { e.preventDefault(); active = Math.min(active + 1, visible().length - 1); highlight(); }
      if (e.key === 'ArrowUp') { e.preventDefault(); active = Math.max(active - 1, 0); highlight(); }
      if (e.key === 'Enter') { const t = visible()[active]; if (t) window.location.href = t.href; }
    });
  })();
</script>
