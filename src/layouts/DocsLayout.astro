---
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const { breadcrumbs } = Astro.props;
const pageLabel = breadcrumbs?.length ? breadcrumbs[breadcrumbs.length - 1].label : '';
const pageTitle = pageLabel && !['Docs', 'Documentation'].includes(pageLabel) ? `${pageLabel} · OpenFlows Docs` : 'OpenFlows Docs';

interface SidebarLink {
  label: string;
  href: string;
  children?: SidebarLink[];
}

interface SidebarSection {
  title: string;
  links: SidebarLink[];
}

const SIDEBAR: SidebarSection[] = [
  {
    title: 'Introduction',
    links: [
      { label: 'What is OpenFlows', href: '/docs/introduction/what-is-openflows' },
      { label: 'How OpenFlows works', href: '/docs/introduction/how-it-works' },
      { label: 'Use cases', href: '/docs/introduction/use-cases' },
      { label: 'How OpenFlows compares', href: '/docs/introduction/how-openflows-compares' },
    ],
  },
  {
    title: 'Get Started',
    links: [
      { label: 'Quick Start', href: '/docs/getting-started' },
      { label: 'Installation', href: '/docs/getting-started/installation' },
      { label: 'First Issue Walkthrough', href: '/docs/getting-started/first-issue' },
      { label: 'Token Guide', href: '/docs/getting-started/token-guide' },
      { label: 'Lifecycle Steps', href: '/docs/getting-started/lifecycle-steps' },
      { label: 'Completion & Merge', href: '/docs/getting-started/completion-and-merge' },
    ],
  },
  {
    title: 'Core Concepts',
    links: [
      { label: 'Architecture-First Development', href: '/docs/concepts/architecture-first' },
      { label: 'The Agent Team', href: '/docs/concepts/agent-team' },
      { label: 'The Planning Gate', href: '/docs/concepts/planning-gate' },
      { label: 'The Coordination Store', href: '/docs/concepts/coordination-store' },
      { label: 'Workspaces', href: '/docs/concepts/workspaces' },
      { label: 'Tenants', href: '/docs/concepts/tenants' },
      { label: 'Human Escalation', href: '/docs/concepts/human-escalation' },
      { label: 'The Agent Registry', href: '/docs/concepts/agent-registry' },
      { label: 'The Coder / OpenFlows Split', href: '/docs/concepts/coder-openflows-split' },
    ],
  },
  {
    title: 'Architecture',
    links: [
      { label: 'Overview', href: '/docs/architecture' },
      { label: 'Components and Interactions', href: '/docs/architecture/components-and-interactions' },
      { label: 'Manager Runtime', href: '/docs/architecture/manager-runtime' },
      { label: 'Credentials and Trust', href: '/docs/architecture/credentials' },
      { label: 'Hooks and A2A', href: '/docs/architecture/hooks-and-a2a' },
      { label: 'Big Picture', href: '/docs/architecture/big-picture' },
      { label: 'The Controller', href: '/docs/architecture/controller' },
      { label: 'The Workspace Fleet', href: '/docs/architecture/workspace-fleet' },
      { label: 'How the Pieces Talk', href: '/docs/architecture/how-the-pieces-talk' },
      { label: 'State Machine & Recovery', href: '/docs/architecture/state-machine-recovery' },
      { label: 'Decision & Routing', href: '/docs/architecture/decision-routing' },
      { label: 'Security by Design', href: '/docs/architecture/security-by-design' },
      { label: 'How It\'s Deployed', href: '/docs/architecture/deployment' },
    ],
  },
  {
    title: 'Guides',
    links: [
      { label: 'Agent Setup', href: '/docs/guides/agent-setup' },
      { label: 'Model Routing', href: '/docs/guides/model-routing' },
      { label: 'Multi-Tenancy', href: '/docs/guides/multi-tenancy' },
      { label: 'Extending: Skills', href: '/docs/guides/extending-skills' },
      { label: 'Extending: MCP', href: '/docs/guides/extending-mcp' },
      { label: 'Extending: Models', href: '/docs/guides/extending-models' },
      { label: 'Operations & Monitoring', href: '/docs/guides/operations' },
      { label: 'Troubleshooting', href: '/docs/guides/troubleshooting' },
    ],
  },
  {
    title: 'Reference',
    links: [
      { label: 'Glossary', href: '/docs/reference/glossary' },
      { label: 'Roles Reference', href: '/docs/reference/roles-reference' },
      { label: 'Lifecycle States', href: '/docs/reference/lifecycle-states' },
      { label: 'Configuration Reference', href: '/docs/reference/configuration-reference' },
      { label: 'Limits & Defaults', href: '/docs/reference/limits-and-defaults' },
      { label: 'Command Surface', href: '/docs/reference/command-surface' },
      { label: 'Notifications Reference', href: '/docs/reference/notifications-reference' },
    ],
  },
  {
    title: 'Contributing',
    links: [
      { label: 'Contributor Guide', href: '/docs/contributing' },
      { label: 'Development Setup', href: '/docs/contributing/development-setup' },
      { label: 'Adding Skills', href: '/docs/contributing/adding-skills' },
      { label: 'Testing', href: '/docs/contributing/testing' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Overview', href: '/docs/resources' },
      { label: 'Further Reading', href: '/docs/resources/further-reading' },
      { label: 'Community & Support', href: '/docs/resources/community-and-support' },
      { label: 'FAQ', href: '/docs/resources/faq' },
    ],
  },
];

const REPO = 'https://github.com/The-AgenticFlow/OpenFlows';
const SITE_REPO = 'https://github.com/The-AgenticFlow/openflows-website';

const normalize = (path: string) => (path.length > 1 ? path.replace(/\/$/, '') : path);
const currentPath = normalize(Astro.url.pathname);
const isHome = currentPath === '/docs';

// Reading order follows the sidebar, so previous / next always match the navigation.
const ordered = [{ label: 'Overview', href: '/docs', section: 'Docs' }, ...SIDEBAR.flatMap((section) => section.links.map((link) => ({ label: link.label, href: link.href, section: section.title })))];
const position = ordered.findIndex((entry) => entry.href === currentPath);
const prev = position > 0 ? ordered[position - 1] : undefined;
const next = position >= 0 && position < ordered.length - 1 ? ordered[position + 1] : undefined;

// Source file for "Edit on GitHub".
const sources = Object.keys(import.meta.glob('/src/pages/docs/**/*.astro'));
const source = sources.find((file) => file === `/src/pages${currentPath}.astro`) ?? sources.find((file) => file === `/src/pages${currentPath}/index.astro`);
const editUrl = source ? `${SITE_REPO}/blob/master${source}` : `${SITE_REPO}/tree/master/src/pages/docs`;
---

<BaseLayout nav={false} footer={false} smooth={false} title={pageTitle} description="Install, configure, operate and extend OpenFlows, the governed AI dev team for Coder.">
  <div class="dmobile">
    <a href="/docs" class="dbrand"><img class="on-light" src="/openlogo-dark.png" alt="" width="24" height="24" /><img class="on-dark" src="/openlogo-light.png" alt="" width="24" height="24" /><span>OpenFlows <b>Docs</b></span></a>
    <button class="dicon" type="button" data-docs-search-open aria-label="Search docs"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></button>
    <button class="dicon docsMenuButton" type="button" aria-label="Open documentation navigation" aria-controls="docs-navigation" aria-expanded="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
  </div>

  <aside class="sidebar" id="docs-navigation" aria-label="Documentation navigation">
    <div class="dsb-head">
      <a href="/docs" class="dbrand"><img class="on-light" src="/openlogo-dark.png" alt="" width="24" height="24" /><img class="on-dark" src="/openlogo-light.png" alt="" width="24" height="24" /><span>OpenFlows <b>Docs</b></span></a>
      <button class="dicon dsb-collapse" type="button" aria-label="Collapse sidebar" title="Collapse sidebar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2.5"/><path d="M9.5 4.5v15"/></svg>
      </button>
    </div>

    <button class="docsSearchTrigger" type="button" data-docs-search-open>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <span>Search</span>
      <kbd>Ctrl</kbd><kbd>K</kbd>
    </button>

    <a class="dversion" href={`${REPO}/releases`} target="_blank" rel="noopener noreferrer">
      <b>v1.2</b><span>latest</span>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
    </a>

    <nav class="dsb-nav">
      <a href="/docs" class:list={['dnav-top', { active: isHome }]}>Home</a>
      {SIDEBAR.map(({ title, links }) => {
        const open = links.some((link) => link.href === currentPath);
        return (
          <details class="navGroup" open={open}>
            <summary class:list={[{ 'has-current': open }]}>
              <span>{title}</span>
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 3l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <ul class="sidebarNav">
              {links.map((link) => (
                <li><a href={link.href} class:list={['sidebarLink', { active: currentPath === link.href }]}>{link.label}</a></li>
              ))}
            </ul>
          </details>
        );
      })}
    </nav>

    <div class="dsb-foot">
      <div class="dsb-icons">
        <a href="/" class="dicon" aria-label="OpenFlows home" title="openflows.dev"><img class="on-light" src="/openlogo-dark.png" alt="" width="18" height="18" /><img class="on-dark" src="/openlogo-light.png" alt="" width="18" height="18" /></a>
        <a href={REPO} class="dicon" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.79-.26.79-.58v-2.23c-3.34.73-4.03-1.42-4.03-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.19.69.8.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/></svg></a>
        <a href="https://discord.gg/gDhK2RQZpY" class="dicon" target="_blank" rel="noopener noreferrer" aria-label="Discord"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.32 4.37a19.8 19.8 0 0 0-4.89-1.52.07.07 0 0 0-.08.04c-.21.38-.44.86-.61 1.25a18.3 18.3 0 0 0-5.49 0 12.6 12.6 0 0 0-.62-1.25.08.08 0 0 0-.08-.04 19.7 19.7 0 0 0-4.88 1.52.07.07 0 0 0-.03.03C.53 9.05-.32 13.58.1 18.06a.08.08 0 0 0 .03.05 19.9 19.9 0 0 0 6 3.03.08.08 0 0 0 .08-.03c.46-.63.87-1.3 1.23-1.99a.08.08 0 0 0-.04-.11 13.1 13.1 0 0 1-1.87-.89.08.08 0 0 1-.01-.13l.37-.29a.07.07 0 0 1 .08-.01c3.93 1.79 8.18 1.79 12.06 0a.07.07 0 0 1 .08.01l.37.29a.08.08 0 0 1 0 .13c-.6.35-1.22.64-1.88.89a.08.08 0 0 0-.04.11c.36.7.77 1.36 1.23 1.99a.08.08 0 0 0 .08.03 19.8 19.8 0 0 0 6-3.03.08.08 0 0 0 .03-.05c.5-5.18-.84-9.67-3.55-13.66a.06.06 0 0 0-.03-.03zM8.02 15.33c-1.18 0-2.16-1.09-2.16-2.42s.96-2.42 2.16-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.96 2.42-2.16 2.42zm7.97 0c-1.18 0-2.15-1.09-2.15-2.42s.95-2.42 2.15-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.95 2.42-2.16 2.42z"/></svg></a>
        <span class="dsb-sep"></span>
        <button class="dicon" type="button" id="docs-theme" aria-label="Toggle dark mode" title="Toggle theme">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
        </button>
      </div>
      <a href="/" class="dsb-site">openflows.dev</a>
      <p class="dsb-copy">© {new Date().getFullYear()} OpenFlows · MIT licensed</p>
    </div>
  </aside>

  <button class="dicon dsb-reopen" type="button" aria-label="Expand sidebar" title="Expand sidebar">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2.5"/><path d="M9.5 4.5v15"/></svg>
  </button>

  <main class:list={['content', { docsHomeContent: isHome }]}>
    <div class="contentInner">
      <div class="dtop">
        {breadcrumbs ? (
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            {breadcrumbs.map(({ label, href }, i) => (
              <span>
                {i > 0 && <span class="sep">/</span>}
                {href ? <a href={href}>{label}</a> : <span class="current">{label}</span>}
              </span>
            ))}
          </nav>
        ) : <span></span>}
        <div class="dactions">
          <button type="button" class="dbtn" id="copy-page">
            <svg class="of-copy-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.8"/><path d="M10.5 5V3.8A1.3 1.3 0 0 0 9.2 2.5H3.8a1.3 1.3 0 0 0-1.3 1.3v5.4a1.3 1.3 0 0 0 1.3 1.3H5"/></svg>
            <span>Copy page</span>
          </button>
          <a class="dbtn" href={editUrl} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><path d="M3 13h2.5L13 5.5 10.5 3 3 10.5z"/></svg>
            <span>Edit</span>
          </a>
        </div>
      </div>

      {!isHome && (
        <details class="dtoc-inline" id="toc-inline-wrap">
          <summary>On this page <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></summary>
          <nav id="toc-inline"></nav>
        </details>
      )}

      <article class="dprose">
        <slot />
      </article>

      <div class="dbottom">
        <a class="dbtn" href={editUrl} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><path d="M3 13h2.5L13 5.5 10.5 3 3 10.5z"/></svg>
          <span>Edit on GitHub</span>
        </a>
        {(prev || next) && (
          <nav class="dpager" aria-label="Previous and next pages">
            {prev ? (
              <a href={prev.href} class="dpage"><span class="dpage-dir"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M7.5 3l-3 3 3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>{prev.label}</span><span class="dpage-sec">{prev.section}</span></a>
            ) : <span></span>}
            {next && (
              <a href={next.href} class="dpage is-next"><span class="dpage-dir">{next.label}<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 3l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span><span class="dpage-sec">{next.section}</span></a>
            )}
          </nav>
        )}
      </div>
    </div>
  </main>

  {!isHome && (
    <aside class="docsToc" aria-label="On this page">
      <p class="docsTocTitle"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 4h11M2.5 8h8M2.5 12h11" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>On this page</p>
      <nav id="docs-page-toc"></nav>
      <a href="#top" class="toc-top" id="toc-top">Back to top ↑</a>
    </aside>
  )}

  <div class="docsSearch" id="docs-search" hidden>
    <div class="docsSearchBackdrop" data-docs-search-close></div>
    <div class="docsSearchPanel" role="dialog" aria-modal="true" aria-label="Search documentation">
      <div class="docsSearchField">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input id="docs-search-input" type="search" placeholder="Search the documentation…" autocomplete="off" spellcheck="false" />
        <kbd data-docs-search-close>Esc</kbd>
      </div>
      <ul class="docsSearchResults" id="docs-search-results" data-lenis-prevent>
        {SIDEBAR.flatMap(({ title, links }) => links.map((link) => (
          <li>
            <a href={link.href} data-search-item data-search-text={`${title} ${link.label}`.toLowerCase()}>
              <span class="dsTitle">{link.label}</span>
              <span class="dsSection">{title}</span>
            </a>
          </li>
        )))}
      </ul>
      <p class="docsSearchEmpty" id="docs-search-empty" hidden>No pages match your search.</p>
    </div>
  </div>
</BaseLayout>
<style is:global>
  :root { --dsb-w: 272px; --dtoc-w: 230px; }

  /* --- Shell --- */
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 50;
    width: var(--dsb-w);
    display: flex;
    flex-direction: column;
    padding: 1rem 0.85rem 0;
    background: var(--of-bg);
    border-right: 1px solid var(--of-line);
    transition: transform 0.45s var(--ease-out);
  }

  .dsb-head { display: flex; align-items: center; justify-content: space-between; padding: 0.15rem 0.35rem 1rem; }
  .dbrand { display: inline-flex; align-items: center; gap: 0.55rem; font-weight: 600; font-size: 0.98rem; letter-spacing: -0.02em; color: var(--of-text); }
  .dbrand b { font-weight: 500; color: var(--of-text-2); }

  .dicon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    color: var(--of-text-2);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .dicon:hover { color: var(--of-text); background: var(--of-surface-2); }
  .dicon svg { width: 17px; height: 17px; }

  .docsSearchTrigger {
    display: flex; align-items: center; gap: 0.55rem; width: 100%;
    height: 38px; padding: 0 0.5rem 0 0.7rem;
    border-radius: 10px; border: 1px solid var(--of-line-strong);
    background: var(--of-surface); color: var(--of-text-3); font: inherit; font-size: 0.875rem; cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .docsSearchTrigger:hover { border-color: color-mix(in srgb, var(--of-text) 30%, transparent); color: var(--of-text-2); }
  .docsSearchTrigger svg { width: 15px; height: 15px; }
  .docsSearchTrigger span { margin-right: auto; }
  .docsSearchTrigger kbd, .docsSearchField kbd {
    padding: 0.05rem 0.35rem; border-radius: 5px;
    border: 1px solid var(--of-line-strong); font-family: var(--font-mono); font-size: 0.66rem; color: var(--of-text-3); background: var(--of-bg);
  }

  .dversion {
    display: flex; align-items: center; gap: 0.5rem; margin: 0.6rem 0 1rem; height: 36px; padding: 0 0.75rem;
    border-radius: 10px; border: 1px solid var(--of-line-strong); background: var(--of-surface); font-size: 0.82rem; color: var(--of-text);
  }
  .dversion span { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--of-text-3); }
  .dversion svg { width: 13px; height: 13px; margin-left: auto; color: var(--of-text-3); }

  .dsb-nav { flex: 1; overflow-y: auto; margin: 0 -0.85rem; padding: 0 0.85rem 1rem; scrollbar-width: thin; scrollbar-color: var(--of-line-strong) transparent; }
  .dnav-top, .navGroup summary {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.5rem 0.6rem; border-radius: 8px;
    font-size: 0.875rem; font-weight: 500; color: var(--of-text-2);
    cursor: pointer; list-style: none; transition: color 0.15s, background 0.15s;
  }
  .navGroup summary::-webkit-details-marker { display: none; }
  .dnav-top:hover, .navGroup summary:hover { color: var(--of-text); background: var(--of-surface-2); }
  .dnav-top.active, .navGroup summary.has-current { color: var(--of-text); }
  .dnav-top.active { background: var(--of-surface-2); }
  .navGroup summary svg { width: 12px; height: 12px; color: var(--of-text-3); transition: transform 0.25s var(--ease-out); }
  .navGroup[open] summary svg { transform: rotate(90deg); }
  .navGroup .sidebarNav { margin: 0.1rem 0 0.5rem 0.95rem; padding-left: 0.6rem; border-left: 1px solid var(--of-line); }
  .sidebarLink { display: block; padding: 0.38rem 0.6rem; border-radius: 7px; font-size: 0.84rem; line-height: 1.4; color: var(--of-text-2); transition: color 0.15s, background 0.15s; }
  .sidebarLink:hover { color: var(--of-text); background: var(--of-surface-2); }
  .sidebarLink.active { color: var(--of-text); font-weight: 500; background: var(--of-surface-2); box-shadow: inset 2px 0 0 var(--of-text); }

  .dsb-foot { padding: 0.85rem 0.35rem 1rem; border-top: 1px solid var(--of-line); }
  .dsb-icons { display: flex; align-items: center; gap: 0.15rem; }
  .dsb-sep { flex: 1; }
  .dsb-icons .dicon img { width: 17px; height: 17px; }
  #docs-theme .moon { display: none; }
  [data-theme='dark'] #docs-theme .sun { display: none; }
  [data-theme='dark'] #docs-theme .moon { display: block; }
  .dsb-site { display: inline-block; margin-top: 0.6rem; font-size: 0.8rem; color: var(--of-text-2); }
  .dsb-site:hover { color: var(--of-text); }
  .dsb-copy { margin-top: 0.15rem; font-size: 0.72rem; color: var(--of-text-3); }

  .dsb-reopen { position: fixed; top: 1rem; left: 1rem; z-index: 40; border: 1px solid var(--of-line-strong); background: var(--of-surface); opacity: 0; pointer-events: none; transition: opacity 0.3s; }
  html.dsb-collapsed .sidebar { transform: translateX(-100%); }
  html.dsb-collapsed .dsb-reopen { opacity: 1; pointer-events: auto; }
  html.dsb-collapsed .content { margin-left: 0; }

  /* --- Content --- */
  .content {
    margin-left: var(--dsb-w);
    margin-right: var(--dtoc-w);
    width: auto;
    max-width: none;
    min-height: 100vh;
    padding: 2rem clamp(1.5rem, 4vw, 3.5rem) 4rem;
    transition: margin-left 0.45s var(--ease-out);
  }
  .content.docsHomeContent { margin-right: 0; }
  .contentInner { max-width: 800px; margin: 0 auto; }
  .docsHomeContent .contentInner { max-width: 980px; }

  .dtop { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; min-height: 32px; }
  .breadcrumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; font-size: 0.82rem; color: var(--of-text-3); margin: 0; }
  .breadcrumbs a { color: var(--of-text-3); text-decoration: none !important; }
  .breadcrumbs a:hover { color: var(--of-text); }
  .breadcrumbs .sep { margin-right: 0.35rem; opacity: 0.6; }
  .breadcrumbs .current { color: var(--of-text-2); }

  .dactions { display: flex; gap: 0.35rem; flex-shrink: 0; }
  .dbtn {
    display: inline-flex; align-items: center; gap: 0.4rem; height: 30px; padding: 0 0.65rem;
    border-radius: 8px; border: 1px solid var(--of-line-strong); background: var(--of-surface);
    font: inherit; font-size: 0.78rem; color: var(--of-text-2); cursor: pointer; text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }
  .dbtn:hover { color: var(--of-text); border-color: color-mix(in srgb, var(--of-text) 30%, transparent); }
  .dbtn svg { width: 13px; height: 13px; }
  .dbtn.is-copied { color: var(--of-accent); border-color: var(--of-accent-line); }

  /* Title + lead paragraph read like the Coder docs header */
  .dprose > h1:first-child { font-size: clamp(1.9rem, 3vw, 2.4rem); font-weight: 600; letter-spacing: -0.035em; margin-bottom: 0.75rem; }
  .dprose > h1:first-child + p { font-size: 1.12rem; line-height: 1.6; color: var(--of-text-2); padding-bottom: 1.5rem; margin-bottom: 2rem; border-bottom: 1px solid var(--of-line); }
  .content :is(h2, h3, h4) { scroll-margin-top: 1.5rem; }

  .dtoc-inline { display: none; margin-bottom: 1.75rem; border-radius: 12px; border: 1px solid var(--of-line); background: var(--of-surface); }
  .dtoc-inline summary { display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; font-size: 0.85rem; color: var(--of-text-2); cursor: pointer; list-style: none; }
  .dtoc-inline summary::-webkit-details-marker { display: none; }
  .dtoc-inline summary svg { width: 12px; height: 12px; transition: transform 0.25s; }
  .dtoc-inline[open] summary svg { transform: rotate(180deg); }
  .dtoc-inline nav { display: flex; flex-direction: column; padding: 0 1rem 0.85rem; }
  .dtoc-inline nav a { padding: 0.3rem 0 0.3rem 0.75rem; border-left: 1px solid var(--of-line-strong); font-size: 0.84rem; color: var(--of-text-2); text-decoration: none; }

  .dbottom { margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--of-line); }
  .dpager { display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; margin-top: 2rem; }
  .dpage { display: flex; flex-direction: column; gap: 0.3rem; padding: 1rem 1.15rem; border-radius: 12px; border: 1px solid var(--of-line); background: var(--of-surface); text-decoration: none; transition: border-color 0.2s, transform 0.3s var(--ease-out); }
  .dpage:hover { border-color: var(--of-line-strong); transform: translateY(-2px); }
  .dpage.is-next { text-align: right; align-items: flex-end; }
  .dpage-dir { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.92rem; font-weight: 500; color: var(--of-text); }
  .dpage-dir svg { width: 12px; height: 12px; }
  .dpage-sec { font-size: 0.78rem; color: var(--of-text-3); }

  /* --- On this page --- */
  .docsToc { position: fixed; top: 0; right: 0; bottom: 0; width: var(--dtoc-w); padding: 2.4rem 1.5rem 2rem 0.5rem; overflow-y: auto; }
  .docsTocTitle { display: flex; align-items: center; gap: 0.45rem; margin: 0 0 0.75rem; font-size: 0.8rem; font-weight: 500; color: var(--of-text-2); }
  .docsTocTitle svg { width: 14px; height: 14px; }
  .docsToc nav a { display: block; padding: 0.32rem 0 0.32rem 0.75rem; border-left: 1px solid var(--of-line-strong); font-size: 0.8rem; line-height: 1.4; color: var(--of-text-3); text-decoration: none; transition: color 0.2s, border-color 0.2s; }
  .docsToc nav a:hover { color: var(--of-text); }
  .docsToc nav a.active { color: var(--of-text); border-left-color: var(--of-text); }
  .docsToc nav a.level-three { padding-left: 1.4rem; }
  .toc-top { display: inline-block; margin-top: 1rem; font-size: 0.78rem; color: var(--of-text-3); }
  .toc-top:hover { color: var(--of-text); }

  .dmobile { display: none; }

  /* --- Search dialog --- */
  .docsSearch { position: fixed; inset: 0; z-index: 300; display: grid; place-items: start center; padding: 12vh 1rem 1rem; }
  .docsSearch[hidden] { display: none; }
  .docsSearchBackdrop { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(4px); animation: dsFade 0.2s ease both; }
  .docsSearchPanel { position: relative; width: min(640px, 100%); max-height: 70vh; display: flex; flex-direction: column; border-radius: 16px; border: 1px solid var(--of-line-strong); background: var(--of-surface); box-shadow: 0 40px 100px rgba(0, 0, 0, 0.3); overflow: hidden; animation: dsIn 0.28s var(--ease-out) both; }
  @keyframes dsFade { from { opacity: 0; } }
  @keyframes dsIn { from { opacity: 0; transform: translateY(-8px) scale(0.98); } }
  .docsSearchField { display: flex; align-items: center; gap: 0.75rem; padding: 0 1rem; border-bottom: 1px solid var(--of-line); color: var(--of-text-3); }
  .docsSearchField svg { width: 18px; height: 18px; flex-shrink: 0; }
  .docsSearchField input { flex: 1; height: 56px; border: 0; outline: 0; background: none; font: inherit; font-size: 1rem; color: var(--of-text); }
  .docsSearchField kbd { cursor: pointer; }
  .docsSearchResults { overflow-y: auto; padding: 0.5rem; list-style: none; }
  .docsSearchResults a { display: flex; justify-content: space-between; gap: 1rem; padding: 0.65rem 0.75rem; border-radius: 9px; text-decoration: none; }
  .docsSearchResults a.is-active, .docsSearchResults a:hover { background: var(--of-surface-2); }
  .dsTitle { font-size: 0.92rem; color: var(--of-text); }
  .dsSection { font-family: var(--font-mono); font-size: 0.7rem; color: var(--of-text-3); white-space: nowrap; }
  .docsSearchEmpty { padding: 2rem; text-align: center; color: var(--of-text-3); font-size: 0.9rem; }

  /* --- Responsive --- */
  @media (max-width: 1240px) {
    .docsToc { display: none; }
    .content { margin-right: 0; }
    .dtoc-inline { display: block; }
  }

  @media (max-width: 1024px) {
    .dmobile {
      position: sticky; top: 0; z-index: 45;
      display: flex; align-items: center; gap: 0.25rem;
      height: 56px; padding: 0 0.75rem 0 1rem;
      background: color-mix(in srgb, var(--of-bg) 88%, transparent); backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--of-line);
    }
    .dmobile .dbrand { margin-right: auto; }
    .sidebar { transform: translateX(-100%); box-shadow: var(--shadow-xl); }
    .sidebar.open { transform: none; }
    .dsb-collapse, .dsb-reopen { display: none; }
    .content { margin-left: 0; padding-top: 1.25rem; }
    html.body-scroll-lock, body.body-scroll-lock { overflow: hidden; }
  }

  @media (max-width: 640px) {
    .dactions .dbtn span { display: none; }
    .dpager { grid-template-columns: 1fr; }
    .dpage.is-next { text-align: left; align-items: flex-start; }
  }
</style>

<script>
  // Section headings get stable ids and a copy-link button.
  const linkIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';
  const article = document.querySelector('.dprose');
  const used = new Set<string>();
  article?.querySelectorAll<HTMLElement>('h1, h2, h3, h4').forEach((heading) => {
    if (!heading.id) {
      const base = (heading.textContent || '').trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'section';
      let id = base;
      let n = 2;
      while (used.has(id)) id = `${base}-${n++}`;
      heading.id = id;
    }
    used.add(heading.id);
    if (heading.tagName === 'H1' || heading.querySelector('.heading-link')) return;
    const link = document.createElement('a');
    link.className = 'heading-link';
    link.href = `#${heading.id}`;
    link.setAttribute('aria-label', `Link to "${(heading.textContent || '').trim()}"`);
    link.innerHTML = linkIcon;
    link.addEventListener('click', (e) => {
      e.preventDefault();
      navigator.clipboard?.writeText(`${location.origin}${location.pathname}#${heading.id}`);
      history.replaceState(null, '', `#${heading.id}`);
      heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
      link.innerHTML = '<span style="font-size:12px;font-weight:700">✓</span>';
      setTimeout(() => (link.innerHTML = linkIcon), 1400);
    });
    heading.appendChild(link);
  });

  // On this page: right rail on wide screens, collapsible box above the content otherwise.
  const headings = article ? [...article.querySelectorAll<HTMLElement>('h2, h3')] : [];
  const tocs = [document.getElementById('docs-page-toc'), document.getElementById('toc-inline')].filter(Boolean) as HTMLElement[];
  tocs.forEach((toc) => {
    headings.forEach((heading) => {
      const a = document.createElement('a');
      a.href = `#${heading.id}`;
      const label = heading.querySelector('.stepTitle') ?? heading.childNodes[0];
      a.textContent = label?.textContent?.trim() || heading.textContent?.trim() || 'Section';
      if (heading.tagName === 'H3') a.classList.add('level-three');
      toc.appendChild(a);
    });
  });
  if (!headings.length) {
    document.querySelector('.docsToc')?.setAttribute('hidden', '');
    document.getElementById('toc-inline-wrap')?.setAttribute('hidden', '');
  }
  document.getElementById('toc-inline')?.addEventListener('click', () => document.getElementById('toc-inline-wrap')?.removeAttribute('open'));
  document.getElementById('toc-top')?.addEventListener('click', (e) => { e.preventDefault(); window.scrollTo({ top: 0, behavior: 'smooth' }); });

  const railLinks = [...document.querySelectorAll<HTMLAnchorElement>('#docs-page-toc a')];
  let tocTick = false;
  const updateToc = () => {
    tocTick = false;
    const current = [...headings].reverse().find((h) => h.getBoundingClientRect().top <= 120) ?? headings[0];
    railLinks.forEach((l) => l.classList.toggle('active', !!current && l.getAttribute('href') === `#${current.id}`));
  };
  updateToc();
  window.addEventListener('scroll', () => { if (!tocTick) { tocTick = true; requestAnimationFrame(updateToc); } }, { passive: true });

  // Keep the current page visible in the sidebar.
  document.querySelector('.sidebarLink.active')?.scrollIntoView({ block: 'center' });

  // Copy page as plain text.
  const copyBtn = document.getElementById('copy-page');
  copyBtn?.addEventListener('click', () => {
    const text = (article as HTMLElement | null)?.innerText ?? '';
    navigator.clipboard?.writeText(`${text.trim()}\n\nSource: ${location.href}`).then(() => {
      copyBtn.classList.add('is-copied');
      const label = copyBtn.querySelector('span');
      if (label) label.textContent = 'Copied';
      setTimeout(() => {
        copyBtn.classList.remove('is-copied');
        if (label) label.textContent = 'Copy page';
      }, 1600);
    });
  });

  // Collapsible sidebar on desktop, remembered between pages.
  const root = document.documentElement;
  try { if (localStorage.getItem('of-docs-sidebar') === 'collapsed') root.classList.add('dsb-collapsed'); } catch {}
  document.querySelector('.dsb-collapse')?.addEventListener('click', () => {
    root.classList.add('dsb-collapsed');
    try { localStorage.setItem('of-docs-sidebar', 'collapsed'); } catch {}
  });
  document.querySelector('.dsb-reopen')?.addEventListener('click', () => {
    root.classList.remove('dsb-collapsed');
    try { localStorage.setItem('of-docs-sidebar', 'open'); } catch {}
  });

  // Mobile drawer.
  const sidebar = document.querySelector('.sidebar');
  const menuBtn = document.querySelector('.docsMenuButton');
  const setDrawer = (open: boolean) => {
    sidebar?.classList.toggle('open', open);
    menuBtn?.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('body-scroll-lock', open);
    document.body.classList.toggle('body-scroll-lock', open);
  };
  menuBtn?.addEventListener('click', () => setDrawer(!sidebar?.classList.contains('open')));
  sidebar?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setDrawer(false); });
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (sidebar?.classList.contains('open') && !t.closest('.sidebar') && !t.closest('.docsMenuButton')) setDrawer(false);
  });

  // Theme toggle (the marketing navbar is hidden on docs).
  document.getElementById('docs-theme')?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.classList.add('of-theme-anim');
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('of-theme', next); } catch {}
    setTimeout(() => root.classList.remove('of-theme-anim'), 500);
  });

  // Ctrl/⌘K search dialog.
  (() => {
    const dialog = document.getElementById('docs-search');
    const input = document.getElementById('docs-search-input') as HTMLInputElement | null;
    const empty = document.getElementById('docs-search-empty');
    if (!dialog || !input) return;
    const items = [...dialog.querySelectorAll<HTMLAnchorElement>('[data-search-item]')];
    let active = 0;
    const visible = () => items.filter((i) => !i.parentElement!.hidden);
    const highlight = () => {
      const list = visible();
      items.forEach((i) => i.classList.remove('is-active'));
      if (list[active]) {
        list[active].classList.add('is-active');
        list[active].scrollIntoView({ block: 'nearest' });
      }
    };
    const filter = () => {
      const q = input.value.trim().toLowerCase();
      items.forEach((i) => { i.parentElement!.hidden = !!q && !q.split(/\s+/).every((w) => (i.dataset.searchText || '').includes(w)); });
      if (empty) empty.hidden = visible().length > 0;
      active = 0;
      highlight();
    };
    const open = () => { dialog.hidden = false; input.value = ''; filter(); setTimeout(() => input.focus(), 10); };
    const close = () => { dialog.hidden = true; };
    document.querySelectorAll('[data-docs-search-open]').forEach((b) => b.addEventListener('click', open));
    dialog.querySelectorAll('[data-docs-search-close]').forEach((b) => b.addEventListener('click', close));
    input.addEventListener('input', filter);
    window.addEventListener('keydown', (e) => {
      const typing = (e.target as HTMLElement)?.closest('input, textarea');
      if ((e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) { e.preventDefault(); open(); return; }
      if (dialog.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowDown') { e.preventDefault(); active = Math.min(active + 1, visible().length - 1); highlight(); }
      if (e.key === 'ArrowUp') { e.preventDefault(); active = Math.max(active - 1, 0); highlight(); }
      if (e.key === 'Enter') { const t = visible()[active]; if (t) window.location.href = t.href; }
    });
  })();
</script>
