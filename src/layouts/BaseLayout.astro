---
import '@/styles/global.css';
import '@/styles/docs.css';
import '@/styles/article.css';
import 'lenis/dist/lenis.css';
import Navbar from '@/organisms/Navbar/Navbar.astro';
import SiteFooter from '@/organisms/Footer/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  footer?: boolean;
  smooth?: boolean;
  nav?: boolean;
}

const siteUrl = Astro.site?.toString() || 'https://openflows.dev';
const {
  title,
  description = 'OpenFlows - Autonomous AI Development Team. Five specialized AI agents coordinate to take GitHub issues all the way to merged, documented pull requests.',
  ogImage,
  footer = true,
  smooth = true,
  nav = true,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const defaultOgImage = '/openlogo.png';
const prismLanguages = ['bash', 'javascript', 'typescript', 'python', 'rust', 'yaml', 'docker'];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#09090a" />
    <link rel="icon" type="image/png" href="/openlogo-dark.png" />
    <link rel="apple-touch-icon" href="/openlogo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400..600&display=swap"
    />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('of-js');
        var theme;
        try { theme = localStorage.getItem('of-theme'); } catch (e) {}
        // Dark is the default; a visitor's own choice from the toggle wins.
        if (theme !== 'light' && theme !== 'dark') theme = 'dark';
        root.setAttribute('data-theme', theme);
      })();
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
    {prismLanguages.map((lang) => (
      <script src={`https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-${lang}.min.js`} crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
    ))}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OpenFlows" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage || defaultOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@openflows" />
    <meta name="twitter:creator" content="@openflows" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage || defaultOgImage} />
  </head>
  <body data-smooth={smooth ? 'on' : 'off'}>
    <a class="of-skip" href="#main-content">Skip to content</a>
    {nav && <Navbar />}
    <div id="main-content">
      <slot />
    </div>
    {footer && <SiteFooter />}

    <script is:inline>
      window.addEventListener('load', function () {
        if (typeof Prism !== 'undefined') Prism.highlightAll();
      });
    </script>

    <script>
      import Lenis from 'lenis';

      // Smooth, inertial scrolling (skipped for reduced motion and for pages
      // that manage their own scroll containers, like the docs).
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReduced && document.body.dataset.smooth === 'on') {
        const lenis = new Lenis({ duration: 1.15, easing: (t) => 1 - Math.pow(1 - t, 4), anchors: { offset: -80 } });
        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
        (window as any).__lenis = lenis;
        document.documentElement.style.scrollBehavior = 'auto';
      }

      // Gentle parallax: [data-parallax="0.08"] drifts against the scroll.
      const parallax = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
      if (!prefersReduced && parallax.length) {
        const tick = () => {
          const vh = window.innerHeight;
          parallax.forEach((el) => {
            const rect = el.getBoundingClientRect();
            if (rect.bottom < -200 || rect.top > vh + 200) return;
            const speed = Number(el.dataset.parallax) || 0.08;
            const offset = (rect.top + rect.height / 2 - vh / 2) * -speed;
            el.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
          });
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      // Split headings into masked words that rise in when visible.
      const splitHeads = [...document.querySelectorAll<HTMLElement>('[data-split]')];
      splitHeads.forEach((el) => {
        let wi = 0;
        const wrap = (node: Node) => {
          [...node.childNodes].forEach((child) => {
            if (child.nodeType === Node.TEXT_NODE) {
              const frag = document.createDocumentFragment();
              (child.textContent ?? '').split(/(\s+)/).forEach((part) => {
                if (!part) return;
                if (/^\s+$/.test(part)) { frag.append(part); return; }
                const outer = document.createElement('span');
                outer.className = 'sw';
                const inner = document.createElement('span');
                inner.textContent = part;
                inner.style.setProperty('--wi', String(wi++));
                outer.append(inner);
                frag.append(outer);
              });
              child.replaceWith(frag);
            } else if (child.nodeType === Node.ELEMENT_NODE && (child as Element).tagName !== 'BR') {
              wrap(child);
            }
          });
        };
        wrap(el);
      });
      if ('IntersectionObserver' in window) {
        const splitObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-split');
              splitObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.2, rootMargin: '0px 0px -6% 0px' });
        splitHeads.forEach((el) => splitObserver.observe(el));
      } else {
        splitHeads.forEach((el) => el.classList.add('is-split'));
      }

      // Scroll reveal: [data-reveal] elements fade up once they enter the viewport.
      // Children of [data-reveal-group] get a staggered delay.
      const groups = document.querySelectorAll<HTMLElement>('[data-reveal-group]');
      groups.forEach((group) => {
        group.querySelectorAll<HTMLElement>(':scope > [data-reveal]').forEach((el, i) => {
          el.style.setProperty('--reveal-i', String(i));
        });
      });

      const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        revealables.forEach((el) => observer.observe(el));
      } else {
        revealables.forEach((el) => el.classList.add('is-revealed'));
      }

      // Scroll-linked word reveal: wrap each word of [data-words] and light it
      // up as the block moves through the viewport.
      const wordBlocks = [...document.querySelectorAll<HTMLElement>('[data-words]')];
      wordBlocks.forEach((block) => {
        const walk = (node: Node) => {
          [...node.childNodes].forEach((child) => {
            if (child.nodeType === Node.TEXT_NODE) {
              const frag = document.createDocumentFragment();
              (child.textContent ?? '').split(/(\s+)/).forEach((part) => {
                if (!part) return;
                if (/^\s+$/.test(part)) frag.append(part);
                else {
                  const span = document.createElement('span');
                  span.className = 'w';
                  span.textContent = part;
                  frag.append(span);
                }
              });
              child.replaceWith(frag);
            } else if (child.nodeType === Node.ELEMENT_NODE) {
              walk(child);
            }
          });
        };
        walk(block);
      });

      let wordTick = false;
      const updateWords = () => {
        wordTick = false;
        const vh = window.innerHeight;
        wordBlocks.forEach((block) => {
          const rect = block.getBoundingClientRect();
          const progress = Math.min(1, Math.max(0, (vh * 0.85 - rect.top) / (rect.height + vh * 0.35)));
          const words = block.querySelectorAll('.w');
          const lit = Math.round(progress * words.length);
          words.forEach((w, i) => w.classList.toggle('on', i < lit));
        });
      };
      if (wordBlocks.length) {
        updateWords();
        window.addEventListener('scroll', () => {
          if (!wordTick) {
            wordTick = true;
            requestAnimationFrame(updateWords);
          }
        }, { passive: true });
      }

      // Count-up numbers: <span data-count="16">
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      const countObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          countObserver.unobserve(el);
          const end = Number(el.dataset.count);
          if (Number.isNaN(end) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          const start = performance.now();
          const step = (now: number) => {
            const t = Math.min(1, (now - start) / 1400);
            el.textContent = String(Math.round(end * (1 - Math.pow(1 - t, 4))));
            if (t < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        });
      }, { threshold: 0.6 });
      counters.forEach((el) => countObserver.observe(el));

      // Cursor spotlight on cards.
      document.addEventListener('pointermove', (event) => {
        const target = (event.target as HTMLElement | null)?.closest<HTMLElement>('.of-spotlight');
        if (!target) return;
        const rect = target.getBoundingClientRect();
        target.style.setProperty('--mx', `${event.clientX - rect.left}px`);
        target.style.setProperty('--my', `${event.clientY - rect.top}px`);
      }, { passive: true });

      // Copy-to-clipboard buttons: <button class="of-copy" data-copy="...">
      document.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-copy]');
        if (!button) return;
        navigator.clipboard?.writeText(button.dataset.copy ?? '').then(() => {
          button.classList.add('is-copied');
          setTimeout(() => button.classList.remove('is-copied'), 1600);
        });
      });
    </script>
  </body>
</html>
