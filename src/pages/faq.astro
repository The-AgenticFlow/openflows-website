---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PixelField from '@/components/site/PixelField.astro';
import FaqList from '@/components/site/FaqList.astro';
import { FAQ_GROUPS } from '@/data/faq';

const total = FAQ_GROUPS.reduce((n, g) => n + g.items.length, 0);
---

<BaseLayout title="FAQ · OpenFlows" description="Answers to common questions about OpenFlows: how it works with Coder, models and data, security, operations and getting help.">
  <main>
    <section class="of-page-hero of-dark">
      <PixelField cell={30} density={0.06} />
      <div class="of-container">
        <span class="of-eyebrow fade-up">FAQ</span>
        <h1 class="of-lines"><span><span style="--l:0">Questions, answered.</span></span></h1>
        <p class="of-lede fade-up" style="animation-delay:250ms">How OpenFlows works with Coder, what happens to your code and keys, and what to do when something goes wrong.</p>
        <label class="faq-search fade-up" style="animation-delay:350ms">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          <input id="faq-filter" type="search" placeholder={`Filter ${total} questions…`} autocomplete="off" aria-label="Filter questions" />
        </label>
      </div>
    </section>

    <section class="of-section">
      <div class="of-container faq-layout">
        <nav class="faq-nav" aria-label="FAQ topics">
          <p class="faq-nav-label">Topics</p>
          <ul>
            {FAQ_GROUPS.map((g, i) => (
              <li><a href={`#${g.id}-group`} class={i === 0 ? 'is-active' : ''} data-faq-nav={g.id}>{g.title}<span>{g.items.length}</span></a></li>
            ))}
          </ul>
        </nav>

        <div class="faq-groups">
          {FAQ_GROUPS.map((g) => (
            <section class="faq-group" id={`${g.id}-group`} data-faq-group={g.id} data-reveal>
              <h2>{g.title}</h2>
              <FaqList items={g.items} />
            </section>
          ))}
          <p class="faq-none" id="faq-none" hidden>No questions match. Try another word, or <a href="https://github.com/The-AgenticFlow/OpenFlows/discussions" target="_blank" rel="noopener noreferrer">ask on GitHub Discussions</a>.</p>

          <div class="faq-more of-card" data-reveal>
            <div>
              <h2>Still have a question?</h2>
              <p>The maintainers answer on Discord and GitHub Discussions, usually the same day.</p>
            </div>
            <div class="of-actions">
              <a href="https://discord.gg/gDhK2RQZpY" target="_blank" rel="noopener noreferrer" class="of-btn of-btn-primary"><span class="of-sq"></span>Ask on Discord</a>
              <a href="/resources#contact" class="of-btn of-btn-ghost">Contact the team</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const input = document.getElementById('faq-filter') as HTMLInputElement | null;
  const items = [...document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-faq-group]')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-faq-nav]')];
  const none = document.getElementById('faq-none');

  // Filter: hide questions that do not contain every word typed.
  input?.addEventListener('input', () => {
    const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    items.forEach((item) => {
      const match = terms.every((t) => (item.dataset.faqText ?? '').includes(t));
      item.hidden = !match;
    });
    // With only a few matches left, open them so the answer is visible straight away.
    const visible = items.filter((i) => !i.hidden);
    if (terms.length && visible.length <= 3) visible.forEach((i) => (i.open = true));
    groups.forEach((g) => (g.hidden = !g.querySelector('[data-faq-item]:not([hidden])')));
    if (none) none.hidden = items.some((i) => !i.hidden);
  });

  // A link to #question-id opens that answer.
  const openFromHash = () => {
    const target = document.getElementById(location.hash.slice(1));
    if (target instanceof HTMLDetailsElement) {
      target.open = true;
      target.scrollIntoView({ block: 'start' });
    }
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  // Highlight the topic in view.
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((l) => l.classList.toggle('is-active', l.dataset.faqNav === (e.target as HTMLElement).dataset.faqGroup));
      });
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  groups.forEach((g) => observer.observe(g));
</script>

<style>
  .faq-search {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    max-width: 520px;
    margin-top: 2rem;
    padding: 0 1.1rem;
    height: 52px;
    border-radius: 999px;
    border: 1px solid var(--of-line-strong);
    background: color-mix(in srgb, var(--of-text) 4%, transparent);
    transition: border-color 0.2s, background 0.2s;
  }
  .faq-search:focus-within { border-color: var(--of-text-2); background: color-mix(in srgb, var(--of-text) 7%, transparent); }
  .faq-search svg { width: 18px; height: 18px; color: var(--of-text-3); flex-shrink: 0; }
  .faq-search input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; color: var(--of-text); font: inherit; font-size: 1rem; }
  .faq-search input::placeholder { color: var(--of-text-3); }

  .faq-layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: clamp(2rem, 6vw, 5.5rem); align-items: start; }

  .faq-nav { position: sticky; top: calc(var(--nav-height) + 2rem); }
  .faq-nav-label { margin-bottom: 0.9rem; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--of-text-3); }
  .faq-nav ul { display: grid; gap: 0.15rem; border-left: 1px solid var(--of-line); }
  .faq-nav a { display: flex; justify-content: space-between; gap: 1rem; margin-left: -1px; padding: 0.45rem 0 0.45rem 1rem; border-left: 1px solid transparent; font-size: 0.9rem; color: var(--of-text-3); transition: color 0.2s, border-color 0.2s; }
  .faq-nav a span { font-family: var(--font-mono); font-size: 0.72rem; }
  .faq-nav a:hover { color: var(--of-text-2); }
  .faq-nav a.is-active { color: var(--of-text); border-left-color: var(--of-text); }

  .faq-groups { display: grid; gap: clamp(3rem, 6vw, 4.5rem); max-width: 820px; }
  .faq-group { scroll-margin-top: calc(var(--nav-height) + 24px); }
  .faq-group[hidden] { display: none; }
  .faq-group h2 { margin-bottom: 1rem; font-size: 1.35rem; font-weight: 500; letter-spacing: -0.03em; }

  .faq-none { color: var(--of-text-2); }
  .faq-none a { color: var(--of-text); text-decoration: underline; text-underline-offset: 3px; }

  .faq-more { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; padding: clamp(1.5rem, 3vw, 2.2rem); }
  .faq-more h2 { font-size: 1.3rem; font-weight: 500; letter-spacing: -0.03em; }
  .faq-more p { margin-top: 0.35rem; color: var(--of-text-2); font-size: 0.95rem; }
  .faq-more .of-actions { margin: 0; }

  @media (max-width: 900px) {
    .faq-layout { grid-template-columns: 1fr; }
    .faq-nav { position: static; }
    .faq-nav ul { display: flex; flex-wrap: wrap; gap: 0.4rem; border: 0; }
    .faq-nav a { margin: 0; padding: 0.35rem 0.8rem; border: 1px solid var(--of-line); border-radius: 999px; }
    .faq-nav a.is-active { border-color: var(--of-text); }
  }
</style>
