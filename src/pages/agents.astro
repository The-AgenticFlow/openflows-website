---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { AGENT_DATA } from '../data/agents.js';

const agents = Object.entries(AGENT_DATA);
---

<BaseLayout title="Agents | OpenFlows" description="Meet the five specialized AI agents that power the OpenFlows pipeline.">
  <Navbar />
  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <p class="eyebrow">The Team</p>
        <h1 class="title">Five agents. One pipeline.<br/> Zero manual steps.</h1>
        <p class="subtitle">
          OpenFlows coordinates five specialized AI agents through a deterministic, event-driven
          pipeline. Each agent has a distinct role, isolated permissions, and its own GitHub identity -
          just like a real development team.
        </p>
      </div>
    </section>

    <!-- Agent Grid -->
    <section class="gridSection">
      <div class="container">
        <h2 class="sectionHeading">Meet the Team</h2>
        <div class="agentGrid">
          {agents.map(([id, data]) => (
            <a href={`/agents/${id}`} class="agentCard">
              <div class="agentContent">
                <p class="agentRole">{data.role}</p>
                <h3 class="agentName">{data.name}</h3>
                <p class="agentMission">{data.mission.slice(0, 120)}...</p>
                <span class="learnMore">Explore {data.name} &rsaquo;</span>
              </div>
              <div class="agentImageWrap">
                <img src={data.image} alt={data.name} class="agentImage" />
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .hero {
    padding-top: calc(var(--nav-height) + var(--space-20));
    padding-bottom: var(--space-32);
    background-color: var(--color-bg);
    text-align: center;
  }

  .container {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .eyebrow {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .title {
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-10);
    line-height: 1.1;
  }

  .subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 800px;
    margin-inline: auto;
    line-height: 1.8;
  }

  .sectionHeading {
    font-size: var(--font-size-3xl);
    font-weight: 500;
    margin-bottom: var(--space-4);
  }

  /* Agent Grid */
  .gridSection {
    padding-block: var(--space-128);
  }

  .agentGrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    margin-top: var(--space-12);
  }

  .agentCard {
    display: grid;
    grid-template-columns: 1fr 180px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .agentCard:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-2px);
  }

  .agentContent {
    padding: var(--space-12);
    display: flex;
    flex-direction: column;
  }

  .agentRole {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .agentName {
    font-size: var(--font-size-xl);
    font-weight: 500;
    margin-bottom: var(--space-3);
  }

  .agentMission {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-8);
    flex: 1;
  }

  .learnMore {
    font-size: var(--font-size-sm);
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .agentImageWrap {
    width: 100%;
    height: 100%;
  }

  .agentImage {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.5);
    transition: filter 0.3s ease;
  }

  .agentCard:hover .agentImage {
    filter: grayscale(0);
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: calc(var(--nav-height) + var(--space-16));
      padding-bottom: var(--space-32);
    }

    .subtitle {
      font-size: var(--font-size-base);
    }

    .gridSection {
      padding-block: var(--space-64);
    }
  }

  @media (max-width: 800px) {
    .agentGrid {
      grid-template-columns: 1fr;
    }

    .agentCard {
      grid-template-columns: 1fr;
    }

    .agentImageWrap {
      height: 200px;
    }

    .agentContent {
      padding: var(--space-8);
    }

    .agentName {
      font-size: var(--font-size-lg);
    }

    .sectionHeading {
      font-size: var(--font-size-2xl);
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding-top: calc(var(--nav-height) + var(--space-8));
      padding-bottom: var(--space-20);
    }

    .container {
      padding-inline: var(--space-4);
    }
  }
</style>
