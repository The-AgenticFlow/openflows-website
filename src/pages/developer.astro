---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { supabase, isSupabaseConfigured, TABLES } from '../lib/supabase.js';

let posts = [];
let error = null;

if (isSupabaseConfigured() && supabase) {
  try {
    const { data, error: fetchError } = await supabase
      .from(TABLES.BLOGS)
      .select(`
        id,
        title,
        slug,
        excerpt,
        cover_image_url,
        published_at,
        created_at,
        view_count,
        is_featured,
        author_name,
        author_avatar_url,
        authors,
        category:blog_categories(name, slug)
      `)
      .eq('status', 'published')
      .eq('blog_categories.slug', 'developer')
      .is('deleted_at', null)
      .order('published_at', { ascending: false });

    if (fetchError) throw fetchError;
    posts = data || [];
  } catch (err) {
    error = err.message;
    console.error('Error fetching developer posts:', err);
  }
}

const formatDate = (dateString) => {
  if (!dateString) return '';
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};

const getResolvedAuthors = (post) => {
  if (post.authors && post.authors.length > 0) {
    return post.authors;
  }
  if (post.author_name) {
    return [{ name: post.author_name, avatar_url: post.author_avatar_url }];
  }
  return [];
};
---

<BaseLayout title="Developer | OpenFlows" description="Articles and guides for developers on OpenFlows.">
  <Navbar />
  <main>
    <div class="developerWrapper">
      <div class="developerLayout">
        <main class="mainFeed">
          <!-- Header -->
          <header class="developerHeader">
            <div class="headerContent">
              <p class="eyebrow">Developer</p>
              <h1 class="title">Articles & Guides for Developers</h1>
              <p class="sub">
                Technical deep dives, API guides, integration tutorials, and SDK documentation from the OpenFlows team.
              </p>
            </div>
          </header>

          <!-- Content Feed -->
          {error ? (
            <div class="error">
              <p>Failed to load articles. Please try again later.</p>
            </div>
          ) : posts.length === 0 ? (
            <div class="emptyState">
              <p class="emptyTitle">No developer articles yet.</p>
              <p class="emptyText">Check back soon for technical guides and tutorials.</p>
            </div>
          ) : (
            <div class="postsGrid">
              {posts.map((post) => {
                const resolvedAuthors = getResolvedAuthors(post);
                return (
                  <a href={`/blog/${post.slug}`} class="postCard">
                    {post.cover_image_url && (
                      <div class="postImage">
                        <img src={post.cover_image_url} alt={post.title} />
                      </div>
                    )}
                    <div class="postContent">
                      <div class="postMeta">
                        {post.category && (
                          <span class="postCategory">{post.category.name}</span>
                        )}
                        <span class="postDate">
                          {formatDate(post.published_at || post.created_at)}
                        </span>
                      </div>
                      <h2 class="postTitle">{post.title}</h2>
                      <p class="postExcerpt">{post.excerpt}</p>
                      <div class="postFooter">
                        <span class="readMore">Read more &rarr;</span>
                        {resolvedAuthors.length > 0 && (() => {
                          const author = resolvedAuthors[0];
                          return (
                            <div class="postAuthor">
                              {author.avatar_url ? (
                                <img src={author.avatar_url} alt={author.name} class="postAuthorAvatar" />
                              ) : (
                                <div class="postAuthorAvatarPlaceholder">{author.name?.charAt(0).toUpperCase()}</div>
                              )}
                              <span class="postAuthorName">{author.name}</span>
                            </div>
                          );
                        })()}
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          )}
        </main>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .developerWrapper {
    background-color: var(--color-bg);
    min-height: 100vh;
    padding-top: var(--nav-height);
  }

  .developerLayout {
    display: grid;
    grid-template-columns: 1fr;
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--space-16) var(--space-6);
  }

  .mainFeed {
    width: 100%;
  }

  .developerHeader {
    margin-bottom: 4rem;
  }

  .headerContent {
    flex: 1;
  }

  .eyebrow {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .title {
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .sub {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    max-width: 520px;
    line-height: 1.7;
  }

  /* Posts Grid */
  .postsGrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  .postCard {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .postCard:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
  }

  .postImage {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .postImage img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .postCard:hover .postImage img {
    transform: scale(1.08);
  }

  .postContent {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .postMeta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
  }

  .postCategory {
    padding: 0.2rem 0.5rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text-secondary);
    font-weight: 600;
    text-transform: uppercase;
  }

  .postDate {
    color: var(--color-text-muted);
  }

  .postTitle {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .postExcerpt {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .postFooter {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }

  .readMore {
    font-size: 0.875rem;
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .postAuthor {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .postAuthorAvatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
  }

  .postAuthorAvatarPlaceholder {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-surface-2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .postAuthorName {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  /* Error */
  .error {
    padding: 4rem;
    text-align: center;
    color: var(--color-text-secondary);
  }

  /* Empty state */
  .emptyState {
    text-align: center;
    padding: var(--space-20) 0;
  }

  .emptyTitle {
    font-size: var(--font-size-xl);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .emptyText {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .postsGrid {
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    }
  }

  @media (max-width: 600px) {
    .developerLayout {
      padding: var(--space-8) var(--space-4);
    }

    .postsGrid {
      grid-template-columns: 1fr;
    }

    .postContent {
      padding: 1rem;
    }

    .postTitle {
      font-size: 1.1rem;
    }

    .postExcerpt {
      font-size: 0.875rem;
    }
  }
</style>
