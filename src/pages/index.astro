</BaseLayout>

<script>
  // Crew: hover, focus or click an agent to expand its panel.
  const crew = document.getElementById('crew');
  if (crew) {
    const members = [...crew.querySelectorAll<HTMLElement>('[data-member]')];
    const open = (m: HTMLElement) => members.forEach((x) => {
      const on = x === m;
      x.classList.toggle('is-open', on);
      x.setAttribute('aria-expanded', String(on));
    });
    const canHover = window.matchMedia('(hover: hover) and (min-width: 1001px)');
    members.forEach((m) => {
      m.addEventListener('mouseenter', () => { if (canHover.matches) open(m); });
      m.addEventListener('focus', () => open(m));
      m.addEventListener('click', () => open(m));
    });
  }

  // Console tour: tabs swap the real Console screen, and advance on their own
  // until the visitor picks one.
  const tour = document.getElementById('console-tour');
  if (tour) {
    const tabs = [...tour.querySelectorAll<HTMLButtonElement>('[data-console-tab]')];
    const screens = [...tour.querySelectorAll<HTMLElement>('[data-console-screen]')];
    let index = 0;
    let timer = 0;
    const show = (i: number) => {
      index = (i + tabs.length) % tabs.length;
      tabs.forEach((t, k) => t.setAttribute('aria-selected', String(k === index)));
      screens.forEach((sc, k) => sc.classList.toggle('is-active', k === index));
    };
    const auto = () => { timer = window.setInterval(() => show(index + 1), 4500); };
    tabs.forEach((t, k) => t.addEventListener('click', () => { window.clearInterval(timer); show(k); }));
    new IntersectionObserver(([e]) => {
      window.clearInterval(timer);
      if (e.isIntersecting && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) auto();
    }, { threshold: 0.3 }).observe(tour);
  }

  // Scroll tunnel: a corridor whose four walls are lined with screens. Scrolling
  // flies the camera forward one short hop per stage.
  const tunnel = document.getElementById('tunnel');
  const tunnelOn = () => tunnel && getComputedStyle(tunnel).display !== 'none';
  if (tunnel) {
    const sticky = tunnel.querySelector<HTMLElement>('.tunnel-sticky')!;
    const tiles = [...tunnel.querySelectorAll<HTMLElement>('[data-tile]')];
    const huds = [...tunnel.querySelectorAll<HTMLElement>('[data-hud]')];
    const steps = [...tunnel.querySelectorAll<HTMLElement>('[data-hud-step]')];
    const hudIndex = document.getElementById('hud-index');
    const hudBar = document.getElementById('hud-bar');
    const N = huds.length;
    const SEGMENTS = tiles.length / 8;
    let W = 0, H = 0, D = 0;
    let current = -1;
    let smooth = 0;
    let target = 0;

    // Each segment of the corridor is a ring of 8 tiles: two per wall.
    const layout = () => {
      W = sticky.clientWidth;
      H = sticky.clientHeight;
      D = Math.round(H * 0.85);
      tiles.forEach((tile, k) => {
        const side = k % 8;
        const wall = side >> 1;
        const half = side & 1;
        const vertical = wall < 2;
        tile.style.width = `${vertical ? D : W / 2}px`;
        tile.style.height = `${vertical ? H / 2 : D}px`;
        tile.dataset.wall = String(wall);
        tile.dataset.half = String(half);
      });
    };
    layout();
    window.addEventListener('resize', layout);

    // Pause briefly on every stage, then glide to the next.
    const settle = (f: number) => {
      const i = Math.floor(f);
      const t = Math.min(1, Math.max(0, (f - i - 0.15) / 0.7));
      return i + t * t * (3 - 2 * t);
    };

    const measure = () => {
      const rect = tunnel.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const raw = Math.min(1, Math.max(0, -rect.top / total));
      target = settle(raw * (N - 1) * 0.9999);
    };

    const render = () => {
      if (!tunnelOn()) { requestAnimationFrame(render); return; }
      measure();
      smooth += (target - smooth) * 0.1;
      const p = smooth;
      // Two segments per stage, offset half a segment so a ring of tiles always
      // starts exactly at the screen edge when the camera rests on a stage.
      const cam = (p * 2 + 0.5) * D;
      const span = SEGMENTS * D;
      const a = W / 2, b = H / 2;

      tiles.forEach((tile, k) => {
        const seg = Math.floor(k / 8);
        const wall = Number(tile.dataset.wall);
        const half = Number(tile.dataset.half);
        // Depth of the segment's centre, wrapped so tiles recycle to the far end.
        const zc = -(((seg * D - cam) % span + span) % span);
        let t = '';
        if (wall === 0) t = `translate3d(${-a}px, ${-b + (half + 0.5) * b}px, ${zc}px) rotateY(90deg)`;
        else if (wall === 1) t = `translate3d(${a}px, ${-b + (half + 0.5) * b}px, ${zc}px) rotateY(-90deg)`;
        else if (wall === 2) t = `translate3d(${-a + (half + 0.5) * a}px, ${-b}px, ${zc}px) rotateX(-90deg)`;
        else t = `translate3d(${-a + (half + 0.5) * a}px, ${b}px, ${zc}px) rotateX(90deg)`;
        tile.style.transform = `translate(-50%, -50%) ${t}`;
        const far = -zc / (span - D);
        const near = Math.min(1, (-zc - D * 0.25) / (D * 0.25));
        tile.style.visibility = zc > -D * 0.3 ? 'hidden' : '';
        tile.style.opacity = Math.max(0, Math.min(near, 1 - far * far)).toFixed(3);
      });

      const active = Math.min(N - 1, Math.max(0, Math.round(p)));
      if (active !== current) {
        current = active;
        huds.forEach((h, i) => h.classList.toggle('is-active', i === active));
        steps.forEach((s, i) => {
          s.classList.toggle('is-active', i === active);
          s.classList.toggle('is-done', i < active);
        });
        if (hudIndex) hudIndex.textContent = String(active + 1).padStart(2, '0');
      }
      if (hudBar) hudBar.style.transform = `scaleX(${(p / (N - 1)).toFixed(4)})`;
      requestAnimationFrame(render);
    };
    requestAnimationFrame(render);

    steps.forEach((step, i) => step.addEventListener('click', () => {
      const rect = tunnel.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const y = window.scrollY + rect.top + (i / (N - 1)) * total;
      const lenis = (window as any).__lenis;
      lenis ? lenis.scrollTo(y, { duration: 1.2 }) : window.scrollTo({ top: y, behavior: 'smooth' });
    }));
  }

  // How it works: auto-advancing stage player. Pauses when hovered or off screen.
  const flow = document.getElementById('flow');
  if (flow) {
    const tabs = [...flow.querySelectorAll<HTMLButtonElement>('[data-flow-tab]')];
    const panels = [...flow.querySelectorAll<HTMLElement>('[data-flow-panel]')];
    const DURATION = 6000;
    let index = 0;
    let timer = 0;
    let started = 0;
    let remaining = DURATION;
    let inView = false;
    let hovering = false;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const show = (next: number) => {
      index = (next + panels.length) % panels.length;
      tabs.forEach((t, i) => {
        t.setAttribute('aria-selected', String(i === index));
        t.classList.toggle('is-done', i < index);
      });
      panels.forEach((p, i) => p.classList.toggle('is-active', i === index));
      const list = tabs[index].closest('ol');
      if (list && list.scrollWidth > list.clientWidth) {
        list.scrollTo({ left: (tabs[index].parentElement as HTMLElement).offsetLeft - 16, behavior: 'smooth' });
      }
      remaining = DURATION;
      flow.style.setProperty('--flow-dur', `${DURATION}ms`);
      restartBar();
      schedule();
    };

    const restartBar = () => {
      const bar = tabs[index]?.querySelector<HTMLElement>('.flow-bar i');
      tabs.forEach((t) => t.querySelector<HTMLElement>('.flow-bar i')?.classList.remove('run'));
      if (!bar) return;
      void bar.offsetWidth;
      bar.classList.add('run');
      bar.style.animationPlayState = playing() ? 'running' : 'paused';
    };

    const playing = () => inView && !hovering && !reduceMotion;

    const schedule = () => {
      clearTimeout(timer);
      if (!playing()) return;
      started = performance.now();
      timer = window.setTimeout(() => show(index + 1), remaining);
    };

    const pause = () => {
      if (timer) remaining -= performance.now() - started;
      clearTimeout(timer);
      timer = 0;
      const bar = tabs[index]?.querySelector<HTMLElement>('.flow-bar i');
      if (bar) bar.style.animationPlayState = 'paused';
    };

    const resume = () => {
      const bar = tabs[index]?.querySelector<HTMLElement>('.flow-bar i');
      if (bar) bar.style.animationPlayState = 'running';
      schedule();
    };

    tabs.forEach((t, i) => t.addEventListener('click', () => show(i)));
    flow.addEventListener('pointerenter', () => { hovering = true; pause(); });
    flow.addEventListener('pointerleave', () => { hovering = false; if (inView) resume(); });
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      if (inView && !hovering) resume(); else pause();
    }, { threshold: 0.35 }).observe(flow);
    flow.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); tabs[index].focus(); }
      if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); tabs[index].focus(); }
    });
    show(0);
  }

  // Product console tilts up and grows to full size as it scrolls into view.
  const scalers = [...document.querySelectorAll<HTMLElement>('[data-scroll-scale]')];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let ticking = false;
  const updateScale = () => {
    ticking = false;
    const vh = window.innerHeight;
    scalers.forEach((el) => {
      const rect = el.getBoundingClientRect();
      const t = Math.min(1, Math.max(0, (vh - rect.top) / (vh * 0.75)));
      const eased = 1 - Math.pow(1 - t, 3);
      el.style.transform = `perspective(1600px) rotateX(${(1 - eased) * 14}deg) scale(${0.9 + eased * 0.1})`;
      el.style.opacity = String(0.4 + eased * 0.6);
    });
  };
  if (!reduce && scalers.length) {
    updateScale();
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateScale);
      }
    }, { passive: true });
  }

</script>

<style>
  /* ── Hero ── */
  .hero-wrap { padding-top: calc(var(--nav-height) + 4px); }

  .hero {
    min-height: min(860px, calc(100svh - var(--nav-height) - 12px));
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .hero :global(.of-pixels) { z-index: -2; }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, #0b0b0c 0%, rgba(11, 11, 12, 0.85) 40%, rgba(11, 11, 12, 0.1) 100%),
      linear-gradient(0deg, #0b0b0c 0%, transparent 35%);
    pointer-events: none;
  }

  .hero-inner { padding-top: clamp(4rem, 9vw, 7rem); padding-bottom: clamp(3rem, 6vw, 4.5rem); }

  .hero-title {
    margin-top: 1.75rem;
    font-size: var(--font-size-hero);
    line-height: 0.98;
    letter-spacing: -0.055em;
    font-weight: 500;
  }

  .hero-sub { max-width: 560px; margin-top: 1.75rem; font-size: clamp(1.05rem, 1.5vw, 1.2rem); line-height: 1.6; color: var(--of-text-2); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.25rem; }
  .hero-command { margin-top: 1.25rem; max-width: 100%; }

  .hero-strip {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem clamp(1rem, 4vw, 2.25rem);
    border-top: 1px solid var(--of-line);
    background: rgba(255, 255, 255, 0.02);
    font-size: 0.9rem;
    color: var(--of-text);
    transition: background 0.3s;
  }

  .hero-strip:hover { background: rgba(255, 255, 255, 0.05); }
  .hero-strip svg { width: 15px; height: 15px; flex-shrink: 0; transition: transform 0.3s var(--ease-out); }
  .hero-strip:hover svg { transform: translateX(4px); }
  .strip-meta { margin-left: auto; font-family: var(--font-mono); font-size: 0.72rem; color: var(--of-text-3); white-space: nowrap; }

  /* ── Logos ── */
  .logos { padding: clamp(3.5rem, 7vw, 5rem) 0 clamp(3rem, 5vw, 4rem); }
  .logos-label { text-align: center; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--of-text-3); margin-bottom: 2.75rem; }
  .logo-row { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 2.5rem clamp(3rem, 7vw, 6.5rem); }
  .logo { position: relative; display: flex; align-items: center; justify-content: center; height: 64px; opacity: 0.6; transition: opacity 0.4s var(--ease-out); }
  .logo:hover { opacity: 1; }
  .logo img { width: auto; max-width: 220px; object-fit: contain; transition: transform 0.5s var(--ease-out); }
  .logo:hover img { transform: translateY(-6px) scale(1.04); }
  .logo-name {
    position: absolute;
    left: 50%;
    top: calc(100% + 0.35rem);
    transform: translate(-50%, -4px);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--of-text-2);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s var(--ease-out), transform 0.45s var(--ease-out);
  }
  .logo:hover .logo-name { opacity: 1; transform: translate(-50%, 0); }
  :global([data-theme='dark']) .logo img { filter: invert(1); }

  /* ── Product (feature rows) ── */
  .product { padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(3rem, 6vw, 4rem); }
  .product-head { text-align: center; margin-bottom: clamp(3.5rem, 8vw, 6rem); }
  .product-head h2 { font-size: clamp(2rem, 4vw, 3.2rem); letter-spacing: -0.05em; line-height: 1.02; }
  .product-head p { max-width: 520px; margin: 1.25rem auto 0; color: var(--of-text-2); font-size: 1.05rem; line-height: 1.6; }

  .feature { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; margin-bottom: clamp(3.5rem, 7vw, 5.5rem); }
  .feature.is-flipped .feature-copy { order: 2; }
  .feature-copy h3 { font-size: clamp(1.6rem, 2.6vw, 2.15rem); letter-spacing: -0.04em; }
  .feature-copy p { margin: 0.9rem 0 1.5rem; max-width: 46ch; color: var(--of-text-2); line-height: 1.65; }

  .feature-wide { grid-template-columns: 1fr; gap: 2rem; }
  .feature-wide .feature-copy { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 4rem; align-items: end; }
  .feature-wide .feature-copy p { margin: 0; }
  .feature-wide .feature-copy a { grid-column: 2; justify-self: start; }

  /* Monochrome light-streak frame, the product shot bleeds off its edge */
  .shot {
    position: relative;
    aspect-ratio: 1.12;
    border-radius: 20px;
    overflow: hidden;
    isolation: isolate;
    background: #0d0d0f;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
  }

  .shot-light {
    position: absolute;
    inset: -30%;
    z-index: -1;
    background:
      linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.28) 42%, rgba(255, 255, 255, 0.05) 50%, transparent 58%),
      linear-gradient(115deg, transparent 52%, rgba(255, 255, 255, 0.14) 60%, transparent 68%),
      radial-gradient(50% 40% at 15% 95%, rgba(255, 255, 255, 0.12), transparent 70%);
    filter: blur(18px);
    animation: shotLight 16s ease-in-out infinite alternate;
  }

  @keyframes shotLight {
    from { transform: translateX(-6%) rotate(0deg); }
    to { transform: translateX(6%) rotate(6deg); }
  }

  .shot-img {
    position: absolute;
    left: 9%;
    top: 11%;
    width: 112%;
    max-width: none;
    border-radius: 12px 0 0 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }

  .shot-card { position: absolute; left: 9%; top: 13%; width: 100%; border-radius: 12px 0 0 12px; }
  .shot-code { margin: 0; padding: 1.25rem 1.4rem 1.5rem; font-family: var(--font-mono); font-size: 0.78rem; line-height: 1.85; color: #c8c9ce; white-space: pre; }

  .shot-wide { aspect-ratio: auto; padding: clamp(1.5rem, 4vw, 3.5rem) clamp(1rem, 4vw, 3.5rem) 0; }
  .console-tabs { position: relative; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.35rem; margin-bottom: 1.5rem; }
  .console-tabs button {
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(0, 0, 0, 0.25);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.82rem;
    cursor: pointer;
    transition: color 0.3s, background 0.3s, border-color 0.3s;
  }
  .console-tabs button:hover { color: #fff; }
  .console-tabs button[aria-selected='true'] { color: #0c0c0d; background: #fff; border-color: #fff; }
  .console-frame {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    aspect-ratio: 1440 / 900;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-bottom: 0;
    border-radius: 14px 14px 0 0;
    overflow: hidden;
    background: #0b0b0c;
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.45);
    transform-origin: 50% 0;
    will-change: transform;
  }
  .console-screen { position: absolute; inset: 0; margin: 0; opacity: 0; transform: scale(1.015); transition: opacity 0.6s var(--ease-out), transform 0.9s var(--ease-out); }
  .console-screen.is-active { opacity: 1; transform: none; }
  .console-screen img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top left; }

  .brief {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--of-line-strong);
    border-bottom: 1px solid var(--of-line-strong);
  }

  .brief h3 { max-width: 26ch; font-size: clamp(1.2rem, 2vw, 1.5rem); letter-spacing: -0.03em; margin-bottom: 1.1rem; }
  .brief img { width: 200px; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 10px; border: 1px solid var(--of-line); transition: transform 0.6s var(--ease-out); }
  .brief:hover img { transform: scale(1.04) rotate(-1deg); }

  /* ── Statement ── */
  .statement { padding: clamp(6rem, 13vw, 11rem) 0; }
  .statement-text {
    margin-top: 2rem;
    max-width: 1000px;
    font-size: clamp(2rem, 4.6vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
    font-weight: 500;
  }

  /* ── Scroll tunnel ── */
  .tunnel-wrap { position: relative; height: calc(var(--stages) * 55vh + 100vh); }

  .tunnel-sticky {
    position: sticky;
    --th: min(calc(100vh - var(--nav-height) - 96px), 720px);
    top: calc(var(--nav-height) + (100vh - var(--nav-height) - var(--th)) / 2);
    width: min(1240px, calc(100% - 48px));
    height: var(--th);
    min-height: 520px;
    margin-inline: auto;
    overflow: hidden;
    perspective: 760px;
    perspective-origin: 50% 50%;
    background: #070708;
  }

  .tunnel-scene { position: absolute; inset: 0; transform-style: preserve-3d; }
  .tunnel-world { position: absolute; left: 50%; top: 50%; width: 0; height: 0; transform-style: preserve-3d; }

  .tile {
    position: absolute;
    left: 0;
    top: 0;
    padding: 8px;
    will-change: transform, opacity;
    backface-visibility: hidden;
  }

  .tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #111113;
    filter: brightness(0.86);
  }

  .tunnel-fog {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(ellipse 36% 34% at 50% 52%, rgba(7, 7, 8, 0.94) 25%, rgba(7, 7, 8, 0.6) 62%, transparent 100%),
      radial-gradient(ellipse 90% 90% at 50% 50%, transparent 55%, rgba(7, 7, 8, 0.35) 100%),
      linear-gradient(180deg, rgba(7, 7, 8, 0.85), transparent 16%, transparent 76%, rgba(7, 7, 8, 0.9));
  }

  .tunnel-hud {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    padding: clamp(1.75rem, 3.5vw, 3rem);
    pointer-events: none;
  }

  .hud-top { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .hud-count { font-family: var(--font-mono); font-size: 0.75rem; color: var(--of-text-3); }
  .hud-count b { color: var(--of-text); font-weight: 500; }

  .hud-copy { position: relative; place-self: center; width: min(560px, 46vw); height: 280px; text-align: center; }
  .hud-stage { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .hud-stage > * { opacity: 0; transform: translateY(14px) scale(0.96); filter: blur(8px); transition: opacity 0.45s var(--ease-out), transform 0.7s var(--ease-out), filter 0.45s var(--ease-out); }
  .hud-stage.is-active > * { opacity: 1; transform: none; filter: none; }
