---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MissionControl from '@/organisms/MissionControl/MissionControl';
import PipelineExplorer from '@/organisms/PipelineExplorer/PipelineExplorer';
import UseCaseTabs from '@/organisms/UseCaseTabs/UseCaseTabs';
import FAQ from '@/organisms/FAQ/FAQ';
import CtaBanner from '@/components/site/CtaBanner.astro';
import { AGENT_SUMMARY } from '@/data/agentSummary';
import { getPublishedPosts, getPostHref, formatPostDate, getReadTime } from '@/components/blog/blog';

const posts = (await getPublishedPosts()).slice(0, 3);

const LOGOS = [
  { name: 'Adorsys', src: '/images/logo-adorsys.png' },
  { name: 'Clemios', src: '/images/logo-clemios.jpeg' },
  { name: 'Rust Cameroon', src: '/images/logo-rust-cameroon.jpeg' },
  { name: 'Rust Nigeria', src: '/images/logo-rust-nigeria.png' },
  { name: 'Rust Africa', src: '/images/logo-rust-africa.jpeg' },
];

const STATS = [
  { value: '5', unit: 'agents', label: 'Specialised roles, one governed pipeline' },
  { value: '0', unit: 'LLM keys', label: 'Inside any agent workspace' },
  { value: '~16', unit: 'min', label: 'Typical run from issue to merged PR' },
  { value: 'MIT', unit: '', label: 'Open source and self-hosted' },
];

const CODER_LAYER = [
  'Ephemeral, Terraform-defined workspaces',
  'Identity, RBAC and audit on every action',
  'AI Gateway holds the model keys',
  'Per-workspace network isolation',
];

const OPENFLOWS_LAYER = [
  'Declared flow graph and routing table',
  'Typed SharedStore state contracts',
  'Planning gate and adversarial review',
  'reconcile() recovery and human escalation',
];

const INDUSTRIES = [
  {
    title: 'Tech innovators',
    desc: 'A 24/7 agentic dev team on your Coder environment, so engineers stay on architecture instead of implementation.',
    href: '/insights/openflows-agentic-dev-team-puts-engineering-back-in-control',
    icon: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
  },
  {
    title: 'Financial services',
    desc: 'An AI delivery system either produces a defensible record or it does not. OpenFlows makes the record part of the design.',
    href: '/insights/the-auditable-agent-compliance-evidence-as-a-design-property',
    icon: '<path d="M3 21h18M5 21V10M19 21V10M9 21V10M15 21V10M12 3l9 5H3z"/>',
  },
  {
    title: 'Government & air-gapped',
    desc: 'Code, decisions, and the audit trail stay inside the agency’s own infrastructure. OpenFlows runs where you say it runs.',
    href: '/insights/the-air-gapped-agent-sensitive-work-that-never-leaves-the-network',
    icon: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><rect x="9" y="10" width="6" height="5" rx="1"/><path d="M10 10V8.5a2 2 0 0 1 4 0V10"/>',
  },
];

const SETUP_COMMAND = './scripts/setup.sh owner/repo --compose';
---

<BaseLayout
  title="OpenFlows · The autonomous AI dev team on your Coder environment"
  description="OpenFlows is an open-source AI software team that turns GitHub issues into reviewed, merged pull requests inside your self-hosted Coder environment, with a planning gate, adversarial review, and a full audit trail."
>
  <main class="home">
    <!-- ───────────── HERO ───────────── -->
    <section class="hero">
      <div class="of-grid-bg" aria-hidden="true"></div>
      <div class="hero-aurora" aria-hidden="true">
        <span class="a1"></span><span class="a2"></span><span class="a3"></span>
      </div>
      <div class="of-noise" aria-hidden="true"></div>

      <div class="of-container hero-inner">
        <a href="/blog/delegated-verification-how-sentinel-gets-forge-to-run-code-without-ever-touching-forges-workspace" class="announce fade-up">
          <span class="announce-tag">New</span>
          <span>Delegated verification over the A2A relay</span>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>

        <h1 class="hero-title fade-up" style="animation-delay:80ms">
          GitHub issues in.<br />
          <span class="of-gradient-text">Reviewed, merged PRs</span> out.
        </h1>

        <p class="hero-sub fade-up" style="animation-delay:160ms">
          OpenFlows is an autonomous AI software team that plans, codes, reviews, ships and documents
          inside your self-hosted <a href="https://coder.com" target="_blank" rel="noopener noreferrer">Coder</a> environment.
          Your engineers keep the architecture and the final say.
        </p>

        <div class="hero-cta fade-up" style="animation-delay:240ms">
          <a href="/docs/getting-started" class="of-btn of-btn-primary of-btn-lg">
            Get started
            <svg class="of-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="#demo" class="of-btn of-btn-ghost of-btn-lg">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.8v8.4L12 8z" fill="currentColor"/></svg>
            Watch the demo
          </a>
        </div>

        <div class="hero-command fade-up" style="animation-delay:320ms">
          <div class="of-command">
            <span class="of-prompt">$</span>
            <code>{SETUP_COMMAND}</code>
            <button class="of-copy" data-copy={SETUP_COMMAND} aria-label="Copy setup command">
              <svg class="of-copy-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.8"/><path d="M10.5 5V3.8A1.3 1.3 0 0 0 9.2 2.5H3.8a1.3 1.3 0 0 0-1.3 1.3v5.4a1.3 1.3 0 0 0 1.3 1.3H5"/></svg>
              <svg class="of-copied" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <span class="hero-meta">Open source · MIT · Runs on your infrastructure</span>
        </div>
      </div>

      <div class="of-container of-container-wide hero-console">
        <div class="console-glow" aria-hidden="true"></div>
        <div class="console-frame" data-reveal="scale">
          <MissionControl client:load />
        </div>
      </div>
    </section>

    <!-- ───────────── LOGOS ───────────── -->
    <section class="logos" aria-label="Supporters">
      <p class="logos-label">Built with and supported by engineering teams and communities</p>
      <div class="marquee">
        <div class="marquee-track">
          {[...LOGOS, ...LOGOS, ...LOGOS].map((logo, i) => (
            <div class="logo-tile" aria-hidden={i >= LOGOS.length ? 'true' : undefined}>
              <img src={logo.src} alt={i < LOGOS.length ? logo.name : ''} loading="lazy" />
              <span>{logo.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ───────────── STATS ───────────── -->
    <section class="of-section-tight">
      <div class="of-container">
        <div class="stats" data-reveal-group>
          {STATS.map((s) => (
            <div class="stat" data-reveal>
              <p class="stat-value">{s.value}<span>{s.unit}</span></p>
              <p class="stat-label">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ───────────── HOW IT WORKS ───────────── -->
    <section class="of-section" id="how-it-works">
      <div class="of-container">
        <div class="of-head" data-reveal>
          <span class="of-eyebrow">How it works</span>
          <h2>One ticket, six handoffs, <span class="of-muted">zero guesswork.</span></h2>
          <p>Every issue moves through the same declared flow. Each stage has an owner, a gate, and a record, so you can see exactly what happened and why.</p>
        </div>
        <div data-reveal>
          <PipelineExplorer client:visible />
        </div>
        <p class="escalate" data-reveal>
          <span class="of-dot"></span>
          You only hear from the team when it matters: security flags, ambiguous specs, or decisions that need a human.
          Escalations arrive in Slack, Discord or WhatsApp with the ticket, the reason, and a link.
        </p>
      </div>
    </section>

    <!-- ───────────── THE TEAM ───────────── -->
    <section class="of-section team-section">
      <div class="of-container">
        <div class="team-head" data-reveal>
          <div class="of-head" style="margin-bottom:0">
            <span class="of-eyebrow">The team</span>
            <h2>Five agents that work like an engineering team.</h2>
            <p>Not five copies of the same assistant. Each role has its own workspace, permissions, skills, and model, so the reviewer’s blind spots differ from the builder’s.</p>
          </div>
          <a href="/agents" class="of-btn of-btn-ghost">Meet the team <svg class="of-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>

        <div class="agents" data-reveal-group>
          {AGENT_SUMMARY.map((agent, i) => (
            <a href={`/agents/${agent.id}`} class={`agent of-card of-spotlight ${i < 2 ? 'is-wide' : ''}`} style={`--agent:${agent.color}; --spot: color-mix(in srgb, ${agent.color} 16%, transparent)`} data-reveal>
              <div class="agent-top">
                <span class="agent-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={agent.icon} />
                </span>
                <span class="agent-role">{agent.role}</span>
              </div>
              <h3>{agent.name}</h3>
              <p>{agent.tagline}</p>
              <div class="agent-tags">
                {agent.tags.map((t) => <span class="of-chip">{t}</span>)}
              </div>
              <span class="agent-more">Explore {agent.name} <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ───────────── CODER × OPENFLOWS ───────────── -->
    <section class="of-section split-section">
      <div class="of-container">
        <div class="split">
          <div class="split-copy" data-reveal>
            <span class="of-eyebrow">Built on Coder</span>
            <h2 class="of-h2">Coder governs <em>where</em> agents run. OpenFlows governs <em>how</em> they coordinate.</h2>
            <p class="of-lede">The integration is deliberately asymmetrical. Coder provides governed, ephemeral workspaces with no AI software and no model keys inside. OpenFlows brings the engineering discipline: the flow graph, the typed contracts, and the FORGE ↔ SENTINEL planning cycle.</p>
            <div class="of-actions">
              <a href="/docs/concepts/coder-openflows-split" class="of-link">Read about the split <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </div>
          </div>

          <div class="stack" data-reveal="scale">
            <div class="layer layer-of">
              <div class="layer-head">
                <img src="/openlogo-light.png" alt="" width="22" height="22" loading="lazy" />
                <span>OpenFlows</span>
                <span class="layer-tag">how they coordinate</span>
              </div>
              <ul>{OPENFLOWS_LAYER.map((f) => <li>{f}</li>)}</ul>
            </div>
            <div class="layer-link" aria-hidden="true"><span></span><span></span><span></span></div>
            <div class="layer layer-coder">
              <div class="layer-head">
                <span class="coder-mark">C</span>
                <span>Coder</span>
                <span class="layer-tag">where agents run</span>
              </div>
              <ul>{CODER_LAYER.map((f) => <li>{f}</li>)}</ul>
            </div>
            <div class="layer-link" aria-hidden="true"><span></span><span></span><span></span></div>
            <div class="layer layer-infra">
              <span>Your cloud, your network, your repositories</span>
              <span class="infra-chips"><span class="of-chip">GitHub</span><span class="of-chip">Redis</span><span class="of-chip">PostgreSQL</span><span class="of-chip">CI</span></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────────── BENTO ───────────── -->
    <section class="of-section">
      <div class="of-container">
        <div class="of-head is-center" data-reveal>
          <span class="of-eyebrow">Engineering discipline, encoded</span>
          <h2>Guardrails are the product.</h2>
          <p>AI can generate code against a spec, but it can’t write the spec. OpenFlows encodes the discipline around it, so speed never costs you control.</p>
        </div>

        <div class="bento" data-reveal-group>
          <article class="cell cell-gate of-card of-spotlight" data-reveal>
            <div class="cell-copy">
              <span class="cell-kicker">Planning gate</span>
              <h3>No code until the plan is approved.</h3>
              <p>FORGE writes a plan and halts. Leaving planning requires a single-use approval that only SENTINEL can issue.</p>
            </div>
            <div class="gate-visual" aria-hidden="true">
              <div class="gate-row"><span class="g-node" style="--c:var(--color-agent-forge)">FORGE</span><span class="g-line"></span><span class="g-file">PLAN.md</span></div>
              <div class="gate-lock">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                <span>plan_ready</span>
              </div>
              <div class="gate-row"><span class="g-node" style="--c:var(--color-agent-sentinel)">SENTINEL</span><span class="g-line is-ok"></span><span class="g-ok">APPROVED</span></div>
            </div>
          </article>

          <article class="cell cell-review of-card of-spotlight" data-reveal>
            <span class="cell-kicker">Adversarial review</span>
            <h3>Different models, different blind spots.</h3>
            <p>Run the builder and the reviewer on different providers. SENTINEL spawns fresh, read-only, for every evaluation.</p>
            <div class="model-pair" aria-hidden="true">
              <span class="of-chip"><i style="background:var(--color-agent-forge)"></i>FORGE · provider A</span>
              <span class="vs">≠</span>
              <span class="of-chip"><i style="background:var(--color-agent-sentinel)"></i>SENTINEL · provider B</span>
            </div>
          </article>

          <article class="cell cell-a2a of-card of-spotlight" data-reveal>
            <span class="cell-kicker">A2A verification</span>
            <h3>Verify without touching the workspace.</h3>
            <p>SENTINEL delegates allowlisted test commands to FORGE’s workspace. Every call is audited, and a timeout never counts as a pass.</p>
            <div class="a2a" aria-hidden="true">
              <span>sentinel</span><span class="a2a-beam"></span><span>forge-1</span>
            </div>
          </article>

          <article class="cell cell-recover of-card of-spotlight" data-reveal>
            <span class="cell-kicker">Self-healing</span>
            <h3>reconcile() runs every cycle.</h3>
            <p>Stale workers, orphaned tickets, crashed workspaces and unmerged PRs are repaired automatically, then escalated after bounded retries.</p>
            <ul class="recover-list" aria-hidden="true">
              <li><span>stale_worker forge-2</span><b>recovered</b></li>
              <li><span>orphaned T-139</span><b>reassigned</b></li>
              <li><span>unmerged PR #301</span><b>resumed</b></li>
            </ul>
          </article>

          <article class="cell cell-escalate of-card of-spotlight" data-reveal>
            <span class="cell-kicker">Human in the loop</span>
            <h3>Asks an exact question instead of guessing.</h3>
            <div class="notify" aria-hidden="true">
              <div class="notify-head"><img src="/openlogo-light.png" alt="" width="18" height="18" loading="lazy" /><b>NEXUS</b><span>now</span></div>
              <p><b>T-147 · awaiting_human</b><br />Spec is ambiguous: should SSO users bypass the rate limit?</p>
              <div class="notify-actions"><span>Open workspace</span><span>View issue</span></div>
            </div>
            <div class="notify notify-2" aria-hidden="true">
              <div class="notify-head"><img src="/openlogo-light.png" alt="" width="18" height="18" loading="lazy" /><b>VESSEL</b><span>2m</span></div>
              <p><b class="is-red">PR #322 · conflict</b><br />3 automatic attempts failed. Escalating instead of force-pushing.</p>
            </div>
            <p class="escalate-copy">Ambiguous specs, security flags and stuck merges are parked as <code>awaiting_human</code>, never silently retried.</p>
            <div class="channels" aria-label="Notification channels"><span class="of-chip">Slack</span><span class="of-chip">Discord</span><span class="of-chip">WhatsApp</span></div>
          </article>

          <article class="cell cell-registry of-card of-spotlight" data-reveal>
            <span class="cell-kicker">Plug and play</span>
            <h3>Skills, MCP servers and models, no code change.</h3>
            <pre class="mini-code" aria-hidden="true"><span class="t-c">// registry.json</span>
<span class="t-k">"forge"</span>: {'{'}
  <span class="t-k">"model"</span>: <span class="t-s">"your-model"</span>,
  <span class="t-k">"skills"</span>: [<span class="t-s">"rust"</span>, <span class="t-s">"react"</span>],
  <span class="t-k">"mcp"</span>: {'{'} <span class="t-k">"github"</span>: {'{ … }'} {'}'}
{'}'}</pre>
          </article>

          <article class="cell cell-tenant of-card of-spotlight" data-reveal>
            <span class="cell-kicker">Multi-tenant</span>
            <h3>One Coder server, many teams.</h3>
            <p>Each tenant is a real Coder user, a repo binding and its own nexus workspace, isolated by RBAC and Redis keyspaces.</p>
            <div class="keyspaces" aria-hidden="true"><code>ns:payments:*</code><code>ns:web:*</code><code>ns:infra:*</code></div>
          </article>
        </div>
      </div>
    </section>

    <!-- ───────────── DEMO ───────────── -->
    <section class="of-section demo-section" id="demo">
      <div class="of-container">
        <div class="of-head is-center" data-reveal>
          <span class="of-eyebrow">See it run</span>
          <h2>Watch the team ship a real issue.</h2>
          <p>NEXUS triages, FORGE builds, SENTINEL reviews, VESSEL ships, and LORE documents, all on top of Coder.</p>
        </div>
        <div class="demo-frame of-window" data-reveal="scale">
          <div class="of-window-bar"><span class="of-window-dots"><span></span><span></span><span></span></span>openflows · live run</div>
          <div class="demo-player" id="demo-player">
            <button class="demo-play" id="demo-play" aria-label="Play the OpenFlows demo video">
              <img src="/images/howitworks.png" alt="" loading="lazy" />
              <span class="demo-shade"></span>
              <span class="demo-button">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13L19 12z" fill="currentColor"/></svg>
              </span>
              <span class="demo-caption">Play the walkthrough</span>
            </button>
          </div>
        </div>
        <div class="demo-links" data-reveal>
          <a href="/demos/terminal" class="of-link">Terminal replay <span aria-hidden="true">→</span></a>
          <a href="/demos/walkthrough" class="of-link">Step-by-step walkthrough <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- ───────────── USE CASES ───────────── -->
    <section class="of-section">
      <div class="of-container">
        <div class="of-head is-center" data-reveal>
          <span class="of-eyebrow">Use cases</span>
          <h2>Code at speed. Stay in control.</h2>
          <p>Four ways teams put OpenFlows to work.</p>
        </div>
        <div data-reveal>
          <UseCaseTabs client:visible />
        </div>
      </div>
    </section>

    <!-- ───────────── INDUSTRIES ───────────── -->
    <section class="of-section industries-section">
      <div class="of-container">
        <div class="of-head" data-reveal>
          <span class="of-eyebrow">Industries</span>
          <h2>Built for teams that answer to auditors.</h2>
        </div>
        <div class="industries" data-reveal-group>
          {INDUSTRIES.map((ind) => (
            <a href={ind.href} class="industry of-card of-spotlight" data-reveal>
              <span class="industry-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ind.icon} /></span>
              <h3>{ind.title}</h3>
              <p>{ind.desc}</p>
              <span class="of-link">Read the brief <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ───────────── QUICK START ───────────── -->
    <section class="of-section quick-section">
      <div class="of-container">
        <div class="quick">
          <div data-reveal>
            <span class="of-eyebrow">Quick start</span>
            <h2 class="of-h2">From zero to your first merged PR.</h2>
            <p class="of-lede">One script creates the GitHub App, starts Coder and Redis, configures the model, pushes templates and connects your repo. Re-run it any time; it skips what is done.</p>
            <ol class="quick-steps">
              <li><span>1</span><div><b>Run the setup script</b><p>Published images on x86-64 Linux, or compile from source.</p></div></li>
              <li><span>2</span><div><b>Open a GitHub issue</b><p>NEXUS picks it up on the next cycle and assigns a worker.</p></div></li>
              <li><span>3</span><div><b>Review the pull request</b><p>Approve the gates that need a human. The team does the rest.</p></div></li>
            </ol>
            <div class="of-actions">
              <a href="/docs/getting-started/installation" class="of-btn of-btn-primary">Installation guide</a>
              <a href="/docs/getting-started/first-issue" class="of-btn of-btn-ghost">First issue walkthrough</a>
            </div>
          </div>
          <div class="of-window quick-term" data-reveal="scale">
            <div class="of-window-bar"><span class="of-window-dots"><span></span><span></span><span></span></span>~/openflows</div>
            <pre class="term"><span class="t-c"># published images, no compiling (x86-64 Linux)</span>
<span class="t-p">$</span> ./scripts/setup.sh acme/web --compose
<span class="t-ok">✓</span> .env created · GitHub App registered
<span class="t-ok">✓</span> Coder + Redis running
<span class="t-ok">✓</span> LLM configured via Coder AI Gateway
<span class="t-ok">✓</span> Templates pushed · tenant <b>acme/web</b> connected
<span class="t-ok">✓</span> nexus workspace started

<span class="t-c"># or compile from this checkout</span>
<span class="t-p">$</span> ./scripts/setup.sh acme/web --source

<span class="t-m">nexus</span> watching acme/web for open issues<span class="term-cursor"></span></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────────── LATEST ───────────── -->
    {posts.length > 0 && (
      <section class="of-section">
        <div class="of-container">
          <div class="team-head" data-reveal>
            <div class="of-head" style="margin-bottom:0">
              <span class="of-eyebrow">From the blog</span>
              <h2>Notes on building trustworthy agents.</h2>
            </div>
            <a href="/resources" class="of-btn of-btn-ghost">All resources <svg class="of-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          </div>
          <div class="posts" data-reveal-group>
            {posts.map((post) => (
              <a href={getPostHref(post)} class="post of-card" data-reveal>
                <div class="post-cover">
                  {post.data.cover_image_url ? (
                    <img src={post.data.cover_image_url} alt="" loading="lazy" />
                  ) : (
                    <div class="post-cover-fallback" />
                  )}
                </div>
                <div class="post-body">
                  <p class="post-meta">{formatPostDate(post.data.published_at)} · {getReadTime(post)} min read</p>
                  <h3>{post.data.title}</h3>
                  <p class="post-excerpt">{post.data.excerpt}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ───────────── FAQ ───────────── -->
    <section class="of-section">
      <div class="of-container">
        <div class="faq">
          <div class="of-head" data-reveal>
            <span class="of-eyebrow">FAQ</span>
            <h2>Questions, answered.</h2>
            <p>Can’t find what you need? Ask in <a href="https://github.com/The-AgenticFlow/OpenFlows/discussions" target="_blank" rel="noopener noreferrer">GitHub Discussions</a> or on <a href="https://discord.gg/gDhK2RQZpY" target="_blank" rel="noopener noreferrer">Discord</a>.</p>
          </div>
          <div data-reveal>
            <FAQ client:visible />
          </div>
        </div>
      </div>
    </section>

    <CtaBanner />
  </main>
</BaseLayout>

<script>
  // Load the Loom player only when asked, so the homepage stays light.
  const play = document.getElementById('demo-play');
  play?.addEventListener('click', () => {
    const player = document.getElementById('demo-player');
    if (!player) return;
    const frame = document.createElement('iframe');
    frame.src = 'https://www.loom.com/embed/46d47c9e9291445a8eb9cc88b2a26627?hideOwner=true&hideTitle=true&hideEmbedTopBar=true&autoplay=1';
    frame.title = 'OpenFlows agent flow demo';
    frame.allow = 'autoplay; fullscreen';
    frame.allowFullscreen = true;
    player.replaceChildren(frame);
  });
</script>

