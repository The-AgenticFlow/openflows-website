---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FAQ from '@/organisms/FAQ/FAQ';
import CtaBanner from '@/components/site/CtaBanner.astro';
import PixelField from '@/components/site/PixelField.astro';
import { AGENT_SUMMARY } from '@/data/agentSummary';
import { getPublishedPosts, getPostHref, formatPostDate, getReadTime } from '@/components/blog/blog';

const posts = (await getPublishedPosts()).slice(0, 3);

const LOGOS = [
  { name: 'Adorsys', src: '/images/mono-logo-adorsys.png', h: 36 },
  { name: 'Clemios', src: '/images/mono-logo-clemios.png', h: 56 },
  { name: 'Rust Cameroon', src: '/images/mono-logo-rust-cameroon.png', h: 58 },
  { name: 'Rust Nigeria', src: '/images/mono-logo-rust-nigeria.png', h: 58 },
  { name: 'Rust Africa', src: '/images/mono-logo-rust-africa.png', h: 56 },
];

// Each stage of the ticket lifecycle, with the artifact that stage produces.
// Code lines are [className, text] pairs.
const STAGES = [
  {
    agent: 'NEXUS',
    title: 'Triage and assign',
    body: 'You open a GitHub issue. NEXUS syncs it into a typed ticket and hands it to an idle FORGE worker in its own fresh Coder workspace.',
    file: 'ticket · T-142',
    code: [
      [['p', '{']],
      [['k', '  "id"'], ['p', ': '], ['s', '"T-142"'], ['p', ',']],
      [['k', '  "issue"'], ['p', ': '], ['n', '318'], ['p', ',']],
      [['k', '  "title"'], ['p', ': '], ['s', '"Rate-limit the /login endpoint"'], ['p', ',']],
      [['k', '  "phase"'], ['p', ': '], ['s', '"planning"'], ['p', ',']],
      [['k', '  "worker"'], ['p', ': '], ['s', '"forge-1"'], ['p', ',']],
      [['k', '  "branch"'], ['p', ': '], ['s', '"forge-1/T-142"']],
      [['p', '}']],
    ],
  },
  {
    agent: 'FORGE → SENTINEL',
    title: 'Plan, then stop at the gate',
    body: 'FORGE writes PLAN.md and halts. No code is written until SENTINEL approves the plan with a single-use approval that cannot be replayed.',
    file: 'PLAN.md',
    code: [
      [['h', '## Plan · T-142']],
      [['p', '1. Token-bucket middleware on POST /login']],
      [['p', '2. Redis counters keyed by IP + account']],
      [['p', '3. 429 + Retry-After, tests for both paths']],
      [['p', '']],
      [['c', 'gate     '], ['p', 'plan_ready']],
      [['c', 'verdict  '], ['g', 'APPROVED'], ['c', '  · sentinel, round 1']],
    ],
  },
  {
    agent: 'FORGE',
    title: 'Build in an isolated workspace',
    body: 'FORGE implements the approved plan segment by segment with conventional commits and runs the suite. The workspace holds zero LLM keys and zero raw credentials.',
    file: 'git log --oneline',
    code: [
      [['n', 'a91f3c2 '], ['p', 'feat(auth): token-bucket limiter on /login']],
      [['n', '4be07d1 '], ['p', 'feat(auth): redis-backed counters per IP']],
      [['n', 'c3d2a90 '], ['p', 'test(auth): cover 429 and Retry-After']],
      [['p', '']],
      [['c', '$ npm test']],
      [['g', '✓ 48 passed'], ['c', ' · 0 failed · 6.2s']],
    ],
  },
  {
    agent: 'SENTINEL',
    title: 'Review adversarially',
    body: 'SENTINEL reviews the diff read-only, on a different model provider if you like, and verifies by running tests in FORGE’s workspace through the audited A2A relay.',
    file: 'review · PR #318',
    code: [
      [['c', 'verify  '], ['p', 'forge-1 → '], ['s', '"npm test -- auth"']],
      [['g', '        ✓ 12 passed'], ['c', '  (a2a, allowlisted)']],
      [['p', '']],
      [['c', 'verdict '], ['g', 'APPROVE']],
      [['c', 'src/auth/limit.ts:41  '], ['p', 'nit: name the magic 429']],
      [['c', 'src/auth/limit.ts:63  '], ['p', 'nit: jitter Retry-After']],
    ],
  },
  {
    agent: 'VESSEL',
    title: 'Merge only when it is safe',
    body: 'VESSEL squash-merges only when the PR is approved, conflict-free and CI-green. Conflicts and failing checks go back to the same FORGE worker, context intact.',
    file: 'vessel · PR #318',
    code: [
      [['c', 'checks     '], ['g', '4/4 passing']],
      [['c', 'review     '], ['g', 'approved']],
      [['c', 'mergeable  '], ['g', 'true']],
      [['p', '']],
      [['k', 'squash-merge '], ['p', '#318 → main']],
      [['g', '✓ merged'], ['c', ' · issue closed · workspace recycled']],
    ],
  },
  {
    agent: 'LORE',
    title: 'Keep the paper trail',
    body: 'After the merge, LORE records an Architecture Decision Record and updates the changelog, so anyone can reconstruct why the change was made.',
    file: 'docs/adr/021-login-rate-limit.md',
    code: [
      [['h', '# ADR-021 · Rate-limit /login']],
      [['c', 'Status    '], ['g', 'Accepted']],
      [['c', 'Context   '], ['p', 'credential stuffing on /login']],
      [['c', 'Decision  '], ['p', 'token bucket, Redis counters']],
      [['c', 'Refs      '], ['s', 'T-142, PR #318']],
    ],
  },
];






const escapeHtml = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const codeHtml = (lines: string[][][]) =>
  lines.map((line) => line.map(([cls, text]) => `<span class="t-${cls}">${escapeHtml(text)}</span>`).join('')).join('\n');

// Real Console screens, captured from the Console running against demo data.
const CONSOLE_SCREENS = [
  { id: 'overview', label: 'Overview', alt: 'OpenFlows Console overview: tenant count, running tenants, GitHub connection and recent activity' },
  { id: 'tenant', label: 'Agent activity', alt: 'Tenant detail page showing runtime health and the agents working on each ticket' },
  { id: 'tenants', label: 'Tenants', alt: 'Tenants list with one runtime per GitHub repository and its status' },
  { id: 'activity', label: 'Operations', alt: 'Activity page listing every lifecycle operation and its result' },
  { id: 'members', label: 'Members', alt: 'Members page with roles and invitations' },
];

// Screens that line the walls of the how-it-works tunnel.
const TUNNEL_IMAGES = [
  ...CONSOLE_SCREENS.flatMap((sc) => [`/images/console/${sc.id}-light.webp`, `/images/console/${sc.id}-dark.webp`]),
  '/images/howitworks.png',
];
const TUNNEL_SEGMENTS = 9;

const SETUP_COMMAND = './scripts/setup.sh owner/repo --compose';
const HEADLINE = ['Orchestrate AI agents', 'on top of your', 'Coder environment.'];
---

<BaseLayout
  title="OpenFlows · The autonomous AI dev team on your Coder environment"
  description="OpenFlows is an open-source AI software team that turns GitHub issues into reviewed, merged pull requests inside your self-hosted Coder environment, with a planning gate, adversarial review, and a full audit trail."
>
  <main class="home">
    <!-- ───────── HERO ───────── -->
    <section class="hero-wrap">
      <div class="hero of-panel of-dark">
        <PixelField cell={30} density={0.09} />
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="of-container hero-inner">
          <span class="of-eyebrow fade-up">OpenFlows · Open source · Self-hosted</span>
          <h1 class="hero-title of-lines">
            {HEADLINE.map((line, i) => <span><span style={`--l:${i}`}>{line}</span></span>)}
          </h1>
          <p class="hero-sub fade-up" style="animation-delay:450ms">
            OpenFlows sits on top of Coder so your team can focus on architecture while an AI dev team runs
            safely, securely and with full governance. Every agent action is auditable from issue to merge,
            for a single developer or a whole company.
          </p>
          <div class="hero-cta fade-up" style="animation-delay:560ms">
            <a href="/docs/getting-started" class="of-btn of-btn-primary of-btn-lg"><span class="of-sq"></span>Install OpenFlows</a>
            <a href="/demos" class="of-btn of-btn-ghost of-btn-lg"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.8v8.4L12 8z" fill="currentColor"/></svg>Watch the demo</a>
          </div>
          <div class="hero-command fade-up" style="animation-delay:660ms">
            <div class="of-command">
              <span class="of-prompt">$</span>
              <code>{SETUP_COMMAND}</code>
              <button class="of-copy" data-copy={SETUP_COMMAND} aria-label="Copy setup command">
                <svg class="of-copy-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.8"/><path d="M10.5 5V3.8A1.3 1.3 0 0 0 9.2 2.5H3.8a1.3 1.3 0 0 0-1.3 1.3v5.4a1.3 1.3 0 0 0 1.3 1.3H5"/></svg>
                <svg class="of-copied" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          </div>
        </div>
        <a class="hero-strip" href="/blog/delegated-verification-how-sentinel-gets-forge-to-run-code-without-ever-touching-forges-workspace">
          <span class="of-tag">New</span>
          <span>Delegated verification: how SENTINEL runs tests without touching FORGE’s workspace</span>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </section>

    <!-- ───────── LOGOS ───────── -->
    <section class="logos" aria-label="Supporters">
      <div class="of-container">
        <p class="logos-label">Supported by engineering teams and communities</p>
        <ul class="logo-row" data-reveal-group>
          {LOGOS.map((logo) => (
            <li class="logo" data-reveal="fade">
              <img src={logo.src} alt={logo.name} style={`height:${logo.h}px`} loading="lazy" />
              <span class="logo-name" aria-hidden="true">{logo.name}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ───────── PRODUCT ───────── -->
    <section class="product">
      <div class="of-container">
        <div class="product-head">
          <h2 data-split>Your agents.<br />Your infrastructure.<br />Your rules.</h2>
          <p>Run a governed AI dev team on self-hosted Coder workspaces, with every handoff, approval and merge on the record.</p>
        </div>

        <article class="feature feature-wide" data-reveal>
          <div class="feature-copy">
            <h3>The OpenFlows Console</h3>
            <p>Connect GitHub, create one tenant per repository, start and stop its runtime, and see which agent is working on which ticket. Members, roles and the full operations history live in the same place.</p>
            <a href="/docs/getting-started" class="of-btn of-btn-ghost of-btn-sm">Get the Console</a>
          </div>
          <div class="shot shot-wide" id="console-tour">
            <div class="shot-light" aria-hidden="true"></div>
            <div class="console-tabs" role="tablist" aria-label="Console screens">
              {CONSOLE_SCREENS.map((sc, i) => (
                <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-console-tab={i}>{sc.label}</button>
              ))}
            </div>
            <div class="console-frame" data-scroll-scale>
              {CONSOLE_SCREENS.map((sc, i) => (
                <figure class={`console-screen ${i === 0 ? 'is-active' : ''}`} data-console-screen={i}>
                  <img class="on-light" src={`/images/console/${sc.id}-light.webp`} alt={sc.alt} width="1440" height="900" />
                  <img class="on-dark" src={`/images/console/${sc.id}-dark.webp`} alt={sc.alt} width="1440" height="900" />
                </figure>
              ))}
            </div>
          </div>
        </article>

        <article class="feature" data-reveal>
          <div class="feature-copy">
            <h3>Agent workspaces on Coder</h3>
            <p>Every agent runs in its own ephemeral, governed Coder workspace on its own branch. Model keys stay in the Coder AI Gateway; workspaces only get short-lived, repository-scoped tokens.</p>
            <a href="/docs/concepts/workspaces" class="of-btn of-btn-ghost of-btn-sm">Explore workspaces</a>
          </div>
          <div class="shot">
            <div class="shot-light" aria-hidden="true"></div>
            <img class="shot-img" src="/images/howitworks.png" alt="Coder dashboard listing the OpenFlows forge, sentinel and nexus workspaces, all running" loading="lazy" data-parallax="0.05" />
          </div>
        </article>

        <article class="feature is-flipped" data-reveal>
          <div class="feature-copy">
            <h3>Gated planning and adversarial review</h3>
            <p>FORGE writes a plan and stops. SENTINEL approves it with a single-use approval, reviews the diff on a different model if you like, and verifies by running tests through the audited A2A relay.</p>
            <a href="/docs/concepts/planning-gate" class="of-btn of-btn-ghost of-btn-sm">Explore the planning gate</a>
          </div>
          <div class="shot">
            <div class="shot-light" aria-hidden="true"></div>
            <div class="shot-card of-window" data-parallax="0.05">
              <div class="of-window-bar"><span class="of-window-dots"><span></span><span></span><span></span></span>review · PR #318</div>
              <pre class="shot-code"><span class="t-h">## Plan · T-142</span>
<span class="t-p">1. Token-bucket middleware on POST /login</span>
<span class="t-p">2. Redis counters keyed by IP + account</span>
<span class="t-p">3. 429 + Retry-After, tests for both paths</span>

<span class="t-c">plan gate  </span><span class="t-g">APPROVED</span><span class="t-c">  · single-use</span>
<span class="t-c">verify     </span><span class="t-p">forge-1 → npm test -- auth</span>
<span class="t-g">           ✓ 12 passed</span><span class="t-c">  (a2a, allowlisted)</span>
<span class="t-c">verdict    </span><span class="t-g">APPROVE</span><span class="t-c">  · 0 blocking, 2 nits</span></pre>
            </div>
          </div>
        </article>

        <a class="brief" href="/docs/architecture" data-reveal>
          <div>
            <h3>Learn how OpenFlows keeps agent work governed and auditable</h3>
            <span class="of-btn of-btn-primary of-btn-sm"><span class="of-sq"></span>Read the architecture</span>
          </div>
          <img src="/images/system-architecture.png" alt="" loading="lazy" />
        </a>
      </div>
    </section>

    <!-- ───────── HOW IT WORKS: scroll tunnel (desktop) ───────── -->
    <div id="how-it-works"></div>
    <section class="tunnel-wrap" id="tunnel" style={`--stages:${STAGES.length}`} aria-label="How OpenFlows works, stage by stage">
      <div class="tunnel-sticky of-panel of-dark">
        <div class="tunnel-scene" aria-hidden="true">
          <div class="tunnel-world" data-world>
            {Array.from({ length: TUNNEL_SEGMENTS * 8 }).map((_, k) => (
              <div class="tile" data-tile={k}><img src={TUNNEL_IMAGES[(k * 3 + Math.floor(k / 8)) % TUNNEL_IMAGES.length]} alt="" decoding="async" /></div>
            ))}
          </div>
        </div>
        <div class="tunnel-fog" aria-hidden="true"></div>

        <div class="tunnel-hud">
          <div class="hud-top">
            <span class="of-eyebrow">How it works</span>
            <span class="hud-count"><b id="hud-index">01</b> / {String(STAGES.length).padStart(2, '0')}</span>
          </div>
          <div class="hud-copy">
            {STAGES.map((st, i) => (
              <div class={`hud-stage ${i === 0 ? 'is-active' : ''}`} data-hud={i}>
                <p class="hud-agent">{String(i + 1).padStart(2, '0')} · {st.agent}</p>
                <h3>{st.title}</h3>
                <p class="hud-body">{st.body}</p>
              </div>
            ))}
          </div>
          <ol class="hud-steps">
            {STAGES.map((st, i) => (
              <li data-hud-step={i} class={i === 0 ? 'is-active' : ''}><span>{String(i + 1).padStart(2, '0')}</span>{st.title}</li>
            ))}
          </ol>
          <div class="hud-progress" aria-hidden="true"><i id="hud-bar"></i></div>
        </div>
      </div>
    </section>

    <!-- ───────── HOW IT WORKS ───────── -->
    <section class="of-section flow-section">
      <div class="of-container">
        <div class="split-head" data-reveal>
          <div>
            <span class="of-eyebrow">How it works</span>
            <h2 class="of-h2" data-split>Six handoffs. Every one on the record.</h2>
          </div>
          <p class="of-lede">Each issue moves through the same declared flow. Every stage has an owner, a gate and an artifact you can inspect.</p>
        </div>

        <div class="flow" id="flow" data-reveal="scale">
          <ol class="flow-tabs" role="tablist" aria-label="Pipeline stages">
            {STAGES.map((s, i) => (
              <li>
                <button role="tab" class="flow-tab" aria-selected={i === 0 ? 'true' : 'false'} data-flow-tab={i}>
                  <span class="flow-num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="flow-text">
                    <span class="flow-agent">{s.agent}</span>
                    <span class="flow-title">{s.title}</span>
                  </span>
                  <span class="flow-bar" aria-hidden="true"><i></i></span>
                </button>
              </li>
            ))}
          </ol>

          <div class="flow-stage of-dark">
            <div class="flow-grid" aria-hidden="true"></div>
            {STAGES.map((s, i) => (
              <div class={`flow-panel ${i === 0 ? 'is-active' : ''}`} data-flow-panel={i} role="tabpanel">
                <div class="flow-copy">
                  <p class="flow-kicker"><span>{String(i + 1).padStart(2, '0')} / 06</span>{s.agent}</p>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
                <div class="of-window flow-window">
                  <div class="of-window-bar"><span class="of-window-dots"><span></span><span></span><span></span></span>{s.file}</div>
                  <pre set:html={codeHtml(s.code)} />
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ───────── AGENTS ───────── -->
    <section class="of-section team-section">
      <div class="of-container">
        <div class="split-head" data-reveal>
          <div>
            <span class="of-eyebrow">The team</span>
            <h2 class="of-h2" data-split>Five agents that work like an engineering team.</h2>
          </div>
          <p class="of-lede">Not five copies of the same assistant. Each role has its own workspace, permissions, skills and model, and each one is accountable for exactly one part of the job.</p>
        </div>
        <div class="crew" id="crew" data-reveal="scale">
          {AGENT_SUMMARY.map((a, i) => (
            <article class={`member ${i === 0 ? 'is-open' : ''}`} data-member={i} tabindex="0" aria-expanded={i === 0 ? 'true' : 'false'}>
              <div class="member-rail" aria-hidden="true">
                <span class="m-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="m-vert">{a.name}</span>
                <span class="m-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={a.icon} /></span>
              </div>
              <div class="member-body">
                <div class="m-top">
                  <span class="m-icon m-icon-lg"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={a.icon} /></span>
                  <span class="m-role">{String(i + 1).padStart(2, '0')} · {a.role}</span>
                </div>
                <h3 class="m-name">{a.name}</h3>
                <p class="m-tag">{a.tagline}</p>
                <dl class="m-spec">
                  <div><dt>Runs in</dt><dd>{a.spec.runs}</dd></div>
                  <div><dt>Writes</dt><dd>{a.spec.writes}</dd></div>
                  <div><dt>Never</dt><dd>{a.spec.never}</dd></div>
                </dl>
                <a href={`/agents/${a.id}`} class="m-link">Meet {a.name} <span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ───────── QUICK START ───────── -->
    <section class="of-section">
      <div class="of-container">
        <div class="quick">
          <div data-reveal>
            <span class="of-eyebrow">Quick start</span>
            <h2 class="of-h2" style="margin-top:1.1rem" data-split>From zero to your first merged PR.</h2>
            <p class="of-lede" style="margin-top:1.2rem">One script creates the GitHub App, starts Coder and Redis, configures the model, pushes templates and connects your repository. Re-run it any time; it skips what is done.</p>
            <ol class="quick-steps">
              <li><span>01</span><div><b>Run the setup script</b><p>Published images or release binaries on Linux and macOS, or compile from source.</p></div></li>
              <li><span>02</span><div><b>Open a GitHub issue</b><p>NEXUS picks it up on the next cycle and assigns a worker.</p></div></li>
              <li><span>03</span><div><b>Review the pull request</b><p>Approve the gates that need a human. The team does the rest.</p></div></li>
            </ol>
            <div class="of-actions">
              <a href="/docs/getting-started/installation" class="of-btn of-btn-primary"><span class="of-sq"></span>Installation guide</a>
              <a href="/docs/getting-started/first-issue" class="of-btn of-btn-ghost">First issue walkthrough</a>
            </div>
          </div>
          <div class="of-window" data-reveal="scale">
            <div class="of-window-bar"><span class="of-window-dots"><span></span><span></span><span></span></span>~/openflows</div>
            <pre class="term"><span class="t-c"># published images, no compiling</span>
<span class="t-c">$</span> ./scripts/setup.sh acme/web --compose
<span class="t-g">✓</span> .env created · GitHub App registered
<span class="t-g">✓</span> Coder + Redis running
<span class="t-g">✓</span> LLM configured via Coder AI Gateway
<span class="t-g">✓</span> Templates pushed · tenant <b>acme/web</b> connected
<span class="t-g">✓</span> nexus workspace started

<span class="t-c"># or compile from this checkout</span>
<span class="t-c">$</span> ./scripts/setup.sh acme/web --source

<b>nexus</b> watching acme/web for open issues<span class="cursor"></span></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────── BLOG ───────── -->
    {posts.length > 0 && (
      <section class="of-section" style="padding-top:0">
        <div class="of-container">
          <div class="split-head" data-reveal>
            <div>
              <span class="of-eyebrow">From the blog</span>
              <h2 class="of-h2" data-split>Notes on building trustworthy agents.</h2>
            </div>
            <a href="/blog" class="of-btn of-btn-ghost">All posts</a>
          </div>
          <div class="posts" data-reveal-group>
            {posts.map((post) => (
              <a href={getPostHref(post)} class="post" data-reveal>
                <div class="post-cover">
                  {post.data.cover_image_url ? <img src={post.data.cover_image_url} alt="" loading="lazy" /> : <div class="post-fallback" />}
                </div>
                <p class="post-meta">{formatPostDate(post.data.published_at)} · {getReadTime(post)} min read</p>
                <h3>{post.data.title}</h3>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ───────── FAQ ───────── -->
    <section class="of-section" style="padding-top:0">
