---
import DocsLayout from '@/layouts/DocsLayout.astro';
import { DOCS_READING_PATH } from '@/data/docsReadingPath';

const SECTIONS = [
  {
    title: 'Introduction',
    desc: 'New to OpenFlows? Start here to understand what it is and when it fits.',
    cards: [
      { icon: '🧭', title: 'What is OpenFlows', desc: 'The core idea, whom it is for, and a quick tour of the team.', href: '/docs/introduction/what-is-openflows' },
      { icon: '🔁', title: 'How OpenFlows works', desc: 'The end-to-end flow from issue to merged pull request.', href: '/docs/introduction/how-it-works' },
      { icon: '🎯', title: 'Use cases', desc: 'The situations where OpenFlows shines.', href: '/docs/introduction/use-cases' },
      { icon: '⚖️', title: 'How OpenFlows compares', desc: 'OpenFlows vs. chat assistants, hosted agents, bare orchestrators, and Coder alone.', href: '/docs/introduction/how-openflows-compares' },
    ],
  },
  {
    title: 'Get Started',
    desc: 'Install OpenFlows, obtain tokens, and run your first autonomous issue-to-merge cycle.',
    cards: [
      { icon: '🚀', title: 'Quick Start', desc: 'The fast path from clone to a working OpenFlows stack.', href: '/docs/getting-started' },
      { icon: '⚙️', title: 'Installation', desc: 'What you need before you start and how the environment is put together.', href: '/docs/getting-started/installation' },
      { icon: '🎯', title: 'First Issue Walkthrough', desc: 'What happens when you create a GitHub issue and the agents take over.', href: '/docs/getting-started/first-issue' },
      { icon: '🔑', title: 'Token Guide', desc: 'User sign-in, runtime sessions, and brokered GitHub access.', href: '/docs/getting-started/token-guide' },
      { icon: '🔁', title: 'Lifecycle Steps', desc: 'The phases every ticket travels through, from planning to merge.', href: '/docs/getting-started/lifecycle-steps' },
      { icon: '✅', title: 'Completion & Merge', desc: 'How work is reviewed, merged, and torn down.', href: '/docs/getting-started/completion-and-merge' },
    ],
  },
  {
    title: 'Core Concepts',
    desc: 'The ideas that make OpenFlows work: architecture-first orchestration, the agent team, and the Coder integration model.',
    cards: [
      { icon: '🏛️', title: 'Architecture-First Development', desc: 'Why the engineering discipline is the product.', href: '/docs/concepts/architecture-first' },
      { icon: '👥', title: 'The Agent Team', desc: 'NEXUS, FORGE, SENTINEL, VESSEL, and LORE - roles, boundaries, and handoffs.', href: '/docs/concepts/agent-team' },
      { icon: '🚦', title: 'The Planning Gate', desc: 'Why agents must plan before they code.', href: '/docs/concepts/planning-gate' },
      { icon: '🧠', title: 'The Coordination Store', desc: 'The single record of truth that keeps every agent consistent.', href: '/docs/concepts/coordination-store' },
      { icon: '💻', title: 'Workspaces', desc: 'Where work actually runs - and why it is safe.', href: '/docs/concepts/workspaces' },
      { icon: '🏢', title: 'Tenants', desc: 'How one server serves many isolated teams.', href: '/docs/concepts/tenants' },
      { icon: '🛎️', title: 'Human Escalation', desc: 'When and how a person gets pulled in.', href: '/docs/concepts/human-escalation' },
      { icon: '📇', title: 'The Agent Registry', desc: 'How the team is configured without code.', href: '/docs/concepts/agent-registry' },
      { icon: '🔗', title: 'The Coder / OpenFlows Split', desc: 'The founding idea: where work runs vs. how it is coordinated.', href: '/docs/concepts/coder-openflows-split' },
    ],
  },
  {
    title: 'Architecture',
    desc: 'Manager-mediated runtime architecture, credential boundaries, agent coordination, recovery, and deployment  -  in plain language.',
    cards: [
      { icon: '🧩', title: 'Components and Interactions', desc: 'A component map of Manager, Coder, Nexus, workers, storage, hooks, and GitHub.', href: '/docs/architecture/components-and-interactions' },
      { icon: '🔐', title: 'Manager Runtime', desc: 'How workspaces register, receive runtime identity, and request lifecycle operations.', href: '/docs/architecture/manager-runtime' },
      { icon: '🗝️', title: 'Credentials and Trust', desc: 'Where platform secrets stay, what a runtime receives, and how GitHub access is brokered.', href: '/docs/architecture/credentials' },
      { icon: '🔁', title: 'Hooks and A2A', desc: 'How Coder lifecycle events, hooks, Nexus, and worker evidence flow together.', href: '/docs/architecture/hooks-and-a2a' },
      { icon: '🗺️', title: 'Big Picture', desc: 'The control plane and the work plane, and how they fit together.', href: '/docs/architecture/big-picture' },
      { icon: '🧠', title: 'The Controller', desc: 'The brain and its orchestration loop.', href: '/docs/architecture/controller' },
      { icon: '🏗️', title: 'The Workspace Fleet', desc: 'Ephemeral worker spaces and the long-lived NEXUS workspace.', href: '/docs/architecture/workspace-fleet' },
      { icon: '🔗', title: 'How the Pieces Talk', desc: 'The three channels that keep the team in sync.', href: '/docs/architecture/how-the-pieces-talk' },
      { icon: '♻️', title: 'State Machine & Recovery', desc: 'NEXUS reconcile, failure detection, and self-healing.', href: '/docs/architecture/state-machine-recovery' },
      { icon: '🧭', title: 'Decision & Routing', desc: 'How work is dispatched and steered between roles.', href: '/docs/architecture/decision-routing' },
      { icon: '🛡️', title: 'Security by Design', desc: 'Why the architecture is safe by construction.', href: '/docs/architecture/security-by-design' },
      { icon: '🚀', title: "How It's Deployed", desc: 'The reference deployment, stood up for many teams.', href: '/docs/architecture/deployment' },
    ],
  },
  {
    title: 'Guides',
    desc: 'Practical instructions for configuring, extending, and operating OpenFlows in production.',
    cards: [
      { icon: '🤖', title: 'Agent Setup', desc: 'Configure roles, models, skills, and tools from the control panel.', href: '/docs/guides/agent-setup' },
      { icon: '🧭', title: 'Model Routing', desc: 'Choose which model each role uses.', href: '/docs/guides/model-routing' },
      { icon: '🏢', title: 'Multi-Tenancy', desc: 'Running multiple teams on a single Coder deployment.', href: '/docs/guides/multi-tenancy' },
      { icon: '📝', title: 'Extending: Skills', desc: 'Teach a role something new, configuration only.', href: '/docs/guides/extending-skills' },
      { icon: '🔌', title: 'Extending: MCP', desc: 'Connect external tools and data.', href: '/docs/guides/extending-mcp' },
      { icon: '🧩', title: 'Extending: Models', desc: 'Add a new model to the platform catalog.', href: '/docs/guides/extending-models' },
      { icon: '📈', title: 'Operations & Monitoring', desc: 'Status, steering, notifications, and recovery runbooks.', href: '/docs/guides/operations' },
      { icon: '🔧', title: 'Troubleshooting', desc: 'Common failures, diagnostics, and fixes.', href: '/docs/guides/troubleshooting' },
    ],
  },
  {
    title: 'Reference',
    desc: 'Quick lookup: roles, glossaries, lifecycle states, configuration, and the control surface.',
    cards: [
      { icon: '📚', title: 'Roles Reference', desc: 'The five team roles and their responsibilities.', href: '/docs/reference/roles-reference' },
      { icon: '📖', title: 'Glossary', desc: 'Every term defined in one line.', href: '/docs/reference/glossary' },
      { icon: '🔁', title: 'Lifecycle States', desc: 'Every state a ticket passes through, and the enforced rules.', href: '/docs/reference/lifecycle-states' },
      { icon: '⚙️', title: 'Configuration Reference', desc: 'The knobs you can set, grouped by concern.', href: '/docs/reference/configuration-reference' },
      { icon: '🔢', title: 'Limits & Defaults', desc: 'The meaningful numbers to know.', href: '/docs/reference/limits-and-defaults' },
      { icon: '🕹️', title: 'Command Surface', desc: 'The programmatic way to drive the same operations as the panel.', href: '/docs/reference/command-surface' },
      { icon: '🔔', title: 'Notifications Reference', desc: 'Channels, what they carry, and how they behave.', href: '/docs/reference/notifications-reference' },
    ],
  },
  {
    title: 'Contributing',
    desc: 'How to get involved and how the project is governed.',
    cards: [
      { icon: '🤝', title: 'Contributor Guide', desc: 'The path from idea to merged change.', href: '/docs/contributing' },
      { icon: '🛠️', title: 'Development Setup', desc: 'Get a local environment working.', href: '/docs/contributing/development-setup' },
      { icon: '📝', title: 'Adding Skills', desc: 'Contribute capability content, configuration only.', href: '/docs/contributing/adding-skills' },
      { icon: '🧪', title: 'Testing', desc: 'How changes are verified before merging.', href: '/docs/contributing/testing' },
    ],
  },
  {
    title: 'Resources',
    desc: 'Further reading and where to get help.',
    cards: [
      { icon: '🧭', title: 'Further Reading', desc: 'A curated path from introduction to deep architecture.', href: '/docs/resources/further-reading' },
      { icon: '💬', title: 'Community & Support', desc: 'Where to ask questions and report problems.', href: '/docs/resources/community-and-support' },
      { icon: '❓', title: 'FAQ', desc: 'Short answers to common setup, security, and operational questions.', href: '/docs/resources/faq' },
    ],
  },
];
---

<DocsLayout breadcrumbs={[{ label: 'Documentation' }]}>
  <div class="docsHero">
    <h1 class="docsTitle">OpenFlows Documentation</h1>
    <p class="docsLead">
      OpenFlows Manager governs users, runtimes, and workspace operations while Coder runs the agent workspaces.
      Read these docs to install, operate, extend, and contribute to the system.
    </p>
    <div class="docsCta">
      <a href="/docs/getting-started" class="of-btn of-btn-primary"><span class="of-sq"></span>Get started</a>
      <a href="/docs/introduction/how-openflows-compares" class="of-btn of-btn-ghost">How OpenFlows compares</a>
    </div>
  </div>

  <section class="docsJourney" aria-labelledby="docs-journey-title">
    <p class="docsJourneyEyebrow">Recommended path</p>
    <h2 id="docs-journey-title">Read the system in order</h2>
    <p>Start with the product, learn the component boundaries, then install and operate it. Each page links to the next.</p>
    <ol class="docsPaths">
      {DOCS_READING_PATH.map(({ label, href, summary }, index) => (
        <li><a href={href} class="docsPath"><span>{String(index + 1).padStart(2, '0')}</span><strong>{label}</strong><small>{summary}</small></a></li>
      ))}
    </ol>
  </section>

  <h2 class="docsBrowseHeading">Browse by topic</h2>

  {SECTIONS.map(({ title, desc, cards }) => (
    <section class="docsSection">
      <h2 class="docsSectionTitle">{title}</h2>
      <p class="docsSectionDesc">{desc}</p>
      <div class="docsGrid">
        {cards.map(({ title, desc, href }) => (
          <a href={href} class="docsCard">
            <h3 class="docsCardTitle">{title}<span aria-hidden="true">→</span></h3>
            <p class="docsCardDesc">{desc}</p>
          </a>
        ))}
      </div>
    </section>
  ))}
</DocsLayout>

<style>
  .docsHero { padding: 0.5rem 0 2.5rem; margin-bottom: 3rem; border-bottom: 1px solid var(--of-line); }
  .content .docsTitle { margin: 0 0 1rem; font-size: clamp(2.2rem, 3.6vw, 2.9rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1.05; color: var(--of-text); }
  .docsLead { max-width: 640px; margin-bottom: 1.75rem; font-size: 1.08rem; line-height: 1.65; color: var(--of-text-2); }
  .docsCta { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .docsCta a { text-decoration: none; }

  .docsJourney { margin-bottom: 3.5rem; }
  .content .docsJourneyEyebrow { margin: 0; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--of-text-3); }
  .content .docsJourney h2, .content .docsBrowseHeading, .content .docsSectionTitle { margin: 0.4rem 0 0.4rem; padding: 0; border: 0; font-size: 1.45rem; font-weight: 600; letter-spacing: -0.03em; color: var(--of-text); }
  .docsJourney > p:not(.docsJourneyEyebrow) { margin-bottom: 1.4rem; color: var(--of-text-2); }

  .docsPaths { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .content .docsPaths li { margin: 0; padding: 0; }
  .docsPath { display: flex; flex-direction: column; gap: 0.4rem; height: 100%; padding: 1.1rem 1.2rem; border: 1px solid var(--of-line); border-radius: 12px; background: var(--of-surface); text-decoration: none; transition: border-color 0.2s, transform 0.3s var(--ease-out); }
  .docsPath:hover { border-color: var(--of-line-strong); transform: translateY(-2px); }
  .docsPath span { font-family: var(--font-mono); font-size: 0.7rem; color: var(--of-text-3); }
  .docsPath strong { font-size: 0.98rem; font-weight: 600; color: var(--of-text); }
  .docsPath small { font-size: 0.85rem; line-height: 1.5; color: var(--of-text-2); }

  .content .docsBrowseHeading { margin-bottom: 1.75rem; }
  .docsSection { margin-bottom: 2.5rem; }
  .content .docsSectionTitle { font-size: 1.05rem; }
  .docsSectionDesc { margin-bottom: 1rem; font-size: 0.92rem; color: var(--of-text-2); }
  .docsGrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0.75rem; }
  .docsCard { display: block; padding: 1.1rem 1.2rem; border: 1px solid var(--of-line); border-radius: 12px; background: var(--of-surface); text-decoration: none; transition: border-color 0.2s, transform 0.3s var(--ease-out); }
  .docsCard:hover { border-color: var(--of-line-strong); transform: translateY(-2px); }
  .content .docsCardTitle { display: flex; justify-content: space-between; gap: 0.75rem; margin: 0 0 0.35rem; padding: 0; font-size: 0.98rem; font-weight: 600; letter-spacing: -0.01em; color: var(--of-text); }
  .docsCardTitle span { color: var(--of-text-3); transition: transform 0.3s var(--ease-out), color 0.2s; }
  .docsCard:hover .docsCardTitle span { color: var(--of-text); transform: translateX(3px); }
  .content .docsCardDesc { margin: 0; font-size: 0.86rem; line-height: 1.5; color: var(--of-text-2); }

  @media (max-width: 860px) { .docsPaths { grid-template-columns: 1fr; } }
</style>
