---
import DocsLayout from '@/layouts/DocsLayout.astro';
import { DocCards } from '@/molecules/DocComponents/DocComponents';

const CARDS = [
  { icon: '🤖', title: 'Agent Setup', desc: 'Configure a team end to end: roles, models, skills, and tools through the agent registry.', href: '/docs/guides/agent-setup' },
  { icon: '🧭', title: 'Model Routing', desc: 'Choose which model each role uses, from lightweight to rigorous — and switch live.', href: '/docs/guides/model-routing' },
  { icon: '🏢', title: 'Multi-Tenancy', desc: 'Run several independent teams on one server with real isolation.', href: '/docs/guides/multi-tenancy' },
  { icon: '📌', title: 'Extending: Skills', desc: 'Teach a role a new capability with configuration only — no system code.', href: '/docs/guides/extending-skills' },
  { icon: '🔌', title: 'Extending: MCP', desc: 'Give the team access to a private tool, either per role or centrally.', href: '/docs/guides/extending-mcp' },
  { icon: '🧩', title: 'Extending: Models', desc: 'Add a new model to the platform catalog, configuration only.', href: '/docs/guides/extending-models' },
  { icon: '📊', title: 'Operations & Monitoring', desc: 'See live status, steer the fleet (pause, drain, target, resume), and wire notifications.', href: '/docs/guides/operations' },
  { icon: '🔍', title: 'Troubleshooting', desc: 'What a stuck state means, symptom by symptom, and how to recover.', href: '/docs/guides/troubleshooting' },
  { icon: '🎫', title: 'First Issue Walkthrough', desc: 'Follow one issue from creation to a merged pull request. (Get Started)', href: '/docs/getting-started/first-issue' },
  { icon: '🙋', title: 'Handling Escalations', desc: 'Why you get pinged and how to resolve a ticket that needs you. (Core Concepts)', href: '/docs/concepts/human-escalation' },
  { icon: '🧩', title: 'Extending with a New Role', desc: "The one extension that touches the system's internals. (See the Agent Registry)", href: '/docs/concepts/agent-registry' },
];
---

<DocsLayout breadcrumbs={[{ label: 'Docs', href: '/docs' }, { label: 'Guides' }]}>
  <h1>Guides</h1>
  <p>
    The guides walk you through real, practical tasks with OpenFlows — the things you'll do
    again and again as an operator or an extender of a team. Each guide is self-contained and
    includes what you should see at each step.
  </p>
  <p>
    Choose the guide that matches what you're trying to accomplish. Each page assumes you've
    completed the Quickstart, and throughout, keep two partnership ideas in mind: Coder
    governs <strong>where</strong> agents run, while OpenFlows governs <strong>how</strong>
    they coordinate.
  </p>
  <DocCards cards={CARDS} />
</DocsLayout>
