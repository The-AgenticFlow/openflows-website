---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const insights = await getCollection('insights');
  const toSafeSlug = (rawSlug) => rawSlug
    .toString()
    .trim()
    .toLowerCase()
    .replace(/&/g, ' and ')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

  return insights.map((insight) => ({
    params: { slug: toSafeSlug(insight.data.slug || insight.slug) },
    props: { insight },
  }));
}

const { insight } = Astro.props;
const { Content } = await render(insight);

const formatDate = (d) => {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const authors = insight.data.author_name
  ? [{ name: insight.data.author_name }]
  : [];

const readTime = insight.data.read_time_minutes || Math.max(1, Math.ceil((insight.body || '').split(/\s+/).length / 200));
---

<BaseLayout
  title={`${insight.data.title} - OpenFlows`}
  description={insight.data.excerpt}
  ogImage={insight.data.cover_image_url}
>
  <main class="insight-post-page">
    <article class="insight-post-article">
      <header class="insight-post-header">
        <h1 style="font-size: 1.9rem; font-weight: 700; line-height: 1.25; margin-bottom: 1rem;">{insight.data.title}</h1>
        <p style="font-size: 1.125rem; color: var(--color-graphite); margin-bottom: 1.5rem;">{insight.data.excerpt}</p>
        <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; font-size: 0.875rem; color: var(--color-graphite);">
          {authors.map((author) => (
            <span>{author.name}</span>
          ))}
          {authors.length > 0 && <span>·</span>}
          <span>{formatDate(insight.data.published_at)}</span>
          <span>·</span>
          <span>{readTime} min read</span>
        </div>
      </header>

      {insight.data.cover_image_url && (
        <div class="insight-cover-image">
          <img src={insight.data.cover_image_url} alt={insight.data.title} />
        </div>
      )}

      <div class="insight-content">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,400;0,700;1,400&display=swap");

  :global(html),
  :global(body) {
    background: #ffffff;
  }

  .insight-post-page {
    min-height: 100vh;
    background: #ffffff;
  }

  .insight-post-article {
    max-width: 900px;
    margin: 0 auto;
    padding: calc(3rem + var(--nav-height)) 2rem 3rem;
  }

  .insight-post-header,
  .insight-cover-image {
    margin-inline: auto;
  }

  .insight-post-header {
    margin-bottom: 2rem;
    text-align: left;
  }

  .insight-cover-image {
    margin-bottom: 2rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .insight-cover-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .insight-content {
    color: #242424;
    font-family: source-serif-pro, "Source Serif 4", Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 31.2px;
    letter-spacing: 0;
    text-align: left;
    text-rendering: optimizelegibility;
    -webkit-font-smoothing: antialiased;
  }

  .insight-content :global(h2) {
    color: #242424;
    font-family: source-serif-pro, "Source Serif 4", Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.25;
    margin: 2.2em 0 0.7em;
    text-align: left;
  }
  .insight-content :global(h3) {
    color: #242424;
    font-family: source-serif-pro, "Source Serif 4", Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 1.8em 0 0.65em;
    text-align: left;
  }
  .insight-content :global(p) {
    color: #242424;
    font-family: source-serif-pro, "Source Serif 4", Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 31.2px;
    margin: 1.56em 0 -0.46em;
    text-align: left;
  }
  .insight-content :global(ul), .insight-content :global(ol) {
    color: #242424;
    font-family: source-serif-pro, "Source Serif 4", Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 20px;
    line-height: 31.2px;
    margin: 1.56em 0 -0.46em;
    padding-left: 1.5rem;
    text-align: left;
  }
  .insight-content :global(li) {
    margin-bottom: 0.75em;
    text-align: left;
  }
  .insight-content :global(pre) {
    background: var(--color-ink);
    color: var(--color-parchment);
    padding: 1rem;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .insight-content :global(code) {
    font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
    font-size: 0.875rem;
  }
  .insight-content :global(:not(pre) > code) {
    background: var(--color-bone);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
  }
  .insight-content :global(blockquote) {
    border-left: 3px solid var(--color-aubergine);
    color: #242424;
    font-style: italic;
    margin: 1.8em 0 0.4em;
    padding-left: 1rem;
    text-align: left;
  }
  .insight-content :global(img) {
    max-width: 100%;
    border-radius: var(--radius-md);
    display: block;
    margin: 2rem auto;
  }
  .insight-content :global(a) {
    color: var(--color-aubergine);
    text-decoration: underline;
  }
  .insight-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-family);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 2rem 0;
    text-align: left;
  }
  .insight-content :global(th), .insight-content :global(td) {
    border: 1px solid var(--color-driftwood);
    padding: 0.75rem;
    text-align: left;
    vertical-align: top;
  }
</style>
