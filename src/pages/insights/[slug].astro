---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const insights = await getCollection('insights');
  const toSafeSlug = (rawSlug) => rawSlug
    .toString()
    .trim()
    .toLowerCase()
    .replace(/&/g, ' and ')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

  return insights.map((insight) => ({
    params: { slug: toSafeSlug(insight.data.slug || insight.slug) },
    props: { insight },
  }));
}

const { insight } = Astro.props;
const { Content } = await render(insight);

const formatDate = (d) => {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const authors = insight.data.author_name
  ? [{ name: insight.data.author_name }]
  : [];

const readTime = insight.data.read_time_minutes || Math.max(1, Math.ceil((insight.body || '').split(/\s+/).length / 200));
---

<BaseLayout
  title={`${insight.data.title} - OpenFlows`}
  description={insight.data.excerpt}
  ogImage={insight.data.cover_image_url}
>
  <main class="of-article">
    <article>
      <header class="of-article-inner">
        <a href="/#how-it-works" class="of-back">← Back to OpenFlows</a>
        <div class="of-article-kicker">
          <span>Insight</span>
          <span class="sep">/</span>
          <span class="muted">{readTime} min read</span>
        </div>
        <h1 class="of-article-title">{insight.data.title}</h1>
        {insight.data.excerpt && <p class="of-article-dek">{insight.data.excerpt}</p>}
        <div class="of-article-meta">
          {authors.map((author, i) => (
            <>{i > 0 && <span class="dot">·</span>}<span>{author.name}</span></>
          ))}
          {authors.length > 0 && <span class="dot">·</span>}
          <span>{formatDate(insight.data.published_at)}</span>
        </div>
      </header>

      {insight.data.cover_image_url && (
        <div class="of-article-cover">
          <img src={insight.data.cover_image_url} alt={insight.data.title} />
        </div>
      )}

      <div class="of-article-body of-prose">
        <Content />
      </div>

      <aside class="of-read-cta">
        <div>
          <b>Evaluate OpenFlows on one repository.</b>
          <span>Customer-managed, open source, and auditable from issue to merge.</span>
        </div>
        <a href="/enterprise" class="of-btn of-btn-primary">For organizations</a>
      </aside>
    </article>
  </main>
</BaseLayout>
