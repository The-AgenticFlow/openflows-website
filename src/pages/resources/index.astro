---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PostRow from '@/components/blog/PostRow.astro';
import { getPublishedPosts } from '@/components/blog/blog';
import ContentRow from '@/components/content/ContentRow.astro';
import MetaLine from '@/components/content/MetaLine.astro';
import { formatStoryDate, getStories } from '@/components/stories/stories';

const posts = await getPublishedPosts();

const research = (await getCollection('research'))
  .filter((item) => item.data.status === 'published' && !item.data.is_draft)
  .sort((a, b) => (b.data.publish_date?.getTime() ?? 0) - (a.data.publish_date?.getTime() ?? 0));

const stories = getStories();

const formatDate = (date?: Date) =>
  date ? date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '';

const tabs = [
  { id: 'blog', label: 'Blog posts', count: posts.length },
  { id: 'research', label: 'Research', count: research.length },
  { id: 'stories', label: 'Case studies', count: stories.length },
];
---

<BaseLayout title="Resources - OpenFlows" description="Blog posts, research papers, and case studies from the OpenFlows team.">
  <main class="resources">
    <header class="resources-header">
      <h1>Resources</h1>
      <p>Blog posts, research papers, and case studies from the OpenFlows team and community.</p>
    </header>

    <div class="resources-tabs" role="tablist" aria-label="Resource type">
      {tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          class="resources-tab"
          aria-controls={tab.id}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-tab={tab.id}
        >
          {tab.label}
          <span class="resources-tab-count">{tab.count}</span>
        </button>
      ))}
    </div>

    <section id="blog" class="resources-panel" role="tabpanel" aria-labelledby="tab-blog">
      {posts.length > 0 ? (
        <>
          {posts.map((post) => <PostRow post={post} />)}
          <p class="resources-more"><a href="/blog">Open the blog</a></p>
        </>
      ) : (
        <p class="resources-empty">No blog posts yet. New essays appear here as soon as they are published.</p>
      )}
    </section>

    <section id="research" class="resources-panel" role="tabpanel" aria-labelledby="tab-research" hidden>
      {research.length > 0 ? (
        research.map((item) => (
          <ContentRow
            href={`/research/${(item.data.slug || item.slug).trim()}`}
            title={item.data.title}
            category={item.data.category}
            summary={item.data.abstract}
            image={item.data.cover_image_url}
          >
            <MetaLine
              items={[
                item.data.authors?.length && {
                  label: item.data.authors.map((author) => author.name).join(', '),
                  emphasis: true,
                },
                item.data.publish_date && {
                  label: formatDate(item.data.publish_date),
                  datetime: item.data.publish_date.toISOString(),
                },
                item.data.venue && { label: item.data.venue },
              ]}
            />
          </ContentRow>
        ))
      ) : (
        <p class="resources-empty">No research papers yet. Publications appear here once they are released.</p>
      )}
    </section>

    <section id="stories" class="resources-panel" role="tabpanel" aria-labelledby="tab-stories" hidden>
      {stories.length > 0 ? (
        stories.map((story) => (
          <ContentRow
            href={story.href}
            title={story.title}
            category={story.category}
            summary={story.summary}
            image={story.image}
          >
            <MetaLine
              items={[
                story.date && { label: formatStoryDate(story.date), datetime: story.date.toISOString() },
              ]}
            />
          </ContentRow>
        ))
      ) : (
        <p class="resources-empty">No case studies yet. Stories from teams using OpenFlows appear here.</p>
      )}
    </section>
  </main>

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.resources-tab'));

    const selectTab = (tab: HTMLButtonElement, { focus = false, updateUrl = true } = {}) => {
      tabs.forEach((other) => {
        const selected = other === tab;
        other.setAttribute('aria-selected', String(selected));
        other.tabIndex = selected ? 0 : -1;
        const panel = document.getElementById(other.dataset.tab ?? '');
        if (panel) panel.hidden = !selected;
      });
      if (focus) tab.focus();
      if (updateUrl) history.replaceState(null, '', `#${tab.dataset.tab}`);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', (event) => {
        const keys: Record<string, number> = {
          ArrowRight: (index + 1) % tabs.length,
          ArrowLeft: (index - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        if (event.key in keys) {
          event.preventDefault();
          selectTab(tabs[keys[event.key]], { focus: true });
        }
      });
    });

    const fromHash = tabs.find((tab) => tab.dataset.tab === window.location.hash.slice(1));
    if (fromHash) selectTab(fromHash, { updateUrl: false });
  </script>
</BaseLayout>

<style>
  .resources {
    max-width: var(--max-width-6xl);
    margin: 0 auto;
    padding: calc(var(--nav-height) + 4rem) 2rem 6rem;
  }

  .resources-header {
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }

  .resources-header h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .resources-header p {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--color-graphite);
  }

  .resources-tabs {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
    overflow-x: auto;
    border-bottom: 1px solid var(--color-driftwood);
    scrollbar-width: none;
  }

  .resources-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    margin-bottom: -1px;
    padding: 0.875rem 1rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    font: inherit;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-graphite);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .resources-tab:hover {
    color: var(--color-ink);
  }

  .resources-tab[aria-selected='true'] {
    color: var(--color-ink);
    border-bottom-color: var(--color-aubergine);
  }

  .resources-tab:focus-visible {
    outline: 2px solid var(--color-aubergine);
    outline-offset: -2px;
    border-radius: var(--radius-sm);
  }

  .resources-tab-count {
    min-width: 1.5rem;
    padding: 0.0625rem 0.4375rem;
    border-radius: 999px;
    background: var(--color-fog);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-graphite);
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .resources-tab[aria-selected='true'] .resources-tab-count {
    background: var(--color-lavender-chip);
    color: var(--color-aubergine);
  }

  .resources-panel :global(.content-row:first-child) {
    border-top: 0;
  }

  .resources-more {
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-driftwood);
    font-weight: 600;
  }

  .resources-more a {
    color: var(--color-aubergine);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--transition-fast);
  }

  .resources-more a:hover {
    text-decoration-color: currentColor;
  }

  .resources-empty {
    padding-block: 3rem;
    color: var(--color-graphite);
  }

  @media (max-width: 640px) {
    .resources {
      padding: calc(var(--nav-height) + 2.5rem) 1rem 4rem;
    }

    .resources-tabs {
      gap: 0;
    }

    .resources-tab {
      gap: 0.375rem;
      padding: 0.75rem 0.375rem;
      font-size: 0.875rem;
    }
  }
</style>
