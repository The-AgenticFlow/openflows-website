---
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const modules = import.meta.glob('/src/content/stories/*.md', { eager: true });
  return Object.entries(modules).map(([path, mod]) => {
    const slug = path.split('/').pop().replace('.md', '');
    const fm = mod.frontmatter || {};
    return {
      params: { slug },
      props: { story: { ...fm, Content: mod.Content, slug } },
    };
  });
}

const { story } = Astro.props;
const { Content, title, category, date, image, slug } = story;

const formatDate = (d) => {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<BaseLayout
  title={`${title} - OpenFlows Stories`}
  description={`${category} - ${title}`}
  ogImage={image}
>
  <article style="max-width: 900px; margin: 0 auto; padding: calc(3rem + var(--nav-height)) 2rem 3rem;">
    <header style="margin-bottom: 2rem;">
      <a href="/resources#stories" style="font-size: 0.875rem; color: var(--color-graphite); display: inline-block; margin-bottom: 1rem;">← Back to Case Studies</a>
      <div style="display: flex; gap: 0.75rem; margin-bottom: 0.75rem; font-size: 0.875rem; color: var(--color-graphite); flex-wrap: wrap;">
        <span style="text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">{category}</span>
        {date && <><span>·</span><span>{formatDate(date)}</span></>}
      </div>
      <h1 style="font-size: 2.5rem; font-weight: 700; line-height: 1.2; margin-bottom: 1rem;">{title}</h1>
    </header>

    {image && (
      <div style="margin-bottom: 2rem; border-radius: var(--radius-lg); overflow: hidden;">
        <img src={image} alt={title} style="width: 100%; height: auto; display: block;" />
      </div>
    )}

    <div class="story-content" style="font-size: 1.125rem; line-height: 1.8; color: var(--color-ink);">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .story-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 2rem 0 1rem;
  }
  .story-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 1.5rem 0 0.75rem;
  }
  .story-content :global(p) {
    margin-bottom: 1rem;
    line-height: 1.7;
  }
  .story-content :global(ul), .story-content :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  .story-content :global(li) {
    margin-bottom: 0.5rem;
  }
  .story-content :global(pre) {
    background: var(--color-ink);
    color: var(--color-parchment);
    padding: 1rem;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .story-content :global(code) {
    font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
    font-size: 0.875rem;
  }
  .story-content :global(:not(pre) > code) {
    background: var(--color-bone);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
  }
  .story-content :global(blockquote) {
    border-left: 3px solid var(--color-aubergine);
    padding-left: 1rem;
    margin: 1rem 0;
    color: var(--color-graphite);
  }
  .story-content :global(img) {
    max-width: 100%;
    border-radius: var(--radius-md);
    margin: 1rem 0;
  }
  .story-content :global(a) {
    color: var(--color-aubergine);
    text-decoration: underline;
  }
</style>
