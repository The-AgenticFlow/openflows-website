---
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const modules = import.meta.glob('/src/content/stories/*.md', { eager: true });
  return Object.entries(modules).map(([path, mod]) => {
    const slug = path.split('/').pop().replace('.md', '');
    const fm = mod.frontmatter || {};
    return {
      params: { slug },
      props: { story: { ...fm, Content: mod.Content, slug } },
    };
  });
}

const { story } = Astro.props;
const { Content, title, category, date, image, slug } = story;

const formatDate = (d) => {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<BaseLayout
  title={`${title} - OpenFlows Stories`}
  description={`${category} - ${title}`}
  ogImage={image}
>
  <article class="story-page" style="max-width: 900px; margin: 0 auto; padding: calc(3rem + var(--nav-height)) 2rem 3rem;">
    <header style="margin-bottom: 2rem;">
      <a href="/resources#stories" style="font-size: 0.875rem; color: var(--color-graphite); display: inline-block; margin-bottom: 1rem;">← Back to Case Studies</a>
      <div style="display: flex; gap: 0.75rem; margin-bottom: 0.75rem; font-size: 0.875rem; color: var(--color-graphite); flex-wrap: wrap;">
        <span style="text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">{category}</span>
        {date && <><span>·</span><span>{formatDate(date)}</span></>}
      </div>
      <h1 style="font-size: 2.5rem; font-weight: 700; line-height: 1.2; margin-bottom: 1rem;">{title}</h1>
    </header>

    {image && (
      <div style="margin-bottom: 2rem; border-radius: var(--radius-lg); overflow: hidden;">
        <img src={image} alt={title} style="width: 100%; height: auto; display: block;" />
      </div>
    )}

    <div class="story-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,400;0,700;1,400&display=swap");

  :global(html),
  :global(body),
  .story-page {
    background: #ffffff;
  }

  .story-content {
    color: #242424;
    font-family: source-serif-pro, "Source Serif 4", Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 31.2px;
    text-rendering: optimizelegibility;
    -webkit-font-smoothing: antialiased;
  }

  .story-content :global(h2) {
    color: #242424;
    font-family: source-serif-pro, "Source Serif 4", Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.25;
    margin: 2.2em 0 0.7em;
  }
  .story-content :global(h3) {
    color: #242424;
    font-family: source-serif-pro, "Source Serif 4", Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 1.8em 0 0.65em;
  }
  .story-content :global(p) {
    color: #242424;
    font-family: source-serif-pro, "Source Serif 4", Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 31.2px;
    margin: 1.56em 0 -0.46em;
  }
  .story-content :global(ul), .story-content :global(ol) {
    color: #242424;
    font-family: source-serif-pro, "Source Serif 4", Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 20px;
    line-height: 31.2px;
    margin: 1.56em 0 -0.46em;
    padding-left: 1.5rem;
  }
  .story-content :global(li) {
    margin-bottom: 0.75em;
  }
  .story-content :global(pre) {
    background: var(--color-ink);
    color: var(--color-parchment);
    padding: 1rem;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .story-content :global(code) {
    font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
    font-size: 0.875rem;
  }
  .story-content :global(:not(pre) > code) {
    background: var(--color-bone);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
  }
  .story-content :global(blockquote) {
    border-left: 3px solid var(--color-aubergine);
    color: #242424;
    font-style: italic;
    margin: 1.8em 0 0.4em;
    padding-left: 1rem;
  }
  .story-content :global(img) {
    max-width: 100%;
    border-radius: var(--radius-md);
    display: block;
    margin: 2rem auto;
  }
  .story-content :global(a) {
    color: var(--color-aubergine);
    text-decoration: underline;
  }
  .story-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-family);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 2rem 0;
  }
  .story-content :global(th), .story-content :global(td) {
    border: 1px solid var(--color-driftwood);
    padding: 0.75rem;
    vertical-align: top;
  }
</style>
