---
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const modules = import.meta.glob('/src/content/stories/*.md', { eager: true });
  return Object.entries(modules).map(([path, mod]) => {
    const slug = path.split('/').pop().replace('.md', '');
    const fm = mod.frontmatter || {};
    return {
      params: { slug },
      props: { story: { ...fm, Content: mod.Content, slug } },
    };
  });
}

const { story } = Astro.props;
const { Content, title, category, date, image, slug } = story;

const formatDate = (d) => {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<BaseLayout
  title={`${title} - OpenFlows Stories`}
  description={`${category} - ${title}`}
  ogImage={image}
>
  <main class="of-article">
    <article>
      <header class="of-article-inner">
        <a href="/resources#stories" class="of-back">← Back to case studies</a>
        <div class="of-article-kicker">
          <span>{category || 'Case study'}</span>
          {date && <><span class="sep">/</span><span class="muted">{formatDate(date)}</span></>}
        </div>
        <h1 class="of-article-title">{title}</h1>
      </header>

      {image && (
        <div class="of-article-cover">
          <img src={image} alt={title} />
        </div>
      )}

      <div class="of-article-body of-prose">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>
