---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const tinaConfigured = import.meta.env.PUBLIC_TINA_CLIENT_ID;
const tinaBranch = import.meta.env.GITHUB_BRANCH || 'master';

// Get counts for display
const blogs = await getCollection('blogs');
const research = await getCollection('research');
const stories = await getCollection('stories');
---

<BaseLayout title="Admin Dashboard - OpenFlows">
  <div style="max-width: 1000px; margin: 0 auto; padding: 4rem 2rem;">
    <div style="margin-bottom: 3rem;">
      <p style="font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-aubergine); margin-bottom: 0.5rem;">Admin</p>
      <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem;">Content Dashboard</h1>
      <p style="color: var(--color-graphite);">Manage website content with Tina CMS and track articles.</p>
    </div>
    
    <!-- Tina Cloud Studio Access -->
    <div style="background: linear-gradient(135deg, var(--color-aubergine) 0%, #4a1a4a 100%); color: white; padding: 2rem; border-radius: var(--radius-lg); margin-bottom: 2rem;">
      <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
        </svg>
        <h2 style="font-size: 1.5rem; margin: 0;">Tina Cloud Studio</h2>
      </div>
      
      <p style="opacity: 0.9; margin-bottom: 1.5rem; line-height: 1.6;">
        Access the visual content editor to create and edit articles, research papers, and stories directly in your browser.
      </p>
      
      {tinaConfigured ? (
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <a href={`https://app.tina.io/studio/${tinaBranch}`} 
             target="_blank"
             rel="noopener"
             style="display: inline-flex; align-items: center; gap: 0.5rem; background: white; color: var(--color-aubergine); padding: 0.75rem 1.5rem; border-radius: var(--radius-md); font-weight: 600; text-decoration: none;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
            Open Tina Studio
          </a>
        </div>
      ) : (
        <div style="background: rgba(255,255,255,0.1); padding: 1rem; border-radius: var(--radius-md);">
          <p style="margin: 0; font-size: 0.875rem;">
            <strong>Setup Required:</strong> Configure Tina Cloud credentials in GitHub Secrets to enable the visual editor.
          </p>
          <details style="margin-top: 1rem; font-size: 0.875rem;">
            <summary style="cursor: pointer; text-decoration: underline;">How to configure</summary>
            <ol style="margin-top: 0.5rem; padding-left: 1.25rem; opacity: 0.9;">
              <li>Go to <a href="https://app.tina.io" target="_blank" style="color: white;">app.tina.io</a> and create an account</li>
              <li>Connect your GitHub repository to Tina Cloud</li>
              <li>Copy the Client ID from Tina Cloud settings</li>
              <li>Generate an API token</li>
              <li>Add <code>TINA_TOKEN</code> and <code>PUBLIC_TINA_CLIENT_ID</code> to GitHub Secrets</li>
            </ol>
          </details>
        </div>
      )}
    </div>
    
    <!-- Quick Stats -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
      <div style="padding: 1.5rem; background: var(--color-bone); border-radius: var(--radius-md); text-align: center;">
        <p style="font-size: 2.5rem; font-weight: 700; color: var(--color-aubergine); margin: 0;">{blogs.length}</p>
        <p style="font-size: 0.875rem; color: var(--color-graphite); margin: 0;">Blog Posts</p>
      </div>
      <div style="padding: 1.5rem; background: var(--color-bone); border-radius: var(--radius-md); text-align: center;">
        <p style="font-size: 2.5rem; font-weight: 700; color: var(--color-aubergine); margin: 0;">{research.length}</p>
        <p style="font-size: 0.875rem; color: var(--color-graphite); margin: 0;">Research Papers</p>
      </div>
      <div style="padding: 1.5rem; background: var(--color-bone); border-radius: var(--radius-md); text-align: center;">
        <p style="font-size: 2.5rem; font-weight: 700; color: var(--color-aubergine); margin: 0;">{stories.length}</p>
        <p style="font-size: 0.875rem; color: var(--color-graphite); margin: 0;">Success Stories</p>
      </div>
    </div>
    
    <!-- Quick Actions -->
    <div style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.25rem; margin-bottom: 1rem;">Quick Actions</h2>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <a href="/blog" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem; background: var(--color-bone); color: var(--color-ink); border-radius: var(--radius-md); text-decoration: none; font-weight: 500;">
          View Blog
        </a>
        <a href="/research" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem; background: var(--color-bone); color: var(--color-ink); border-radius: var(--radius-md); text-decoration: none; font-weight: 500;">
          View Research
        </a>
        <a href="https://github.com/The-AgenticFlow/openflows-website/tree/main/src/content" target="_blank" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem; background: #24292e; color: white; border-radius: var(--radius-md); text-decoration: none; font-weight: 500;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub Content
        </a>
      </div>
    </div>
    
    <!-- Giscus Comments Info -->
    <div style="padding: 1.5rem; background: var(--color-bone); border-radius: var(--radius-lg); margin-bottom: 2rem;">
      <h2 style="font-size: 1.25rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1-3.8a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
        Interactive Comments
      </h2>
      <p style="color: var(--color-graphite); margin-bottom: 1rem;">
        Each article has a GitHub Discussions-powered comment section at the bottom. Readers can comment directly on articles, and those comments become GitHub Discussions automattically.
      </p>
      <a href="https://github.com/apps/giscus" target="_blank" style="display: inline-flex; align-items: center; gap: 0.5rem; color: var(--color-aubergine); font-weight: 500;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        Configure Giscus on GitHub
      </a>
    </div>
    
    <!-- Resources -->
    <div style="padding: 1.5rem; background: var(--color-bone); border-radius: var(--radius-lg);">
      <h2 style="font-size: 1.25rem; margin-bottom: 1rem;">Resources</h2>
      <div style="display: grid; gap: 0.75rem;">
        <a href="https://tina.io/docs/" target="_blank" style="display: flex; align-items: center; gap: 0.5rem; color: var(--color-graphite); text-decoration: none; padding: 0.75rem; background: white; border-radius: var(--radius-md);">
          <span style="font-size: 1.25rem;">📚</span>
          <span>Tina CMS Documentation</span>
        </a>
        <a href="https://giscus.app/" target="_blank" style="display: flex; align-items: center; gap: 0.5rem; color: var(--color-graphite); text-decoration: none; padding: 0.75rem; background: white; border-radius: var(--radius-md);">
          <span style="font-size: 1.25rem;">💬</span>
          <span>Giscus Comments Setup</span>
        </a>
        <a href="https://github.com/The-AgenticFlow/openflows-website/actions" target="_blank" style="display: flex; align-items: center; gap: 0.5rem; color: var(--color-graphite); text-decoration: none; padding: 0.75rem; background: white; border-radius: var(--radius-md);">
          <span style="font-size: 1.25rem;">⚙️</span>
          <span>GitHub Actions (Build Status)</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
