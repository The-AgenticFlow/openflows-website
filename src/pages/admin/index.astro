---
import BaseLayout from '@/layouts/BaseLayout.astro';
const tinaConfigured = import.meta.env.PUBLIC_TINA_CLIENT_ID;
---

<BaseLayout title="Content Management - OpenFlows">
  <div style="max-width: 800px; margin: 0 auto; padding: 4rem 2rem; text-align: center;">
    <h1 style="font-size: 2.5rem; margin-bottom: 2rem;">Content Management</h1>
    
    <div style="padding: 2rem; background: var(--color-bone); border-radius: var(--radius-lg); margin-bottom: 2rem;">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 1rem; color: var(--color-aubergine);">
        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
      </svg>
      <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">Tina CMS</h2>
      <p style="color: var(--color-graphite); margin-bottom: 1.5rem;">
        This website uses Tina CMS for content management. 
        Edit content directly in your browser with a visual editor.
      </p>
      
      {tinaConfigured ? (
        <a href="/admin/index.html" 
           style="display: inline-block; background: var(--color-aubergine); color: white; padding: 0.75rem 1.5rem; border-radius: var(--radius-md); font-weight: 600;">
          Open Content Editor
        </a>
      ) : (
        <div style="background: #fef3c7; border: 1px solid #fbbf24; padding: 1rem; border-radius: var(--radius-md); text-align: left;">
          <p style="color: #92400e; font-size: 0.875rem; margin: 0;">
            <strong>Setup Required:</strong> Tina CMS is configured but needs environment variables for the visual editor.
            Run <code>npm run dev</code> to start the content editor locally.
          </p>
        </div>
      )}
    </div>
    
    <div style="text-align: left; margin-top: 2rem;">
      <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Managing Content</h3>
      <ul style="color: var(--color-graphite); line-height: 2;">
        <li><strong>Blog Posts:</strong> Edit markdown files in <code>src/content/blogs/</code></li>
        <li><strong>Research Papers:</strong> Edit markdown files in <code>src/content/research/</code></li>
        <li><strong>Stories:</strong> Edit markdown files in <code>src/content/stories/</code></li>
      </ul>
      
      <p style="color: var(--color-graphite); margin-top: 2rem; font-size: 0.875rem;">
        Content changes are automatically reflected when you rebuild the site with <code>npm run build</code>.
      </p>
    </div>
  </div>
</BaseLayout>
