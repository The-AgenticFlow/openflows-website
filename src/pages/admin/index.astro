---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const tinaConfigured = import.meta.env.PUBLIC_TINA_CLIENT_ID;
const tinaBranch = import.meta.env.GITHUB_BRANCH || 'master';

// Detect environment - production has PUBLIC_TINA_CLIENT_ID set
const isProduction = Boolean(tinaConfigured);
const isDevelopment = !isProduction && typeof window !== 'undefined' && window.location.hostname === 'localhost';

// Get counts for display (all content)
const blogs = await getCollection('blogs');
const research = await getCollection('research');
const stories = await getCollection('stories');

// Count published content
const publishedBlogs = blogs.filter(b => b.data.status === 'published').length;
const publishedResearch = research.filter(r => r.data.status === 'published').length;
const publishedStories = stories.length;
---

<BaseLayout title="Admin Dashboard - OpenFlows">
  <div style="max-width: 1000px; margin: 0 auto; padding: 4rem 2rem;">
    <div style="margin-bottom: 3rem;">
      <p style="font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-aubergine); margin-bottom: 0.5rem;">Admin</p>
      <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem;">Content Dashboard</h1>
      <p style="color: var(--color-graphite);">Create and publish content that appears on the public website.</p>
    </div>
    
    <!-- How to Publish Section -->
    <div style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; padding: 2rem; border-radius: var(--radius-lg); margin-bottom: 2rem;">
      <h2 style="font-size: 1.5rem; margin: 0 0 1.5rem 0; display: flex; align-items: center; gap: 0.75rem;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        How to Publish Content
      </h2>
      
      <div style="display: grid; gap: 1.5rem;">
        <div style="display: flex; gap: 1rem; align-items: flex-start;">
          <div style="width: 32px; height: 32px; background: white; color: #059669; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">1</div>
          <div>
            <p style="font-weight: 600; margin: 0 0 0.25rem 0;">Open Tina CMS Studio</p>
            <p style="opacity: 0.9; margin: 0; font-size: 0.875rem;">
              {isProduction ? (
                <>
                  Click the "Open Tina Studio" button below to access the visual content editor
                </>
              ) : (
                <>
                  Run <code style="background: rgba(0,0,0,0.2); padding: 0.125rem 0.375rem; border-radius: 4px;">npm run dev</code> then visit <a href="http://localhost:4321/admin" style="color: white; text-decoration: underline;">http://localhost:4321/admin</a>
                </>
              )}
            </p>
          </div>
        </div>
        
        <div style="display: flex; gap: 1rem; align-items: flex-start;">
          <div style="width: 32px; height: 32px; background: white; color: #059669; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">2</div>
          <div>
            <p style="font-weight: 600; margin: 0 0 0.25rem 0;">Create New Content</p>
            <p style="opacity: 0.9; margin: 0; font-size: 0.875rem;">In Tina Studio, click "Create" and select your content type (Blog, Research, or Case Study)</p>
          </div>
        </div>
        
        <div style="display: flex; gap: 1rem; align-items: flex-start;">
          <div style="width: 32px; height: 32px; background: white; color: #059669; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">3</div>
          <div>
            <p style="font-weight: 600; margin: 0 0 0.25rem 0;">Set Status to "Published"</p>
            <p style="opacity: 0.9; margin: 0; font-size: 0.875rem;">In the content editor, change status to "Published" and click "Save"</p>
          </div>
        </div>
        
        <div style="display: flex; gap: 1rem; align-items: flex-start;">
          <div style="width: 32px; height: 32px; background: white; color: #059669; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">4</div>
          <div>
            <p style="font-weight: 600; margin: 0 0 0.25rem 0;">Auto-Deploy</p>
            <p style="opacity: 0.9; margin: 0; font-size: 0.875rem;">Tina auto-commits changes to GitHub - the site rebuilds and deploys automatically!</p>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Tina Cloud / Local Access -->
    <div style="background: linear-gradient(135deg, var(--color-aubergine) 0%, #4a1a4a 100%); color: white; padding: 2rem; border-radius: var(--radius-lg); margin-bottom: 2rem;">
      <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
        </svg>
        <h2 style="font-size: 1.5rem; margin: 0;">Tina CMS Studio</h2>
      </div>
      
      {isProduction ? (
        <div>
          <p style="opacity: 0.9; margin-bottom: 1.5rem;">
            Access Tina Cloud Studio from app.tina.io. Create and edit blog posts, research papers, and case studies right in your browser.
          </p>
          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href={`https://app.tina.io/studio/${tinaBranch}`} 
               target="_blank"
               rel="noopener"
               style="display: inline-flex; align-items: center; gap: 0.5rem; background: white; color: var(--color-aubergine); padding: 0.75rem 1.5rem; border-radius: var(--radius-md); font-weight: 600; text-decoration: none;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
              Open Tina Cloud Studio
            </a>
            <a href="https://app.tina.io" 
               target="_blank"
               rel="noopener"
               style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: rgba(255,255,255,0.2); color: white; border-radius: var(--radius-md); text-decoration: none; font-weight: 500;">
              Go to app.tina.io
            </a>
          </div>
          <p style="margin-top: 1rem; font-size: 0.75rem; opacity: 0.7;">
            Note: The visual editor works from app.tina.io, not from this site's /admin route (GitHub Pages CSP blocks it).
          </p>
        </div>
      ) : (
        <div style="background: rgba(255,255,255,0.1); padding: 1rem; border-radius: var(--radius-md);">
          <p style="margin: 0 0 0.5rem 0;">Local Development Mode:</p>
          <p style="margin: 0; font-size: 0.875rem; opacity: 0.9;">
            Run <code style="background: rgba(0,0,0,0.2); padding: 0.125rem 0.375rem; border-radius: 4px;">npm run dev</code> to start the local development server.
          </p>
          <a href="http://localhost:4321/admin" style="display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1rem; background: white; color: var(--color-aubergine); padding: 0.75rem 1.5rem; border-radius: var(--radius-md); font-weight: 600; text-decoration: none;">
            Go to Local Admin
          </a>
        </div>
      )}
    </div>
    
    <!-- Content Stats -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
      <div style="padding: 1.5rem; background: var(--color-bone); border-radius: var(--radius-md); text-align: center;">
        <p style="font-size: 2.5rem; font-weight: 700; color: var(--color-aubergine); margin: 0;">{publishedBlogs}</p>
        <p style="font-size: 0.875rem; color: var(--color-graphite); margin: 0;">Published Blogs</p>
        <p style="font-size: 0.75rem; color: var(--color-graphite); margin: 0.5rem 0 0 0;">{blogs.length - publishedBlogs} drafts</p>
      </div>
      <div style="padding: 1.5rem; background: var(--color-bone); border-radius: var(--radius-md); text-align: center;">
        <p style="font-size: 2.5rem; font-weight: 700; color: var(--color-aubergine); margin: 0;">{publishedResearch}</p>
        <p style="font-size: 0.875rem; color: var(--color-graphite); margin: 0;">Published Research</p>
        <p style="font-size: 0.75rem; color: var(--color-graphite); margin: 0.5rem 0 0 0;">{research.length - publishedResearch} drafts</p>
      </div>
      <div style="padding: 1.5rem; background: var(--color-bone); border-radius: var(--radius-md); text-align: center;">
        <p style="font-size: 2.5rem; font-weight: 700; color: var(--color-aubergine); margin: 0;">{publishedStories}</p>
        <p style="font-size: 0.875rem; color: var(--color-graphite); margin: 0;">Case Studies</p>
      </div>
    </div>
    
    <!-- Quick Links -->
    <div style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.25rem; margin-bottom: 1rem;">Quick Links</h2>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <a href="/resources" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem; background: var(--color-aubergine); color: white; border-radius: var(--radius-md); text-decoration: none; font-weight: 600;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/>
          </svg>
          View Resources Page
        </a>
        <a href="/blog" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem; background: var(--color-bone); color: var(--color-ink); border-radius: var(--radius-md); text-decoration: none; font-weight: 500;">
          View Blog
        </a>
        <a href="/research" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem; background: var(--color-bone); color: var(--color-ink); border-radius: var(--radius-md); text-decoration: none; font-weight: 500;">
          View Research
        </a>
      </div>
    </div>
    
    <!-- Content Type Guide -->
    <div style="padding: 1.5rem; background: var(--color-bone); border-radius: var(--radius-lg);">
      <h2 style="font-size: 1.25rem; margin-bottom: 1rem;">Content Types</h2>
      <div style="display: grid; gap: 1rem;">
        <div style="padding: 1rem; background: white; border-radius: var(--radius-md); display: flex; gap: 1rem; align-items: center;">
          <div style="width: 48px; height: 48px; background: var(--color-aubergine); color: white; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">📝</div>
          <div>
            <p style="font-weight: 600; margin: 0;">Blog Posts</p>
            <p style="font-size: 0.875rem; color: var(--color-graphite); margin: 0;">Articles, announcements, and company updates. Set status to "Published" to make live.</p>
          </div>
        </div>
        <div style="padding: 1rem; background: white; border-radius: var(--radius-md); display: flex; gap: 1rem; align-items: center;">
          <div style="width: 48px; height: 48px; background: var(--color-aubergine); color: white; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">📄</div>
          <div>
            <p style="font-weight: 600; margin: 0;">Research Papers</p>
            <p style="font-size: 0.875rem; color: var(--color-graphite); margin: 0;">Academic papers, technical reports, and publications. Include venue and author info.</p>
          </div>
        </div>
        <div style="padding: 1rem; background: white; border-radius: var(--radius-md); display: flex; gap: 1rem; align-items: center;">
          <div style="width: 48px; height: 48px; background: var(--color-aubergine); color: white; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">🏆</div>
          <div>
            <p style="font-weight: 600; margin: 0;">Case Studies</p>
            <p style="font-size: 0.875rem; color: var(--color-graphite); margin: 0;">Success stories, customer highlights, and use case examples.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
