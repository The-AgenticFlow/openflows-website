---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const tinaConfigured = import.meta.env.PUBLIC_TINA_CLIENT_ID;

// Get counts for display
const blogs = await getCollection('blogs');
const research = await getCollection('research');
const stories = await getCollection('stories');
---

<BaseLayout title="Content Management - OpenFlows">
  <div style="max-width: 900px; margin: 0 auto; padding: 4rem 2rem;">
    <h1 style="font-size: 2.5rem; margin-bottom: 1rem;">Content Management</h1>
    <p style="color: var(--color-graphite); font-size: 1.125rem; margin-bottom: 3rem;">
      This website uses local markdown files for content, managed through Git-based workflows.
    </p>
    
    <!-- Content Stats -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 3rem;">
      <div style="padding: 1.5rem; background: var(--color-bone); border-radius: var(--radius-md); text-align: center;">
        <p style="font-size: 2rem; font-weight: 700; color: var(--color-aubergine); margin: 0;">{blogs.length}</p>
        <p style="font-size: 0.875rem; color: var(--color-graphite); margin: 0;">Blog Posts</p>
      </div>
      <div style="padding: 1.5rem; background: var(--color-bone); border-radius: var(--radius-md); text-align: center;">
        <p style="font-size: 2rem; font-weight: 700; color: var(--color-aubergine); margin: 0;">{research.length}</p>
        <p style="font-size: 0.875rem; color: var(--color-graphite); margin: 0;">Research Papers</p>
      </div>
      <div style="padding: 1.5rem; background: var(--color-bone); border-radius: var(--radius-md); text-align: center;">
        <p style="font-size: 2rem; font-weight: 700; color: var(--color-aubergine); margin: 0;">{stories.length}</p>
        <p style="font-size: 0.875rem; color: var(--color-graphite); margin: 0;">Stories</p>
      </div>
    </div>
    
    <!-- Tina CMS Info -->
    <div style="padding: 2rem; background: var(--color-bone); border-radius: var(--radius-lg); margin-bottom: 2rem; border-left: 4px solid var(--color-aubergine);">
      <h2 style="font-size: 1.25rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.75rem;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
        </svg>
        Tina CMS Visual Editor
      </h2>
      
      <p style="color: var(--color-graphite); margin-bottom: 1rem; line-height: 1.6;">
        For local development, Tina CMS provides a visual editor to edit content in your browser.
        This requires running the development server locally.
      </p>
      
      <div style="background: #1e1e1e; padding: 1rem; border-radius: var(--radius-md); margin-bottom: 1rem;">
        <p style="color: #10b981; font-family: monospace; font-size: 0.875rem; margin: 0;">
          npm run dev
        </p>
        <p style="color: #888; font-family: monospace; font-size: 0.75rem; margin: 0.5rem 0 0 0;">
          # Then visit http://localhost:4321/admin
        </p>
      </div>
      
      <p style="color: var(--color-graphite); font-size: 0.875rem;">
        <strong>Note:</strong> The visual editor only works locally, not on the deployed site, 
        due to Content Security Policy restrictions on GitHub Pages.
      </p>
    </div>
    
    <!-- Content Locations -->
    <div style="margin-top: 2rem;">
      <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Content Locations</h3>
      <div style="display: grid; gap: 1rem;">
        <div style="padding: 1rem; background: var(--color-bone); border-radius: var(--radius-md);">
          <p style="font-weight: 600; margin: 0 0 0.5rem 0;">Blog Posts</p>
          <p style="color: var(--color-graphite); font-size: 0.875rem; margin: 0; font-family: monospace;"><code>src/content/blogs/*.md</code></p>
        </div>
        <div style="padding: 1rem; background: var(--color-bone); border-radius: var(--radius-md);">
          <p style="font-weight: 600; margin: 0 0 0.5rem 0;">Research Papers</p>
          <p style="color: var(--color-graphite); font-size: 0.875rem; margin: 0; font-family: monospace;"><code>src/content/research/*.md</code></p>
        </div>
        <div style="padding: 1rem; background: var(--color-bone); border-radius: var(--radius-md);">
          <p style="font-weight: 600; margin: 0 0 0.5rem 0;">Success Stories</p>
          <p style="color: var(--color-graphite); font-size: 0.875rem; margin: 0; font-family: monospace;"><code>src/content/stories/*.md</code></p>
        </div>
      </div>
    </div>
    
    <!-- Workflow -->
    <div style="margin-top: 2rem;">
      <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Workflow</h3>
      <ol style="color: var(--color-graphite); line-height: 2; padding-left: 1.5rem;">
        <li>Clone the repository</li>
        <li>Run <code>npm install</code></li>
        <li>Run <code>npm run dev</code> to start the development server with Tina CMS</li>
        <li>Edit content through the visual editor or directly in markdown files</li>
        <li>Commit and push changes to trigger a rebuild</li>
        <li>The site automatically deploys to GitHub Pages</li>
      </ol>
    </div>
    
    <div style="margin-top: 2rem; padding: 1rem; background: #e0e7ff; border-radius: var(--radius-md); border: 1px solid #a5b4fc;">
      <p style="color: #3730a3; font-size: 0.875rem; margin: 0;">
        <strong>Tip:</strong> After pushing changes, the build takes about 1-2 minutes. 
        Check the Actions tab for build progress.
      </p>
    </div>
  </div>
</BaseLayout>
