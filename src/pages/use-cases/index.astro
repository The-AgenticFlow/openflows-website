---
import BaseLayout from '../../layouts/BaseLayout.astro'
import DocsLayout from '../../components/DocsLayout.astro'
import DocCards from '../../components/DocCards.astro'

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Use Cases' },
]

const CARDS = [
  { 
    icon: '🌐', 
    title: 'Web Development', 
    desc: 'A 2-person startup ships 40 features in a month. FORGE implements, SENTINEL reviews every segment, VESSEL merges - no PR review queue, no context switching.', 
    href: '/use-cases/web-development' 
  },
  { 
    icon: '🔧', 
    title: 'DevOps Automation', 
    desc: 'VESSEL fully automates CI/CD on GitHub Actions. Conflict rework loops eliminate manual rebase churn. Green CI → squash merge, automatically.', 
    href: '/use-cases/devops' 
  },
]
---

<BaseLayout title="Use Cases — Real teams, real results | OpenFlows" description="See how development teams use OpenFlows to eliminate manual churn and ship faster with five autonomous AI agents handling their GitHub backlog.">
  <DocsLayout breadcrumbs={breadcrumbs}>
    <section class="hero">
      <div class="container">
        <p class="eyebrow">Use Cases</p>
        <h1 class="title">Real teams, real results</h1>
        <p class="sub">See how development teams use OpenFlows to eliminate manual churn and ship faster with five autonomous AI agents handling their GitHub backlog.</p>
      </div>
    </section>
    <section class="section">
      <div class="container">
        <DocCards cards={CARDS} />
      </div>
    </section>
  </DocsLayout>
</BaseLayout>

<style>
  .hero {
    padding-top: calc(var(--nav-height) + 4rem);
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .eyebrow {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .title {
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .sub {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    max-width: 560px;
    line-height: 1.7;
  }

  .section {
    padding-block: 3rem 6rem;
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: calc(var(--nav-height) + 2rem);
      padding-bottom: 2rem;
    }

    .section {
      padding-block: 2rem 4rem;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding-top: calc(var(--nav-height) + 1.5rem);
      padding-bottom: 1.5rem;
    }

    .container {
      padding-inline: var(--space-4);
    }
  }
</style>
