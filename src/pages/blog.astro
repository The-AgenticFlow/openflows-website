---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { supabase, isSupabaseConfigured, TABLES } from '../lib/supabase.js';

let posts = [];
let categories = ['all'];

if (isSupabaseConfigured() && supabase) {
  try {
    const { data, error } = await supabase
      .from(TABLES.BLOGS)
      .select(`
        id,
        title,
        slug,
        excerpt,
        cover_image_url,
        published_at,
        created_at,
        view_count,
        is_featured,
        author_name,
        author_avatar_url,
        authors,
        category:blog_categories(name, slug)
      `)
      .eq('status', 'published')
      .is('deleted_at', null)
      .order('published_at', { ascending: false });

    if (error) {
      console.warn('Blogs table not found, using empty posts:', error.message);
      posts = [];
    } else {
      posts = data || [];
      const uniqueCategories = [...new Set(posts.map(p => p.category?.name).filter(Boolean))];
      categories = ['all', ...uniqueCategories];
    }
  } catch (err) {
    console.warn('Error fetching blog posts, using empty posts:', err.message);
    posts = [];
  }
} else {
  console.warn('Supabase not configured, using empty posts');
  posts = [];
}

const formatDate = (dateString) => {
  if (!dateString) return '';
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};

const getResolvedAuthors = (post) => {
  if (post.authors && post.authors.length > 0) {
    return post.authors;
  }
  if (post.author_name) {
    return [{ name: post.author_name, avatar_url: post.author_avatar_url }];
  }
  return [];
};

// Split: first post is featured hero, rest go into the grid/list
const featuredPost = posts.length > 0 ? posts[0] : null;
const remainingPosts = posts.length > 1 ? posts.slice(1) : [];
---

<BaseLayout title="Blog — OpenFlows" description="Stories, stories from the OpenFlows team - releases, research, and open source news.">
  <Navbar />
  <main>
    <div class="blog-wrapper">
      <div class="blog-layout">
        <!-- Left Rail (Visible in List View) -->
        <aside class="left-rail">
          <div class="sticky-rail">
            <h3 class="rail-title">Journal</h3>
            <nav class="rail-nav" id="categoryNav">
              {categories.map((cat) => (
                <button
                  class={`rail-link ${cat === 'all' ? 'rail-link-active' : ''}`}
                  data-category={cat}
                >
                  {cat === 'all' ? 'Latest' : cat}
                </button>
              ))}
            </nav>

            <div class="cta-widget">
              <h4 class="cta-heading">Ask</h4>
              <p class="cta-text">Need implementation details? Jump into the docs and learn more about our agents.</p>
              <a href="/docs" class="cta-link">Open docs</a>
            </div>
          </div>
        </aside>

        <div class="main-feed">
          <!-- Header with Hero and View Toggle -->
          <header class="blog-header">
            <div class="header-content">
              <p class="eyebrow">Blog</p>
              <h1 class="title">What we're building, fixing, and learning.</h1>
              <p class="sub">
                Stories from the OpenFlows team - releases, research, and open source news.
              </p>
            </div>

            <div class="view-controls">
              <div class="toggle-group">
                <button
                  class="view-toggle active"
                  id="gridToggle"
                  title="Grid View"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <rect x="3" y="3" width="7" height="7" rx="1" />
                    <rect x="14" y="3" width="7" height="7" rx="1" />
                    <rect x="3" y="14" width="7" height="7" rx="1" />
                    <rect x="14" y="14" width="7" height="7" rx="1" />
                  </svg>
                </button>
                <button
                  class="view-toggle"
                  id="listToggle"
                  title="List View"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="3" y1="18" x2="21" y2="18" />
                    <circle cx="2" cy="6" r="1.5" fill="currentColor" stroke="none" />
                    <circle cx="2" cy="12" r="1.5" fill="currentColor" stroke="none" />
                    <circle cx="2" cy="18" r="1.5" fill="currentColor" stroke="none" />
                  </svg>
                </button>
              </div>
            </div>
          </header>

          <!-- Content Feed -->
          {posts.length === 0 ? (
            <div class="empty-state">
              <p class="empty-title">No posts yet.</p>
              <p class="empty-text">Blog content will appear here once published.</p>
            </div>
          ) : (
            <>
              <!-- Featured / Most Recent Post - Hero Card -->
              {featuredPost && (
                <a href={`/blog/${featuredPost.slug}`} class="featured-card">
                  {featuredPost.cover_image_url && (
                    <div class="featured-bg">
                      <img src={featuredPost.cover_image_url} alt="" />
                      <div class="featured-overlay" />
                    </div>
                  )}
                  <div class="featured-content">
                    <div class="featured-top">
                      <span class="featured-date">
                        {formatDate(featuredPost.published_at || featuredPost.created_at)}
                      </span>
                      {featuredPost.category && (
                        <span class="featured-category">
                          {featuredPost.category.name}
                        </span>
                      )}
                    </div>
                    <h2 class="featured-title">{featuredPost.title}</h2>
                    <p class="featured-excerpt">{featuredPost.excerpt}</p>
                    {(() => {
                      const authors = getResolvedAuthors(featuredPost);
                      if (!authors.length) return null;
                      return (
                        <div class="featured-authors">
                          <div class="stacked-avatars">
                            {authors.slice(0, 3).map((author, i) => (
                              <div class="stacked-avatar" style={`z-index: ${10 - i}`}>
                                {author.avatar_url ? (
                                  <img src={author.avatar_url} alt={author.name} />
                                ) : (
                                  <span>{author.name?.charAt(0).toUpperCase()}</span>
                                )}
                              </div>
                            ))}
                          </div>
                          <span class="featured-author-names">
                            {authors.map(a => a.name).join(', ')}
                          </span>
                        </div>
                      );
                    })()}
                  </div>
                </a>
              )}

              <!-- Remaining Posts -->
              {remainingPosts.length > 0 && (
                <div class="posts-grid" id="postsContainer">
                  {remainingPosts.map((post) => {
                    const authors = getResolvedAuthors(post);
                    const firstAuthor = authors.length > 0 ? authors[0] : null;
                    return (
                      <a
                        href={`/blog/${post.slug}`}
                        class="post-card"
                        data-category={post.category?.name || 'all'}
                      >
                        {post.cover_image_url && (
                          <div class="post-image">
                            <img src={post.cover_image_url} alt={post.title} />
                          </div>
                        )}
                        <div class="post-content">
                          <div class="post-meta">
                            {post.category && (
                              <span class="post-category">{post.category.name}</span>
                            )}
                            <span class="post-date">
                              {formatDate(post.published_at || post.created_at)}
                            </span>
                          </div>
                          <h2 class="post-title">{post.title}</h2>
                          <p class="post-excerpt">{post.excerpt}</p>
                          <div class="post-footer">
                            <span class="read-more">Read more →</span>
                            {firstAuthor && (
                              <div class="post-author">
                                {firstAuthor.avatar_url ? (
                                  <img src={firstAuthor.avatar_url} alt={firstAuthor.name} class="post-author-avatar" />
                                ) : (
                                  <div class="post-author-avatar-placeholder">{firstAuthor.name?.charAt(0).toUpperCase()}</div>
                                )}
                                <span class="post-author-name">{firstAuthor.name}</span>
                              </div>
                            )}
                          </div>
                        </div>
                      </a>
                    );
                  })}
                </div>
              )}

              <!-- List View (hidden by default, shown via JS) -->
              {remainingPosts.length > 0 && (
                <div class="posts-list" id="postsListContainer" style="display: none;">
                  {remainingPosts.map((post) => {
                    const authors = getResolvedAuthors(post);
                    const firstAuthor = authors.length > 0 ? authors[0] : null;
                    return (
                      <a
                        href={`/blog/${post.slug}`}
                        class="post-row"
                        data-category={post.category?.name || 'all'}
                      >
                        <div class="row-date">
                        {formatDate(post.published_at || post.created_at)}
                      </div>
                        <div class="row-content">
                          <h2 class="row-title">{post.title}</h2>
                          <p class="row-excerpt">{post.excerpt}</p>
                          <div class="row-meta">
                            {post.category && (
                              <span class="pill-tag">{post.category.name}</span>
                            )}
                            <span class="row-author">
                              {post.author_name || 'OpenFlows Team'}
                            </span>
                          </div>
                        </div>
                      </a>
                    );
                  })}
                </div>
              )}
            </>
          )}
        </div>

        <!-- Right Rail (Visible in List View) -->
        <aside class="right-rail">
          <div class="sticky-rail">
            <h3 class="rail-title">Reading Paths</h3>
            <nav class="rail-nav">
              <a href="/docs/security" class="rail-link">Security docs</a>
              <a href="/docs/providers" class="rail-link">OpenAI provider</a>
              <a href="/docs/plugins" class="rail-link">Plugins</a>
              <a href="/showcase" class="rail-link">Showcase</a>
            </nav>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Client-side interactivity for view mode toggle and category filtering
  document.addEventListener('DOMContentLoaded', () => {
    const gridToggle = document.getElementById('gridToggle');
    const listToggle = document.getElementById('listToggle');
    const postsContainer = document.getElementById('postsContainer');
    const postsListContainer = document.getElementById('postsListContainer');
    const blogWrapper = document.querySelector('.blog-wrapper');
    const categoryNav = document.getElementById('categoryNav');
    const categoryButtons = categoryNav?.querySelectorAll('.rail-link');

    let currentView = 'grid';
    let currentCategory = 'all';

    // View mode toggle
    gridToggle?.addEventListener('click', () => {
      currentView = 'grid';
      gridToggle.classList.add('active');
      listToggle.classList.remove('active');
      if (postsContainer) postsContainer.style.display = 'grid';
      if (postsListContainer) postsListContainer.style.display = 'none';
      blogWrapper?.classList.remove('is-list-view');
    });

    listToggle?.addEventListener('click', () => {
      currentView = 'list';
      listToggle.classList.add('active');
      gridToggle.classList.remove('active');
      if (postsContainer) postsContainer.style.display = 'none';
      if (postsListContainer) postsListContainer.style.display = 'flex';
      blogWrapper?.classList.add('is-list-view');
    });

    // Category filtering
    categoryButtons?.forEach(btn => {
      btn.addEventListener('click', () => {
        currentCategory = btn.dataset.category;
        
        // Update active state
        categoryButtons.forEach(b => b.classList.remove('rail-link-active'));
        btn.classList.add('rail-link-active');

        // Filter posts in both views
        const allPostCards = postsContainer?.querySelectorAll('.post-card');
        const allPostRows = postsListContainer?.querySelectorAll('.post-row');

        allPostCards?.forEach(card => {
          if (currentCategory === 'all' || card.dataset.category === currentCategory) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });

        allPostRows?.forEach(row => {
          if (currentCategory === 'all' || row.dataset.category === currentCategory) {
            row.style.display = '';
          } else {
            row.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  .blog-wrapper {
    background-color: var(--color-bg);
    min-height: 100vh;
    padding-top: var(--nav-height);
  }

  .blog-layout {
    display: grid;
    grid-template-columns: 1fr;
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--space-16) var(--space-6);
    transition: all var(--transition-base);
  }

  /* List View Layout adjustment */
  .is-list-view .blog-layout {
    grid-template-columns: 240px 1fr 240px;
    gap: var(--space-12);
    max-width: 1440px;
  }

  /* Rails (Only visible in list view) */
  .left-rail,
  .right-rail {
    display: none;
    position: relative;
  }

  .is-list-view .left-rail,
  .is-list-view .right-rail {
    display: block;
  }

  .sticky-rail {
    position: sticky;
    top: calc(var(--nav-height) + 2rem);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .rail-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .rail-nav {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rail-link {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    text-align: left;
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .rail-link:hover {
    color: var(--color-text-primary);
    transform: translateX(4px);
  }

  .rail-link-active {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* CTA Widget */
  .cta-widget {
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .cta-heading {
    font-size: 0.8rem;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cta-text {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .cta-link {
    font-size: 0.85rem;
    color: var(--color-text-primary);
    font-weight: 600;
    text-decoration: underline;
  }

  /* Main Feed */
  .main-feed {
    width: 100%;
  }

  .blog-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 4rem;
    gap: 2rem;
  }

  .header-content {
    flex: 1;
  }

  .eyebrow {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .title {
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .sub {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    max-width: 520px;
    line-height: 1.7;
  }

  /* View Controls */
  .view-controls {
    display: flex;
    align-items: center;
  }

  .toggle-group {
    display: flex;
    background: var(--color-surface);
    padding: 4px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .view-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 6px;
    color: var(--color-text-muted);
    transition: all var(--transition-fast);
  }

  .view-toggle:hover {
    color: var(--color-text-secondary);
  }

  .view-toggle.active {
    background: var(--color-surface-2);
    color: var(--color-text-primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  /* Featured Hero Card */
  .featured-card {
    position: relative;
    display: block;
    width: 100%;
    min-height: 420px;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    overflow: hidden;
    margin-bottom: 3.5rem;
    text-decoration: none;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .featured-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-3px);
  }

  .featured-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .featured-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.75) brightness(0.55);
    transition: transform var(--transition-slow);
  }

  .featured-card:hover .featured-bg img {
    transform: scale(1.04);
  }

  .featured-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right,
        rgba(0, 0, 0, 0.7) 40%,
        rgba(0, 0, 0, 0.2) 100%);
  }

  .featured-content {
    position: relative;
    z-index: 2;
    padding: 3rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    min-height: 420px;
  }

  .featured-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .featured-date {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .featured-category {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-hover);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    background: var(--color-border);
  }

  .featured-title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-text-primary);
    letter-spacing: -0.025em;
    margin-bottom: 1rem;
  }

  .featured-excerpt {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 680px;
  }

  .featured-authors {
    position: absolute;
    right: 3rem;
    bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .stacked-avatars {
    display: flex;
    align-items: center;
  }

  .stacked-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--color-surface);
    overflow: hidden;
    margin-left: -8px;
    background: var(--color-surface-2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .stacked-avatar:first-child {
    margin-left: 0;
  }

  .stacked-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-author-names {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  /* Posts Grid */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .post-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
  }

  .post-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .post-card:hover .post-image img {
    transform: scale(1.08);
  }

  .post-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
  }

  .post-category {
    padding: 0.2rem 0.5rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text-secondary);
    font-weight: 600;
    text-transform: uppercase;
  }

  .post-date {
    color: var(--color-text-muted);
  }

  .post-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .post-excerpt {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }

  .read-more {
    font-size: 0.875rem;
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .post-author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .post-author-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
  }

  .post-author-avatar-placeholder {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-surface-2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .post-author-name {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  /* Post List */
  .posts-list {
    display: flex;
    flex-direction: column;
  }

  .post-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: var(--space-8);
    padding-block: 2.5rem;
    border-top: 1px solid var(--color-border);
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .row-date {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-family: inherit;
    font-weight: 500;
  }

  .row-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--color-text-primary);
    transition: opacity var(--transition-fast);
    letter-spacing: -0.02em;
  }

  .post-row:hover .row-title {
