---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { supabase, isSupabaseConfigured, TABLES } from '../lib/supabase.js';

// Fetch ALL posts without filtering - filtering happens client-side
let posts = [];
let categories = [{ name: 'Latest', slug: 'all' }];

if (isSupabaseConfigured() && supabase) {
  try {
    const { data, error } = await supabase
      .from(TABLES.BLOGS)
      .select(`
        id,
        title,
        slug,
        excerpt,
        cover_image_url,
        published_at,
        created_at,
        view_count,
        is_featured,
        author_name,
        author_avatar_url,
        authors,
        category:blog_categories(name, slug)
      `)
      .eq('status', 'published')
      .is('deleted_at', null)
      .order('published_at', { ascending: false });

    if (error) {
      console.warn('Blogs table not found, using empty posts:', error.message);
      posts = [];
    } else {
      posts = data || [];
      // Build unique categories with slugs for consistent filtering
      const categoryMap = new Map();
      posts.forEach(p => {
        if (p.category?.slug) {
          const slugLower = p.category.slug.toLowerCase();
          if (!categoryMap.has(slugLower)) {
            categoryMap.set(slugLower, { name: p.category.name, slug: slugLower });
          }
        }
      });
      const uniqueCategories = [...categoryMap.values()];
      categories = [{ name: 'Latest', slug: 'all' }, ...uniqueCategories];
    }
  } catch (err) {
    console.warn('Error fetching blog posts, using empty posts:', err.message);
    posts = [];
  }
} else {
  console.warn('Supabase not configured, using empty posts');
  posts = [];
}

const formatDate = (dateString) => {
  if (!dateString) return '';
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};

const getResolvedAuthors = (post) => {
  if (post.authors && post.authors.length > 0) {
    return post.authors;
  }
  if (post.author_name) {
    return [{ name: post.author_name, avatar_url: post.author_avatar_url }];
  }
  return [];
};

// Split: first post is featured hero, rest go into the grid/list
const featuredPost = posts.length > 0 ? posts[0] : null;
const remainingPosts = posts.length > 1 ? posts.slice(1) : [];
---

<BaseLayout title="Blog — OpenFlows" description="Stories, stories from the OpenFlows team - releases, research, and open source news.">
  <Navbar />
  <main>
    <div class="blog-wrapper">
      <div class="blog-layout">
        <!-- Left Rail (Visible in List View) -->
        <aside class="left-rail">
          <div class="sticky-rail">
            <h3 class="rail-title">Journal</h3>
            <nav class="rail-nav" id="categoryNav">
              {categories.map((cat) => (
                <button
                  class={`rail-link ${cat.slug === 'all' ? 'rail-link-active' : ''}`}
                  data-category={cat.slug}
                >
                  {cat.name}
                </button>
              ))}
            </nav>

            <div class="cta-widget">
              <h4 class="cta-heading">Ask</h4>
              <p class="cta-text">Need implementation details? Jump into the docs and learn more about our agents.</p>
              <a href="/docs" class="cta-link">Open docs</a>
            </div>
          </div>
        </aside>

        <div class="main-feed">
          <!-- Header with Hero and View Toggle -->
          <header class="blog-header">
            <div class="header-content">
              <p class="eyebrow" id="categoryEyebrow">Blog</p>
              <h1 class="title" id="categoryTitle">What we're building, fixing, and learning.</h1>
              <p class="sub">
                Stories from the OpenFlows team - releases, research, and open source news.
              </p>
            </div>

            <div class="view-controls">
              <div class="toggle-group">
                <button
                  class="view-toggle active"
                  id="gridToggle"
                  title="Grid View"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <rect x="3" y="3" width="7" height="7" rx="1" />
                    <rect x="14" y="3" width="7" height="7" rx="1" />
                    <rect x="3" y="14" width="7" height="7" rx="1" />
                    <rect x="14" y="14" width="7" height="7" rx="1" />
                  </svg>
                </button>
                <button
                  class="view-toggle"
                  id="listToggle"
                  title="List View"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="3" y1="18" x2="21" y2="18" />
                    <circle cx="2" cy="6" r="1.5" fill="currentColor" stroke="none" />
                    <circle cx="2" cy="12" r="1.5" fill="currentColor" stroke="none" />
                    <circle cx="2" cy="18" r="1.5" fill="currentColor" stroke="none" />
                  </svg>
                </button>
              </div>
            </div>
          </header>

          <!-- Content Feed -->
          {posts.length === 0 ? (
            <div class="empty-state">
              <p class="empty-title">No posts yet.</p>
              <p class="empty-text">Blog content will appear here once published.</p>
            </div>
          ) : (
            <>
              <!-- Featured / Most Recent Post - Hero Card -->
              {featuredPost && (
                <a href={`/blog/${featuredPost.slug}`} class="featured-card" data-category={featuredPost.category?.slug || 'all'}>
                  {featuredPost.cover_image_url && (
                    <div class="featured-bg">
                      <img src={featuredPost.cover_image_url} alt="" />
                      <div class="featured-overlay" />
                    </div>
                  )}
                  <div class="featured-content">
                    <div class="featured-top">
                      <span class="featured-date">
                        {formatDate(featuredPost.published_at || featuredPost.created_at)}
                      </span>
                      {featuredPost.category && (
                        <span class="featured-category">
                          {featuredPost.category.name}
                        </span>
                      )}
                    </div>
                    <h2 class="featured-title">{featuredPost.title}</h2>
                    <p class="featured-excerpt">{featuredPost.excerpt}</p>
                    {(() => {
                      const authors = getResolvedAuthors(featuredPost);
                      const firstAuthor = authors.length > 0 ? authors[0] : null;
                      if (!firstAuthor) return null;
                      return (
                        <div class="featured-authors">
                          {firstAuthor.avatar_url ? (
                            <img src={firstAuthor.avatar_url} alt={firstAuthor.name} class="featured-author-avatar" />
                          ) : (
                            <span class="featured-author-avatar-placeholder">{firstAuthor.name?.charAt(0).toUpperCase()}</span>
                          )}
                          <span class="featured-author-name">{firstAuthor.name}</span>
                        </div>
                      );
                    })()}
                  </div>
                </a>
              )}

              <!-- Remaining Posts -->
              {remainingPosts.length > 0 && (
                <div class="posts-grid" id="postsContainer">
                  {remainingPosts.map((post) => {
                    const authors = getResolvedAuthors(post);
                    const firstAuthor = authors.length > 0 ? authors[0] : null;
                    return (
                      <a
                        href={`/blog/${post.slug}`}
                        class="post-card"
                        data-category={post.category?.slug || 'all'}
                      >
                        {post.cover_image_url && (
                          <div class="post-image">
                            <img src={post.cover_image_url} alt={post.title} />
                          </div>
                        )}
                        <div class="post-content">
                          <div class="post-meta">
                            {post.category && (
                              <span class="post-category">{post.category.slug}</span>
                            )}
                            <span class="post-date">
                              {formatDate(post.published_at || post.created_at)}
                            </span>
                          </div>
                          <h2 class="post-title">{post.title}</h2>
                          <p class="post-excerpt">{post.excerpt}</p>
                          <div class="post-footer">
                            <span class="read-more">Read more →</span>
                            {firstAuthor && (
                              <div class="post-author">
                                {firstAuthor.avatar_url ? (
                                  <img src={firstAuthor.avatar_url} alt={firstAuthor.name} class="post-author-avatar" />
                                ) : (
                                  <div class="post-author-avatar-placeholder">{firstAuthor.name?.charAt(0).toUpperCase()}</div>
                                )}
                                <span class="post-author-name">{firstAuthor.name}</span>
                              </div>
                            )}
                          </div>
                        </div>
                      </a>
                    );
                  })}
                </div>
              )}

              <!-- List View (hidden by default, shown via JS) -->
              {remainingPosts.length > 0 && (
                <div class="posts-list" id="postsListContainer" style="display: none;">
                  {remainingPosts.map((post) => {
                    const authors = getResolvedAuthors(post);
                    const firstAuthor = authors.length > 0 ? authors[0] : null;
                    return (
                      <a
                        href={`/blog/${post.slug}`}
                        class="post-row"
                        data-category={post.category?.slug || 'all'}
                      >
                        <div class="row-date">
                          {formatDate(post.published_at || post.created_at)}
                        </div>
                        <div class="row-content">
                          <h2 class="row-title">{post.title}</h2>
                          <p class="row-excerpt">{post.excerpt}</p>
                          <div class="row-meta">
                            {post.category && (
                              <span class="pill-tag">{post.category.slug}</span>
                            )}
                            {firstAuthor && (
                              <span class="row-author">
                                {firstAuthor.avatar_url ? (
                                  <img src={firstAuthor.avatar_url} alt={firstAuthor.name} class="row-author-avatar" />
                                ) : (
                                  <span class="row-author-avatar-placeholder">{firstAuthor.name?.charAt(0).toUpperCase()}</span>
                                )}
                                {firstAuthor.name}
                              </span>
                            )}
                          </div>
                        </div>
                      </a>
                    );
                  })}
                </div>
              )}
            </>
          )}
        </div>

        <!-- Right Rail (Visible in List View) -->
        <aside class="right-rail">
          <div class="sticky-rail">
            <h3 class="rail-title">Reading Paths</h3>
            <nav class="rail-nav">
              <a href="/docs/security" class="rail-link">Security docs</a>
              <a href="/docs/providers" class="rail-link">OpenAI provider</a>
              <a href="/docs/plugins" class="rail-link">Plugins</a>
              <a href="/showcase" class="rail-link">Showcase</a>
            </nav>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Client-side interactivity for view mode toggle and category filtering
  document.addEventListener('DOMContentLoaded', () => {
    const gridToggle = document.getElementById('gridToggle');
    const listToggle = document.getElementById('listToggle');
    const postsContainer = document.getElementById('postsContainer');
    const postsListContainer = document.getElementById('postsListContainer');
    const blogWrapper = document.querySelector('.blog-wrapper');
    const categoryNav = document.getElementById('categoryNav');
    const categoryButtons = categoryNav?.querySelectorAll('.rail-link');
    const categoryEyebrow = document.getElementById('categoryEyebrow');
    const categoryTitle = document.getElementById('categoryTitle');
    const featuredCard = document.querySelector('.featured-card');

    let currentView = 'grid';
    
    // Category aliases: map short names/variants to canonical slugs
    const CATEGORY_ALIASES: Record<string, string> = {
      'dev': 'developer',
      'developer': 'developer',
      'res': 'research',
      'research': 'research',
    };

    // Helper to get display name from slug
    function getCategoryDisplayName(slug: string): string {
      if (slug === 'all') return 'Latest';
      if (slug === 'open-source') return 'Open Source';
      return slug.charAt(0).toUpperCase() + slug.slice(1);
    }

    // Read initial category from URL query parameter
    const urlParams = new URLSearchParams(window.location.search);
    const rawCategory = urlParams.get('category')?.toLowerCase() || 'all';
    let currentCategory = CATEGORY_ALIASES[rawCategory] || rawCategory;

    // Apply initial category state
    function applyInitialCategory() {
      // Update active button state (handle aliases)
      categoryButtons?.forEach(btn => {
        btn.classList.remove('rail-link-active');
        const btnCategory = btn.dataset.category || 'all';
        if (matchesCategory(btnCategory, currentCategory) && currentCategory !== 'all') {
          btn.classList.add('rail-link-active');
        } else if (btnCategory === 'all' && currentCategory === 'all') {
          btn.classList.add('rail-link-active');
        }
      });

      // Update header text
      if (categoryEyebrow && categoryTitle) {
        if (currentCategory !== 'all') {
          const displayName = getCategoryDisplayName(currentCategory);
          categoryEyebrow.textContent = displayName;
          categoryTitle.textContent = `${displayName} Articles`;
        } else {
          categoryEyebrow.textContent = 'Blog';
          categoryTitle.textContent = "What we're building, fixing, and learning.";
        }
      }

      // Filter posts
      filterPosts();
    }

    // Reverse alias map: canonical slug -> all possible slugs that match it
    const CATEGORY_REVERSE_ALIASES: Record<string, string[]> = {
      'developer': ['developer', 'dev'],
      'research': ['research', 'res'],
    };

    function matchesCategory(elementCategory: string, filterCategory: string): boolean {
      if (filterCategory === 'all') return true;
      if (elementCategory === filterCategory) return true;
      
      // Check if elementCategory is an alias of filterCategory
      const aliases = CATEGORY_REVERSE_ALIASES[filterCategory];
      if (aliases && aliases.includes(elementCategory)) return true;
      
      return false;
    }

    function filterPosts() {
      // Filter featured card
      if (featuredCard) {
        const cardCategory = featuredCard.dataset.category || 'all';
        if (matchesCategory(cardCategory, currentCategory)) {
          featuredCard.style.display = '';
        } else {
          featuredCard.style.display = 'none';
        }
      }

      // Filter grid posts
      const allPostCards = postsContainer?.querySelectorAll('.post-card');
      allPostCards?.forEach(card => {
        const cardCategory = card.dataset.category || 'all';
        if (matchesCategory(cardCategory, currentCategory)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });

      // Filter list posts
      const allPostRows = postsListContainer?.querySelectorAll('.post-row');
      allPostRows?.forEach(row => {
        const rowCategory = row.dataset.category || 'all';
        if (matchesCategory(rowCategory, currentCategory)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    applyInitialCategory();

    // View mode toggle
    gridToggle?.addEventListener('click', () => {
      currentView = 'grid';
      gridToggle.classList.add('active');
      listToggle.classList.remove('active');
      if (postsContainer) postsContainer.style.display = 'grid';
      if (postsListContainer) postsListContainer.style.display = 'none';
      blogWrapper?.classList.remove('is-list-view');
    });

    listToggle?.addEventListener('click', () => {
      currentView = 'list';
      listToggle.classList.add('active');
      gridToggle.classList.remove('active');
      if (postsContainer) postsContainer.style.display = 'none';
      if (postsListContainer) postsListContainer.style.display = 'flex';
      blogWrapper?.classList.add('is-list-view');
    });

    // Category filtering
    categoryButtons?.forEach(btn => {
      btn.addEventListener('click', () => {
        currentCategory = btn.dataset.category;
        
        // Update URL without reload
        const newUrl = currentCategory === 'all' 
          ? '/blog' 
          : `/blog?category=${currentCategory}`;
        window.history.pushState({ category: currentCategory }, '', newUrl);
        
        applyInitialCategory();
      });
    });
  });
</script>

<style>
  .blog-wrapper {
    background-color: var(--color-bg);
    min-height: 100vh;
    padding-top: var(--nav-height);
  }

  .blog-layout {
    display: grid;
    grid-template-columns: 1fr;
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--space-16) var(--space-6);
    transition: all var(--transition-base);
  }

  /* List View Layout adjustment */
  .is-list-view .blog-layout {
    grid-template-columns: 240px 1fr 240px;
    gap: var(--space-12);
    max-width: 1440px;
  }

  /* Rails (Only visible in list view) */
  .left-rail,
  .right-rail {
    display: none;
    position: relative;
  }

  .is-list-view .left-rail,
  .is-list-view .right-rail {
    display: block;
  }

  .sticky-rail {
    position: sticky;
    top: calc(var(--nav-height) + 2rem);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .rail-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .rail-nav {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rail-link {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    text-align: left;
    transition: all var(--transition-fast);
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  .rail-link:hover {
    color: var(--color-text-primary);
    transform: translateX(4px);
  }

  .rail-link-active {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* CTA Widget */
  .cta-widget {
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .cta-heading {
    font-size: 0.8rem;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cta-text {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .cta-link {
    font-size: 0.85rem;
    color: var(--color-text-primary);
    font-weight: 600;
    text-decoration: underline;
  }

  /* Main Feed */
  .main-feed {
    width: 100%;
  }

  .blog-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 4rem;
    gap: 2rem;
  }

  .header-content {
    flex: 1;
  }

  .eyebrow {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .title {
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .sub {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    max-width: 520px;
    line-height: 1.7;
  }

  /* View Controls */
  .view-controls {
    display: flex;
    align-items: center;
  }

  .toggle-group {
    display: flex;
    background: var(--color-surface);
    padding: 4px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .view-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 6px;
    color: var(--color-text-muted);
    transition: all var(--transition-fast);
  }

  .view-toggle:hover {
    color: var(--color-text-secondary);
  }

  .view-toggle.active {
    background: var(--color-surface-2);
    color: var(--color-text-primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  /* Featured Hero Card */
  .featured-card {
    position: relative;
    display: block;
    width: 100%;
    min-height: 420px;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    overflow: hidden;
    margin-bottom: 3.5rem;
    text-decoration: none;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .featured-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-3px);
  }

  .featured-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .featured-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.75) brightness(0.55);
    transition: transform var(--transition-slow);
  }

  .featured-card:hover .featured-bg img {
    transform: scale(1.04);
  }

  .featured-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right,
        rgba(0, 0, 0, 0.7) 40%,
        rgba(0, 0, 0, 0.2) 100%);
  }

  .featured-content {
    position: relative;
    z-index: 2;
    padding: var(--space-12);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100%;
  }

  .featured-top {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .featured-date {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .featured-category {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-primary);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 2px 10px;
    border-radius: var(--radius-full);
    backdrop-filter: blur(4px);
  }

  .featured-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .featured-excerpt {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
    max-width: 600px;
  }

  .featured-authors {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    position: absolute;
    bottom: var(--space-6);
    right: var(--space-6);
  }

  .featured-author-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255, 255, 255, 0.2);
  }

  .featured-author-avatar-placeholder {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .featured-author-name {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: var(--space-24) var(--space-6);
  }

  .empty-title {
    font-size: var(--font-size-xl);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .empty-text {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
  }

  /* Posts Grid */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-8);
