---
import BaseLayout from '../../layouts/BaseLayout.astro'
import DocsLayout from '../../components/DocsLayout.astro'
import Callout from '../../components/Callout.astro'

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Demos', href: '/demos' },
  { label: 'Terminal Simulation' },
]

const LINES = [
  { type: 'cmd',     text: 'openflows' },
  { type: 'success', text: '✓ Starting REAL End-to-End Orchestration' },
  { type: 'output',  text: '  Loaded 6 worker slots: [nexus, forge-1, forge-2, sentinel, vessel, lore]' },
  { type: 'output',  text: '' },
  { type: 'output',  text: '[nexus] Polling GitHub for open issues...' },
  { type: 'output',  text: '[nexus] Found 3 open issues' },
  { type: 'output',  text: '[nexus] Assigning issue #1 → forge-1  (T-001)' },
  { type: 'output',  text: '' },
  { type: 'output',  text: '[forge-1] Worktree created: forge-1/T-001' },
  { type: 'output',  text: '[forge-1] Spawning Claude Code...' },
  { type: 'output',  text: '[forge-1] PLAN.md written - spawning SENTINEL for review' },
  { type: 'output',  text: '[sentinel] CONTRACT.md → AGREED' },
  { type: 'output',  text: '[forge-1] Implementing segment 1/3...' },
  { type: 'output',  text: '[sentinel] segment-1-eval.md → APPROVED' },
  { type: 'output',  text: '[forge-1] Implementing segment 2/3...' },
  { type: 'output',  text: '[sentinel] segment-2-eval.md → APPROVED' },
  { type: 'output',  text: '[forge-1] Implementing segment 3/3...' },
  { type: 'output',  text: '[sentinel] final-review.md → APPROVED' },
  { type: 'success', text: '[forge-1] PR #7 opened: "Fix pagination offset in API endpoint"' },
  { type: 'output',  text: '' },
  { type: 'output',  text: '[vessel] Polling CI for PR #7 (10s interval)...' },
  { type: 'success', text: '[vessel] CI: success ✓ - squash-merging PR #7' },
  { type: 'output',  text: '[lore] ADR-003 written and committed' },
  { type: 'output',  text: '' },
  { type: 'output',  text: '[nexus] T-001 merged. Picking next ticket...' },
  { type: 'output',  text: '[nexus] No more open issues. Halting gracefully.' },
]
---

<BaseLayout title="Terminal Simulation — See OpenFlows in action | OpenFlows" description="Watch OpenFlows autonomously discover a GitHub issue, plan the implementation, write code, review it, and merge the pull request - all without human intervention.">
  <DocsLayout breadcrumbs={breadcrumbs}>
    <div class="terminalPage">
      <p class="eyebrow">Demos</p>
      <h1 class="title">Terminal Simulation</h1>
      <p class="subtitle">
        Watch OpenFlows autonomously discover a GitHub issue, plan the implementation, write code, review it, and merge the pull request - all without human intervention.
      </p>

      <div class="terminalDemo">
        <div class="terminalBar">
          <span class="tDot red"></span>
          <span class="tDot yellow"></span>
          <span class="tDot green"></span>
          <span class="terminalTitle">openflows - my-org/my-project</span>
        </div>
        <div class="terminalBody" id="terminalBody">
          <!-- Lines will be added by JS -->
        </div>
      </div>

      <button class="replayBtn" id="replayBtn">
        ↻ Replay
      </button>

      <Callout type="tip" title="This is a simulation">
        This demo plays a pre-recorded session. In production, OpenFlows reads your real GitHub issues, clones your actual codebase, and writes production code. Try it yourself with the <a href="/docs/getting-started">Quick Start Guide</a>.
      </Callout>

      <h2 class="whatYouSaw">What you just saw</h2>
      <ol class="stepsList">
        <li><strong>NEXUS</strong> polls GitHub, discovers open issues, assigns T-001 to forge-1</li>
        <li><strong>FORGE</strong> creates an isolated worktree, writes PLAN.md, spawns Claude Code</li>
        <li><strong>SENTINEL</strong> reviews the plan (CONTRACT.md: AGREED) before any code is written</li>
        <li><strong>FORGE</strong> implements segment by segment; SENTINEL evaluates each one</li>
        <li><strong>SENTINEL</strong> final review approved - FORGE opens PR #7 via GitHub MCP</li>
        <li><strong>VESSEL</strong> polls CI at 10s intervals, squash-merges when green</li>
        <li><strong>LORE</strong> writes ADR-003 and commits it to the repo</li>
      </ol>
    </div>
  </DocsLayout>
</BaseLayout>

<script is:inline>
  const LINES = [
    { type: 'cmd',     text: 'openflows' },
    { type: 'success', text: '✓ Starting REAL End-to-End Orchestration' },
    { type: 'output',  text: '  Loaded 6 worker slots: [nexus, forge-1, forge-2, sentinel, vessel, lore]' },
    { type: 'output',  text: '' },
    { type: 'output',  text: '[nexus] Polling GitHub for open issues...' },
    { type: 'output',  text: '[nexus] Found 3 open issues' },
    { type: 'output',  text: '[nexus] Assigning issue #1 → forge-1  (T-001)' },
    { type: 'output',  text: '' },
    { type: 'output',  text: '[forge-1] Worktree created: forge-1/T-001' },
    { type: 'output',  text: '[forge-1] Spawning Claude Code...' },
    { type: 'output',  text: '[forge-1] PLAN.md written - spawning SENTINEL for review' },
    { type: 'output',  text: '[sentinel] CONTRACT.md → AGREED' },
    { type: 'output',  text: '[forge-1] Implementing segment 1/3...' },
    { type: 'output',  text: '[sentinel] segment-1-eval.md → APPROVED' },
    { type: 'output',  text: '[forge-1] Implementing segment 2/3...' },
    { type: 'output',  text: '[sentinel] segment-2-eval.md → APPROVED' },
    { type: 'output',  text: '[forge-1] Implementing segment 3/3...' },
    { type: 'output',  text: '[sentinel] final-review.md → APPROVED' },
    { type: 'success', text: '[forge-1] PR #7 opened: "Fix pagination offset in API endpoint"' },
    { type: 'output',  text: '' },
    { type: 'output',  text: '[vessel] Polling CI for PR #7 (10s interval)...' },
    { type: 'success', text: '[vessel] CI: success ✓ - squash-merging PR #7' },
    { type: 'output',  text: '[lore] ADR-003 written and committed' },
    { type: 'output',  text: '' },
    { type: 'output',  text: '[nexus] T-001 merged. Picking next ticket...' },
    { type: 'output',  text: '[nexus] No more open issues. Halting gracefully.' },
  ];

  let timerRef = null;
  let visibleCount = 0;
  let running = false;

  function createLineElement(line, index) {
    const span = document.createElement('span');
    span.className = 'tLine';
    
    if (line.type === 'cmd') {
      const prompt = document.createElement('span');
      prompt.className = 'tPrompt';
      prompt.textContent = '❯ ';
      span.appendChild(prompt);
      span.appendChild(document.createTextNode(line.text));
    } else if (line.type === 'success') {
      const successSpan = document.createElement('span');
      successSpan.className = 'tSuccess';
      successSpan.textContent = line.text;
      span.appendChild(successSpan);
    } else {
      const outputSpan = document.createElement('span');
      outputSpan.className = 'tOutput';
      outputSpan.textContent = line.text;
      span.appendChild(outputSpan);
    }
    
    return span;
  }

  function addLine() {
    const terminalBody = document.getElementById('terminalBody');
    if (!terminalBody || visibleCount >= LINES.length) {
      if (visibleCount >= LINES.length) {
        // Add cursor blink at end
        const cursor = document.createElement('span');
        cursor.className = 'tLine';
        const cursorSpan = document.createElement('span');
        cursorSpan.className = 'tOutput';
        cursorSpan.textContent = '▌';
        cursor.appendChild(cursorSpan);
        terminalBody.appendChild(cursor);
      }
      return;
    }
    
    const line = LINES[visibleCount];
    const lineEl = createLineElement(line, visibleCount);
    terminalBody.appendChild(lineEl);
    visibleCount++;
    
    if (visibleCount < LINES.length) {
      timerRef = setTimeout(addLine, visibleCount === 0 ? 400 : 180);
    } else {
      // Add cursor at end
      const cursor = document.createElement('span');
      cursor.className = 'tLine';
      const cursorSpan = document.createElement('span');
      cursorSpan.className = 'tOutput';
      cursorSpan.textContent = '▌';
      cursor.appendChild(cursorSpan);
      terminalBody.appendChild(cursor);
    }
  }

  function startAnimation() {
    const terminalBody = document.getElementById('terminalBody');
    if (!terminalBody) return;
    
    // Clear existing content
    terminalBody.innerHTML = '';
    visibleCount = 0;
    running = true;
    
    // Start animation
    timerRef = setTimeout(addLine, 300);
  }

  function stopAnimation() {
    running = false;
    if (timerRef) {
      clearTimeout(timerRef);
      timerRef = null;
    }
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', () => {
    startAnimation();
    
    // Setup replay button
    const replayBtn = document.getElementById('replayBtn');
    if (replayBtn) {
      replayBtn.addEventListener('click', () => {
        stopAnimation();
        setTimeout(startAnimation, 50);
      });
    }
  });
</script>

<style>
  .terminalPage {
    max-width: 860px;
    margin-inline: auto;
    padding: calc(var(--nav-height) + 3rem) var(--space-6) 6rem;
  }

  .subtitle {
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }

  .terminalDemo {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .terminalBar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--color-surface-hover);
    border-bottom: 1px solid var(--color-border);
  }

  .tDot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .tDot.red {
    background: #ff5f56;
  }

  .tDot.yellow {
    background: #ffbd2e;
  }

  .tDot.green {
    background: #27c93f;
  }

  .terminalTitle {
    margin-left: 0.5rem;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .terminalBody {
    padding: 1rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: var(--font-size-sm);
    line-height: 1.6;
    min-height: 300px;
  }

  .tLine {
    display: block;
    margin-bottom: 0.25rem;
  }

  .tPrompt {
    color: var(--color-accent);
    font-weight: 600;
  }

  .tSuccess {
    color: #22c55e;
    font-weight: 500;
  }

  .tOutput {
    color: var(--color-text-secondary);
  }

  .replayBtn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    cursor: pointer;
    transition: border-color var(--transition-fast);
    font-family: 'IBM Plex Mono', monospace;
    margin-top: 0.75rem;
  }

  .replayBtn:hover {
    border-color: var(--color-border-hover);
  }

  .whatYouSaw {
    font-size: 1.2rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-text-primary);
  }

  .stepsList {
    color: var(--color-text-secondary);
    line-height: 1.8;
    padding-left: 1.5rem;
  }

  .stepsList li {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 768px) {
    .terminalPage {
      padding: calc(var(--nav-height) + 2rem) var(--space-6) 4rem;
    }
  }

  @media (max-width: 600px) {
    .terminalPage {
      padding: calc(var(--nav-height) + 1.5rem) var(--space-4) 4rem;
    }
  }
</style>
