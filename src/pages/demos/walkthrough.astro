---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CodeBlock } from '@/molecules/DocComponents/DocComponents';
import CtaBanner from '@/components/site/CtaBanner.astro';

const STEPS = [
  {
    agent: 'nexus',
    title: 'Issue Discovery',
    description: 'NEXUS polls GitHub for open issues and creates tickets in the SharedStore',
    code: `// NEXUS discovers open issues
const issues = await github.listIssues({ state: 'open' });
for (const issue of issues) {
  await sharedStore.createTicket({
    issueNumber: issue.number,
    title: issue.title,
    body: issue.body
  });
}`
  },
  {
    agent: 'nexus',
    title: 'Task Assignment',
    description: 'NEXUS assigns tickets to idle FORGE workers based on availability',
    code: `// NEXUS assigns work
const worker = await sharedStore.getIdleWorker();
const ticket = await sharedStore.getNextTicket();
await sharedStore.assignTicket(ticket.id, worker.id);`
  },
  {
    agent: 'forge',
    title: 'Planning Phase',
    description: 'FORGE creates a PLAN.md file outlining the implementation approach',
    code: `# PLAN.md

## Problem
Fix pagination offset calculation in API endpoint

## Solution
1. Update calculateOffset() function in pagination.rs
2. Add unit tests for edge cases
3. Update API documentation

## Risks
- Breaking change for existing API consumers
- Need to verify with integration tests`
  },
  {
    agent: 'forge',
    title: 'Code Implementation',
    description: 'FORGE writes the actual code changes based on the plan',
    code: `// src/api/pagination.rs
pub fn calculate_offset(page: u32, per_page: u32) -> u32 {
    if page == 0 {
        0
    } else {
        (page - 1) * per_page
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_first_page() {
        assert_eq!(calculate_offset(1, 10), 0);
    }
}`
  },
  {
    agent: 'sentinel',
    title: 'Code Review',
    description: 'SENTINEL reviews the code for correctness, security, and style',
    code: `// SENTINEL review results
{
  "correctness": "PASS",
  "security": "PASS",
  "style": "PASS",
  "tests": "PASS",
  "comments": [
    "Good edge case handling for page 0",
    "Consider adding more test cases"
  ],
  "approved": true
}`
  },
  {
    agent: 'forge',
    title: 'Pull Request',
    description: 'FORGE creates a pull request with all changes',
    code: `# Pull Request: Fix pagination offset calculation

## Changes
- Updated calculate_offset() to handle page 0 correctly
- Added comprehensive unit tests
- Updated API documentation

## Testing
- All unit tests passing
- Integration tests verified
- Manual testing completed

Fixes #142`
  },
  {
    agent: 'vessel',
    title: 'CI/CD & Merge',
    description: 'VESSEL monitors CI status and merges when all checks pass',
    code: `// VESSEL monitors CI
while (!ci.complete) {
  const status = await github.getCIStatus(pr.number);
  if (status.success) {
    await github.mergePR(pr.number, {
      merge_method: 'squash',
      commit_title: 'Fix pagination offset (#142)'
    });
    break;
  }
  await sleep(10000);
}`
  },
  {
    agent: 'lore',
    title: 'Documentation',
    description: 'LORE updates documentation and creates an ADR for the change',
    code: `# ADR-001: Pagination Offset Fix

## Status
Accepted

## Context
The pagination offset calculation was incorrect for page 0,
causing API responses to skip the first item.

## Decision
Updated calculate_offset() to return 0 when page is 0,
matching expected API behavior.

## Consequences
- Fixes bug #142
- Breaking change for clients expecting old behavior
- Requires API version bump`
  }
];
---

<BaseLayout title="Step-by-step walkthrough · OpenFlows demos" description="Follow a GitHub issue through OpenFlows to a merged pull request, with the artifact each agent produces at every step.">
  <main>
    <section class="of-page-hero">
      <div class="of-grid-bg" aria-hidden="true"></div>
      <div class="of-container">
        <a href="/demos" class="of-back fade-up">← All demos</a>
        <span class="of-eyebrow fade-up" style="display:flex">Walkthrough</span>
        <h1 class="fade-up" style="animation-delay:80ms">From issue to merged PR, step by step.</h1>
        <p class="of-lede fade-up" style="animation-delay:160ms">Follow one ticket through the whole pipeline and see the artifact each agent produces along the way: the ticket, the plan, the code, the review, the PR, the merge and the ADR.</p>
      </div>
    </section>

    <section style="padding-bottom: clamp(3rem, 6vw, 5rem)">
      <div class="of-container of-container-narrow">
        <ol class="steps">
          {STEPS.map((step, index) => (
            <li class="step" data-agent={step.agent} data-reveal>
              <div class="marker"><span>{String(index + 1).padStart(2, '0')}</span></div>
              <div class="body">
                <span class="agent">{step.agent.toUpperCase()}</span>
                <h2>{step.title}</h2>
                <p>{step.description}</p>
                <CodeBlock lang={step.code.includes('pub fn') ? 'rust' : step.code.includes('#') ? 'markdown' : 'javascript'}>
                  {step.code}
                </CodeBlock>
              </div>
            </li>
          ))}
        </ol>
        <p class="disclaimer">Snippets are illustrative. The real system is written in Rust and coordinates through the SharedStore; see the <a href="/docs/architecture">architecture docs</a> for the exact contracts.</p>
      </div>
    </section>

    <CtaBanner title="Ready to try it on your repository?" body="Install OpenFlows on your Coder environment and watch your own issues move through these steps." />
  </main>
</BaseLayout>

<style>
  .of-back { margin-bottom: 1.5rem; }
  .steps { position: relative; display: grid; gap: 1.25rem; }
  .steps::before { content: ''; position: absolute; left: 21px; top: 20px; bottom: 20px; width: 1px; background: linear-gradient(180deg, var(--of-line-strong), transparent); }
  .step { --agent: var(--of-mint); position: relative; display: flex; gap: 1.5rem; }
  .step[data-agent='nexus'] { --agent: var(--color-agent-nexus); }
  .step[data-agent='forge'] { --agent: var(--color-agent-forge); }
  .step[data-agent='sentinel'] { --agent: var(--color-agent-sentinel); }
  .step[data-agent='vessel'] { --agent: var(--color-agent-vessel); }
  .step[data-agent='lore'] { --agent: var(--color-agent-lore); }
  .marker span { position: relative; display: grid; place-items: center; width: 43px; height: 43px; border-radius: 12px; border: 1px solid color-mix(in srgb, var(--agent) 45%, transparent); background: var(--of-bg); box-shadow: inset 0 0 0 100px color-mix(in srgb, var(--agent) 9%, transparent); font-family: var(--font-mono); font-size: 0.78rem; color: var(--agent); }
  .body { flex: 1; min-width: 0; padding: 1.4rem 1.5rem 1.5rem; border-radius: 16px; border: 1px solid var(--of-line); background: rgba(255, 255, 255, 0.02); }
  .agent { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; color: var(--agent); }
  .body h2 { margin-top: 0.4rem; font-size: 1.25rem; }
  .body p { margin: 0.4rem 0 1rem; color: var(--of-text-2); font-size: 0.95rem; }
  .disclaimer { margin-top: 2rem; font-size: 0.85rem; color: var(--of-text-3); }
  .disclaimer a { color: var(--of-text-2); text-decoration: underline; }
  @media (max-width: 560px) {
    .step { gap: 0.85rem; }
    .body { padding: 1.1rem; }
  }
</style>
