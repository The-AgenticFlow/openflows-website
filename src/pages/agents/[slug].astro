---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { AGENT_DATA } from '../../data/agents.js';

export function getStaticPaths() {
  return Object.keys(AGENT_DATA).map((slug) => ({
    params: { slug },
    props: { agent: AGENT_DATA[slug], slug },
  }));
}

const { agent, slug } = Astro.props;
---

<BaseLayout title={`${agent.name} | OpenFlows`} description={agent.mission}>
  <Navbar />
  <main class="page">
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <p class="eyebrow">THE OPENFLOWS TEAM</p>
        <h1 class="title">{agent.name}</h1>
        <p class="role">{agent.role}</p>
        <p class="subtitle">{agent.mission}</p>
      </div>
    </section>

    <!-- Capabilities Section -->
    <section class="section capabilities">
      <div class="container">
        <p class="sectionLabel">CAPABILITIES</p>
        <ul class="capabilitiesList">
          {agent.capabilities.map((cap) => (
            <li class="capabilityItem">{cap}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="section howItWorks">
      <div class="container">
        <p class="sectionLabel">HOW IT WORKS</p>
        <div class="flowList">
          {agent.flow.map((step, i) => {
            const parts = step.split(':');
            const title = parts[0].trim();
            const desc = parts.slice(1).join(':').trim();
            return (
              <div class="flowItem">
                <div class="flowHeader">
                  <span class="flowNumber">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="flowTitle">{title}</h3>
                </div>
                {desc && <p class="flowDesc">{desc}</p>}
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta">
      <div class="container">
        <p class="ctaTitle">Deploy {agent.name} on your repo</p>
        <p class="ctaDesc">Install OpenFlows, point it at a GitHub repository with open issues, and {agent.name} will be running in minutes.</p>
        <div class="ctaActions">
          <a href="https://github.com/The-AgenticFlow/OpenFlows" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">View on GitHub</a>
          <a href="/docs/getting-started/installation" class="btn btn-outline">Installation Guide &rarr;</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page {
    padding-top: var(--nav-height);
  }

  .container {
    max-width: 800px;
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  /* Hero */
  .hero {
    padding-block: var(--space-24);
    text-align: center;
  }

  .eyebrow {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
    color: var(--color-cyan);
  }

  .role {
    font-size: var(--font-size-lg);
    color: var(--color-text-primary);
    margin-bottom: var(--space-12);
  }

  .subtitle {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    max-width: 600px;
    margin-inline: auto;
    line-height: 1.8;
  }

  /* Sections */
  .section {
    padding-block: var(--space-16);
  }

  .sectionLabel {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
  }

  /* Capabilities */
  .capabilitiesList {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .capabilityItem {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    padding-left: var(--space-4);
    position: relative;
  }

  .capabilityItem::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    background-color: var(--color-cyan);
    border-radius: 50%;
  }

  /* How It Works */
  .flowList {
    display: flex;
    flex-direction: column;
  }

  .flowItem {
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .flowItem:last-child {
    border-bottom: none;
  }

  .flowHeader {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .flowNumber {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    font-family: var(--font-mono, monospace);
  }

  .flowTitle {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
  }

  .flowDesc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
    padding-left: var(--space-8);
  }

  /* CTA */
  .cta {
    padding-block: var(--space-24);
    text-align: center;
  }

  .ctaTitle {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .ctaDesc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    max-width: 500px;
    margin-inline: auto;
    margin-bottom: var(--space-8);
    line-height: 1.7;
  }

  .ctaActions {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1.25rem;
    font-size: var(--font-size-sm);
    font-weight: 500;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .btn-ghost {
    background-color: transparent;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  .btn-ghost:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-hover);
  }

  .btn-outline {
    background-color: transparent;
    color: var(--color-cyan);
    border: 1px solid var(--color-cyan);
  }

  .btn-outline:hover {
    background-color: var(--color-cyan);
    color: var(--color-bg);
  }

  @media (max-width: 768px) {
    .hero {
      padding-block: var(--space-16);
    }

    .container {
      padding-inline: var(--space-4);
    }

    .ctaActions {
      flex-direction: column;
      align-items: center;
    }

    .btn {
      width: 100%;
      max-width: 250px;
    }
  }
</style>
