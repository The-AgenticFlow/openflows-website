---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBanner from '@/components/site/CtaBanner.astro';

const RUN_STAGES = [
  { n: '01', title: 'Issue enters the queue', sub: 'Repository and tenant are known', tag: 'GitHub' },
  { n: '02', title: 'Manager authorizes work', sub: 'Identity, scope, capacity, credentials', tag: 'Control plane' },
  { n: '03', title: 'Agents work in Coder', sub: 'Nexus coordinates isolated workspaces', tag: 'Runtime' },
  { n: '04', title: 'Evidence reaches review', sub: 'Changes, verification, pull request', tag: 'Human gate' },
];

const WORKFLOW = [
  { step: '01', label: 'Connect', title: 'Choose a repository', body: 'Sign in, connect a GitHub App installation, and create a tenant for a repository the installation can access.' },
  { step: '02', label: 'Provision', title: 'Start the runtime', body: 'Manager records durable operations and asks Coder to create the tenant controller and scoped worker workspaces.' },
  { step: '03', label: 'Execute', title: 'Run the issue', body: 'Nexus assigns ticket work. Agents use registered runtime sessions and request only the credentials their task permits.' },
  { step: '04', label: 'Review', title: 'Inspect the evidence', body: 'Changes and verification return through the tenant workflow before a human decides whether to merge.' },
];

const BOUNDARIES = [
  {
    label: 'Trusted control plane',
    title: 'Manager keeps platform authority',
    body: 'GitHub App signing material, the Coder operator credential, and the encryption key remain outside agent workspaces. Manager resolves organization, tenant, workspace, and repository scope on privileged requests.',
    href: '/docs/architecture/security-by-design',
    link: 'Inspect the security model',
    icon: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
  },
  {
    label: 'Tenant execution plane',
    title: 'Workspaces receive limited access',
    body: 'A workspace registers with a one-time bootstrap, then uses a runtime session. GitHub installation tokens are short-lived and repository-scoped. Tenant Redis uses a tenant credential and namespace.',
    href: '/docs/architecture/credentials',
    link: 'Inspect credential lifecycles',
    icon: '<rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  },
  {
    label: 'Recovery and audit',
    title: 'Work can be resumed and examined',
    body: 'Provisioning operations use database leases and idempotency keys. Tenant coordination records include assignments, heartbeats, hooks, and A2A evidence. Operators remain responsible for securing the supporting services.',
    href: '/docs/guides/operations',
    link: 'Inspect operations',
    icon: '<path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/><path d="M12 8v4l3 2"/>',
  },
];

const OPERATE = [
  { name: 'OpenFlows Manager', desc: 'Product API, credential broker, hook ingress, and durable workers' },
  { name: 'PostgreSQL and Redis', desc: 'Control-plane records and tenant coordination' },
  { name: 'Coder and a provisioner', desc: 'Templates, builds, and workspace execution' },
  { name: 'Secret provider and public HTTPS origin', desc: 'Platform credentials, runtime bundles, and GitHub callbacks' },
];

const AVAILABILITY = [
  { status: 'Available to evaluate', tone: 'now', title: 'Open source, customer-managed', body: 'Deploy the documented services in your own environment and validate one repository and tenant end to end.' },
  { status: 'Discuss requirements', tone: 'talk', title: 'Enterprise operating needs', body: 'Share identity, policy, support, and audit requirements with the project. Availability and scope require a direct conversation.' },
  { status: 'Not available yet', tone: 'later', title: 'OpenFlows-operated service', body: 'A hosted operating model is planned. This page does not present it as a service you can sign up for today.' },
];

const PILOT = [
  'Prepare Manager, Coder, PostgreSQL, Redis, secrets, and GitHub integration.',
  'Connect one repository, create a tenant, and confirm runtime heartbeats.',
  'Run a representative issue and inspect the resulting PR and verification evidence.',
  'Review credential scope, operation recovery, and operator logs with your security team.',
];
---

<BaseLayout
  title="OpenFlows for engineering organizations · OpenFlows"
  description="Evaluate OpenFlows for governed, self-hosted AI development. See the issue-to-PR workflow, runtime trust boundaries, deployment requirements, and what is available today."
>
  <main>
    <section class="of-page-hero">
      <div class="of-grid-bg" aria-hidden="true"></div>
      <div class="of-container">
        <div class="hero-grid">
          <div>
            <span class="of-eyebrow fade-up">OpenFlows for engineering organizations</span>
            <h1 class="fade-up" style="animation-delay:80ms">Agent work your team can <span class="of-gradient-text">actually account for.</span></h1>
            <p class="of-lede fade-up" style="animation-delay:160ms">Turn a GitHub issue into a reviewed pull request with clear ownership, isolated workspaces, scoped credentials, and a record of what happened along the way.</p>
            <div class="of-actions fade-up" style="animation-delay:240ms">
              <a class="of-btn of-btn-primary of-btn-lg" href="#evaluation">Plan an evaluation</a>
              <a class="of-btn of-btn-ghost of-btn-lg" href="/docs/architecture/components-and-interactions">Explore the architecture</a>
            </div>
            <p class="hero-note fade-up" style="animation-delay:300ms"><span class="of-dot"></span>Open source at the core. Customer-managed deployments can be evaluated today.</p>
          </div>

          <div class="run of-window fade-up" style="animation-delay:200ms" aria-label="An issue passes through OpenFlows Manager, tenant workspaces, and review before becoming a pull request">
            <div class="of-window-bar"><span class="of-window-dots"><span></span><span></span><span></span></span>one governed run<span class="run-id">ISSUE → PR</span></div>
            <ol class="run-stages">
              {RUN_STAGES.map((s, i) => (
                <li style={`--i:${i}`}>
                  <span class="run-num">{s.n}</span>
                  <div><strong>{s.title}</strong><small>{s.sub}</small></div>
                  <span class="run-tag">{s.tag}</span>
                </li>
              ))}
            </ol>
            <p class="run-foot">The agent does the work. Your team keeps the decision.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="of-section" id="workflow">
      <div class="of-container">
        <div class="of-head" data-reveal>
          <span class="of-eyebrow">From issue to review</span>
          <h2>One workflow, with visible handoffs.</h2>
          <p>OpenFlows separates product authority from execution. Manager decides what a runtime may do; Nexus coordinates work inside one tenant; Forge and Sentinel work in separate Coder workspaces.</p>
        </div>
        <div class="workflow" data-reveal-group>
          {WORKFLOW.map((w) => (
            <article class="wf of-card" data-reveal>
              <span class="wf-step">{w.step} <i>/</i> {w.label}</span>
              <h3>{w.title}</h3>
              <p>{w.body}</p>
            </article>
          ))}
        </div>
        <a class="of-link wf-link" href="/docs/getting-started/first-issue">Walk through a first issue <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </div>
    </section>

    <section class="of-section" id="security">
      <div class="of-container">
        <div class="of-head" data-reveal>
          <span class="of-eyebrow">Trust boundaries</span>
          <h2>Give each runtime the authority it needs, not the keys to the platform.</h2>
          <p>The security model is defined by which system holds each credential and how a workspace proves its identity. We document these boundaries so your security team can inspect and test them.</p>
        </div>
        <div class="boundaries" data-reveal-group>
          {BOUNDARIES.map((b) => (
            <article class="boundary of-card of-spotlight" data-reveal>
              <span class="b-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={b.icon} /></span>
              <span class="b-label">{b.label}</span>
              <h3>{b.title}</h3>
              <p>{b.body}</p>
              <a href={b.href} class="of-link">{b.link} <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="of-section" id="deployment">
      <div class="of-container">
        <div class="deploy">
          <div class="of-head" data-reveal>
            <span class="of-eyebrow">Deploy with intent</span>
            <h2>Run the control plane alongside your engineering systems.</h2>
            <p>A customer-managed evaluation uses the same Manager-mediated runtime architecture described in the public docs. There is no separate, simplified enterprise runtime to trust.</p>
            <a class="of-link" href="/docs/architecture/deployment">See service connections <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          </div>
          <div class="operate of-card" data-reveal="scale">
            <p class="operate-title">What you operate</p>
            <ul>
              {OPERATE.map((o) => (
                <li>
                  <span class="operate-dot"></span>
                  <div><strong>{o.name}</strong><span>{o.desc}</span></div>
                </li>
              ))}
            </ul>
            <a href="/docs/getting-started/installation" class="of-link">Review installation prerequisites <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="of-section" id="editions">
      <div class="of-container">
        <div class="of-head is-center" data-reveal>
          <span class="of-eyebrow">Availability</span>
          <h2>Start with the model you can run today.</h2>
          <p>The open-source platform and customer-managed deployment are available to evaluate. Enterprise operating requirements need a direct conversation. An OpenFlows-operated service is planned, not available today.</p>
        </div>
        <div class="avail" data-reveal-group>
          {AVAILABILITY.map((a) => (
            <div class={`av of-card av-${a.tone}`} data-reveal>
              <span class="av-status"><span class="av-dot"></span>{a.status}</span>
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="of-section" id="evaluation">
      <div class="of-container">
        <div class="pilot">
          <div data-reveal>
            <span class="of-eyebrow">Start with proof</span>
            <h2 class="of-h2" style="margin-top:1rem">Evaluate one repository before you scale the platform.</h2>
            <p class="of-lede" style="margin-top:1.1rem">Use a contained pilot to test the real boundaries: GitHub connection, tenant provisioning, runtime registration, issue execution, review evidence, and recovery after a worker interruption.</p>
            <div class="of-actions">
              <a class="of-btn of-btn-primary" href="/docs/getting-started/installation">Read the setup guide</a>
              <a class="of-btn of-btn-ghost" href="https://github.com/The-AgenticFlow/OpenFlows/discussions" target="_blank" rel="noopener noreferrer">Discuss your requirements ↗</a>
            </div>
          </div>
          <ol class="pilot-list" data-reveal-group>
            {PILOT.map((p, i) => (
              <li data-reveal><span>0{i + 1}</span><p>{p}</p></li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <CtaBanner
      title="Bring governed AI delivery to your org."
      body="Start with one repository, one tenant, and your own infrastructure. Scale when your security team is satisfied."
      primary={{ label: 'Plan an evaluation', href: '/docs/getting-started/installation' }}
      secondary={{ label: 'Talk to the maintainers', href: 'https://github.com/The-AgenticFlow/OpenFlows/discussions', external: true }}
    />
  </main>
</BaseLayout>

<style>
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .hero-grid h1 { font-size: clamp(2.4rem, 4.6vw, 3.9rem); max-width: 15ch; }
  .hero-note { display: flex; align-items: center; gap: 0.6rem; margin-top: 1.5rem; font-size: 0.85rem; color: var(--of-text-3); }

  .run { box-shadow: var(--shadow-xl), 0 0 100px -40px rgba(62, 224, 161, 0.4); }
  .run-id { margin-left: auto; color: var(--of-mint); }
  .run-stages { display: grid; padding: 0.75rem; }

  .run-stages li {
    position: relative;
    display: grid;
    grid-template-columns: 36px 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 0.85rem;
    border-radius: 12px;
    animation: stageGlow 8s ease-in-out infinite;
    animation-delay: calc(var(--i) * 2s);
  }

  .run-stages li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 32px;
    bottom: -6px;
    width: 1px;
    height: 12px;
    background: var(--of-line-strong);
  }

  @keyframes stageGlow {
    0%, 100% { background: transparent; }
    6%, 22% { background: rgba(62, 224, 161, 0.06); }
    28% { background: transparent; }
  }

  .run-num { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; border: 1px solid var(--of-line-strong); font-family: var(--font-mono); font-size: 0.75rem; color: var(--of-mint); background: var(--of-bg); }
  .run-stages strong { display: block; font-size: 0.93rem; font-weight: 500; }
  .run-stages small { display: block; font-size: 0.8rem; color: var(--of-text-3); margin-top: 0.1rem; }
  .run-tag { font-family: var(--font-mono); font-size: 0.68rem; padding: 0.25rem 0.5rem; border-radius: 6px; border: 1px solid var(--of-line-strong); color: var(--of-text-2); }
  .run-foot { padding: 0.9rem 1.25rem; border-top: 1px solid var(--of-line); font-size: 0.85rem; color: var(--of-text-2); }

  .workflow { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .wf { padding: 1.5rem; }
  .wf-step { font-family: var(--font-mono); font-size: 0.72rem; color: var(--of-mint); letter-spacing: 0.06em; text-transform: uppercase; }
  .wf-step i { font-style: normal; color: var(--of-text-3); }
  .wf h3 { margin-top: 1.4rem; font-size: 1.1rem; }
  .wf p { margin-top: 0.55rem; font-size: 0.9rem; line-height: 1.6; color: var(--of-text-2); }
  .wf-link { margin-top: 1.75rem; }

  .boundaries { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .boundary { display: flex; flex-direction: column; padding: 1.75rem; }
  .b-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--of-mint-line); background: var(--of-mint-soft); color: var(--of-mint); }
  .b-icon svg { width: 22px; height: 22px; }
  .b-label { margin-top: 1.5rem; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--of-text-3); }
  .boundary h3 { margin-top: 0.5rem; font-size: 1.2rem; }
  .boundary p { margin: 0.65rem 0 1.5rem; font-size: 0.9rem; line-height: 1.65; color: var(--of-text-2); }
  .boundary .of-link { margin-top: auto; }

  .deploy { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .deploy .of-head { margin-bottom: 0; }
  .operate { padding: 1.75rem; }
  .operate-title { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--of-text-3); }
  .operate ul { display: grid; gap: 0.5rem; margin: 1.25rem 0 1.5rem; }
  .operate li { display: flex; gap: 0.9rem; padding: 0.9rem 1rem; border-radius: 12px; border: 1px solid var(--of-line); background: rgba(8, 9, 11, 0.6); }
  .operate-dot { width: 8px; height: 8px; margin-top: 7px; flex-shrink: 0; border-radius: 2px; background: var(--of-mint); box-shadow: 0 0 10px var(--of-mint); }
  .operate strong { display: block; font-weight: 500; font-size: 0.95rem; }
  .operate li span:not(.operate-dot) { display: block; font-size: 0.85rem; color: var(--of-text-2); margin-top: 0.15rem; }

  .avail { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .av { --tone: var(--of-mint); padding: 1.75rem; }
  .av-talk { --tone: var(--of-amber); }
  .av-later { --tone: var(--of-text-3); }
  .av-status { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.65rem; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--tone) 40%, transparent); background: color-mix(in srgb, var(--tone) 9%, transparent); font-family: var(--font-mono); font-size: 0.7rem; color: var(--tone); }
  .av-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--tone); }
  .av h3 { margin-top: 1.4rem; font-size: 1.15rem; }
  .av p { margin-top: 0.6rem; font-size: 0.9rem; line-height: 1.6; color: var(--of-text-2); }

  .pilot { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .pilot-list { display: grid; gap: 0.75rem; counter-reset: p; }
  .pilot-list li { display: flex; gap: 1.1rem; align-items: flex-start; padding: 1.15rem 1.25rem; border-radius: 14px; border: 1px solid var(--of-line); background: rgba(255, 255, 255, 0.02); }
  .pilot-list span { font-family: var(--font-mono); font-size: 0.8rem; color: var(--of-mint); padding-top: 1px; }
  .pilot-list p { font-size: 0.95rem; line-height: 1.55; }

  @media (max-width: 1000px) {
    .hero-grid, .deploy, .pilot { grid-template-columns: 1fr; }
    .workflow { grid-template-columns: 1fr 1fr; }
    .boundaries, .avail { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .workflow { grid-template-columns: 1fr; }
    .run-stages li { grid-template-columns: 32px 1fr; }
    .run-tag { display: none; }
  }
</style>
