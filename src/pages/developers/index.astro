---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PixelField from '@/components/site/PixelField.astro';
import CtaBanner from '@/components/site/CtaBanner.astro';

const CARDS = [
  {
    title: 'Integration guides',
    desc: 'Connect OpenFlows to GitHub, a LiteLLM proxy, Redis, Docker Compose, and your existing CI/CD stack.',
    href: '/developers/integrations',
    cta: 'Browse integrations',
    icon: '<path d="M9 7H6a4 4 0 0 0 0 8h3M15 7h3a4 4 0 0 1 0 8h-3M8 11h8"/>',
  },
  {
    title: 'GitHub repository',
    desc: 'Full source, issues, discussions and releases. MIT licensed, written in Rust with Tokio, reqwest and fred.',
    href: 'https://github.com/The-AgenticFlow/OpenFlows',
    cta: 'Open on GitHub',
    external: true,
    icon: '<path d="M9 19c-4 1.5-4-2-6-2.5M15 21v-3.5a3 3 0 0 0-.9-2.4c3-.3 6-1.5 6-6.6a5 5 0 0 0-1.4-3.6 4.7 4.7 0 0 0-.1-3.5s-1.1-.3-3.6 1.4a12.3 12.3 0 0 0-6.4 0C6.1 1.1 5 1.4 5 1.4a4.7 4.7 0 0 0-.1 3.5A5 5 0 0 0 3.5 8.5c0 5.1 3 6.3 6 6.6a3 3 0 0 0-.9 2.3V21"/>',
  },
  {
    title: 'Architecture reference',
    desc: 'The PocketFlow engine, SharedStore keys, crate structure, and the full data flow from issue to merged PR.',
    href: '/docs/architecture/big-picture',
    cta: 'Read the architecture',
    icon: '<path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/>',
  },
  {
    title: 'Contributing',
    desc: 'Set up a development environment, add skills, and run the test suites before you open a pull request.',
    href: '/docs/contributing',
    cta: 'Start contributing',
    icon: '<path d="M4 17l6-6-6-6M12 19h8"/>',
  },
  {
    title: 'Command surface',
    desc: 'Every operator command, from tenant setup to gate decisions, in one reference.',
    href: '/docs/reference/command-surface',
    cta: 'View commands',
    icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9l3 3-3 3M13 15h4"/>',
  },
  {
    title: 'Extending OpenFlows',
    desc: 'Plug in new skills, MCP servers and models through the registry, with no code change.',
    href: '/docs/guides/extending-skills',
    cta: 'Extend the registry',
    icon: '<path d="M12 2v6M12 16v6M4.9 4.9l4.2 4.2M14.9 14.9l4.2 4.2M2 12h6M16 12h6M4.9 19.1l4.2-4.2M14.9 9.1l4.2-4.2"/>',
  },
];
---

<BaseLayout title="Developers · OpenFlows" description="Everything you need to integrate with and extend OpenFlows: integration guides, architecture docs, and the full source code on GitHub.">
  <main>
    <section class="of-page-hero of-dark is-center">
      <PixelField cell={30} density={0.06} />
      <div class="of-container">
        <span class="of-eyebrow fade-up">Developers</span>
        <h1 class="fade-up" style="animation-delay:80ms">Build on <span class="of-gradient-text">OpenFlows.</span></h1>
        <p class="of-lede fade-up" style="animation-delay:160ms">Integration guides, architecture references and the full source code. Everything you need to run, extend and contribute.</p>
        <div class="of-actions fade-up" style="animation-delay:240ms">
          <div class="of-command">
            <span class="of-prompt">$</span>
            <code>git clone https://github.com/The-AgenticFlow/OpenFlows</code>
            <button class="of-copy" data-copy="git clone https://github.com/The-AgenticFlow/OpenFlows" aria-label="Copy clone command">
              <svg class="of-copy-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.8"/><path d="M10.5 5V3.8A1.3 1.3 0 0 0 9.2 2.5H3.8a1.3 1.3 0 0 0-1.3 1.3v5.4a1.3 1.3 0 0 0 1.3 1.3H5"/></svg>
              <svg class="of-copied" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <section style="padding-bottom: clamp(3rem, 6vw, 5rem)">
      <div class="of-container">
        <div class="grid" data-reveal-group>
          {CARDS.map((c) => (
            <a href={c.href} class="card of-card of-spotlight" target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener noreferrer' : undefined} data-reveal>
              <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon} /></span>
              <h2>{c.title}</h2>
              <p>{c.desc}</p>
              <span class="of-link">{c.cta} <span aria-hidden="true">{c.external ? '↗' : '→'}</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <CtaBanner title="Ship your first contribution." body="Pick a good first issue, open a pull request, and the maintainers will help you land it." primary={{ label: 'Contributor guide', href: '/docs/contributing' }} secondary={{ label: 'Good first issues', href: 'https://github.com/The-AgenticFlow/OpenFlows/issues', external: true }} />
  </main>
</BaseLayout>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .card { display: flex; flex-direction: column; padding: 1.75rem; }
  .icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--of-line-strong); background: var(--of-surface-2); color: var(--of-mint); }
  .icon svg { width: 22px; height: 22px; }
  .card h2 { margin-top: 1.4rem; font-size: 1.2rem; }
  .card p { margin: 0.55rem 0 1.4rem; font-size: 0.92rem; color: var(--of-text-2); line-height: 1.6; }
  .card .of-link { margin-top: auto; }
  @media (max-width: 960px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
