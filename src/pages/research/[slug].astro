---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const research = await getCollection('research');
  return research.map((item) => ({
    params: { slug: (item.data.slug || item.slug).trim() },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const formatDate = (d) => {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<BaseLayout
  title={`${item.data.title} - OpenFlows Research`}
  description={item.data.abstract}
  ogImage={item.data.cover_image_url}
>
  <main class="of-article">
  <article>
    <header class="of-article-inner">
      <a href="/research" class="of-back">← Back to research</a>
      <div class="of-article-kicker">
        <span>{item.data.category}</span>
        {item.data.venue && <><span class="sep">/</span><span class="muted">{item.data.venue}</span></>}
        <span class="sep">/</span>
        <span class="muted">{formatDate(item.data.publish_date)}</span>
      </div>
      <h1 class="of-article-title">{item.data.title}</h1>
      {item.data.abstract && <p class="of-article-dek">{item.data.abstract}</p>}

      <div class="of-article-meta">
        {item.data.authors && item.data.authors.map((author, i) => (
          <>{i > 0 && <span class="dot">·</span>}<span>{author.name}{author.affiliation && <span class="dot"> ({author.affiliation})</span>}</span></>
        ))}
        {item.data.pdf_url && (
          <a href={item.data.pdf_url} target="_blank" rel="noopener noreferrer" class="of-btn of-btn-ghost of-btn-sm" style="margin-left:auto">View PDF ↗</a>
        )}
      </div>

      {item.data.tags && item.data.tags.length > 0 && (
        <div class="of-article-tags">
          {item.data.tags.map((tag) => <span class="of-chip">{tag}</span>)}
        </div>
      )}
    </header>

    {item.data.cover_image_url && (
      <div class="of-article-cover">
        <img src={item.data.cover_image_url} alt={item.data.title} />
      </div>
    )}

    <div class="research-content of-article-body of-prose">
      <Content />
    </div>

    <script is:inline>
      (function () {
        var blocks = document.querySelectorAll('.research-content pre[data-language="mermaid"]');
        if (!blocks.length) return;

        function render() {
          if (typeof window.mermaid === 'undefined') return;
          window.mermaid.initialize({ startOnLoad: false, theme: 'dark', securityLevel: 'loose' });
          blocks.forEach(function (pre, i) {
            var code = pre.textContent || '';
            var id = 'mermaid-' + i;
            var wrapper = document.createElement('div');
            wrapper.className = 'research-mermaid';
            wrapper.id = id;
            try {
              window.mermaid.render(id, code).then(function (result) {
                wrapper.innerHTML = result.svg;
                var svg = wrapper.querySelector('svg');
                if (svg) {
                  svg.removeAttribute('style');
                  svg.setAttribute('style', 'max-width: none; width: 100%; height: auto;');
                }
                pre.parentNode.replaceChild(wrapper, pre);
              });
            } catch (e) {
              wrapper.textContent = code;
              pre.parentNode.replaceChild(wrapper, pre);
            }
          });
        }

        if (window.mermaid) {
          render();
        } else {
          var s = document.createElement('script');
          s.src = 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js';
          s.onload = render;
          document.head.appendChild(s);
        }
      })();
    </script>

    <!-- Giscus Comments Section -->
    <div style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--color-fog);">
      <h3 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 2rem;">Comments</h3>
      <script src="https://giscus.app/client.js"
              data-repo="The-AgenticFlow/openflows-website"
              data-repo-id="R_kgDOShxBEw"
              data-category="Announcements"
              data-category-id="DIC_kwDOShxBE84C_8Ek"
              data-mapping="pathname"
              data-strict="0"
              data-reactions-enabled="1"
              data-emit-metadata="0"
              data-input-position="bottom"
              data-theme="preferred_color_scheme"
              data-lang="en"
              crossorigin="anonymous"
              async>
      </script>
    </div>
  </article>
  </main>

</BaseLayout>
