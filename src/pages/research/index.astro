---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const research = await getCollection('research');

const formatDate = (d) => {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const categories = ['all', ...new Set(research.map(r => r.data.category).filter(Boolean))];
---

<BaseLayout title="Research · OpenFlows" description="Papers, preprints, and technical reports on autonomous multi-agent software engineering and the OpenFlows architecture.">
  <main>
    <section class="of-page-hero">
      <div class="of-grid-bg" aria-hidden="true"></div>
      <div class="of-container">
        <span class="of-eyebrow fade-up">Research</span>
        <h1 class="fade-up" style="animation-delay:80ms">Publications</h1>
        <p class="of-lede fade-up" style="animation-delay:160ms">Papers, preprints and technical reports on autonomous multi-agent software engineering and the OpenFlows architecture.</p>
      </div>
    </section>

    <section style="padding-bottom: clamp(4rem, 8vw, 6rem)">
      <div class="of-container">
        {research.length === 0 ? (
          <p class="empty">No publications yet.</p>
        ) : (
          <div class="list" data-reveal-group>
            {research.map((item) => (
              <a href={`/research/${item.data.slug}`} class="paper of-card of-spotlight" data-reveal>
                <div class="paper-meta">
                  <span class="kind">{item.data.category}</span>
                  {item.data.venue && <span>{item.data.venue}</span>}
                  <span>{formatDate(item.data.publish_date)}</span>
                </div>
                <h2>{item.data.title}</h2>
                <p class="abstract">{item.data.abstract}</p>
                <div class="paper-foot">
                  {item.data.authors && item.data.authors.length > 0 && (
                    <span class="authors">{item.data.authors.map((a) => a.name).join(', ')}</span>
                  )}
                  <span class="of-link">Read the paper <span aria-hidden="true">→</span></span>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .list { display: grid; gap: 1rem; }
  .paper { display: block; padding: clamp(1.5rem, 3vw, 2.25rem); }
  .paper-meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--of-text-3); text-transform: uppercase; letter-spacing: 0.06em; }
  .kind { color: var(--of-mint); }
  .paper h2 { margin-top: 1rem; font-size: clamp(1.4rem, 2.6vw, 1.9rem); letter-spacing: -0.03em; }
  .abstract { margin-top: 0.85rem; max-width: 80ch; color: var(--of-text-2); line-height: 1.7; font-size: 0.97rem; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .paper-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--of-line); }
  .authors { font-size: 0.88rem; color: var(--of-text-2); }
  .empty { padding: 4rem 0; text-align: center; color: var(--of-text-3); }
</style>
