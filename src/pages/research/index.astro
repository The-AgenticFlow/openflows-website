---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const research = await getCollection('research');

const formatDate = (d) => {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const categories = ['all', ...new Set(research.map(r => r.data.category).filter(Boolean))];
---

<BaseLayout title="Research - OpenFlows" description="Papers, preprints, and technical reports on autonomous multi-agent software engineering.">
  <section style="max-width: 1200px; margin: 0 auto; padding: 4rem 2rem;">
    <div style="margin-bottom: 3rem;">
      <p style="font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-aubergine); margin-bottom: 0.5rem;">Research</p>
      <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem;">Publications</h1>
      <p style="font-size: 1.125rem; color: var(--color-graphite); max-width: 600px;">Papers, preprints, and technical reports on autonomous multi-agent software engineering and the OpenFlows architecture.</p>
    </div>

    {research.length === 0 ? (
      <p style="text-align: center; color: var(--color-graphite); padding: 3rem;">No publications yet.</p>
    ) : (
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 2rem;">
        {research.map((item) => (
          <article style="padding: 1.5rem; background: var(--color-bone); border-radius: var(--radius-md); border: 1px solid var(--color-fog);">
            <div style="display: flex; gap: 0.75rem; margin-bottom: 0.75rem; font-size: 0.75rem; color: var(--color-graphite);">
              <span style="text-transform: uppercase; letter-spacing: 0.05em;">{item.data.category}</span>
              {item.data.venue && <><span>·</span><span>{item.data.venue}</span></>}
              <span>·</span>
              <span>{formatDate(item.data.publish_date)}</span>
            </div>
            <h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; line-height: 1.3;">
              <a href={`/research/${item.data.slug}`} style="color: var(--color-ink);">{item.data.title}</a>
            </h2>
            <p style="font-size: 0.875rem; color: var(--color-graphite); line-height: 1.6; margin-bottom: 1rem;">{item.data.abstract}</p>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              {item.data.authors && item.data.authors.length > 0 && (
                <span style="font-size: 0.75rem; color: var(--color-graphite);">
                  {item.data.authors.map(a => a.name).join(', ')}
                </span>
              )}
              <a href={`/research/${item.data.slug}`} style="font-size: 0.875rem; font-weight: 600;">Read →</a>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
