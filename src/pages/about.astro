---
import BaseLayout from '@/layouts/BaseLayout.astro';
import styles from './About.module.css';

const STATS = [
  { value: '5', label: 'Specialized agents' },
  { value: '24/7', label: 'Autonomous operation' },
  { value: '~16min', label: 'Issue to merged PR' },
  { value: 'MIT', label: 'Open source license' },
];

const AGENTS = [
  {
    name: 'NEXUS',
    role: 'Orchestrator',
    desc: 'Polls GitHub for issues, provisions workspaces, assigns work to agents, and manages the entire pipeline lifecycle.',
  },
  {
    name: 'FORGE',
    role: 'Builder',
    desc: 'Receives tickets, writes PLAN.md, implements code segment by segment, and opens pull requests.',
  },
  {
    name: 'SENTINEL',
    role: 'Reviewer',
    desc: 'Reviews every code segment against 5 criteria: correctness, security, test coverage, standards compliance, and no regressions.',
  },
  {
    name: 'VESSEL',
    role: 'Shipper',
    desc: 'Handles CI status, resolves merge conflicts, and squash-merges approved PRs after SENTINEL approval.',
  },
  {
    name: 'LORE',
    role: 'Documenter',
    desc: 'Writes ADRs (Architecture Decision Records) and updates CHANGELOG.md after each successful merge.',
  },
];

const VALUES = [
  {
    title: 'Autonomous by default',
    desc: 'The pipeline runs without human input. NEXUS polls GitHub, assigns tickets, provisions ephemeral Coder workspaces, and manages the full lifecycle. It only escalates to AwaitingHuman for spec ambiguity, security concerns, or resource limits.',
  },
  {
    title: 'Each agent has an identity',
    desc: 'Agent = CLI backend (muscle) + configuration harness (brain). Each agent has its own persona, skills, hooks, and permissions. GitHub identity is handled by Coder external auth  -  agents inherit identity from the logged-in Coder user via the git-config module. No personal access tokens needed.',
  },
  {
    title: 'Built for resilience',
    desc: 'A five-layer crash recovery stack catches failures at every level, from malformed LLM output to crashed nodes. NEXUS reconcile() detects orphaned tickets, stale workers, and unmerged PRs on every cycle. Ephemeral Coder workspaces are torn down after merge  -  no lingering state, no stale credentials.',
  },
  {
    title: 'Model-agnostic, adversarial by design',
    desc: 'Each agent\'s LLM provider and model are configured independently in registry.json. FORGE and SENTINEL can use different providers  -  Anthropic for the builder, OpenAI for the reviewer  -  so the reviewer\'s blind spots differ from the writer\'s. SENTINEL spawns fresh per evaluation, read-only and bias-free.',
  },
  {
    title: 'Open source, MIT licensed',
    desc: 'The orchestration engine  -  PocketFlow core, SharedStore, agent harnesses, and TUI setup wizard  -  is on GitHub under the MIT license. Install via npm, cargo, Docker, or a one-line curl installer. Self-hosted on your infrastructure, with Coder AI Gateway and LiteLLM fallback for any model provider.',
  },
  {
    title: 'Ship faster, not harder',
    desc: 'FORGE implements and opens PRs in 15–30 minutes. SENTINEL reviews every segment automatically. VESSEL merges when CI is green. A 2-person startup can ship 40 features in a month because the pipeline eliminates the PR review queue and founder context-switching.',
  },
  {
    title: 'Conflict rework, not rebase churn',
    desc: 'When VESSEL detects a merge conflict, it does not create a new branch or lose context. It writes CONFLICT_RESOLUTION.md and re-routes the ticket back to the same FORGE worker. FORGE reworks the implementation, re-commits, and VESSEL re-monitors CI  -  no manual rebase.',
  },
  {
    title: 'Documentation as a byproduct',
    desc: 'LORE writes Architecture Decision Records and updates CHANGELOG.md after every successful merge. Technical decisions are captured automatically, not as an afterthought. The team ships code and the paper trail writes itself.',
  },
];
---

<BaseLayout title="About - OpenFlows" description="Learn about OpenFlows - the autonomous AI development team orchestration layer that coordinates five specialized agents to take GitHub issues to merged pull requests.">
  {/* ── Hero ── */}
  <section class={styles.hero}>
    <div class={styles.container}>
      <p class={styles.eyebrow}>About OpenFlows</p>
      <h1 class={styles.heroTitle}>
        The orchestration layer for<br class={styles.br} /> autonomous AI development teams.
      </h1>
      <p class={styles.heroSub}>
        OpenFlows coordinates five specialized AI agents through a Redis-backed state machine
        to take GitHub issues all the way to merged, documented pull requests. GitHub identity
        is handled by Coder external auth  -  no personal access tokens. The entire pipeline runs
        autonomously - you wake up to completed features, reviewed PRs, and updated documentation.
      </p>
    </div>
  </section>

  {/* ── Stats bar ── */}
  <section class={styles.statsBar}>
    <div class={styles.container}>
      <div class={styles.statsGrid}>
        {STATS.map(({ value, label }) => (
          <div key={label} class={styles.statItem}>
            <span class={styles.statValue}>{value}</span>
            <span class={styles.statLabel}>{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── The Agents ── */}
  <section class={styles.split}>
    <div class={styles.container}>
      <p class={styles.eyebrow}>The team</p>
      <h2 class={styles.valuesHeading}>Five agents, one pipeline</h2>
      <div class={styles.valuesGrid}>
        {AGENTS.map(({ name, role, desc }) => (
          <div key={name} class={styles.valueCard}>
            <h3 class={styles.valueTitle}>{name} <span class={styles.agentRole}> -  {role}</span></h3>
            <p class={styles.valueDesc}>{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Pull quote ── */}
  <section class={styles.quoteSection}>
    <div class={styles.container}>
      <blockquote class={styles.quote}>
        "Coder governs where agents run. OpenFlows governs how they coordinate.
        Code is the output. Architecture is the product."
      </blockquote>
    </div>
  </section>

  {/* ── How it works - text left ── */}
  <section class={styles.split}>
    <div class={styles.container}>
      <div class={styles.splitGrid}>
        <div class={styles.splitText}>
          <p class={styles.eyebrow}>How it works</p>
          <h2 class={styles.splitHeading}>From issue to merged PR, autonomously</h2>
          <p class={styles.splitDesc}>
            NEXUS polls GitHub for open issues and provisions ephemeral workspaces for each task.
            FORGE receives the ticket, writes a PLAN.md, and implements the code segment by segment.
            SENTINEL reviews every segment against five criteria before approval. VESSEL handles CI
            status and merges approved PRs. LORE documents everything with ADRs and CHANGELOG updates.
          </p>
          <p class={styles.splitDesc}>
            The entire pipeline runs without human intervention. NEXUS only reaches out when it
            genuinely needs you - spec ambiguity, security concerns, or resource limits. Otherwise,
            the team runs autonomously within your governed environment.
          </p>
          <div class={styles.linkRow}>
            <a href="/docs/architecture" class={styles.textLink}>Architecture Overview ›</a>
            <a href="/docs/getting-started" class={styles.textLink}>Get Started ›</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Values grid ── */}
  <section class={styles.valuesSection}>
    <div class={styles.container}>
      <p class={styles.eyebrow}>What we stand for</p>
      <h2 class={styles.valuesHeading}>Built on clear principles</h2>
      <div class={styles.valuesGrid}>
        {VALUES.map(({ title, desc }) => (
          <div key={title} class={styles.valueCard}>
            <h3 class={styles.valueTitle}>{title}</h3>
            <p class={styles.valueDesc}>{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Community ── */}
  <section class={styles.split}>
    <div class={styles.container}>
      <div class={styles.splitGrid}>
        <div class={styles.splitText}>
          <p class={styles.eyebrow}>Community</p>
          <h2 class={styles.splitHeading}>Help build the autonomous AI development team.</h2>
          <p class={styles.splitDesc}>
            OpenFlows is an MIT-licensed, self-hosted AI software team that turns GitHub issues
            into reviewed, production-ready pull requests inside your Coder environment.
            Contributions shape the agents, NEXUS orchestration, FORGE implementation, SENTINEL
            adversarial review, VESSEL merge automation, LORE docs, through skills, MCP servers,
            new model integrations, and the PocketFlow flow graph.
          </p>
          <p class={styles.splitDesc}>
            Maintained by the AgenticFlow team. Whether you're hardening the planning gate and
            failure recovery, tuning agent personas and permissions, or documenting architecture,
            your work directly shapes how autonomous development teams operate.
          </p>
          <div class={styles.linkRow}>
            <a
              href="https://discord.gg/gDhK2RQZpY"
              class={styles.socialBtn}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class={styles.socialIcon} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z" />
              </svg>
              Join Discord
            </a>
            <a
              href="https://github.com/The-AgenticFlow/OpenFlows"
              class={styles.socialBtn}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class={styles.socialIcon} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
              </svg>
              GitHub
            </a>
            <a
              href="https://github.com/The-AgenticFlow/OpenFlows/issues"
              class={styles.socialBtn}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class={styles.socialIcon} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
              </svg>
              Report an issue
            </a>
            <a href="/docs/getting-started/installation" class={styles.socialBtn}>
              <svg class={styles.socialIcon} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                <polyline points="4 17 10 11 4 5" />
                <line x1="12" y1="19" x2="20" y2="19" />
              </svg>
              Installation Guide
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style src="./About.module.css"></style>
