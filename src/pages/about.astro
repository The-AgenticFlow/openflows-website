---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PixelField from '@/components/site/PixelField.astro';
import CtaBanner from '@/components/site/CtaBanner.astro';

const REPO = 'https://github.com/The-AgenticFlow/OpenFlows';

const CHANNELS = [
  {
    title: 'Discord',
    desc: 'Chat with maintainers and other operators. The fastest place to get unstuck.',
    href: 'https://discord.gg/gDhK2RQZpY',
    cta: 'Join the server',
    icon: '<path d="M20.32 4.37a19.8 19.8 0 0 0-4.89-1.52.07.07 0 0 0-.08.04c-.21.38-.44.86-.61 1.25a18.3 18.3 0 0 0-5.49 0 12.6 12.6 0 0 0-.62-1.25.08.08 0 0 0-.08-.04 19.7 19.7 0 0 0-4.88 1.52.07.07 0 0 0-.03.03C.53 9.05-.32 13.58.1 18.06a.08.08 0 0 0 .03.05 19.9 19.9 0 0 0 6 3.03.08.08 0 0 0 .08-.03c.46-.63.87-1.3 1.23-1.99a.08.08 0 0 0-.04-.11 13.1 13.1 0 0 1-1.87-.89.08.08 0 0 1-.01-.13l.37-.29a.07.07 0 0 1 .08-.01c3.93 1.79 8.18 1.79 12.06 0a.07.07 0 0 1 .08.01l.37.29a.08.08 0 0 1 0 .13c-.6.35-1.22.64-1.88.89a.08.08 0 0 0-.04.11c.36.7.77 1.36 1.23 1.99a.08.08 0 0 0 .08.03 19.8 19.8 0 0 0 6-3.03.08.08 0 0 0 .03-.05c.5-5.18-.84-9.67-3.55-13.66a.06.06 0 0 0-.03-.03zM8.02 15.33c-1.18 0-2.16-1.09-2.16-2.42s.96-2.42 2.16-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.96 2.42-2.16 2.42zm7.97 0c-1.18 0-2.15-1.09-2.15-2.42s.95-2.42 2.15-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.95 2.42-2.16 2.42z"/>',
    fill: true,
  },
  {
    title: 'GitHub',
    desc: 'Source, releases, issues and pull requests. Everything is MIT licensed.',
    href: REPO,
    cta: 'Star the repo',
    icon: '<path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.79-.26.79-.58v-2.23c-3.34.73-4.03-1.42-4.03-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.19.69.8.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/>',
    fill: true,
  },
  {
    title: 'Discussions',
    desc: 'Ask questions, share how you run OpenFlows, and propose ideas.',
    href: `${REPO}/discussions`,
    cta: 'Start a thread',
    icon: '<path d="M4 5h11v8H8l-4 3z"/><path d="M15 9h5v8l-3-2h-6v-2"/>',
  },
  {
    title: 'Blog',
    desc: 'Engineering essays from the team on building trustworthy agents.',
    href: '/blog',
    cta: 'Read the blog',
    icon: '<path d="M4 20h4L19 9l-4-4L4 16z"/><path d="M13 7l4 4"/>',
    internal: true,
  },
];

const CONTRIBUTE = [
  { title: 'Add a skill', desc: 'Drop a SKILL.md into the plugin skills folder and register it for a role.', href: '/docs/contributing/adding-skills' },
  { title: 'Plug in an MCP server', desc: 'Give an agent a new tool through the registry, no code change.', href: '/docs/guides/extending-mcp' },
  { title: 'Integrate a model', desc: 'Route a role to a new provider through Coder AI settings.', href: '/docs/guides/extending-models' },
  { title: 'Improve the docs', desc: 'Fix a gap, clarify a concept, or add a guide you wished existed.', href: '/docs/contributing' },
  { title: 'Report a bug', desc: 'Open an issue with steps to reproduce. Small reports help a lot.', href: `${REPO}/issues` },
  { title: 'Harden the core', desc: 'Planning gate, recovery, A2A relay: pick an issue and send a PR.', href: '/docs/contributing/development-setup' },
];

const PRINCIPLES = [
  { title: 'Architecture first', desc: 'Engineers own the spec and the final say. Agents implement against it.' },
  { title: 'Governed by default', desc: 'Every action is gated, attributed and auditable from issue to merge.' },
  { title: 'Open and self-hosted', desc: 'MIT licensed, running on your infrastructure, with your models.' },
  { title: 'Never guess', desc: 'When a spec is ambiguous, agents ask an exact question instead of improvising.' },
];
---

<BaseLayout title="Community · OpenFlows" description="Join the OpenFlows community: chat on Discord, contribute on GitHub, and help build the open-source, governed AI dev team for Coder.">
  <main>
    <section class="of-page-hero of-dark">
      <PixelField cell={30} density={0.06} />
      <div class="of-container">
        <span class="of-eyebrow fade-up">Community</span>
        <h1 class="of-lines"><span><span style="--l:0">Build OpenFlows</span></span><span><span style="--l:1">with us.</span></span></h1>
        <p class="of-lede fade-up" style="animation-delay:300ms">OpenFlows is open source and built in the open. Ask questions, share what you ship, and help shape how autonomous engineering teams should work.</p>
        <div class="of-actions fade-up" style="animation-delay:400ms">
          <a href="https://discord.gg/gDhK2RQZpY" target="_blank" rel="noopener noreferrer" class="of-btn of-btn-primary of-btn-lg"><span class="of-sq"></span>Join the Discord</a>
          <a href="/docs/contributing" class="of-btn of-btn-ghost of-btn-lg">Contributor guide</a>
        </div>
      </div>
    </section>

    <section class="of-section">
      <div class="of-container">
        <div class="channels" data-reveal-group>
          {CHANNELS.map((c) => (
            <a href={c.href} class="channel of-card" target={c.internal ? undefined : '_blank'} rel={c.internal ? undefined : 'noopener noreferrer'} data-reveal>
              <span class="channel-icon"><svg viewBox="0 0 24 24" fill={c.fill ? 'currentColor' : 'none'} stroke={c.fill ? 'none' : 'currentColor'} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon} /></span>
              <h2>{c.title}</h2>
              <p>{c.desc}</p>
              <span class="channel-cta">{c.cta} <span aria-hidden="true">{c.internal ? '→' : '↗'}</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="of-section" style="padding-top:0">
      <div class="of-container">
        <div class="split-head" data-reveal>
          <div>
            <span class="of-eyebrow">Contribute</span>
            <h2 class="of-h2">Ways to get involved.</h2>
          </div>
          <p class="of-lede">Most contributions need no deep knowledge of the core. The registry is designed so skills, tools and models plug in without touching orchestration code.</p>
        </div>
        <div class="contrib" data-reveal-group>
          {CONTRIBUTE.map((c, i) => (
            <a href={c.href} class="contrib-item" data-reveal>
              <span class="contrib-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
              <span class="contrib-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="principles-wrap">
      <div class="principles of-panel of-dark">
        <div class="of-container">
          <div class="split-head" data-reveal>
            <div>
              <span class="of-eyebrow">What we believe</span>
              <h2 class="of-h2">Code is the output. Architecture is the product.</h2>
            </div>
            <p class="of-lede">Coder governs where agents run. OpenFlows governs how they coordinate. These principles decide what we build and what we refuse to.</p>
          </div>
          <div class="principle-grid" data-reveal-group>
            {PRINCIPLES.map((p, i) => (
              <div class="principle" data-reveal>
                <span class="contrib-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{p.title}</h3>
                <p>{p.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <div style="height: clamp(4rem, 8vw, 6rem)"></div>
    <CtaBanner title="Your first contribution starts here." body="Pick an issue, open a pull request, and the maintainers will help you land it." primary={{ label: 'Contributor guide', href: '/docs/contributing' }} secondary={{ label: 'Good first issues', href: `${REPO}/issues`, external: true }} />
  </main>
</BaseLayout>

<style>
  .channels { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .channel { display: flex; flex-direction: column; padding: 1.6rem; min-height: 250px; }
  .channel-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--of-text); color: var(--of-invert); }
  .channel-icon svg { width: 20px; height: 20px; }
  .channel h2 { margin-top: 1.5rem; font-size: 1.2rem; letter-spacing: -0.02em; }
  .channel p { margin: 0.5rem 0 1.5rem; font-size: 0.9rem; line-height: 1.55; color: var(--of-text-2); }
  .channel-cta { margin-top: auto; font-size: 0.88rem; font-weight: 500; }

  .split-head { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 4rem; align-items: end; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .split-head h2 { margin-top: 1rem; }

  .contrib { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--of-line-strong); border-left: 1px solid var(--of-line-strong); }
  .contrib-item { position: relative; display: flex; flex-direction: column; padding: 1.6rem 1.6rem 1.8rem; border-right: 1px solid var(--of-line-strong); border-bottom: 1px solid var(--of-line-strong); transition: background 0.3s; }
  .contrib-item:hover { background: var(--of-surface); }
  .contrib-num { font-family: var(--font-mono); font-size: 0.72rem; color: var(--of-text-3); }
  .contrib-item h3, .principle h3 { margin-top: 1.75rem; font-size: 1.1rem; letter-spacing: -0.02em; }
  .contrib-item p, .principle p { margin-top: 0.45rem; font-size: 0.9rem; line-height: 1.55; color: var(--of-text-2); }
  .contrib-arrow { position: absolute; top: 1.5rem; right: 1.6rem; color: var(--of-text-3); transition: transform 0.4s var(--ease-out), color 0.3s; }
  .contrib-item:hover .contrib-arrow { transform: translateX(4px); color: var(--of-text); }


  .principles { padding: clamp(4rem, 8vw, 6.5rem) 0; }
  .principle-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--of-line); }
  .principle { padding: 1.6rem 1.5rem 0 0; }
  .principle + .principle { padding-left: 1.5rem; border-left: 1px solid var(--of-line); }

  @media (max-width: 1000px) {
    .channels { grid-template-columns: 1fr 1fr; }
    .contrib { grid-template-columns: 1fr 1fr; }
    .split-head { grid-template-columns: 1fr; }
    .principle-grid { grid-template-columns: 1fr 1fr; }
    .principle:nth-child(3) { padding-left: 0; border-left: 0; }
  }

  @media (max-width: 600px) {
    .channels, .people, .contrib, .principle-grid { grid-template-columns: 1fr; }
    .principle, .principle + .principle { padding-left: 0; border-left: 0; padding-bottom: 1.25rem; }
  }
</style>
