---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CommunityBand from '@/organisms/About/CommunityBand.astro';
import Layers from '@/organisms/About/Layers.astro';
import PrinciplesGrid from '@/organisms/About/PrinciplesGrid.astro';
import RunLog from '@/organisms/About/RunLog.astro';
import StatBand from '@/organisms/About/StatBand.astro';
import TeamList from '@/organisms/About/TeamList.astro';

const STATS = [
  { value: '5', label: 'Specialized agents' },
  { value: '24/7', label: 'Autonomous operation' },
  { value: '~16 min', label: 'Issue to merged PR' },
  { value: 'MIT', label: 'Open source license' },
];

const AGENTS = [
  {
    id: 'nexus',
    name: 'NEXUS',
    role: 'Orchestrator',
    desc: 'Syncs GitHub issues, assigns work to agents, and coordinates the tenant pipeline. Manager provisions and manages the workspaces.',
    color: 'var(--color-agent-nexus)',
  },
  {
    id: 'forge',
    name: 'FORGE',
    role: 'Builder',
    desc: 'Receives tickets, writes PLAN.md, implements code segment by segment, and opens pull requests.',
    color: 'var(--color-agent-forge)',
  },
  {
    id: 'sentinel',
    name: 'SENTINEL',
    role: 'Reviewer',
    desc: 'Reviews every code segment against 5 criteria: correctness, security, test coverage, standards compliance, and no regressions.',
    color: 'var(--color-agent-sentinel)',
  },
  {
    id: 'vessel',
    name: 'VESSEL',
    role: 'Shipper',
    desc: 'Handles CI status, resolves merge conflicts, and squash-merges approved PRs after SENTINEL approval.',
    color: 'var(--color-agent-vessel)',
  },
  {
    id: 'lore',
    name: 'LORE',
    role: 'Documenter',
    desc: 'Writes ADRs (Architecture Decision Records) and updates CHANGELOG.md after each successful merge.',
    color: 'var(--color-agent-lore)',
  },
];

const PRINCIPLES = [
  {
    title: 'Autonomous by default',
    desc: 'NEXUS coordinates tickets and agents, while Manager provisions workspaces and brokers runtime credentials. The pipeline escalates decisions that require a person.',
  },
  {
    title: 'Each agent has an identity',
    desc: 'Each agent has a role, skills, hooks, and a workspace runtime identity. Manager brokers short-lived GitHub App installation tokens scoped to the tenant repository; human GitHub OAuth remains separate.',
  },
  {
    title: 'Built for resilience',
    desc: 'Manager persists operations and uses leases so another instance can resume queued work. Agent coordination and workspace reconciliation provide additional recovery paths.',
  },
  {
    title: 'Model-agnostic, adversarial by design',
    desc: "Each agent's model is configured independently, so FORGE and SENTINEL can use different providers and the reviewer's blind spots differ from the writer's. SENTINEL spawns fresh per evaluation, read-only and bias-free.",
  },
  {
    title: 'Open source, MIT licensed',
    desc: 'The orchestration engine, SharedStore, agent harnesses, and setup wizard are on GitHub under the MIT license, self-hosted on your infrastructure.',
  },
  {
    title: 'Ship faster, not harder',
    desc: 'FORGE implements and opens PRs in 15–30 minutes, SENTINEL reviews every segment automatically, and VESSEL merges when CI is green, so the review queue stops being the bottleneck.',
  },
  {
    title: 'Conflict rework, not rebase churn',
    desc: 'When VESSEL detects a merge conflict, it writes CONFLICT_RESOLUTION.md and routes the ticket back to the same FORGE worker, which reworks and re-commits without losing context.',
  },
  {
    title: 'Documentation as a byproduct',
    desc: 'LORE writes Architecture Decision Records and updates CHANGELOG.md after every successful merge, so technical decisions are captured as the work ships.',
  },
];
---

<BaseLayout title="About - OpenFlows" description="Learn about OpenFlows - the autonomous AI development team orchestration layer that coordinates five specialized agents to take GitHub issues to merged pull requests.">
  <main class="about">
    <header class="about-hero">
      <div class="about-hero-inner" data-intro>
        <p class="about-label">About OpenFlows</p>
        <h1>The orchestration layer for autonomous AI development teams</h1>
        <p class="about-lede">
          OpenFlows coordinates five specialized AI agents through a Redis-backed state machine, taking GitHub issues
          all the way to merged, documented pull requests. You wake up to completed features, reviewed PRs, and
          updated documentation.
        </p>
        <div class="about-hero-actions">
          <a href="/docs/getting-started" class="about-button primary">Get started</a>
          <a href="/docs/architecture" class="about-button">Read the architecture</a>
        </div>
      </div>
    </header>

    <Layers />
    <StatBand stats={STATS} />
    <TeamList agents={AGENTS} />
    <RunLog />
    <PrinciplesGrid principles={PRINCIPLES} />
    <CommunityBand />
  </main>
</BaseLayout>

<style>
  .about {
    --about-frame: min(var(--max-width-6xl), calc(100% - 2 * var(--space-6)));

    position: relative;
  }

  /* Dashed guides frame the content column down the whole page. */
  .about::before,
  .about::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 0;
    border-left: 1px dashed var(--color-driftwood);
    pointer-events: none;
  }

  .about::before {
    left: calc((100% - var(--about-frame)) / 2);
  }

  .about::after {
    right: calc((100% - var(--about-frame)) / 2);
  }

  .about > :global(*) {
    position: relative;
    z-index: 1;
  }

  .about-hero {
    padding: calc(var(--nav-height) + clamp(4rem, 9vw, 8rem)) 0 clamp(3rem, 6vw, 5rem);
  }

  .about-hero-inner {
    max-width: var(--max-width-6xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .about-label {
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-graphite);
  }

  .about-hero h1 {
    margin: 0 0 2rem;
    max-width: 15ch;
    font-size: clamp(3rem, 7vw, 6.5rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .about-lede {
    margin: 0 0 2.5rem;
    max-width: 38rem;
    font-size: clamp(1.125rem, 1.6vw, 1.3125rem);
    line-height: 1.6;
    color: var(--color-graphite);
  }

  .about-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .about-button {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.375rem;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    transition: background-color 0.25s ease, transform 0.25s var(--ease-out-soft);
  }

  .about-button:hover {
    background: var(--color-bone);
    color: var(--color-ink);
    transform: translateY(-1px);
  }

  .about-button.primary {
    border-color: var(--color-aubergine);
    background: var(--color-aubergine);
    color: #fff;
  }

  .about-button.primary:hover {
    background: var(--color-aubergine-deep);
    color: #fff;
  }

  .about-button:focus-visible {
    outline: 2px solid var(--color-aubergine);
    outline-offset: 3px;
  }

  .about > :global(.community) {
    background: var(--color-parchment-canvas);
  }
</style>
