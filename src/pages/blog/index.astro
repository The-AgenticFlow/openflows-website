---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCover from '@/components/blog/PostCover.astro';
import PostMeta from '@/components/blog/PostMeta.astro';
import PostRow from '@/components/blog/PostRow.astro';
import { getPostHref, getPublishedPosts } from '@/components/blog/blog';

const posts = await getPublishedPosts();
const lead = posts.find((post) => post.data.is_featured) ?? posts[0];
const rest = posts.filter((post) => post.id !== lead?.id);
---

<BaseLayout title="Blog - OpenFlows" description="Essays on building software with AI agents, from the OpenFlows team.">
  <main class="blog-index">
    <header class="blog-index-header">
      <h1>Blog</h1>
      <p>Essays on building software with AI agents, from the OpenFlows team.</p>
    </header>

    {lead && (
      <article class="blog-lead">
        <PostCover post={lead} eager />
        <div class="blog-lead-body">
          {lead.data.category_id && <p class="blog-lead-category">{lead.data.category_id}</p>}
          <h2 class="blog-lead-title">
            <a href={getPostHref(lead)}>{lead.data.title}</a>
          </h2>
          {lead.data.excerpt && <p class="blog-lead-excerpt">{lead.data.excerpt}</p>}
          <PostMeta post={lead} />
        </div>
      </article>
    )}

    {rest.length > 0 && (
      <section class="blog-index-list" aria-label="More posts">
        {rest.map((post) => <PostRow post={post} />)}
      </section>
    )}

    {posts.length === 0 && (
      <p class="blog-index-empty">No posts yet. New essays will appear here as soon as they are published.</p>
    )}
  </main>
</BaseLayout>

<style>
  .blog-index {
    max-width: var(--max-width-6xl);
    margin: 0 auto;
    padding: calc(var(--nav-height) + 4rem) 2rem 6rem;
  }

  .blog-index-header {
    max-width: 40rem;
    margin-bottom: 3.5rem;
  }

  .blog-index-header h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .blog-index-header p {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--color-graphite);
  }

  .blog-lead {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    margin-bottom: 4rem;
  }

  .blog-lead-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .blog-lead-category {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-aubergine);
  }

  .blog-lead-title {
    margin: 0;
    font-size: clamp(1.875rem, 3.2vw, 2.625rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .blog-lead-title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .blog-lead-title a::after {
    content: '';
    position: absolute;
    inset: -0.75rem;
    border-radius: var(--radius-xl);
  }

  .blog-lead-title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .blog-lead-title a:focus-visible {
    outline: none;
  }

  .blog-lead-title a:focus-visible::after {
    outline: 2px solid var(--color-aubergine);
  }

  .blog-lead-excerpt {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--color-graphite);
  }

  .blog-index-empty {
    padding-block: 3rem;
    color: var(--color-graphite);
  }

  @media (max-width: 860px) {
    .blog-lead {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-bottom: 3rem;
    }
  }

  @media (max-width: 640px) {
    .blog-index {
      padding: calc(var(--nav-height) + 2.5rem) 1rem 4rem;
    }

    .blog-index-header {
      margin-bottom: 2.5rem;
    }
  }
</style>
