---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogItem from '@/components/blog/BlogItem.astro';
import BlogSidebar from '@/components/blog/BlogSidebar.astro';
import LeadPost from '@/components/blog/LeadPost.astro';
import { getPublishedPosts } from '@/components/blog/blog';

const posts = await getPublishedPosts();
// Posts arrive newest first, so the featured spot always shows the latest one.
const lead = posts[0];

const topicCounts = new Map<string, number>();
posts.forEach((post) => {
  const topic = post.data.category_id?.trim();
  if (topic) topicCounts.set(topic, (topicCounts.get(topic) ?? 0) + 1);
});
const topics = [...topicCounts.entries()]
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---

<BaseLayout title="Blog - OpenFlows" description="Essays on building software with AI agents, from the OpenFlows team.">
  <main class="blog" data-blog>
    <header class="blog-head">
      <h1>Blog</h1>
      <p class="blog-sub">Essays on building software with AI agents, from the OpenFlows team.</p>
    </header>

    {posts.length > 0 ? (
      <div class="blog-layout">
        <BlogSidebar topics={topics} total={posts.length} />

        <div class="blog-main">
          <p class="blog-status" role="status" aria-live="polite" data-blog-status>
            {posts.length} {posts.length === 1 ? 'post' : 'posts'}
          </p>

          {lead && <LeadPost post={lead} />}

          <div class="blog-list">
            {posts.map((post) => (
              <BlogItem post={post} lead={post.id === lead?.id} hidden={post.id === lead?.id} />
            ))}
          </div>

          <div class="blog-empty" hidden data-blog-empty>
            <p>No posts match that search.</p>
            <button type="button" data-blog-clear>Clear filters</button>
          </div>
        </div>
      </div>
    ) : (
      <p class="blog-none">No posts yet. New essays appear here as soon as they are published.</p>
    )}
  </main>

  <script>
    import '@/components/blog/blogFilter';
  </script>
</BaseLayout>

<style>
  .blog {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: calc(var(--nav-height) + clamp(2.5rem, 5vw, 4rem)) var(--space-6) 6rem;
  }

  .blog-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-ink);
  }

  .blog-head h1 {
    margin: 0;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .blog-sub {
    margin: 0;
    font-size: 1.0625rem;
    color: var(--color-graphite);
  }

  .blog-layout {
    display: grid;
    grid-template-columns: 15.5rem minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .blog-main {
    min-width: 0;
  }

  .blog-status {
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-graphite);
  }

  .blog-list {
    display: flex;
    flex-direction: column;
  }

  .blog-empty {
    padding: 3rem 0;
    text-align: center;
    color: var(--color-graphite);
  }

  .blog-empty[hidden] {
    display: none;
  }

  .blog-empty button {
    margin-top: 0.5rem;
    padding: 0.625rem 1.25rem;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    background: none;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
    cursor: pointer;
  }

  .blog-empty button:hover {
    background: var(--color-bone);
  }

  .blog-empty button:focus-visible {
    outline: 2px solid var(--color-aubergine);
    outline-offset: 3px;
  }

  .blog-none {
    padding-block: 3rem;
    color: var(--color-graphite);
  }

  @media (max-width: 900px) {
    .blog-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .blog {
      padding-inline: var(--space-4);
    }
  }
</style>
