---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import { supabase, isSupabaseConfigured, TABLES } from '../../lib/supabase.js';
import MarkdownRenderer from '../../components/MarkdownRenderer/MarkdownRenderer.jsx';
import TextToSpeechPlayer from '../../components/TextToSpeechPlayer/TextToSpeechPlayer.jsx';

// Giscus configuration from environment variables
const giscusConfig = {
  repo: import.meta.env.PUBLIC_GISCUS_REPO || '',
  repoId: import.meta.env.PUBLIC_GISCUS_REPO_ID || '',
  category: import.meta.env.PUBLIC_GISCUS_CATEGORY || 'General',
  categoryId: import.meta.env.PUBLIC_GISCUS_CATEGORY_ID || '',
};

const showComments = giscusConfig.repo && giscusConfig.repoId && giscusConfig.categoryId;

export async function getStaticPaths() {
  if (!isSupabaseConfigured() || !supabase) {
    return [];
  }

  try {
    const { data, error } = await supabase
      .from(TABLES.BLOGS)
      .select('slug')
      .eq('status', 'published')
      .is('deleted_at', null);

    if (error) {
      console.warn('Error fetching blog slugs:', error.message);
      return [];
    }

    return (data || []).map((post) => ({
      params: { slug: post.slug },
    }));
  } catch (err) {
    console.warn('Error in getStaticPaths:', err.message);
    return [];
  }
}

const { slug } = Astro.params;

let post = null;
let notFound = false;

if (isSupabaseConfigured() && supabase && slug) {
  try {
    const { data, error } = await supabase
      .from(TABLES.BLOGS)
      .select(`
        *,
        category:blog_categories(name, slug)
      `)
      .eq('slug', slug)
      .eq('status', 'published')
      .is('deleted_at', null)
      .single();

    if (error) {
      console.warn('Error fetching blog post:', error.message);
      notFound = true;
    } else {
      post = data;
    }
  } catch (err) {
    console.warn('Error fetching blog post:', err.message);
    notFound = true;
  }
} else {
  notFound = true;
}

const formatDate = (dateString) => {
  if (!dateString) return '';
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const getReadTime = (content) => {
  if (!content) return 1;
  const words = content.trim().split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
};

const getResolvedAuthors = (post) => {
  if (post.authors && post.authors.length > 0) {
    return post.authors;
  }
  if (post.author_name) {
    return [{ name: post.author_name, avatar_url: post.author_avatar_url, role: '', linkedin: '', github: '', website: '' }];
  }
  return [];
};

if (notFound || !post) {
  return Astro.redirect('/blog');
}

const resolvedAuthors = getResolvedAuthors(post);
const readTime = getReadTime(post.content || '');
const postImage = post.cover_image_url || 'https://openflows.dev/og-image.png';
const postDescription = post.excerpt || post.title || 'OpenFlows Blog Post';
const canonicalURL = `https://openflows.dev/blog/${post.slug}`;
---

<BaseLayout title={post.title} description={postDescription} image={postImage} canonicalURL={canonicalURL}>
  <Navbar />
  <main>
    <article class="article">
      <!-- Back Button -->
      <a href="/blog" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m15 18-6-6 6-6" />
        </svg>
        Back to Blog
      </a>

      <!-- Hero Card with Cover Image -->
      <header class="hero-card">
        {post.cover_image_url && (
          <div class="hero-bg">
            <img src={post.cover_image_url} alt="" />
            <div class="hero-overlay" />
          </div>
        )}
        <div class="hero-content">
          <div class="hero-meta">
            <span class="hero-date">
              {formatDate(post.published_at || post.created_at)}
            </span>
            <span class="hero-read-time">
              {readTime} min read
            </span>
          </div>
          <h1 class="hero-title">{post.title}</h1>
          <p class="hero-excerpt">{post.excerpt}</p>
          <div class="hero-footer">
            {post.category && (
              <span class="hero-category">{post.category.name}</span>
            )}
            {resolvedAuthors.length > 0 && (
              <div class="hero-author">
                {resolvedAuthors[0].avatar_url ? (
                  <img src={resolvedAuthors[0].avatar_url} alt={resolvedAuthors[0].name} class="hero-avatar" />
                ) : (
                  <div class="hero-avatar-placeholder">
                    {resolvedAuthors[0].name?.charAt(0).toUpperCase()}
                  </div>
                )}
                <span class="hero-author-name">{resolvedAuthors[0].name}</span>
              </div>
            )}
          </div>
        </div>
      </header>

      <!-- Authors Section -->
      {resolvedAuthors.length > 0 && (
        <section class="authors-section">
          <p class="authors-section-label">Written by</p>
          <div class="authors-grid">
            {resolvedAuthors.map((author) => (
              <div class="author-card">
                <div class="author-card-left">
                  {author.avatar_url ? (
                    <img src={author.avatar_url} alt={author.name} class="author-card-avatar" />
                  ) : (
                    <div class="author-card-avatar-placeholder">
                      {author.name?.charAt(0).toUpperCase()}
                    </div>
                  )}
                </div>
                <div class="author-card-body">
                  <span class="author-card-name">{author.name}</span>
                  {author.role && (
                    <span class="author-card-role">{author.role}</span>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Share Button + TTS Player Row -->
      <div class="share-bar">
        <!-- Text To Speech Player -->
        <div class="tts-player">
          <TextToSpeechPlayer client:load title={post.title} text={post.content || ''} />
        </div>
        <button class="share-link-btn" id="shareBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
          </svg>
          <span id="shareText">Share</span>
        </button>
      </div>

      <!-- Content -->
      <div class="article-body">
        <MarkdownRenderer client:load content={post.content || ''} />
      </div>

      <!-- Footer - Share -->
      <footer class="article-footer">
        <div class="share-buttons">
          <span class="share-label">Share this article</span>
          <div class="share-icons">
            <a
              href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(canonicalURL)}&title=${encodeURIComponent(post.title)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="share-btn"
              aria-label="Share on LinkedIn"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </a>
          </div>
        </div>
      </footer>

      <!-- Giscus Comments -->
      {showComments && (
        <GiscusComments
          repo={giscusConfig.repo}
          repoId={giscusConfig.repoId}
          category={giscusConfig.category}
          categoryId={giscusConfig.categoryId}
        />
      )}
    </article>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Copy link to clipboard
  const shareBtn = document.getElementById('shareBtn');
  const shareText = document.getElementById('shareText');

  if (shareBtn) {
    shareBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        shareText.textContent = 'Copied!';
        setTimeout(() => {
          shareText.textContent = 'Share';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy:', err);
      }
    });
  }
</script>

<style>
  .article {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6);
    min-height: 100vh;
    overflow-x: hidden;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 2.5rem;
    margin-left: -10rem;
    transition: all var(--transition-base);
    opacity: 0.7;
  }

  @media (max-width: 800px) {
    .back-link {
      margin-left: 0;
    }
  }

  .back-link:hover {
    opacity: 1;
    color: var(--color-text-primary);
    transform: translateX(-4px);
  }

  /* Hero Card */
  .hero-card {
    position: relative;
    width: calc(100% + 20rem);
    margin-left: -10rem;
    margin-right: -10rem;
    min-height: 500px;
    border-radius: 2rem;
    overflow: hidden;
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 800px) {
    .hero-card {
      width: 100%;
      margin-left: 0;
      margin-right: 0;
      min-height: 360px;
      border-radius: var(--radius-lg);
    }
  }

  @media (max-width: 480px) {
    .hero-card {
      min-height: 300px;
      border-radius: var(--radius-md);
    }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) brightness(0.6);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom,
        rgba(0, 0, 0, 0.1) 0%,
        rgba(0, 0, 0, 0.2) 40%,
        rgba(0, 0, 0, 0.5) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: 3.5rem;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
  }

  @media (max-width: 800px) {
    .hero-content {
      padding: 2rem;
    }
  }

  @media (max-width: 480px) {
    .hero-content {
      padding: 1.5rem;
    }
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .hero-date {
    font-weight: 500;
  }

  .hero-read-time {
    font-weight: 500;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text-primary);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .hero-excerpt {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
    max-width: 650px;
  }

  .hero-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .hero-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .hero-category {
    padding: 0.35rem 0.75rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
  }

  .hero-avatar-placeholder {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-surface-2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-text-primary);
  }

  .hero-author-name {
    font-weight: 600;
    color: var(--color-text-primary);
    font-size: 0.9rem;
  }

  /* Authors Section */
  .authors-section {
    max-width: 100%;
    margin: 3rem 0 2rem;
    padding: 0;
    background: transparent;
    border: none;
    overflow-x: hidden;
  }

  .authors-section-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .authors-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .author-card {
    display: flex;
    align-items: center;
    flex-direction: row;
    gap: 0.75rem;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    max-width: 100%;
    overflow: hidden;
  }

  @media (max-width: 480px) {
    .author-card {
      padding: 0.75rem;
    }
  }

  .author-card:hover {
    border-color: var(--color-border-hover);
  }

  .author-card-left {
    flex-shrink: 0;
  }

  .author-card-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-card-avatar-placeholder {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-surface-2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-text-primary);
  }

  .author-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .author-card-name {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-text-primary);
  }

  .author-card-role {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  /* Share Bar */
  .share-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .tts-player {
    flex: 1;
  }

  .tts-player :global(.ttsContainer) {
    margin-bottom: 0;
  }

  .share-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: transparent;
    border: none;
    border-radius: 0;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .share-link-btn:hover {
    color: var(--color-text-primary);
  }

  .share-link-btn svg {
    flex-shrink: 0;
  }

  /* Article Body */
  .article-body {
    max-width: 100%;
    margin: 0;
    overflow-x: hidden;
  }

  .article-body :global(p),
  .article-body :global(ul),
  .article-body :global(ol),
  .article-body :global(h1),
  .article-body :global(h2),
  .article-body :global(h3),
  .article-body :global(h4),
  .article-body :global(h5),
  .article-body :global(h6),
  .article-body :global(blockquote),
  .article-body :global(hr),
  .article-body :global(pre) {
    max-width: 100%;
    margin-left: 0;
    margin-right: 0;
  }

  /* Tables scroll horizontally instead of breaking layout */
  .article-body :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  /* Prevent code blocks inside table cells from overflowing */
  .article-body :global(td),
  .article-body :global(th) {
    max-width: 0;
    overflow: hidden;
    word-break: break-word;
    white-space: normal;
  }

  .article-body :global(td pre),
  .article-body :global(th pre) {
    white-space: pre-wrap;
    word-break: break-word;
    overflow-x: auto;
  }

  /* Footer Section */
  .article-footer {
    max-width: 720px;
    margin: 5rem 0 0;
    padding-top: 3rem;
    border-top: 1px solid var(--color-border);
  }

  .share-buttons {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .share-label {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .share-icons {
    display: flex;
    gap: 1rem;
  }

  .share-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    transition: all var(--transition-base);
  }

  .share-btn:hover {
    background: var(--color-surface-2);
    color: var(--color-text-primary);
    border-color: var(--color-text-primary);
    transform: translateY(-2px);
  }

  /* Responsive */
  @media (max-width: 800px) {
    .article {
      padding: var(--space-12) var(--space-4);
    }

    .hero-title {
      font-size: clamp(1.5rem, 5vw, 2.5rem);
    }

    .hero-excerpt {
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .hero-meta {
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .hero-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
