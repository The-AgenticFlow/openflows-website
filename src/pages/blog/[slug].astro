---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import PostMeta from '@/components/blog/PostMeta.astro';
import PostRow from '@/components/blog/PostRow.astro';
import { getPublishedPosts, toSafeSlug, type BlogPost } from '@/components/blog/blog';

const MORE_POSTS_COUNT = 2;

export async function getStaticPaths() {
  const blogs = await getCollection('blogs');
  return blogs.map((blog) => ({
    params: { slug: toSafeSlug(blog.data.slug || blog.slug) },
    props: { blog },
  }));
}

const { blog } = Astro.props as { blog: BlogPost };
const { Content } = await render(blog);

const morePosts = (await getPublishedPosts())
  .filter((post) => post.id !== blog.id)
  .slice(0, MORE_POSTS_COUNT);
---

<BaseLayout
  title={`${blog.data.title} - OpenFlows`}
  description={blog.data.meta_description || blog.data.excerpt}
  ogImage={blog.data.cover_image_url}
>
  <main class="post-page">
    <article>
      <header class="post-header">
        <a class="post-back" href="/blog">← All posts</a>
        {blog.data.category_id && <p class="post-category">{blog.data.category_id}</p>}
        <h1 class="post-title">{blog.data.title}</h1>
        {blog.data.excerpt && <p class="post-excerpt">{blog.data.excerpt}</p>}
        <PostMeta post={blog} />
      </header>

      {blog.data.cover_image_url && (
        <figure class="post-cover">
          <img
            src={blog.data.cover_image_url}
            alt={blog.data.cover_image_alt || ''}
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}

      <div class="post-content">
        <Content />
      </div>
    </article>

    {morePosts.length > 0 && (
      <section class="post-more" aria-labelledby="post-more-heading">
        <h2 id="post-more-heading">Keep reading</h2>
        {morePosts.map((post) => <PostRow post={post} headingLevel="h3" />)}
      </section>
    )}

    <section id="comments" class="post-comments" aria-labelledby="post-comments-heading">
      <h2 id="post-comments-heading">Comments</h2>
      <p>Questions or feedback? Comments are stored as GitHub Discussions on the OpenFlows website repository.</p>
      <div id="giscus-container"></div>
    </section>
  </main>

  <script>
    const loadGiscus = () => {
      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.setAttribute('data-repo', 'The-AgenticFlow/openflows-website');
      script.setAttribute('data-repo-id', 'R_kgDOShxBEw');
      script.setAttribute('data-category', 'Announcements');
      script.setAttribute('data-category-id', 'DIC_kwDOShxBE84C_8Ek');
      script.setAttribute('data-mapping', 'pathname');
      script.setAttribute('data-strict', '0');
      script.setAttribute('data-reactions-enabled', '1');
      script.setAttribute('data-emit-metadata', '0');
      script.setAttribute('data-input-position', 'bottom');
      script.setAttribute('data-theme', 'light');
      script.setAttribute('data-lang', 'en');
      script.setAttribute('data-loading', 'lazy');
      script.setAttribute('crossorigin', 'anonymous');
      script.async = true;
      document.getElementById('giscus-container')?.appendChild(script);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadGiscus);
    } else {
      loadGiscus();
    }
  </script>
</BaseLayout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap");

  :global(html),
  :global(body) {
    background: var(--color-bone);
  }

  .post-page {
    --post-text-width: 42rem;
    --post-wide-width: 64rem;
    --post-serif: "Source Serif 4", Georgia, Cambria, "Times New Roman", serif;

    padding: calc(var(--nav-height) + 3.5rem) 1.5rem 6rem;
  }

  .post-header,
  .post-content,
  .post-more,
  .post-comments {
    max-width: var(--post-text-width);
    margin-inline: auto;
  }

  .post-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .post-back {
    align-self: flex-start;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-graphite);
    text-decoration: none;
  }

  .post-back:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .post-category {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-aubergine);
  }

  .post-title {
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .post-excerpt {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--color-graphite);
    text-wrap: pretty;
  }

  .post-cover {
    max-width: var(--post-wide-width);
    margin: 0 auto 3.5rem;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--color-fog);
  }

  .post-cover img {
    display: block;
    width: 100%;
    height: auto;
  }

  .post-content {
    font-family: var(--post-serif);
    font-size: 1.25rem;
    line-height: 1.65;
    color: var(--color-ink);
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  .post-content :global(p),
  .post-content :global(li) {
    color: inherit;
  }

  .post-content :global(p) {
    margin: 0 0 1.4em;
  }

  .post-content :global(h2),
  .post-content :global(h3) {
    font-family: var(--post-serif);
    font-weight: 700;
    color: var(--color-ink);
    text-wrap: balance;
    scroll-margin-top: calc(var(--nav-height) + 1.5rem);
  }

  .post-content :global(h2) {
    margin: 2.2em 0 0.6em;
    font-size: 1.75rem;
    line-height: 1.25;
  }

  .post-content :global(h3) {
    margin: 1.8em 0 0.5em;
    font-size: 1.375rem;
    line-height: 1.3;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1.4em;
    padding-left: 1.4em;
  }

  .post-content :global(ul) {
    list-style: disc;
  }

  .post-content :global(ol) {
    list-style: decimal;
  }

  .post-content :global(li) {
    margin-bottom: 0.5em;
    padding-left: 0.25em;
  }

  .post-content :global(li::marker) {
    color: var(--color-graphite);
  }

  .post-content :global(a) {
    color: var(--color-aubergine);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .post-content :global(blockquote) {
    margin: 1.8em 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--color-aubergine);
    font-style: italic;
  }

  .post-content :global(img) {
    display: block;
    max-width: 100%;
    margin: 2rem auto;
    border-radius: var(--radius-md);
  }

  .post-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .post-content :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    background: var(--color-parchment-canvas);
  }

  .post-content :global(pre) {
    margin: 0 0 1.4em;
    padding: 1.25rem;
    overflow-x: auto;
    border-radius: var(--radius-lg);
    background: var(--color-ink);
    color: var(--color-bone);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .post-content :global(pre code) {
    font-size: inherit;
  }

  .post-content :global(table) {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    font-family: var(--font-family);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .post-content :global(th),
  .post-content :global(td) {
    padding: 0.75rem;
    border: 1px solid var(--color-driftwood);
    text-align: left;
    vertical-align: top;
  }

  .post-content :global(hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--color-driftwood);
  }

  .post-more,
  .post-comments {
    margin-top: 5rem;
  }

  .post-more h2,
  .post-comments h2 {
    margin: 0 0 1rem;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .post-comments {
    padding-top: 2rem;
    border-top: 1px solid var(--color-driftwood);
  }

  .post-comments p {
    margin: 0 0 1.5rem;
    font-size: 0.9375rem;
    color: var(--color-graphite);
  }

  #giscus-container {
    min-height: 200px;
  }

  @media (max-width: 640px) {
    .post-page {
      padding: calc(var(--nav-height) + 2rem) 1rem 4rem;
    }

    .post-cover {
      margin-bottom: 2.5rem;
      border-radius: var(--radius-lg);
    }

    .post-excerpt {
      font-size: 1.125rem;
    }

    .post-content {
      font-size: 1.125rem;
    }
  }
</style>
