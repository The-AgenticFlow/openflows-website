---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AuthorByline from '@/components/blog/AuthorByline.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const blogs = await getCollection('blogs');
  const toSafeSlug = (rawSlug) => rawSlug
    .toString()
    .trim()
    .toLowerCase()
    .replace(/&/g, ' and ')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

  return blogs.map((blog) => ({
    params: { slug: toSafeSlug(blog.data.slug || blog.slug) },
    props: { blog },
  }));
}

const { blog } = Astro.props;
const { Content } = await render(blog);

const formatDate = (d) => {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const readTime = blog.data.read_time_minutes || Math.max(1, Math.ceil((blog.body || '').split(/\s+/).length / 200));
---

<BaseLayout
  title={`${blog.data.title} - OpenFlows`}
  description={blog.data.meta_description || blog.data.excerpt}
  ogImage={blog.data.cover_image_url}
>
  <main class="of-article">
    <article>
      <header class="of-article-inner">
        <a href="/blog" class="of-back">← Back to blog</a>
        <div class="of-article-kicker">
          <span>{blog.data.category_id || 'Blog'}</span>
          <span class="sep">/</span>
          <span class="muted">{readTime} min read</span>
        </div>
        <h1 class="of-article-title">{blog.data.title}</h1>
        {blog.data.excerpt && <p class="of-article-dek">{blog.data.excerpt}</p>}
        <div class="of-article-meta">
          <AuthorByline post={blog} />
          <span class="dot">·</span>
          <time datetime={blog.data.published_at?.toISOString?.()}>{formatDate(blog.data.published_at)}</time>
        </div>
      </header>

      {blog.data.cover_image_url && (
        <div class="of-article-cover">
          <img src={blog.data.cover_image_url} alt={blog.data.cover_image_alt || blog.data.title} />
        </div>
      )}

      <div class="of-article-body of-prose">
        <Content />
      </div>

      <aside class="of-read-cta">
        <div>
          <b>See the pipeline for yourself.</b>
          <span>Install OpenFlows on your Coder environment and run your first issue.</span>
        </div>
        <a href="/docs/getting-started" class="of-btn of-btn-primary">Get started</a>
      </aside>

      <div id="comments" class="of-comments">
        <h2>Comments</h2>
        <p>Questions, feedback, or thoughts? Comment below and join the discussion on GitHub.</p>
        <div id="giscus-container" style="min-height: 200px;"></div>
      </div>
    </article>
  </main>

  <script>
    // Initialize Giscus
    const loadGiscus = () => {
      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.setAttribute('data-repo', 'The-AgenticFlow/openflows-website');
      script.setAttribute('data-repo-id', 'R_kgDOShxBEw');
      script.setAttribute('data-category', 'Announcements');
      script.setAttribute('data-category-id', 'DIC_kwDOShxBE84C_8Ek');
      script.setAttribute('data-mapping', 'pathname');
      script.setAttribute('data-strict', '0');
      script.setAttribute('data-reactions-enabled', '1');
      script.setAttribute('data-emit-metadata', '0');
      script.setAttribute('data-input-position', 'bottom');
      script.setAttribute('data-theme', 'transparent_dark');
      script.setAttribute('data-lang', 'en');
      script.setAttribute('crossorigin', 'anonymous');
      script.async = true;
      document.getElementById('giscus-container')?.appendChild(script);
    };

    // Load Giscus after page is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadGiscus);
    } else {
      loadGiscus();
    }
  </script>
</BaseLayout>
