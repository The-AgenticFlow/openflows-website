{
  "$ref": "#/definitions/blogs",
  "definitions": {
    "blogs": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        },
        "cover_image_url": {
          "type": "string"
        },
        "cover_image_alt": {
          "type": "string"
        },
        "author_name": {
          "type": "string"
        },
        "author_avatar_url": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "avatar_url": {
                "type": "string"
              },
              "linkedin": {
                "type": "string"
              },
              "github": {
                "type": "string"
              },
              "twitter": {
                "type": "string"
              },
              "website": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "category_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "published",
            "archived"
          ],
          "default": "published"
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "meta_title": {
          "type": "string"
        },
        "meta_description": {
          "type": "string"
        },
        "view_count": {
          "type": "number"
        },
        "read_time_minutes": {
          "type": "number"
        },
        "is_featured": {
          "type": "boolean"
        },
        "is_draft": {
          "type": "boolean",
          "default": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "excerpt",
        "author_name"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}